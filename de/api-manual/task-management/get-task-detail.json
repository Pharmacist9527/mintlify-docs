{
  "openapi": "3.1.0",
  "info": {
    "title": "Aufgabendetails-API abrufen",
    "description": "Status, Fortschritt und Ergebnisinformationen asynchroner Aufgaben anhand der Aufgaben-ID abfragen",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produktionsumgebung"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/tasks/{task_id}": {
      "get": {
        "summary": "Aufgabenstatus abfragen",
        "description": "Status, Fortschritt und Ergebnisinformationen asynchroner Aufgaben anhand der Aufgaben-ID abfragen",
        "operationId": "getTaskDetail",
        "tags": [
          "Aufgabenverwaltung"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Aufgaben-ID, ignorieren Sie {} bei der Abfrage, hängen Sie die ID aus dem Antworttext der asynchronen Aufgabe am Ende des Pfades an",
            "example": "task-unified-1756817821-4x3rx6ny"
          }
        ],
        "responses": {
          "200": {
            "description": "Details zum Aufgabenstatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                },
                "example": {
                  "created": 1788436500,
                  "duration": 30,
                  "id": "task-unified-1788436500-yscib7uw",
                  "model": "gemini-3-pro-image-preview",
                  "object": "image.generation.task",
                  "progress": 100,
                  "result_data": [
                    {
                      "url": "http://example.com/image.jpg"
                    }
                  ],
                  "results": [
                    "http://example.com/image.jpg"
                  ],
                  "status": "completed",
                  "task_info": {
                    "can_cancel": false
                  },
                  "type": "image",
                  "usage": {
                    "cost": {
                      "credits": 10,
                      "usd": 0.148,
                      "cny": 1
                    },
                    "credits_used": 10
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert: API-Schlüssel fehlt, ist ungültig, abgelaufen oder deaktiviert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Konto deaktiviert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "user_disabled",
                    "message": "Your account has been disabled (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Aufgabe existiert nicht oder gehört nicht zum aktuellen API-Schlüssel (auch bei fehlerhaft formatierter Aufgaben-ID)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "message": "Task not found",
                    "type": "invalid_request_error",
                    "param": "",
                    "code": "task_not_found"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Anfrage-Ratenlimit überschritten (Retry-After-Header wird ebenfalls gesetzt)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "You have reached the request limit: max 60 requests per 1 minutes. Retry after 30 seconds. (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "retry_after": 30,
                    "retryable": true,
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "message": "Failed to get task status",
                    "type": "api_error",
                    "param": "",
                    "code": "internal_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskDetailResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1756817821
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1756817821-4x3rx6ny"
          },
          "model": {
            "type": "string",
            "description": "Verwendetes Modell",
            "example": "gemini-3-pro-image-preview"
          },
          "object": {
            "type": "string",
            "description": "Aufgabentyp",
            "enum": [
              "image.generation.task",
              "video.generation.task",
              "audio.generation.task"
            ],
            "example": "image.generation.task"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Aufgabenfortschritt in Prozent",
            "example": 100
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus. Hinweis: Solange die Aufgabe upstream noch wartet, meldet die Abfrage-API bereits \"processing\"; Clients sehen daher normalerweise nur processing / completed / failed.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "completed"
          },
          "type": {
            "type": "string",
            "description": "Aufgabentyp",
            "enum": [
              "image",
              "video",
              "audio",
              "text"
            ],
            "example": "image"
          },
          "duration": {
            "type": "integer",
            "description": "Aufgabendauer in Sekunden. Nur vorhanden, wenn status \"completed\" oder \"failed\" ist.",
            "example": 30
          },
          "video_duration": {
            "type": "number",
            "description": "Tatsächliche Länge des generierten Videos in Sekunden. Nur bei einigen Videomodellen (z. B. Kling) im Endzustand vorhanden.",
            "example": 5.0
          },
          "draft_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Frist für die Konvertierung in ein finales Video (UTC, RFC 3339). Wird nur für Seedance-2.5-Entwürfe (mit `draft: true` erstellt) im Status `completed` zurückgegeben. Nach diesem Zeitpunkt ist eine Konvertierung mit Seedance 2.5 Draft-to-Video nicht mehr möglich",
            "example": "2026-09-23T17:19:36Z"
          },
          "source_task_id": {
            "type": "string",
            "description": "ID der Entwurfsaufgabe, aus der dieses finale Video konvertiert wurde. Wird nur für Seedance-2.5-Draft-to-Video-Aufgaben zurückgegeben",
            "example": "task-unified-1774857405-abc123"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Liste der Ergebnis-URLs. Nur vorhanden, wenn status \"completed\" ist und das Modell URL-Ergebnisse liefert; andernfalls fehlt das Feld.",
            "example": [
              "http://example.com/image.jpg"
            ]
          },
          "result_data": {
            "description": "Modellspezifisches vollständiges Ergebnisobjekt. Bei Bildmodellen ein Array von Objekten wie [{\"url\": ...}] (dieselben URLs wie in results); einige Modelle liefern umfangreichere Objekte (z. B. Song-Objekte bei Suno). Fehlt, wenn das Modell kein strukturiertes Ergebnis hat.",
            "example": [
              {
                "url": "http://example.com/image.jpg"
              }
            ]
          },
          "usage": {
            "type": "object",
            "description": "Nutzungs- und Abrechnungsinformationen. Nur vorhanden, wenn status \"completed\" ist. Enthält immer credits_used und cost; Token-Felder erscheinen nur bei tokenbasiert abgerechneten Modellen (z. B. gpt-image-2). Einige Modelle liefern weitere modellspezifische Felder.",
            "properties": {
              "credits_used": {
                "type": "number",
                "description": "Für diese Aufgabe tatsächlich abgerechnete Credits. Fehlt nur, wenn die Abrechnung noch nicht abgeschlossen werden konnte.",
                "example": 10
              },
              "cost": {
                "type": "object",
                "description": "Kosten dieser Aufgabe in drei Währungen, umgerechnet aus credits_used (aufgerundet).",
                "properties": {
                  "credits": {
                    "type": "number",
                    "description": "Abgerechnete Credits (identisch mit credits_used)",
                    "example": 10
                  },
                  "usd": {
                    "type": "number",
                    "description": "Gegenwert in USD",
                    "example": 0.148
                  },
                  "cny": {
                    "type": "number",
                    "description": "Gegenwert in CNY",
                    "example": 1
                  }
                }
              },
              "image_input_tokens": {
                "type": "integer",
                "description": "Bild-Eingabetokens (nur tokenbasiert abgerechnete Bildmodelle, z. B. gpt-image-2)",
                "example": 1032
              },
              "image_cached_input_tokens": {
                "type": "integer",
                "description": "Zwischengespeicherte Bild-Eingabetokens (nur tokenbasiert abgerechnete Bildmodelle)"
              },
              "image_output_tokens": {
                "type": "integer",
                "description": "Bild-Ausgabetokens (nur tokenbasiert abgerechnete Bildmodelle)",
                "example": 987
              },
              "text_input_tokens": {
                "type": "integer",
                "description": "Text-Eingabetokens (nur tokenbasiert abgerechnete Modelle)",
                "example": 13
              },
              "text_cached_input_tokens": {
                "type": "integer",
                "description": "Zwischengespeicherte Text-Eingabetokens (nur tokenbasiert abgerechnete Bildmodelle)"
              },
              "text_output_tokens": {
                "type": "integer",
                "description": "Text-Ausgabetokens (nur vorhanden, wenn größer als 0)"
              },
              "total_tokens": {
                "type": "integer",
                "description": "Gesamtzahl der Tokens (nur tokenbasiert abgerechnete Modelle)",
                "example": 2032
              }
            }
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Fehlerinformationen bei fehlgeschlagener Aufgabe (nur vorhanden, wenn status \"failed\" ist). Hinweis: error.code ist hier ein Geschäftsfehlercode vom Typ String und unterscheidet sich von HTTP-Statuscodes. Die vollständige Liste finden Sie in der Fehlercode-Referenz.",
            "properties": {
              "code": {
                "type": "string",
                "description": "Geschäftsfehlercode (String-Typ)",
                "example": "content_policy_violation"
              },
              "message": {
                "type": "string",
                "description": "Benutzerfreundliche Fehlerbeschreibung mit Fehlerbehebungstipps",
                "example": "Content policy violation.\nYour request was blocked by safety filters. Please adjust your prompt or input images and try again."
              },
              "details": {
                "type": "string",
                "description": "Zusätzliche Fehlerdetails, nur vorhanden, wenn verfügbar"
              },
              "suggestion": {
                "type": "string",
                "description": "Empfohlene Maßnahme, nur bei einigen Beta-/Alias-Modellen vorhanden"
              }
            }
          },
          "task_info": {
            "type": "object",
            "description": "Detaillierte Aufgabeninformationen",
            "properties": {
              "can_cancel": {
                "type": "boolean",
                "description": "Ob die Aufgabe abgebrochen werden kann",
                "example": false
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode (String-Typ)",
                "example": "task_not_found"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibungsnachricht. Von der Middleware erzeugte Fehler (401, 429) enden mit \" (request id: ...)\"",
                "example": "Task not found"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp",
                "example": "invalid_request_error"
              },
              "param": {
                "type": "string",
                "nullable": true,
                "description": "Zugehöriger Parametername; bei diesem Endpunkt null oder leer"
              },
              "retry_after": {
                "type": "integer",
                "description": "Wartezeit in Sekunden vor einem erneuten Versuch (nur 429)",
                "example": 30
              },
              "retryable": {
                "type": "boolean",
                "description": "Ob die Anfrage wiederholt werden kann (nur 429)",
                "example": true
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüsselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Aufgabenverwaltung",
      "description": "APIs zur Verwaltung asynchroner Aufgaben"
    }
  ]
}
