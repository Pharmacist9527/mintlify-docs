{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi API (alle Modelle) - Chat Completions: Schnellstart",
    "description": "Schnellstart-Beispiele für Kimi-Textmodelle über das Protokoll OpenAI-kompatible Chat Completions. Für ein Gespräch genügen `model` und `messages`; Tool-Aufrufe, Websuche, strukturierte Ausgaben, Bildeingaben und weitere Funktionen sind auf der Seite „Vollständige Referenz“ beschrieben.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Produktion (Empfohlen)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Schneller Kimi-Chat (alle Modelle)",
        "description": "- Kimi-Modelle über das OpenAI-Chat-Completions-Protokoll aufrufen und mit `model` auswählen\n- Nur `model` und `messages` sind erforderlich\n- Alle drei Modelle haben ein Kontextfenster von 1.048.576 Tokens; das Standard-Ausgabelimit beträgt 131.072 Tokens\n- Reasoning ist bei allen drei Modellen immer aktiv und wird in `reasoning_content` zurückgegeben; Reasoning-Tokens zählen zur Ausgabe\n- Tool-Aufrufe, Websuche, strukturierte Ausgaben, Bildeingaben und Cache-Einstellungen sind in der [vollständigen Referenz](/de/api-manual/language-series/kimi/chat-completions/chat-completions-reference) beschrieben",
        "operationId": "kimiChatCompletionsQuick",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionQuickRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Minimale Pro-Anfrage",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Erkläre Kontext-Caching in einem Satz."
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Highspeed mit geringem Reasoning-Aufwand",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Erkläre Kontext-Caching in einem Satz."
                      }
                    ],
                    "reasoning_effort": "low"
                  }
                },
                "k3": {
                  "summary": "Minimale Kimi-K3-Anfrage",
                  "value": {
                    "model": "kimi-k3",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Erkläre Kontext-Caching in einem Satz."
                      }
                    ]
                  }
                },
                "multi_turn": {
                  "summary": "System-Prompts und mehrstufige Gespräche",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "system",
                        "content": "Du bist ein sorgfältiger technischer Redakteur. Antworte knapp."
                      },
                      {
                        "role": "user",
                        "content": "Was ist Kontext-Caching?"
                      },
                      {
                        "role": "assistant",
                        "content": "Kontext-Caching speichert wiederkehrende Präfixe von Anfragen, damit spätere Cache-Treffer schneller und kostengünstiger verarbeitet werden können."
                      },
                      {
                        "role": "user",
                        "content": "Für welche Anwendungsfälle eignet es sich?"
                      }
                    ],
                    "reasoning_effort": "low"
                  }
                },
                "streaming": {
                  "summary": "SSE-Streaming-Ausgabe",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Schreibe ein vierzeiliges Gedicht über eine Sommernacht."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 2048,
                    "stream": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gespräch erfolgreich generiert; Streaming-Anfragen liefern einen SSE-Ereignisstrom",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE-Daten im OpenAI-Chat-Completions-Format, abgeschlossen mit `data: [DONE]`."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Aufzurufendes Modell:\n\n| Modell-ID | Einordnung |\n|---|---|\n| `kimi-k3.1-pro` | Neueste Modellgeneration (empfohlen) |\n| `kimi-k3.1-pro-highspeed` | Gleiche Parameter wie Pro, schnellere Generierung |\n| `kimi-k3` | Vorherige Modellgeneration |\n\nAlle drei Modelle haben ein Kontextfenster von 1.048.576 Tokens und immer aktives Reasoning."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Gesprächsnachrichten. Bei mehrstufigen Gesprächen historische Nachrichten in Reihenfolge angeben; Hinweise zum Zurücksenden von Reasoning- und Tool-Aufrufverlauf stehen in der vollständigen Referenz.",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            }
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max"
            ],
            "default": "max",
            "description": "Reasoning-Aufwand, Standard `max`. `kimi-k3` unterstützt nur `max`; weitere kompatible Werte stehen in der vollständigen Referenz."
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "Maximale generierte Tokens einschließlich Reasoning und endgültiger Antwort; Standard 131072, Maximum 1048576."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Ob die Antwort als SSE-Strom zurückgegeben wird."
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "description": "Nachrichtenrolle: `system` für System-Prompts, `user` für Benutzereingaben und `assistant` für frühere Antworten."
          },
          "content": {
            "type": "string",
            "description": "Nachrichteninhalt (Klartext).",
            "example": "Erkläre Kontext-Caching in einem Satz."
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Antwort-ID.",
            "example": "chatcmpl-6adc72a2823cc13b156bf863"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Erstellungszeit als Unix-Zeitstempel in Sekunden.",
            "example": 1792832163
          },
          "model": {
            "type": "string",
            "description": "Für diesen Aufruf verwendetes Modell.",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "enum": [
              "stop",
              "length",
              "tool_calls"
            ],
            "description": "Endgrund: `stop` bedeutet reguläres Ende, `length` das Erreichen des Ausgabelimits und `tool_calls` eine Tool-Anforderung des Modells.",
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Endgültige Antwort.",
            "example": "Kontext-Caching speichert wiederkehrende Präfixe von Anfragen, damit spätere Cache-Treffer schneller und kostengünstiger verarbeitet werden können."
          },
          "reasoning_content": {
            "type": "string",
            "description": "Reasoning-Inhalt. In mehrstufigen Gesprächen zusammen mit der vollständigen assistant-Nachricht zurücksenden.",
            "example": "Der Benutzer möchte in einem Satz erfahren, was Kontext-Caching speichert und welche Vorteile es bietet."
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Gesamte Eingabe-Tokens einschließlich Cache-Treffern.",
            "example": 24
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Ausgabe-Tokens einschließlich Reasoning-Tokens.",
            "example": 96
          },
          "total_tokens": {
            "type": "integer",
            "description": "Gesamtzahl der Eingabe- und Ausgabe-Token.",
            "example": 120
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Aus dem Cache gelieferte Eingabe-Token.",
                "example": 0
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Schlussfolgerungs-Token, bereits in completion_tokens enthalten.",
                "example": 62
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültige Anfrageparameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API-Schlüssel fehlt oder ist ungültig",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Ratenlimit überschritten oder Kontingent nicht ausreichend",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Interner Dienstfehler",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern eine Bearer-Token-Authentifizierung##\n\n**API-Schlüssel abrufen:**\n\nBesuchen Sie die [API-Schlüsselverwaltung](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel abzurufen\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Chat Completions",
      "description": "OpenAI-Chat-Completions-kompatible API"
    }
  ]
}
