{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi API (alle Modelle) - Chat Completions: Vollständige Referenz",
    "description": "Kimi-Textmodelle über das Protokoll OpenAI Chat Completions aufrufen. Mit `model` wählen Sie `kimi-k3.1-pro`, `kimi-k3.1-pro-highspeed` oder `kimi-k3`. Alle haben ein Kontextfenster von 1.048.576 Tokens und unterstützen mehrstufige Gespräche, Streaming, Tool-Aufrufe, Websuche, strukturierte Ausgaben sowie Bild- und Videoeingaben.\n\nReasoning ist bei allen drei Modellen immer aktiv und wird in `reasoning_content` zurückgegeben. Reasoning-Aufwand und Cache-Schreib-TTL unterscheiden sich je nach Modell; siehe Feld `model`. In mehrstufigen Gesprächen den vollständigen Reasoning- und Tool-Aufrufverlauf beibehalten.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Produktion (Empfohlen)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi Chat API (alle Modelle, OpenAI-kompatibel)",
        "description": "Kimi-Modelle im OpenAI-Chat-Completions-Format aufrufen, mit normalen JSON-Antworten oder SSE-Streaming. In mehrstufigen Gesprächen reasoning_content und tool_calls der assistant-Nachrichten vollständig beibehalten.\n\nDie Websuche wird über die Chat-Completions-API möglicherweise nicht ausgelöst. Wenn Sie eine Websuche benötigen, empfehlen wir die Responses- oder Messages-API. Wenn die Websuche tool_calls zurückgibt, function.arguments jedes Aufrufs als Inhalt einer tool-Nachricht mit derselben tool_call_id zurücksenden und anschließend die endgültige Antwort anfordern.",
        "operationId": "createChatCompletionKimi",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Minimale Pro-Anfrage",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Minimale Highspeed-Anfrage",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "k3": {
                  "summary": "Minimale Kimi-K3-Anfrage",
                  "value": {
                    "model": "kimi-k3",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "SSE-Streaming-Ausgabe",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true
                  }
                },
                "multimodal": {
                  "summary": "Bildeingabe",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAA..."
                            }
                          },
                          {
                            "type": "text",
                            "text": "Beschreibe dieses Bild."
                          }
                        ]
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Prüfe das heutige Wetter in Peking."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "Wetter für eine angegebene Stadt abrufen",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "Stadtname"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                },
                "web_search": {
                  "summary": "Websuche (einheitliche Syntax)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Striktes JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "cache_1h": {
                  "summary": "Automatisches Schreiben in den 1h-Cache (nur K3.1-Serie)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat-Completion-Antwort; Streaming-Anfragen liefern einen SSE-Ereignisstrom",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE-Daten im OpenAI-Chat-Completions-Format, abgeschlossen mit `data: [DONE]`."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Aufzurufendes Modell:\n\n| Modell-ID | Einordnung | Reasoning-Aufwand |\n|---|---|---|\n| `kimi-k3.1-pro` | Neueste Modellgeneration (empfohlen) | `low` / `high` / `max`, Standard `max` |\n| `kimi-k3.1-pro-highspeed` | Gleiche Parameter wie Pro, schnellere Generierung | Wie `kimi-k3.1-pro` |\n| `kimi-k3` | Vorherige Modellgeneration | Nur `max` |\n\nAlle drei Modelle haben ein Kontextfenster von 1.048.576 Tokens und immer aktives Reasoning.\n\nDie Cache-Schreib-TTL (`prompt_cache_options`) wird nur von der K3.1-Serie unterstützt; `kimi-k3` unterstützt diesen Parameter nicht."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Gesprächsnachrichten. Bei mehrstufigen Gesprächen müssen vollständige historische Assistant-Nachrichten aufgenommen werden.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "Maximale Anzahl generierter Token einschließlich Schlussfolgerungen und endgültiger Antwort. Standard: 131072; Maximum: 1048576, zusätzlich durch den verbleibenden Kontext begrenzt."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "Reasoning-Aufwand. Reasoning ist immer aktiv.\n\n- `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`: Empfohlen sind `low` / `high` / `max`, Standard `max`. Für allgemeine Clients wird `medium` wie `high`, `xhigh` wie `max` und `minimal` / `none` wie `low` behandelt; `none` deaktiviert Reasoning nicht.\n- `kimi-k3`: Nur `max` wird unterstützt (Standard).\n\nHöherer Aufwand erhöht meist Reasoning-Tokens und Latenz. Reasoning-Tokens zählen zur Ausgabe."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Ob die Antwort als SSE-Strom zurückgegeben wird."
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "Funktionswerkzeuge oder Websuche. Suche mit {\"type\":\"web_search\"} deklarieren; die Websuche wird möglicherweise nicht ausgelöst. Wenn Sie eine Websuche benötigen, empfehlen wir die Responses- oder Messages-API.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "Steuert, ob das Modell Werkzeuge aufruft oder eine bestimmte Funktion erzwingt."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Optionen für das Schreiben in den Kontext-Cache, nur von `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` unterstützt; `kimi-k3` unterstützt diesen Parameter nicht. Ohne Angabe wird standardmäßig automatisch ein 5m-Cache geschrieben. Lesen und Schreiben werden getrennt berechnet.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "Cache-TTL: 5m oder 1h; Standard: 5m."
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "Ausgabeformat: text für Klartext, json_object für ein JSON-Objekt oder json_schema für strukturierte Ausgabe gemäß JSON Schema.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "Ausgabeformat: text (Standard) für Klartext; json_object für ein gültiges JSON-Objekt; json_schema für Schema-konforme Ausgabe (empfohlen; json_schema angeben)."
              },
              "json_schema": {
                "type": "object",
                "description": "JSON Schema für die Ausgabe bei type=json_schema.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Schema-Name zur Identifikation."
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "Ob das angegebene JSON Schema strikt eingehalten wird; Standard: true."
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema zur Definition der Ausgabestruktur.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "Veralteter Alias für das Ausgabelimit. Für neue Anfragen max_completion_tokens verwenden; nicht beide setzen."
          },
          "temperature": {
            "type": "number",
            "default": 1,
            "description": "Sampling-Temperatur, vom Modell fest auf `1` gesetzt; das Feld muss nicht angegeben werden. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` ignorieren es automatisch; `kimi-k3` gibt bei nicht unterstützten Werten einen Fehler zurück."
          },
          "top_p": {
            "type": "number",
            "default": 0.95,
            "description": "Nucleus-Sampling-Schwelle, vom Modell fest auf `0.95` gesetzt; das Feld muss nicht angegeben werden. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` ignorieren es automatisch; `kimi-k3` gibt bei nicht unterstützten Werten einen Fehler zurück."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Nachrichtenrolle: system, user, assistant oder tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "Nachrichtentext. Bei Klartext einen String übergeben; bei multimodaler Eingabe ein Array von Inhaltsblöcken (Text + Bild + Video). Bei einem Werkzeugaufruf darf der Assistant-Inhalt null sein.",
            "oneOf": [
              {
                "type": "string",
                "description": "Nachrichtentext als Klartext."
              },
              {
                "type": "array",
                "description": "Array multimodaler Inhaltsblöcke.",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "Schlussfolgerungsinhalt des Assistant. Bei mehrstufigen Gesprächen als Teil der vollständigen Assistant-Nachricht unverändert zurücksenden."
          },
          "tool_calls": {
            "type": "array",
            "description": "Vom Assistant zurückgegebene Werkzeugaufrufe. In nachfolgenden Werkzeugrunden unverändert zurücksenden.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID des zugehörigen Werkzeugaufrufs bei `role=tool`."
          }
        }
      },
      "ContentPart": {
        "description": "Multimodaler Inhaltsblock. `type` bestimmt, welches Feld verwendet wird.",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string",
                "description": "Textinhalt, wenn `type=text`."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "image_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image_url"
                ]
              },
              "image_url": {
                "description": "Bild, wenn `type=image_url`; kann auch direkt als URL-String übergeben werden.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Bildinhalt als Base64-data-URL (data:image/png;base64,...)."
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "video_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "video_url"
                ]
              },
              "video_url": {
                "description": "Video, wenn `type=video_url`; kann auch direkt als URL-String übergeben werden.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Videoinhalt als Base64-data-URL (data:video/mp4;base64,...)."
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "Websuchwerkzeug."
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Werkzeugtyp. Derzeit fest auf function eingestellt.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Für das Modell verfügbare Funktionsdefinition.",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Funktionsname."
              },
              "description": {
                "type": "string",
                "description": "Beschreibung, anhand derer das Modell entscheidet, wann die Funktion aufgerufen wird."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "Definition der Funktionsparameter im JSON-Schema-Format."
              },
              "strict": {
                "type": "boolean",
                "description": "Ob Funktionsargumente strikt dem JSON Schema in parameters entsprechen müssen."
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Typ der benannten Werkzeugauswahl. Fest auf function eingestellt.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Funktion, die das Modell aufrufen muss.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name der Funktion, die das Modell aufrufen muss."
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Werkzeugaufruf-ID, über die eine nachfolgende tool-Nachricht mit tool_call_id verknüpft wird."
          },
          "type": {
            "type": "string",
            "description": "Typ des Tool-Aufrufs: `function` für clientseitige Funktionen; `builtin_function` für das integrierte Tool `$web_search`.",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Vom Modell angeforderte Funktion und Argumente.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Funktionsname."
              },
              "arguments": {
                "type": "string",
                "description": "Als JSON-Zeichenfolge codierte Funktionsargumente."
              }
            }
          }
        },
        "description": "Werkzeugaufrufe in weiteren Gesprächsrunden vollständig erhalten, einschließlich IDs, Typen, Funktionsnamen, Argumenten und Schlussfolgerungen."
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Gesamte Eingabe-Tokens, einschließlich regulärer Eingabe, Cache-Lesen und Cache-Schreiben. K3.1-Serie: reguläre Eingabe = prompt_tokens-cached_tokens-cache_write_tokens; `kimi-k3`: reguläre Eingabe = prompt_tokens-cached_tokens."
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Enthält Schlussfolgerungs-Token."
          },
          "total_tokens": {
            "type": "integer",
            "description": "Gesamtzahl der Eingabe- und Ausgabe-Token."
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Aus dem Cache gelieferte Eingabe-Token."
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "Gesamte Cache-Schreib-Tokens dieser Anfrage, einschließlich 5m-/1h-Schreibvorgängen. Die K3.1-Serie berechnet sie separat ohne erneute reguläre Eingabegebühr; `kimi-k3` unterscheidet sie nicht separat und berechnet sie als reguläre Eingabe."
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Schlussfolgerungs-Token, bereits in completion_tokens enthalten."
              }
            }
          }
        }
