  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Name des Chat-Modells",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "Liste der Konversationsnachrichten, unterstützt Mehrrundendialog\n\nNachrichten mit unterschiedlichen Rollen haben unterschiedliche Feldstrukturen; wählen Sie die entsprechende Rolle zur Ansicht aus",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Reasoning-Tiefe, Standardwert: `max`. Höhere Stufen erhöhen in der Regel den Verbrauch an Reasoning-Tokens und die Antwortzeit.",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "high"
          },
          "thinking": {
            "type": "object",
            "description": "Reasoning-Modus. MiniMax-M3.1-Flash verwendet immer Reasoning. Nur `adaptive` wird unterstützt; das Feld kann weggelassen werden",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive"
                ],
                "default": "adaptive"
              }
            }
          },
          "reasoning_split": {
            "type": "boolean",
            "description": "Legt fest, ob Reasoning-Inhalte separat zurückgegeben werden. Nur `true` wird unterstützt; die Inhalte werden über `reasoning_content` zurückgegeben. Das Feld kann weggelassen werden",
            "enum": [
              true
            ],
            "default": true
          },
          "temperature": {
            "type": "number",
            "description": "Sampling-Temperatur; steuert die Zufälligkeit der Ausgabe\n\n**Hinweise**:\n- Bereich: `[0, 2]`, Standardwert: 1\n- Niedrigere Werte erzeugen deterministischere, höhere Werte vielfältigere Ausgaben\n\n**Empfehlung**: Ändern Sie nicht gleichzeitig temperature und top_p",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Parameter für Nucleus Sampling\n\n**Hinweise**:\n- Bestimmt die kumulative Wahrscheinlichkeit der Tokens, aus denen ausgewählt wird\n- Beispielsweise bedeutet 0.95, dass aus Tokens mit einer kumulativen Wahrscheinlichkeit von 95% ausgewählt wird\n- Bereich: `[0, 1]`, Standardwert: 0.95\n\n**Empfehlung**: Ändern Sie nicht gleichzeitig temperature und top_p",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Maximale Länge der generierten Ausgabe in Tokens, **einschließlich Reasoning und Antwort**\n\n**Hinweise**:\n- Empfohlen: **131,072** (128K), Maximum: **524,288** (512K)\n- Bei einem zu niedrigen Wert kann das Limit bereits während des Reasonings erreicht werden. In diesem Fall wird `finish_reason=length` mit leerem `content` zurückgegeben",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Ob die Antwort im Streaming-Modus zurückgegeben wird\n\n- `true`: Streaming-Antwort, gibt Inhalte in Echtzeit-Chunks über SSE (Server-Sent Events) zurück\n- `false`: Wartet auf die vollständige Antwort, bevor sie zurückgegeben wird (Standard)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "Optionen für die Streaming-Antwort\n\nNur wirksam, wenn `stream=true`",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Legt fest, ob vor dem Ende des Streams ein zusätzlicher Datenblock zurückgegeben wird, der ausschließlich die `usage`-Statistik enthält"
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Liste der Werkzeugdefinitionen für Function Calling\n\nJedes Werkzeug benötigt einen Namen, eine Beschreibung und ein Parameterschema",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "Strategie zur Werkzeugauswahl. Nur `auto` wird unterstützt; das Modell entscheidet, ob ein Werkzeug aufgerufen wird",
            "enum": [
              "auto"
            ],
            "default": "auto"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Veralteter Parameter zur Begrenzung der Generierungslänge\n\n**Hinweis**: Veraltet, bitte verwenden Sie stattdessen `max_completion_tokens`",
            "deprecated": true,
            "minimum": 1
          },
          "n": {
            "type": "integer",
            "description": "Anzahl der generierten Antworten; nur `1` wird unterstützt",
            "enum": [
              1
            ],
            "default": 1
          }
        }
      },
      "SystemMessage": {
        "title": "System Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Rollenkennung, fest auf `system` gesetzt"
          },
          "content": {
            "type": "string",
            "description": "Inhalt des System-Prompts, dient zum Festlegen der Rolle und des Verhaltens der KI"
          },
          "name": {
            "type": "string",
            "description": "Name des Teilnehmers, dient zur Unterscheidung verschiedener Quellen von System-Prompts"
          }
        }
      },
      "UserMessage": {
        "title": "User Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Rollenkennung, fest auf `user` gesetzt"
          },
          "content": {
            "description": "Inhalt der Benutzernachricht\n\n**Hinweise**:\n- Für reinen Text übergeben Sie direkt eine Zeichenkette\n- Für multimodale Eingaben übergeben Sie ein Array von Inhaltsblöcken; unterstützt werden `text`, `image_url` (Bild) und `video_url` (Video)\n- Maximale Größe des Anfragekörpers: 64 MB",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Name des Teilnehmers, dient zur Unterscheidung verschiedener Benutzer"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Multimodaler Content-Part. Deklarieren Sie den Typ über `type` und füllen Sie nur die zu diesem Typ passenden Felder aus",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Inhaltstyp\n\n- `text`: Textblock\n- `image_url`: Bildeingabe\n- `video_url`: Videoeingabe"
          },
          "text": {
            "type": "string",
            "description": "Textinhalt, wenn `type=text`"
          },
          "image_url": {
            "type": "object",
            "description": "Bildeingabe (wenn `type=image_url`). Maximal 10 MB pro Bild, unterstützt JPEG / PNG / GIF / WEBP",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Bild-URL oder eine mit `data:` beginnende base64-data-URL"
              },
              "detail": {
                "type": "string",
                "description": "Steuert die Auflösung der Bildanalyse\n\n- `low`: Niedrige Präzision, verbraucht weniger Tokens\n- `default`: Standardpräzision\n- `high`: Hohe Präzision, erkennt mehr Details, verbraucht aber mehr Tokens",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximale Pixelgrenze für die längste Seite des Bildes",
                "minimum": 1
              }
            }
          },
          "video_url": {
            "type": "object",
            "description": "Videoeingabe (wenn `type=video_url`). Maximal 50 MB für URL- / Base64-Video, unterstützt MP4 / AVI / MOV / MKV",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Video-URL, eine base64-Daten-URL, die mit `data:` beginnt, oder eine Dateireferenz im Format `mm_file://{file_id}`"
              },
              "detail": {
                "type": "string",
                "description": "Steuert die Auflösung der Video-Frame-Extraktion",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "fps": {
                "type": "number",
                "description": "Abtastrate für Videoframes, Standardwert: 1, Bereich: [0.2, 5]. Eine höhere Abtastrate hilft, Änderungen im Bild zu erfassen, und erhöht in der Regel den Token-Verbrauch.",
                "minimum": 0.2,
                "maximum": 5,
                "default": 1
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximale Pixelgrenze für die längste Seite von Video-Frames",
                "minimum": 1
              }
            }
          }
        }
      },
      "AssistantRequestMessage": {
        "title": "Assistant Message",
        "type": "object",
        "required": [
          "role"
