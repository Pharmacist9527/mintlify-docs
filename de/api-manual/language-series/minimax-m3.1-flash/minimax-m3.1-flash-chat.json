                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name der aufgerufenen Funktion"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Funktionsargumente (JSON-Zeichenkette)"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ToolMessage": {
        "title": "Tool Message",
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id"
