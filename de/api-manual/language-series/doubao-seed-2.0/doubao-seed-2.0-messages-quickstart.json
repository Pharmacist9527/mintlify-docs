{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Messages — Schnellstart",
    "description": "Senden Sie in fünf Minuten Ihre erste Chatanfrage an Seed über Messages (Anthropic).",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Produktion (empfohlen)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Seed-Dialog mit Messages (Anthropic) starten",
        "description": "- Rufen Sie Seed im Anthropic-Messages-Format auf, auch mit kompatiblen Tools wie Claude Code.\n- Bei synchronen Anfragen wird die Antwort direkt zurückgegeben.\n- Für den Einstieg genügen die wichtigsten Parameter.\n- Unterstützte Modelle — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [API-Referenz](/de/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-messages-reference)",
        "operationId": "createMessageQuickSeed",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat-Generierung erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungueltige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert, Token ungueltig oder abgelaufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Kontingent, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Kein Zugriff erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit ueberschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Der Modelldienst ist vorübergehend gestört.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Dienst voruebergehend nicht verfuegbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modell auswählen\n\n| Modell-ID | Einsatzgebiet | Kontextfenster |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Empfohlenes Spitzenmodell für komplexe Schlussfolgerungen, lange Dokumente und Codebasen | 1.000.000 Token |\n| `doubao-seed-2-1-turbo` | Preisgünstig für Dialoge, Datenextraktion und Agentenaufgaben | 256.000 Token |\n| `doubao-seed-2-1-lite` | Günstigstes Seed-2.1-Modell. Audioeingaben sind nur über Chat Completions und Responses möglich | 1.000.000 Token |\n| `doubao-seed-evolving` | Wöchentliche Updates zum Erproben neuer Funktionen | 1.000.000 Token |\n| `doubao-seed-2.0-pro` | Spitzenmodell der Reihe Seed 2.0 | 256.000 Token |\n| `doubao-seed-2.0-lite` | Schnelles, leichtgewichtiges Seed-2.0-Modell | 256.000 Token |\n| `doubao-seed-2.0-mini` | Schnellstes Seed-2.0-Modell für einfache Aufgaben | 256.000 Token |\n| `doubao-seed-2.0-code` | Seed-2.0-Modell für Programmieraufgaben | 256.000 Token |\n\nSeed 2.1 verwendet in Modell-IDs einen Bindestrich (`2-1`), Seed 2.0 einen Punkt (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "example": 4096,
            "description": "Maximale Ausgabelänge einschließlich Denkprozess und Antwort. Planen Sie bei aktiviertem Denken mindestens 1024 Token ein. Ist das Budget erschöpft, lautet `stop_reason` dann `max_tokens` und die Antwort enthält möglicherweise nur Denkblöcke."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Nachrichtenliste",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            },
            "example": [
              {
                "role": "user",
                "content": "Hallo! Stell dich bitte in drei Sätzen vor."
              }
            ]
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Nachrichtenrolle"
          },
          "content": {
            "type": "string",
            "description": "Nachrichteninhalt (Klartext)"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Eindeutiger Bezeichner der Antwort",
            "example": "0217952345678901234567890abcdef"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "description": "Immer `message`."
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Immer `assistant`."
          },
          "model": {
            "type": "string",
            "description": "Für diese Anfrage verwendetes Modell.",
            "example": "doubao-seed-2-1-pro"
          },
          "content": {
            "type": "array",
            "description": "Generierte Inhaltsblöcke. Bei aktiviertem Denken steht meist ein `thinking`- vor dem `text`-Block. Lesen Sie für die Antwort alle Blöcke mit `type=\"text\"`.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/ThinkingBlock"
                }
              ]
            },
            "example": [
              {
                "type": "thinking",
                "thinking": "Gewünscht ist eine kurze Vorstellung …",
                "signature": "EqQBCkgIARABGAIi..."
              },
              {
                "type": "text",
                "text": "Hallo! Ich bin ein Sprachmodell der Seed-Reihe und helfe beim Schlussfolgern, Schreiben und Programmieren."
              }
            ]
          },
          "stop_reason": {
            "type": "string",
            "description": "Grund für das Ende der Ausgabe.\n\n- `end_turn`: reguläres Ende\n- `max_tokens`: Tokenlimit erreicht\n- `stop_sequence`: Stoppsequenz erkannt\n- `tool_use`: Funktionsaufruf angefordert",
            "enum": [
              "end_turn",
              "max_tokens",
              "stop_sequence",
              "tool_use"
            ],
            "example": "end_turn"
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ],
            "description": "Erkannte Stoppsequenz oder `null`, falls keine erkannt wurde."
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "TextBlock": {
        "type": "object",
        "title": "Text",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ],
            "description": "Immer `text`."
          },
          "text": {
            "type": "string",
            "description": "Textinhalt"
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "title": "Denkprozess",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "thinking"
            ],
            "description": "Immer `thinking`."
          },
          "thinking": {
            "type": "string",
            "description": "Denkprozess des Modells. Senden Sie ihn in Folgerunden unverändert mit der Signatur zurück."
          },
          "signature": {
            "type": "string",
            "description": "Signatur des Denkblocks. Behalten Sie in Folgerunden Signatur, Inhalt und Reihenfolge der Blöcke bei."
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "description": "Token-Verbrauchsstatistiken",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Nicht aus dem Cache gelesene Eingabetoken, ohne `cache_read_input_tokens`.",
            "example": 25
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "Zum Cache-Tarif berechnete Eingabetoken. Gesamteingabe = `input_tokens` + `cache_read_input_tokens`.",
            "example": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "Immer 0. Für Cache-Schreibvorgänge fällt hier keine gesonderte Gebühr an.",
            "example": 0
          },
          "output_tokens": {
            "type": "integer",
            "description": "Ausgabetoken einschließlich Denkprozess.",
            "example": 120
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP-Status-Fehlercode"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              },
              "param": {
                "type": "string",
                "description": "Zugehoeriger Parametername"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Vorschlag bei Fehler"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schluessel erhalten:**\n\nBesuchen Sie die [API-Schluesselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schluessel zu erhalten\n\n**Zum Anfrage-Header hinzufuegen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "Anthropic-Messages-kompatible API"
    }
  ]
}
