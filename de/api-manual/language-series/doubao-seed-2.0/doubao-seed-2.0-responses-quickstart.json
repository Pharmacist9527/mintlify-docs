{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Responses — Schnellstart",
    "description": "Senden Sie in fünf Minuten Ihre erste Chatanfrage an Seed über Responses.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Produktion (empfohlen)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Seed-Dialog mit Responses starten",
        "description": "- Rufen Sie Seed im Format der Responses API auf.\n- Speichern Sie den Kontext serverseitig und setzen Sie Dialoge mit `previous_response_id` fort, ohne den Verlauf erneut zu senden.\n- Für den Einstieg genügen die wichtigsten Parameter.\n- Unterstützte Modelle — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [API-Referenz](/de/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-responses-reference)",
        "operationId": "createResponseQuickSeed",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Antwortgenerierung erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "Ungueltige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert, Token ungueltig oder abgelaufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Kontingent, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Kein Zugriff erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource nicht gefunden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit ueberschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Der Modelldienst ist vorübergehend gestört.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Dienst voruebergehend nicht verfuegbar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modell auswählen\n\n| Modell-ID | Einsatzgebiet | Kontextfenster |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Empfohlenes Spitzenmodell für komplexe Schlussfolgerungen, lange Dokumente und Codebasen | 1.000.000 Token |\n| `doubao-seed-2-1-turbo` | Preisgünstig für Dialoge, Datenextraktion und Agentenaufgaben | 256.000 Token |\n| `doubao-seed-2-1-lite` | Günstigstes Seed-2.1-Modell, unterstützt Audioeingaben | 1.000.000 Token |\n| `doubao-seed-evolving` | Wöchentliche Updates zum Erproben neuer Funktionen | 1.000.000 Token |\n| `doubao-seed-2.0-pro` | Spitzenmodell der Reihe Seed 2.0 | 256.000 Token |\n| `doubao-seed-2.0-lite` | Schnelles, leichtgewichtiges Seed-2.0-Modell | 256.000 Token |\n| `doubao-seed-2.0-mini` | Schnellstes Seed-2.0-Modell für einfache Aufgaben | 256.000 Token |\n| `doubao-seed-2.0-code` | Seed-2.0-Modell für Programmieraufgaben | 256.000 Token |\n\nSeed 2.1 verwendet in Modell-IDs einen Bindestrich (`2-1`), Seed 2.0 einen Punkt (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "input": {
            "type": "string",
            "description": "Eingabeinhalt (reiner Text), entspricht einer Texteingabe mit der Rolle user",
            "example": "Hallo! Stell dich bitte in drei Sätzen vor."
          }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Eindeutige Kennung dieser Antwort",
            "example": "resp_02177148667427813c33c36521378d02b2c8389204fa8c3e2f63e"
          },
          "object": {
            "type": "string",
            "description": "Objekttyp, fester Wert response",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "number",
            "description": "Unix-Zeitstempel der Erstellung (Sekunden)",
            "example": 1771486674
          },
          "model": {
            "type": "string",
            "description": "Für diese Anfrage verwendetes Modell.",
            "example": "doubao-seed-2-1-pro"
          },
          "status": {
            "type": "string",
            "description": "Antwortstatus\n\n- `completed`: Generierung abgeschlossen\n- `in_progress`: Generierung laeuft\n- `incomplete`: Unvollstaendig\n- `failed`: Fehlgeschlagen",
            "enum": [
              "completed",
              "in_progress",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "Modellausgabe-Inhaltsliste",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Maximale Ausgabe-Token-Anzahl des Modells",
            "example": 32768
          },
          "caching": {
            "type": "object",
            "description": "Cache-Konfiguration der Anfrage. Bei `type=enabled` wurde ein expliziter Cache geschrieben, für den Speichergebühren anfallen.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          },
          "store": {
            "type": "boolean",
            "description": "Ob die Antwort gespeichert wurde",
            "example": true
          },
          "expire_at": {
            "type": "integer",
            "description": "Ablaufzeit der gespeicherten Antwort und des expliziten Caches als Unix-Zeitstempel in Sekunden.",
            "example": 1771745874
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Fehlerinformationen, bei Erfolg null"
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasoningOutput"
          },
          {
            "$ref": "#/components/schemas/MessageOutput"
          },
          {
            "$ref": "#/components/schemas/WebSearchCallOutput"
          }
        ]
      },
      "ReasoningOutput": {
        "title": "Chain-of-Thought-Ausgabe",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Ausgabeelement-ID",
            "example": "rs_0217****404a"
          },
          "type": {
            "type": "string",
            "description": "Ausgabetyp, hier reasoning",
            "enum": [
              "reasoning"
            ]
          },
          "summary": {
            "type": "array",
            "description": "Chain-of-Thought-Inhalt",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Chain-of-Thought-Inhaltstext"
                },
                "type": {
                  "type": "string",
                  "description": "Typ, fester Wert summary_text",
                  "enum": [
                    "summary_text"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Status",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "MessageOutput": {
        "title": "Nachrichtenausgabe",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Ausgabeelement-ID",
            "example": "msg_0217****a93c"
          },
          "type": {
            "type": "string",
            "description": "Ausgabetyp, hier message",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "description": "Rolle, fester Wert assistant",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "type": "array",
            "description": "Nachrichteninhaltsliste",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Textinhalt",
                  "example": "Hallo! Schoen Sie zu sehen! Wie kann ich Ihnen helfen?"
                },
                "type": {
                  "type": "string",
                  "description": "Inhaltstyp",
                  "enum": [
                    "output_text"
                  ]
                },
                "annotations": {
                  "type": "array",
                  "nullable": true,
                  "description": "Anmerkungsinformationen"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Status",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Token-Verbrauchsstatistiken",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Eingabetoken insgesamt, einschließlich Cache-Treffern.",
            "example": 88
          },
          "input_tokens_details": {
            "type": "object",
            "description": "Details zu Eingabe-Token",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Aus dem Cache gelesene Eingabetoken, berechnet zum Cache-Tarif.",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Ausgabetoken einschließlich Denkprozess.",
            "example": 230
          },
          "output_tokens_details": {
            "type": "object",
            "description": "Details zu Ausgabe-Token",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Anzahl der Reasoning/Chain-of-Thought-Token",
                "example": 211
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Gesamtanzahl der Token",
            "example": 318
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP-Status-Fehlercode"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              },
              "param": {
                "type": "string",
                "description": "Zugehoeriger Parametername"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Vorschlag bei Fehler"
              }
            }
          }
        }
      },
      "WebSearchCallOutput": {
        "title": "Websuchaufruf",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_call"
            ]
          },
          "id": {
            "type": "string",
            "example": "ws_1"
          },
          "status": {
            "type": "string",
            "example": "completed"
          },
          "action": {
            "type": "object",
            "description": "Ausgeführte Suchaktion und verwendete Suchbegriffe.",
            "properties": {
              "type": {
                "type": "string",
                "example": "search"
              },
              "query": {
                "type": "string"
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schluessel erhalten:**\n\nBesuchen Sie die [API-Schluesselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schluessel zu erhalten\n\n**Zum Anfrage-Header hinzufuegen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Responses API",
      "description": "Responses API Chat-Generierungsschnittstelle"
    }
  ]
}
