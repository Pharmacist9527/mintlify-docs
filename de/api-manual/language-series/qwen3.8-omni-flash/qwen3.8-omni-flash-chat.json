{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Chat Completions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Chat Completions",
        "description": "Nutzen Sie Qwen3.8 Omni Flash über EvoLink für Text- und Bildanalysen mit einstellbarem Denkaufwand. Vergleichen Sie vor der Integration die Anfragekosten und wählen Sie Chat Completions oder Responses.\n\nImplizites Caching kann bei wiederverwendbaren Präfixen ab 1024 Tokens greifen. Treffer haben einen eigenen Tarif; das Erstellen des Caches kostet nichts. Treffer sind nicht garantiert.\n\nVerwenden Sie Responses mit einem web_search-Werkzeug. Chat akzeptiert nur die Suchstrategie agent. Chat mit Denkmodus und Suche lieferte ohne Streaming HTTP 400; im getesteten Stream fehlten vollständige Verbrauchsdaten und eine Endmarkierung. Verlassen Sie sich dabei nicht auf vollständige Abrechnungsdaten. Die Suche teilt ein Kontolimit von 15 RPS; darüber kann eine Antwort ohne Suche erfolgen.",
        "operationId": "qwen38OmniFlashChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Grundlegendes Textgespräch",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "system",
                        "content": "You are a helpful assistant."
                      },
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                },
                "multimodal": {
                  "summary": "Multimodale Eingabe (Bild)",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Describe the content of this image"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://dashscope.oss-cn-beijing.aliyuncs.com/images/dog_and_girl.jpeg"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat erfolgreich generiert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_output_limit": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "invalid_reasoning_effort": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht autorisiert, ungültiges oder abgelaufenes Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_client_key": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "upstream_authentication": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Guthaben",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Zu viele Anfragen (Ratenbegrenzung)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern eine Bearer-Token-Authentifizierung##\n\n**API-Schlüssel abrufen**:\n\nBesuchen Sie die [API-Schlüsselverwaltung](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel abzurufen\n\n**Zum Anfrage-Header hinzufügen**:\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Name des Chat-Modells",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash"
          },
          "messages": {
            "type": "array",
            "description": "Liste der Gesprächsnachrichten, unterstützt mehrstufige Gespräche. Die Nachrichtenfeldstruktur unterscheidet sich je nach Rolle (system / user / assistant / tool); bitte wählen Sie die entsprechende Rolle aus.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ]
            },
            "minItems": 1
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Maximale Anzahl der Ausgabetokens einschließlich Denktokens.",
            "minimum": 1,
            "maximum": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Ob die Antwort als Stream zurückgegeben wird.\n\n- `true`: blockweise über SSE (Server-Sent Events) zurückgegeben\n- `false` (Standard): die vollständige Antwort wird auf einmal zurückgegeben",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "description": "Optionen für die Streaming-Antwort, nur bei `stream=true` wirksam.",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Bei `true` wird vor dem Ende des Streams zusätzlich ein Datenblock zurückgegeben, der nur `usage` enthält."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Liste der Werkzeugdefinitionen für Function Calling. Jedes Werkzeug muss Name, Beschreibung und Parameter-Schema definieren.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "xhigh",
            "description": "Chat reasoning_effort akzeptiert none, minimal, low, medium, high, xhigh und max; Standard ist xhigh. Nicht mit thinking_budget kombinieren. Responses verwendet reasoning.effort."
          },
          "preserve_thinking": {
            "type": "boolean",
            "default": true,
            "description": "Das Kontextfenster ist Kapazität, keine Zielgröße für Eingaben. Eingabelimits hängen vom Protokoll und Denkmodus ab. Chat verwendet standardmäßig xhigh; preserve_thinking ist standardmäßig aktiv, und zurückgesendete Denkverläufe zählen als Eingabe."
          }
        }
      },
      "SystemMessage": {
        "type": "object",
        "title": "System Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Nachrichtenrolle, fest auf `system`"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "UserMessage": {
        "type": "object",
        "title": "User Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Nachrichtenrolle, fest auf `user`"
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          }
        }
      },
      "AssistantRequestMessage": {
        "type": "object",
        "title": "Assistant Message",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Nachrichtenrolle, fest auf `assistant`"
          },
          "content": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "description": "Liste der vom Assistant in der vorherigen Runde initiierten Werkzeugaufrufe (zum Auffüllen des Function-Calling-Verlaufs).",
            "items": {
              "type": "object"
            }
          },
          "reasoning_content": {
            "type": "string",
            "description": "Das Kontextfenster ist Kapazität, keine Zielgröße für Eingaben. Eingabelimits hängen vom Protokoll und Denkmodus ab. Chat verwendet standardmäßig xhigh; preserve_thinking ist standardmäßig aktiv, und zurückgesendete Denkverläufe zählen als Eingabe."
          }
        }
      },
      "ToolMessage": {
        "type": "object",
        "title": "Tool Message",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Nachrichtenrolle, fest auf `tool` (Werkzeugausführungsergebnis)"
          },
          "content": {
            "description": "Inhalt des Werkzeugausführungsergebnisses. Kann ein String oder ein Array von Content-Parts sein.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "tool_call_id": {
            "type": "string",
            "description": "Zugehörige Werkzeugaufruf-ID"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url"
            ]
          },
          "text": {
            "type": "string",
            "description": "Textinhalt, wenn `type=text`"
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Bild-URL oder eine mit `data:` beginnende base64-data-URL"
              }
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Werkzeugdefinition für Function Calling.",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Werkzeugtyp, fest auf `function`"
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Funktionsname"
              },
              "description": {
                "type": "string",
                "description": "Beschreibung des Funktionszwecks"
              },
              "parameters": {
                "type": "object",
                "description": "JSON-Schema der Funktionsparameter"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Eindeutige Kennung dieses Gesprächs",
            "example": "chatcmpl-xxxxxxxx"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Erstellungszeit (Unix-Sekunden)",
            "example": 1735120033
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Grund für den Stopp\n\n- `stop`: normales Ende\n- `length`: Obergrenze von `max_completion_tokens` erreicht\n- `tool_calls`: Werkzeugaufruf erforderlich",
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "description": "Antwortnachricht des Assistant.",
        "properties": {
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "Antworttext"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Mit der Antwort zurückgegebener Denktext."
          },
          "tool_calls": {
            "type": "array",
            "description": "Liste der vom Modell initiierten Werkzeugaufrufe",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer"
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
