          },
          "object": {
            "type": "string",
            "const": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "Erstellungszeit in Unix-Sekunden."
          },
          "model": {
            "type": "string",
            "example": "glm-5.3-flash"
          },
          "status": {
            "type": "string",
