          "output_tokens": {
            "type": "integer",
            "description": "Gesamte Ausgabe-Tokens einschließlich Denk-Tokens."
          },
          "total_tokens": {
            "type": "integer",
            "description": "Summe aus Eingabe- und Ausgabe-Tokens."
          },
          "input_tokens_details": {
            "type": "object",
