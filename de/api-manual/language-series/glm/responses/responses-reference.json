            "required": [
              "type",
              "name",
              "parameters"
            ]
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "web_search"
              }
            },
            "required": [
              "type"
            ]
          }
        ]
