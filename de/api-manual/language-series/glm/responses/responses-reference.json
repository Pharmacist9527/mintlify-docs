            "type": "string",
            "description": "call_id des ursprünglichen function_call."
          },
          "output": {
            "type": "string",
            "description": "Funktionsergebnis, üblicherweise als JSON-kodierter String."
          }
        },
        "required": [
          "type",
          "call_id",
          "output"
        ]
      },
      "Tool": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "function"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "object",
