{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed – OpenAI-kompatible API",
    "description": "Unterstützt kimi-k3.1-pro und kimi-k3.1-pro-highspeed mit einem Kontextfenster von 1.048.576 Token. Beide Modelle führen immer Schlussfolgerungen durch; native Stufen: low / high / max, Standard: max.\n\nUnterstützt Gesprächsverlauf, SSE, Funktionswerkzeuge, Websuche, striktes JSON Schema und Kontext-Caching für 5m / 1h. Feste Sampling-Einstellungen: temperature=1, top_p=0.95, n=1, presence_penalty=frequency_penalty=0. Diese Parameter müssen nicht übergeben werden.\n\n[Modelle, Preise und Nutzung](/de/api-manual/language-series/kimi-k3.1-pro/kimi-k3.1-pro-overview).",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Produktion (empfohlen)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed Chat-API (OpenAI-kompatibel)",
        "description": "Beide exakten Modell-IDs verwenden denselben Endpunkt. Native Denkstufen: low / high / max. reasoning_content und tool_calls vollständig im Verlauf erhalten. Suchergebnisse kommen über tool_calls; zurückgeben und erneut anfragen, um die endgültige Antwort zu erhalten.",
        "operationId": "createChatCompletionKimiK31Pro",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Minimale Pro-Anfrage",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Minimale Highspeed-Anfrage",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "SSE-Streaming mit usage",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                },
                "cache_1h": {
                  "summary": "Automatisches Schreiben in den 1h-Cache",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Websuche (einheitliche Syntax)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "web_search_native": {
                  "summary": "Websuche (native Moonshot-Syntax)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "builtin_function",
                        "function": {
                          "name": "$web_search"
                        }
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Striktes JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Prüfe das heutige Wetter in Peking."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "Wetter für eine bestimmte Stadt abfragen",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "Name der Stadt"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat-Completion-Antwort; Streaming-Anfragen liefern einen SSE-Ereignisstrom",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE-Daten im OpenAI-Chat-Completions-Format, abgeschlossen mit `data: [DONE]`."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Pro und Highspeed verwenden dieselben Endpunkte und Parameter. Highspeed hat andere Preise für Eingabe, Ausgabe und Cache-Schreiben; Cache-Lesen kostet gleich viel."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Gesprächsnachrichten. Bei mehrstufigen Gesprächen müssen vollständige historische Assistant-Nachrichten aufgenommen werden.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "Maximale Anzahl generierter Token einschließlich Schlussfolgerungen und endgültiger Antwort. Standard: 131072; Maximum: 1048576, zusätzlich durch den verbleibenden Kontext begrenzt."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "Denkaufwand: low / high / max empfohlen, Standard: max. Schlussfolgerungen sind immer aktiv. Client-Aliase: medium wird high, xhigh wird max, minimal / none wird low. none deaktiviert das Denken nicht. Höhere Stufen erhöhen meist Denk-Token und Latenz. Denk-Token zählen zur Ausgabe."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Ob die Antwort als SSE-Strom zurückgegeben wird."
          },
          "stream_options": {
            "$ref": "#/components/schemas/StreamOptions",
            "description": "Optionen für Streaming-Antworten. Sie gelten nur bei `stream=true` und ändern weder Tokenpreise noch die Anzahl generierter Token."
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "Funktionswerkzeuge oder Websuche. Suche mit {\"type\":\"web_search\"} oder nativem Moonshot builtin_function / $web_search. Abrechnung pro tatsächlicher Suche; normale Funktionen verursachen keine Suchgebühr.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                },
                {
                  "$ref": "#/components/schemas/BuiltinWebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "Steuert, ob das Modell Werkzeuge aufruft oder eine bestimmte Funktion erzwingt."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Optionen für das Kontext-Cache-Schreiben. Ohne Angabe wird automatisch der 5m-Cache verwendet. Schreiben und Lesen werden getrennt abgerechnet.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "TTL für Cache-Schreiben. Für 1h und 5m gelten die jeweiligen Schreibpreise. Maßgeblich für Treffer und TTL-Zuordnung ist die Abrechnung."
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "Steuert das Ausgabeformat. Standard {\"type\":\"text\"}: Klartext. {\"type\":\"json_object\"} aktiviert JSON-Modus mit gültigem JSON-Objekt; JSON und Format im Prompt anfordern. {\"type\":\"json_schema\"} aktiviert Structured Output gemäß JSON Schema (empfohlen; json_schema ebenfalls angeben). Validierungsprobleme können bei walle GitHub Issues (https://github.com/MoonshotAI/walle/issues) gemeldet werden.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "Ausgabeformat: text (Standard) für Klartext; json_object für ein gültiges JSON-Objekt; json_schema für Schema-konforme Ausgabe (empfohlen; json_schema angeben)."
              },
              "json_schema": {
                "type": "object",
                "description": "JSON Schema für die Ausgabe bei type=json_schema.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Schema-Name zur Identifikation."
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "Schema strikt erzwingen. Standard: true. Bei true muss das Schema MFJS entsprechen, sonst folgen Fehler oder Warnungen. Bei false wird nur gültiges JSON garantiert, ohne strikte interne Struktur."
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema der Ausgabestruktur. Muss MFJS (Moonshot Flavored JSON Schema) entsprechen. Prüfung mit walle CLI: go install github.com/moonshotai/walle/cmd/walle@latest && walle -schema '<schema>' -level strict",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "prompt_cache_key": {
            "type": "string",
            "default": null,
            "description": "Schlüssel für ähnliche Anfragen zur Verbesserung der Cache-Trefferquote. Bei Coding Agents die Sitzungs- oder Aufgaben-ID nutzen und beim Fortsetzen beibehalten. Für Kimi Code Plan zur Verbesserung der Trefferquote erforderlich; auch für andere mehrstufige Agents empfohlen."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "Veralteter Alias für das Ausgabelimit. Für neue Anfragen max_completion_tokens verwenden; nicht beide setzen."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Nachrichtenrolle: system, user, assistant oder tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "Nachrichtentext. Bei Klartext einen String übergeben; bei multimodaler Eingabe ein Array von Inhaltsblöcken (Text + Bild + Video). Bei einem Werkzeugaufruf darf der Assistant-Inhalt null sein.",
            "oneOf": [
              {
                "type": "string",
                "description": "Nachrichtentext als Klartext."
              },
              {
                "type": "array",
                "description": "Array multimodaler Inhaltsblöcke.",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "Schlussfolgerungsinhalt des Assistant. Bei mehrstufigen Gesprächen als Teil der vollständigen Assistant-Nachricht unverändert zurücksenden."
          },
          "tool_calls": {
            "type": "array",
            "description": "Vom Assistant zurückgegebene Werkzeugaufrufe. In nachfolgenden Werkzeugrunden unverändert zurücksenden.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID des zugehörigen Werkzeugaufrufs bei `role=tool`."
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "Multimodaler Inhaltsblock. `type` bestimmt, welches Feld verwendet wird.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Inhaltsblocktyp."
          },
          "text": {
            "type": "string",
            "description": "Textinhalt, wenn `type=text`."
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "Bild, wenn `type=image_url`; kann auch direkt als URL-String übergeben werden.",
            "properties": {
              "url": {
                "type": "string",
                "description": "Bildadresse. Unterstützt Base64-Data-URL (`data:image/png;base64,...`) oder Kimi-Plattform-Dateireferenz (`ms://<file_id>`)."
              }
            }
          },
          "video_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "Video, wenn `type=video_url`; kann auch direkt als URL-String übergeben werden.",
            "properties": {
              "url": {
                "type": "string",
                "description": "Videoadresse. Unterstützt Base64-Data-URL (`data:video/mp4;base64,...`) oder Kimi-Plattform-Dateireferenz (`ms://<file_id>`)."
              }
            }
          }
        }
      },
      "StreamOptions": {
        "type": "object",
        "properties": {
          "include_usage": {
            "type": "boolean",
            "default": false,
            "description": "Wenn true, wird vor `[DONE]` ein abschließender Nutzungsblock an den Aufrufer gesendet. Diese Option steuert nur die Sichtbarkeit dieses Blocks und fügt keine abrechenbaren Token hinzu oder ändert Preise."
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "Websuche-Werkzeug. Wird vom Gateway in Moonshot `$web_search` umgewandelt; Abrechnung pro Aufruf"
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Werkzeugtyp. Derzeit fest auf function eingestellt.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Für das Modell verfügbare Funktionsdefinition.",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Funktionsname."
              },
              "description": {
                "type": "string",
                "description": "Beschreibung, anhand derer das Modell entscheidet, wann die Funktion aufgerufen wird."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "Definition der Funktionsparameter im JSON-Schema-Format."
              },
              "strict": {
                "type": "boolean",
                "description": "Ob Funktionsargumente strikt dem JSON Schema in parameters entsprechen müssen."
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Typ der benannten Werkzeugauswahl. Fest auf function eingestellt.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Funktion, die das Modell aufrufen muss.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name der Funktion, die das Modell aufrufen muss."
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Werkzeugaufruf-ID, über die eine nachfolgende tool-Nachricht mit tool_call_id verknüpft wird."
          },
          "type": {
            "type": "string",
            "description": "Typ des Tool-Aufrufs: `function` für clientseitige Funktionen; `builtin_function` für das integrierte Tool `$web_search`.",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Vom Modell angeforderte Funktion und Argumente.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Funktionsname."
              },
              "arguments": {
                "type": "string",
                "description": "Als JSON-Zeichenfolge codierte Funktionsargumente."
              }
            }
          }
        },
        "description": "Vollständigen Werkzeugverlauf erhalten. Integrierte Suchantworten können type=builtin_function nutzen; der Server akzeptiert diesen Typ beim Zurückgeben. IDs, arguments und Denkverlauf vollständig beibehalten."
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Gesamte Eingabe-Token einschließlich normaler Eingabe, Cache-Lesen und Cache-Schreiben. Normale Eingabe = prompt_tokens - cached_tokens - cache_write_tokens."
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Enthält Schlussfolgerungs-Token."
          },
          "total_tokens": {
            "type": "integer",
            "description": "Gesamtzahl der Eingabe- und Ausgabe-Token."
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Aus dem Cache gelieferte Eingabe-Token."
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "Gesamte in den Cache geschriebene Token einschließlich 5m / 1h. Nicht erneut als normale Eingabe abrechnen."
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Schlussfolgerungs-Token, bereits in completion_tokens enthalten."
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "BuiltinWebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "$web_search"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültige Anfrageparameter",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API-Schlüssel fehlt oder ist ungültig",
        "content": {
          "application/json": {
            "schema": {
