{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniHuman 2.0 Digitaler Mensch Videogenerierungs-API",
    "description": "Audiogesteuerte Aufgaben zur Generierung digitaler menschlicher Videos mit dem OmniHuman 2.0 Modell erstellen",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produktionsumgebung"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "OmniHuman 2.0 Digitale Menschliche Videogenerierung",
        "description": "- OmniHuman 2.0 (omnihuman-2.0) Modell generiert aus einem Personenbild und einer Audiodatei ein digitales menschliches Video, dessen Lippen- und Körperbewegungen dem Audio folgen\n- Asynchroner Verarbeitungsmodus, verwenden Sie die zurückgegebene Aufgaben-ID zum [Abfragen](/de/api-manual/task-management/get-task-detail)\n- Generierte Videolinks sind 24 Stunden gültig, bitte speichern Sie diese umgehend\n\n**Hinweis:**\n- Audiodauer-Limit: 4–300 Sekunden\n- Unterstützte Audioformate: MP3, WAV\n- Die Abrechnung basiert auf der Audiodauer (aufgerundet auf `0.1` Sekunden)",
        "operationId": "createOmniHuman20VideoGeneration",
        "tags": [
          "Digitale Mensch-Videogenerierung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic_generation": {
                  "summary": "Einfache digitale menschliche Generierung",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ]
                  }
                },
                "with_prompt": {
                  "summary": "Mit Prompt",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ],
                    "prompt": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aufgabe zur Generierung digitaler menschlicher Videos erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "Nicht unterstützter Parameter",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "mask_url is not supported by omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_many_images": {
                    "summary": "Mehr als 1 Bild",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "omnihuman-2.0 accepts exactly 1 image, got 2",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_audio_url": {
                    "summary": "Audio-URL fehlt",
                    "value": {
                      "error": {
                        "code": "missing_audio_url",
                        "message": "audio_url is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_image_urls": {
                    "summary": "Bild-URL fehlt",
                    "value": {
                      "error": {
                        "code": "missing_image_urls",
                        "message": "image_urls is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio": {
                    "summary": "Audio kann nicht heruntergeladen oder gelesen werden",
                    "value": {
                      "error": {
                        "code": "invalid_audio",
                        "message": "failed to read audio_url: download audio failed: HTTP 404",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio_duration": {
                    "summary": "Audiodauer außerhalb des zulässigen Bereichs",
                    "value": {
                      "error": {
                        "code": "invalid_audio_duration",
                        "message": "audio duration 2.50s is out of range [4, 300] for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_media_url": {
                    "summary": "Medien-URL verweist auf eine lokale oder private Netzwerkadresse",
                    "value": {
                      "error": {
                        "code": "invalid_media_url",
                        "message": "invalid parameter \"audio_url\": points to a local or private network address; provide a publicly accessible URL",
                        "type": "invalid_request_error",
                        "param": "audio_url"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht autorisiert, ungültiges oder abgelaufenes Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Kontingent, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Zugriff verweigert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: omnihuman-2.0",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Ratenlimit überschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "audio_url",
          "image_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modellname für die Generierung digitaler menschlicher Videos\n\n**Hinweis:**\n- Dieses Modell unterstützt die OmniHuman-1.5-Parameter `mask_url`, `subject_check`, `auto_mask`, `pe_fast_mode`, `audio_urls` nicht; werden sie aktiviert oder mit nicht leeren Werten übergeben, wird ein 400-Parameterfehler zurückgegeben\n- Alle Parameter gehören auf die oberste Ebene des Request-Bodys; ein nicht leeres `model_params` führt zu einem 400-Parameterfehler",
            "enum": [
              "omnihuman-2.0"
            ],
            "default": "omnihuman-2.0",
            "example": "omnihuman-2.0"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "description": "Audio-URL zur Steuerung von Lippensynchronisation und Körperbewegungen\n\n**Hinweis:**\n- Audiodauer: `4`–`300` Sekunden (einschließlich); außerhalb dieses Bereichs wird ein 400-Parameterfehler zurückgegeben\n- Unterstützte Formate: `.mp3`, `.wav`\n- Dateigröße: weniger als `15MB`\n- Audio-URLs müssen direkt vom Server zugänglich sein; kann das Audio nicht heruntergeladen werden, hat es ein nicht unterstütztes Format oder überschreitet es die Größengrenze, wird ein 400-Parameterfehler zurückgegeben\n- Die Abrechnung basiert auf der Audiodauer (aufgerundet auf `0.1` Sekunden)",
            "example": "https://your-cdn.com/omnihuman/speech.mp3"
          },
          "image_urls": {
            "type": "array",
            "description": "Referenzbild-URL-Liste mit der zu animierenden Person\n\n**Hinweis:**\n- Anzahl der Bilder pro Anfrage: `1`; mehr als `1` Bild führt zu einem 400-Parameterfehler\n- Unterstützte Dateiformate: `.jpg`, `.jpeg`, `.png`, `.webp`, `.bmp`, `.tiff`, `.gif`, `.heic`, `.heif`\n- Bildgröße: weniger als `30MB`\n- Seitenverhältnis (Breite/Höhe): `0.4`–`2.5`\n- Breite und Höhe: `300`–`6000` px\n- Bild-URLs müssen direkt vom Server zugänglich sein",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://your-cdn.com/omnihuman/portrait.jpg"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Optionaler Text-Prompt zur Steuerung von Szene, Bewegungen und Kameraführung, unterstützt nur Chinesisch, Englisch, Japanisch, Koreanisch, Spanisch (Mexiko) und Indonesisch",
            "example": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS-Callback-Adresse nach Aufgabenabschluss\n\n**Callback-Zeitpunkt:**\n- Wird ausgelöst, wenn die Aufgabe abgeschlossen, fehlgeschlagen oder abgebrochen wurde\n- Wird nach Abschluss der Abrechnungsbestätigung gesendet\n\n**Sicherheitsbeschränkungen:**\n- Nur HTTPS-Protokoll wird unterstützt\n- Callback an interne IP-Adressen ist verboten (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, usw.)\n- URL-Länge darf `2048` Zeichen nicht überschreiten\n\n**Callback-Mechanismus:**\n- Timeout: `10` Sekunden\n- Maximal `3` Wiederholungsversuche bei Fehler (Wiederholung nach `1` Sekunde/`2` Sekunden/`4` Sekunden)\n- Das Format des Callback-Antwortkörpers entspricht dem Antwortformat der Aufgabenabfrage-API\n- Ein 2xx-Statuscode der Callback-Adresse gilt als erfolgreich, andere Statuscodes lösen eine Wiederholung aus",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Tatsächlich verwendeter Modellname",
            "example": "omnihuman-2.0"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Spezifischer Aufgabentyp"
          },
          "progress": {
            "type": "integer",
            "description": "Aufgabenfortschritt in Prozent (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Detaillierte Informationen zur Videoaufgabe"
          },
          "type": {
            "type": "string",
            "enum": [
              "video"
            ],
            "description": "Aufgaben-Ausgabetyp",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Nutzungs- und Abrechnungsinformationen"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Gibt an, ob die Aufgabe abgebrochen werden kann. OmniHuman 2.0 unterstützt keinen Abbruch; immer `false`.",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Geschätzte Abschlusszeit (Sekunden)",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "Geschätzte Videolänge (Sekunden)",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Nutzungs- und Abrechnungsinformationen",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Abrechnungsregel (per_second für OmniHuman)",
            "enum": [
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Geschätzte verbrauchte Credits (basierend auf der Audiodauer)",
            "minimum": 0,
            "example": 59.024
          },
          "user_group": {
            "type": "string",
            "description": "Benutzergruppenkategorie",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode-Bezeichner"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              },
              "param": {
                "type": "string",
                "description": "Zugehöriger Parametername"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüsselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Digitale Mensch-Videogenerierung",
      "description": "OmniHuman 2.0 APIs zur Generierung digitaler menschlicher Videos"
    }
  ]
}
