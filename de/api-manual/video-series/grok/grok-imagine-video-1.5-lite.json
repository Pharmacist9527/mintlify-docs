{
  "openapi": "3.1.0",
  "info": {
    "title": "grok-imagine-video-1.5-lite Schnittstelle",
    "description": "Verwenden Sie Grok Imagine 1.5 Lite für günstigere Text-zu-Video- und Bild-zu-Video-Generierung",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produktionsumgebung"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "grok-imagine-video-1.5-lite Schnittstelle",
        "description": "- Grok Imagine 1.5 Lite (grok-imagine-video-1.5-lite) ist die günstigere Stufe von Grok Imagine 1.5: Text-zu-Video und Bild-zu-Video unter einem Modellnamen\n- Es gibt keinen Modus-Parameter: Die Anzahl der Einträge in `image_urls` wählt den Modus — `0` = Text-zu-Video, `1` = Bild-zu-Video (als erstes Frame verwendet). Referenzbilder (2 oder mehr) werden nicht unterstützt\n- `1080p`-Ausgabe wird aus 720p hochskaliert und mit einem höheren Sekundensatz berechnet\n- Asynchroner Verarbeitungsmodus, verwenden Sie die zurückgegebene Aufgaben-ID zum [Abfragen](/de/api-manual/task-management/get-task-detail)\n- Generierte Videolinks sind 24 Stunden gültig, bitte speichern Sie sie umgehend",
        "operationId": "createGrokImagineVideo15LiteGeneration",
        "tags": [
          "Videogenerierung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrokImagineVideo15LiteRequest"
              },
              "examples": {
                "text_to_video": {
                  "summary": "Text zu Video (ohne Bild)",
                  "value": {
                    "model": "grok-imagine-video-1.5-lite",
                    "prompt": "Eine neonbeleuchtete Straße bei Nacht, langsame Kamerafahrt nach vorn durch den Regen",
                    "duration": 6,
                    "quality": "480p",
                    "aspect_ratio": "16:9"
                  }
                },
                "image_to_video": {
                  "summary": "Bild zu Video (1 Bild)",
                  "value": {
                    "model": "grok-imagine-video-1.5-lite",
                    "prompt": "Die Person beginnt zu tanzen",
                    "image_urls": [
                      "https://cdn.evolink.ai/Model-Example/GrokImagine1.5/generated-image.png"
                    ],
                    "duration": 6,
                    "quality": "480p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Videoaufgabe erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht autorisiert, ungültiges oder abgelaufenes Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Kontingent, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Zugriff verweigert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: grok-imagine-video-1.5-lite",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Ratenlimit überschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GrokImagineVideo15LiteRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modellname",
            "enum": [
              "grok-imagine-video-1.5-lite"
            ],
            "default": "grok-imagine-video-1.5-lite",
            "example": "grok-imagine-video-1.5-lite"
          },
          "prompt": {
            "type": "string",
            "description": "Video-Beschreibungs-Prompt (erforderlich, darf nicht leer sein)\n\n**Längenbeschränkung:** max. `4096` Zeichen",
            "example": "The person starts dancing"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Eingabebild-URL (optional). Ein Bild schaltet die Anfrage auf Bild-zu-Video um.\n\n**Moduswahl:**\n- `0` Bilder (Feld weglassen): Text-zu-Video, keine Bildgebühr\n- `1` Bild: Bild-zu-Video, als erstes Frame verwendet\n- `2` oder mehr Bilder werden abgelehnt — Referenz-zu-Video wird auf Lite nicht unterstützt\n\n**Anforderungen:**\n- Bildgröße: max. `10MB`\n- Unterstützte Formate: JPEG, PNG, WebP",
            "minItems": 0,
            "maxItems": 1,
            "example": [
              "https://example.com/image.jpg"
            ]
          },
          "duration": {
            "type": "integer",
            "description": "Videodauer (Sekunden), beliebige ganze Zahl zwischen `1` und `15` Sekunden",
            "minimum": 1,
            "maximum": 15,
            "default": 6,
            "example": 6
          },
          "quality": {
            "type": "string",
            "description": "Videoauflösung, Standard ist `480p`\n\n**Beschreibung:**\n- `480p`: Standardauflösung, dies ist der Standardwert\n- `720p`: Hohe Auflösung\n- `1080p`: Aus 720p hochskaliert, mit einem höheren Sekundensatz berechnet\n\nDie Sätze je Auflösung finden Sie im [Preisbereich](https://evolink.ai/de/grok-imagine-video-1-5?model=grok-imagine-video-1.5-lite#pricing).",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "default": "480p",
            "example": "480p"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Seitenverhältnis der Ausgabe, Standard ist `auto`\n\n**Gilt für:** Text-zu-Video (`0` Bilder). Mit einem Eingabebild folgt die Ausgabe den Abmessungen dieses Bildes und dieser Parameter wird ignoriert.\n\n**Beschreibung:**\n- `auto`: Das Modell bestimmt den Bildausschnitt, der zwischen Durchläufen variieren kann; dies ist der Standardwert\n- `16:9`: Querformat\n- `9:16`: Hochformat\n- `1:1`: Quadratisch\n- `4:3`: Querformat, klassisches TV-Verhältnis\n- `3:4`: Hochformat, klassisches TV-Verhältnis\n- `3:2`: Querformat, klassisches Fotoverhältnis\n- `2:3`: Hochformat, klassisches Fotoverhältnis",
            "enum": [
              "auto",
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "3:2",
              "2:3"
            ],
            "default": "auto",
            "example": "16:9"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS-Callback-URL nach Aufgabenabschluss\n\n**Callback-Zeitpunkt:**\n- Wird ausgelöst, wenn die Aufgabe abgeschlossen, fehlgeschlagen oder abgebrochen wurde\n- Wird nach Abrechnungsbestätigung gesendet\n\n**Sicherheitsbeschränkungen:**\n- Nur HTTPS-Protokoll unterstützt\n- Callback an interne IPs verboten (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- URL-Länge darf `2048` Zeichen nicht überschreiten\n\n**Callback-Mechanismus:**\n- Timeout: `10` Sekunden\n- Maximal `3` Wiederholungsversuche bei Fehler (nach `1`/`2`/`4` Sekunden)\n- Antwortformat entspricht der Aufgabenabfrage-API\n- 2xx-Statuscode = Erfolg, andere lösen Wiederholung aus",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Tatsächlich verwendeter Modellname",
            "example": "grok-imagine-video-1.5-lite"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Spezifischer Aufgabentyp"
          },
          "progress": {
            "type": "integer",
            "description": "Aufgabenfortschritt in Prozent (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Detaillierte Informationen zur Videoaufgabe"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Aufgaben-Ausgabetyp",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Nutzungs- und Abrechnungsinformationen"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Ob die Aufgabe abgebrochen werden kann",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "Geschätzte Abschlusszeit (Sekunden)",
            "minimum": 0,
            "example": 120
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Nutzungs- und Abrechnungsinformationen",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Abrechnungsregel",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Geschätzter Guthabenverbrauch",
            "minimum": 0,
            "example": 26.66
          },
          "user_group": {
            "type": "string",
            "description": "Benutzergruppenkategorie",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode-Bezeichner"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüsselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
