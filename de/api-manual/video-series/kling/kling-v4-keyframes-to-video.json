{
  "openapi": "3.1.0",
  "info": {
    "title": "kling-v4-keyframes-to-video API",
    "description": "Aufgaben zur Videogenerierung aus Schlüsselbildern mit KI-Modellen erstellen",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produktion"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "kling-v4-keyframes-to-video API",
        "description": "- Kling-4.0 Keyframes to Video (kling-v4-keyframes-to-video) generiert Videos aus Schlüsselbildern\n- Übergeben Sie `2` bis `10` Schlüsselbilder in zeitlicher Reihenfolge, um ein Video zu erzeugen, das diese Bilder nacheinander durchläuft\n- Asynchroner Verarbeitungsmodus, verwenden Sie die zurückgegebene Aufgaben-ID zum [Status abfragen](/de/api-manual/task-management/get-task-detail)\n- Generierte Videolinks sind 24 Stunden gültig, bitte speichern Sie diese umgehend",
        "operationId": "createVideoGeneration",
        "tags": [
          "Videogenerierung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Gleichmäßig verteilte Schlüsselbilder",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "Die Kamera bewegt sich von einer Straße am frühen Morgen zu einem Platz in der Abenddämmerung, während das Licht allmählich wärmer wird",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/morning.jpg"
                      },
                      {
                        "image_url": "https://example.com/noon.jpg"
                      },
                      {
                        "image_url": "https://example.com/evening.jpg"
                      }
                    ],
                    "duration": 6,
                    "aspect_ratio": "16:9",
                    "quality": "720p"
                  }
                },
                "with_time": {
                  "summary": "Zeitpunkte der Schlüsselbilder festlegen",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "Eine Blume entwickelt sich von der Knospe zur vollen Blüte und verwelkt anschließend",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/bud.jpg",
                        "time": 0
                      },
                      {
                        "image_url": "https://example.com/bloom.jpg",
                        "time": 4.5
                      },
                      {
                        "image_url": "https://example.com/wilt.jpg",
                        "time": 10
                      }
                    ],
                    "duration": 10,
                    "aspect_ratio": "1:1",
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Videogenerierungsaufgabe erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht authentifiziert, Token ungültig oder abgelaufen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Guthaben nicht ausreichend, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Zugriff verweigert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: kling-v4-keyframes-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit überschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt",
          "keyframes"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Name des Videogenerierungsmodells",
            "enum": [
              "kling-v4-keyframes-to-video"
            ],
            "default": "kling-v4-keyframes-to-video",
            "example": "kling-v4-keyframes-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Text-Prompt zur Beschreibung der Übergänge zwischen den Schlüsselbildern\n\n**Hinweis:**\n- Maximal `2500` Zeichen",
            "example": "Die Kamera bewegt sich von einer Straße am frühen Morgen zu einem Platz in der Abenddämmerung, während das Licht allmählich wärmer wird",
            "maxLength": 2500
          },
          "keyframes": {
            "type": "array",
            "description": "Schlüsselbilder in zeitlicher Reihenfolge: Das erste Bild ist das Startbild, das letzte das Endbild (**erforderlich**)\n\n**Beschränkungen:**\n- `2` bis `10` Bilder, höchstens jedoch `duration` + 1 (maximal `4` Bilder bei `3` Sekunden bzw. `6` Bilder bei `5` Sekunden)\n- `time` muss entweder für alle oder für keines der Schlüsselbilder angegeben werden. Ohne Zeitangaben werden die Schlüsselbilder gleichmäßig über das Video verteilt\n\n**Hinweis:**\n- Bildgröße: bis zu `10MB`\n- Unterstützte Formate: `.jpg`, `.jpeg`, `.png`\n- Bildabmessungen: Breite und Höhe >= `300px`, Seitenverhältnis zwischen `1:2.5` und `2.5:1`\n- Die Bild-URL muss vom Server direkt erreichbar sein oder beim Aufruf direkt heruntergeladen werden\n\n**Beispiel 1: `time` weglassen, um Schlüsselbilder gleichmäßig zu verteilen**\n\n```json\n[\n  {\"image_url\": \"https://example.com/morning.jpg\"},\n  {\"image_url\": \"https://example.com/noon.jpg\"},\n  {\"image_url\": \"https://example.com/evening.jpg\"}\n]\n```\n\n**Beispiel 2: `time` für jedes Schlüsselbild angeben, um Zeitpunkte festzulegen (hier ist `duration` gleich `10`)**\n\n```json\n[\n  {\"image_url\": \"https://example.com/bud.jpg\", \"time\": 0},\n  {\"image_url\": \"https://example.com/bloom.jpg\", \"time\": 4.5},\n  {\"image_url\": \"https://example.com/wilt.jpg\", \"time\": 10}\n]\n```",
            "items": {
              "type": "object",
              "properties": {
                "image_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL des Schlüsselbildes"
                },
                "time": {
                  "type": "number",
                  "description": "Zeitpunkt dieses Schlüsselbildes in Sekunden ab Videobeginn. Dezimalwerte sind zulässig (zum Beispiel `2.5`)\n\n**Hinweis:**\n- Bereich: `0` bis `duration`\n- Muss nach dem vorherigen Schlüsselbild liegen"
                }
              },
              "required": [
                "image_url"
              ]
            },
            "minItems": 2,
            "maxItems": 10
          },
          "duration": {
            "type": "integer",
            "description": "Videodauer in Sekunden. Standardwert: `5` Sekunden\n\n**Bereich:**\n- Ganze Zahl von `3` bis `30`",
            "minimum": 3,
            "maximum": 30,
            "default": 5,
            "example": 5
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Video-Seitenverhältnis\n\n**Optionen:**\n- `16:9`: Querformat\n- `9:16`: Hochformat\n- `1:1`: Quadratisch\n- `21:9`: Ultrabreitformat",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "21:9"
            ],
            "example": "16:9",
            "default": "16:9"
          },
          "quality": {
            "type": "string",
            "description": "Auflösungsstufe\n\n**Optionen:**\n- `720p`: Standard 720P\n- `1080p`: Hohe Qualität 1080P",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "example": "720p"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS-Callback-URL für Aufgabenabschluss\n\n**Callback-Zeitpunkt:**\n- Wird ausgelöst, wenn die Aufgabe abgeschlossen, fehlgeschlagen oder abgebrochen wurde\n- Wird nach Abrechnungsbestätigung gesendet\n\n**Sicherheitsbeschränkungen:**\n- Nur HTTPS-Protokoll\n- Interne IP-Adressen sind verboten (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- URL-Länge darf `2048` Zeichen nicht überschreiten\n\n**Callback-Mechanismus:**\n- Timeout: `10` Sekunden\n- Maximal `3` Wiederholungsversuche nach Fehler (nach `1`/`2`/`4` Sekunden nach Fehler)\n- Callback-Antwortformat ist konsistent mit der Aufgabenabfrage-API\n- 2xx-Statuscode gilt als erfolgreich, andere Codes lösen Wiederholung aus",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Tatsächlich verwendeter Modellname",
            "example": "kling-v4-keyframes-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Aufgabentyp"
          },
          "progress": {
            "type": "integer",
            "description": "Aufgabenfortschritt in Prozent (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Details zur Videoaufgabe"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Aufgaben-Ausgabetyp",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Nutzungs- und Abrechnungsinformationen"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Ob die Aufgabe abgebrochen werden kann",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "Geschätzte Abschlusszeit (Sekunden)",
            "minimum": 0,
            "example": 300
          },
          "video_duration": {
            "type": "integer",
            "description": "Videodauer (Sekunden)",
            "example": 5
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Nutzungs- und Abrechnungsinformationen",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Abrechnungsregel",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Geschätzter Guthabenverbrauch",
            "minimum": 0,
            "example": 270000
          },
          "user_group": {
            "type": "string",
            "description": "Benutzergruppenkategorie",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode-Bezeichner"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Alle APIs erfordern Bearer-Token-Authentifizierung ##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüssel-Verwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Videogenerierung",
      "description": "APIs zur KI-Videogenerierung"
    }
  ]
}
