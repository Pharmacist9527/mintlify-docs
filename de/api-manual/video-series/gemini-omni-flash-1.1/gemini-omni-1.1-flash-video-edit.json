{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini Omni Flash 1.1 Videobearbeitung",
    "description": "Bearbeitet ein Eingabevideo anhand optionaler Referenzbilder",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produktionsumgebung"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Gemini Omni Flash 1.1 Videobearbeitung",
        "description": "- Bearbeitet ein Eingabevideo anhand optionaler Referenzbilder\n- `video_urls`: Genau ein über HTTP/HTTPS erreichbares MP4, höchstens 10 Sekunden.\n- `image_urls`: Optionale Referenzbild-URLs, maximal 10. Nur HTTP/HTTPS.\n- `quality`: Ausgabeauflösung: 360p, 720p, 1080p, 4k oder auto. Standard: auto; auto folgt dem Eingabevideo.\n- `duration`: Nur auto ist zulässig und zugleich Standard. Die Dauer folgt dem Eingabevideo.\n- `aspect_ratio`: Nur auto ist zulässig und zugleich Standard. Das Verhältnis folgt dem Eingabevideo.\n- Das Modell erzeugt automatisch synchrones natives Audio.\n- Negative Anforderungen direkt in prompt schreiben.\n- Asynchrone Verarbeitung: [Aufgabenstatus abfragen](/de/api-manual/task-management/get-task-detail)\n- Generierte Links sind 24 Stunden gültig.",
        "operationId": "createGeminiOmni11FlashVideoEditGeneration",
        "tags": [
          "Videogenerierung"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni11FlashVideoEditRequest"
              },
              "examples": {
                "video_edit": {
                  "summary": "Videobearbeitung",
                  "value": {
                    "model": "gemini-omni-1.1-flash-video-edit",
                    "prompt": "Das Licht wärmer machen, den Rest unverändert lassen.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "quality": "auto",
                    "duration": "auto",
                    "aspect_ratio": "auto"
                  }
                },
                "video_edit_with_reference": {
                  "summary": "Videobearbeitung mit Referenzbild",
                  "value": {
                    "model": "gemini-omni-1.1-flash-video-edit",
                    "prompt": "Den Kleidungsstil des Referenzbilds beibehalten.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "image_urls": [
                      "https://example.com/reference.png"
                    ],
                    "quality": "auto",
                    "duration": "auto",
                    "aspect_ratio": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Videoaufgabe erfolgreich erstellt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Ungültige Anfrageparameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Nicht autorisiert, ungültiges oder abgelaufenes Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Unzureichendes Kontingent, Aufladung erforderlich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Zugriff verweigert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-1.1-flash-video-edit",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Ratenlimit überschritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Interner Serverfehler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni11FlashVideoEditRequest": {
        "required": [
          "model",
          "prompt",
          "video_urls"
        ],
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Modellname, fest auf `gemini-omni-1.1-flash-video-edit` eingestellt",
            "enum": [
              "gemini-omni-1.1-flash-video-edit"
            ],
            "example": "gemini-omni-1.1-flash-video-edit",
            "default": "gemini-omni-1.1-flash-video-edit"
          },
          "prompt": {
            "type": "string",
            "description": "Anweisung für die gewünschte Bearbeitung und unveränderte Inhalte.",
            "example": "Das Licht wärmer machen, den Rest unverändert lassen."
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "Genau ein über HTTP/HTTPS erreichbares MP4, höchstens 10 Sekunden.",
            "example": [
              "https://example.com/source.mp4"
            ]
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Optionale Referenzbild-URLs, maximal 10. Nur HTTP/HTTPS.",
            "example": [
              "https://example.com/reference.png"
            ]
          },
          "quality": {
            "type": "string",
            "description": "Ausgabeauflösung: 360p, 720p, 1080p, 4k oder auto. Standard: auto; auto folgt dem Eingabevideo.",
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "duration": {
            "type": "string",
            "description": "Nur auto ist zulässig und zugleich Standard. Die Dauer folgt dem Eingabevideo.",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Nur auto ist zulässig und zugleich Standard. Das Verhältnis folgt dem Eingabevideo.",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS-Callback-Adresse nach Aufgabenabschluss\n\n**Callback-Zeitpunkt:**\n- Wird ausgelöst, wenn die Aufgabe abgeschlossen (completed), fehlgeschlagen (failed) oder abgebrochen (cancelled) wurde\n- Wird nach Abschluss der Abrechnungsbestätigung gesendet\n\n**Sicherheitsbeschränkungen:**\n- Nur HTTPS-Protokoll wird unterstützt\n- Callback an interne IP-Adressen ist verboten (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, usw.)\n- URL-Länge darf `2048` Zeichen nicht überschreiten\n\n**Callback-Mechanismus:**\n- Timeout: `10` Sekunden\n- Maximal `3` Wiederholungsversuche bei Fehler (Wiederholung nach `1` Sekunde/`2` Sekunden/`4` Sekunden)\n- Das Format des Callback-Antwortkörpers entspricht dem Antwortformat der Aufgabenabfrage-API\n- Ein 2xx-Statuscode der Callback-Adresse gilt als erfolgreich, andere Statuscodes lösen eine Wiederholung aus",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Tatsächlich verwendeter Modellname",
            "example": "gemini-omni-1.1-flash-video-edit"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Spezifischer Aufgabentyp"
          },
          "progress": {
            "type": "integer",
            "description": "Aufgabenfortschritt in Prozent (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus. Der Erstellungsendpunkt gibt processing zurück.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Detaillierte Informationen zur Videoaufgabe"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Aufgaben-Ausgabetyp",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Nutzungs- und Abrechnungsinformationen"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Ob die Aufgabe abgebrochen werden kann",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Geschätzte Abschlusszeit (Sekunden)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "Die Ausgabedauer folgt dem Eingabevideo.",
            "example": 5
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Nutzungs- und Abrechnungsinformationen",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Abrechnungsregel",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Geschätzter Guthabenverbrauch",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Abrechnungsgruppe, der der Benutzer angehört",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode-Bezeichner"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüsselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
