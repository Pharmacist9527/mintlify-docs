                },
                "quality": {
                  "enum": [
                    "720p",
                    "1080p",
                    "4k"
                  ]
                },
                "duration": {
                  "type": "string",
                  "enum": [
                    "auto"
                  ],
                  "default": "auto"
                },
                "aspect_ratio": {
                  "enum": [
                    "auto"
                  ],
                  "default": "auto"
                }
              },
              "not": {
                "required": [
                  "image_urls"
                ]
              }
            }
          }
        ]
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Zeitstempel der Aufgabenerstellung",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Aufgaben-ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Tatsächlich verwendeter Modellname",
            "example": "gemini-omni-1.2-flash-text-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Spezifischer Aufgabentyp"
          },
          "progress": {
            "type": "integer",
            "description": "Aufgabenfortschritt in Prozent (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Aufgabenstatus. Der Erstellungsendpunkt gibt immer `processing` zurück; auch der interne Status `pending` wird Clients als `processing` angezeigt.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Detaillierte Informationen zur Videoaufgabe"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Aufgaben-Ausgabetyp",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Nutzungs- und Abrechnungsinformationen"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Ob die Aufgabe abgebrochen werden kann",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Geschätzte Abschlusszeit (Sekunden)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "Dauer des Ausgabevideos in Sekunden.\n\n- Text-zu-Video, Bild-zu-Video, Referenz-zu-Video: entspricht `duration` der Anfrage.\n- Videobearbeitung: `duration` ist standardmäßig und ausschließlich `auto`. Die Ausgabe folgt der Eingabe; hier wird deren erkannte Dauer zurückgegeben.\n- Videoverlängerung: Gesamtdauer der Ausgabe, also Eingabedauer plus angeforderte zusätzliche `duration`.\n- Video-Hochskalierung: entspricht der Eingabe; gibt deren erkannte Dauer zurück.",
            "example": 3
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Nutzungs- und Abrechnungsinformationen",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Abrechnungsregel",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Geschätzter Guthabenverbrauch",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Abrechnungsgruppe, der der Benutzer angehört",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Fehlercode-Bezeichner"
              },
              "message": {
                "type": "string",
                "description": "Fehlerbeschreibung"
              },
              "type": {
                "type": "string",
                "description": "Fehlertyp"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Alle APIs erfordern Bearer-Token-Authentifizierung##\n\n**API-Schlüssel erhalten:**\n\nBesuchen Sie die [API-Schlüsselverwaltungsseite](https://evolink.ai/dashboard/keys), um Ihren API-Schlüssel zu erhalten\n\n**Zum Anfrage-Header hinzufügen:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
