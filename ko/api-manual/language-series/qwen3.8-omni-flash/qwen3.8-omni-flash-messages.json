{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Messages",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Messages",
        "description": "Messages는 기본 텍스트 대화에 사용합니다. 이미지는 Chat 문서를 참고하고, 내장 웹 검색은 Responses를 사용하세요.",
        "operationId": "qwen38OmniFlashMessages",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "basic": {
                  "summary": "기본 대화",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "max_tokens": 1024,
                    "messages": [
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 매개변수 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "H01": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "L00": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않았거나 토큰이 유효하지 않거나 만료됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "H15": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "H16": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "잔액 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "요청이 너무 잦음(속도 제한)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##모든 API에는 Bearer Token 인증이 필요합니다##\n\n**API Key 발급:**\n\n[API Key 관리 페이지](https://evolink.ai/dashboard/keys)에서 API Key를 발급받으세요\n\n**요청 헤더에 추가:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash",
            "description": "대화 모델 이름"
          },
          "messages": {
            "type": "array",
            "description": "대화 메시지 목록(system 미포함). 각 메시지는 `role`(`user` / `assistant`)과 `content`(문자열 또는 내용 블록 배열)를 포함합니다.",
            "items": {
              "$ref": "#/components/schemas/InputMessage"
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "추론을 포함한 최대 출력 토큰 수입니다.",
            "example": 1024,
            "minimum": 1,
            "maximum": 131072
          }
        }
      },
      "InputMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "description": "메시지 역할"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "msg_xxxxxxxx"
          },
          "type": {
            "type": "string",
            "example": "message"
          },
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "content": {
            "type": "array",
            "description": "응답 내용 블록 배열",
            "items": {
              "$ref": "#/components/schemas/OutputContentBlock"
            }
          },
          "stop_reason": {
            "type": "string",
            "example": "end_turn"
          },
          "usage": {
            "$ref": "#/components/schemas/AnthropicUsage"
          }
        }
      },
      "OutputContentBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "thinking"
            ]
          },
          "text": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "AnthropicUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
