{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Chat Completions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Chat Completions",
        "description": "EvoLink의 Qwen3.8 Omni Flash로 추론 강도를 조절하며 텍스트와 이미지를 분석하세요. 연동 전에 요청 비용을 비교하고 Chat Completions 또는 Responses를 선택하세요.\n\n재사용할 접두부가 1024토큰 이상이면 암시적 캐싱이 적용될 수 있습니다. 적중 시 별도 요금이 적용되며 생성 비용은 없습니다. 적중이 보장되지는 않습니다.\n\n웹 검색은 Responses의 web_search 도구를 사용하세요. Chat 검색 전략은 agent만 허용합니다. Chat의 추론·검색 조합은 비스트리밍에서 HTTP 400을 반환했고, 테스트한 스트림에는 완전한 usage와 종료 마커가 없었습니다. 이 조합에서 완전한 과금 기록을 얻을 수 있다고 가정하지 마세요. 검색은 계정 전체에서 15 RPS를 공유하며, 초과하면 검색 없이 응답할 수 있습니다.",
        "operationId": "qwen38OmniFlashChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "기본 텍스트 대화",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "system",
                        "content": "You are a helpful assistant."
                      },
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                },
                "multimodal": {
                  "summary": "멀티모달 입력(이미지)",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Describe the content of this image"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://dashscope.oss-cn-beijing.aliyuncs.com/images/dog_and_girl.jpeg"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "대화 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 매개변수 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "H01": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "L00": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않았거나 토큰이 유효하지 않거나 만료됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "H15": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "H16": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "잔액 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "요청이 너무 잦음(속도 제한)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##모든 API에는 Bearer Token 인증이 필요합니다##\n\n**API Key 발급:**\n\n[API Key 관리 페이지](https://evolink.ai/dashboard/keys)에서 API Key를 발급받으세요\n\n**요청 헤더에 추가:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "대화 모델 이름",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash"
          },
          "messages": {
            "type": "array",
            "description": "대화 메시지 목록, 멀티턴 대화 지원. 역할(system / user / assistant / tool)에 따라 메시지 필드 구조가 다르므로 해당 역할을 선택해 확인하세요.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ]
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "추론을 포함한 최대 출력 토큰 수입니다.",
            "minimum": 1,
            "maximum": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "응답을 스트리밍 방식으로 반환할지 여부.\n\n- `true`: SSE(Server-Sent Events)로 청크 단위 반환\n- `false`(기본값): 완전한 응답을 한 번에 반환",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "description": "스트리밍 응답 옵션, `stream=true`일 때만 유효합니다.",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "`true`일 때, 스트리밍 종료 전에 `usage`만 포함한 데이터 청크를 추가로 반환합니다."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "도구 정의 목록, Function Calling에 사용됩니다. 각 도구는 이름, 설명, 매개변수 schema를 정의해야 합니다.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "xhigh",
            "description": "Chat reasoning_effort는 none, minimal, low, medium, high, xhigh, max를 허용하며 기본값은 xhigh입니다. thinking_budget과 함께 보내지 마세요. Responses는 reasoning.effort를 사용합니다."
          },
          "preserve_thinking": {
            "type": "boolean",
            "default": true,
            "description": "컨텍스트 창은 용량이지 목표 입력 크기가 아닙니다. 입력 한도는 프로토콜과 추론 모드에 따라 달라집니다. Chat 기본값은 xhigh이며 preserve_thinking은 기본 활성화됩니다. 기록에 다시 보내는 추론 내용은 입력으로 계산됩니다."
          }
        }
      },
      "SystemMessage": {
        "type": "object",
        "title": "System Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "메시지 역할, `system`으로 고정"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "UserMessage": {
        "type": "object",
        "title": "User Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "메시지 역할, `user`로 고정"
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          }
        }
      },
      "AssistantRequestMessage": {
        "type": "object",
        "title": "Assistant Message",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "메시지 역할, `assistant`로 고정"
          },
          "content": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "description": "이전 턴에서 어시스턴트가 시작한 도구 호출 목록(Function Calling 이력 재구성에 사용).",
            "items": {
              "type": "object"
            }
          },
          "reasoning_content": {
            "type": "string",
            "description": "컨텍스트 창은 용량이지 목표 입력 크기가 아닙니다. 입력 한도는 프로토콜과 추론 모드에 따라 달라집니다. Chat 기본값은 xhigh이며 preserve_thinking은 기본 활성화됩니다. 기록에 다시 보내는 추론 내용은 입력으로 계산됩니다."
          }
        }
      },
      "ToolMessage": {
        "type": "object",
        "title": "Tool Message",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "메시지 역할, `tool`로 고정(도구 실행 결과)"
          },
          "content": {
            "description": "도구 실행 결과 내용. 문자열 또는 content part 배열일 수 있습니다.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "tool_call_id": {
            "type": "string",
            "description": "대응하는 도구 호출 ID"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url"
            ]
          },
          "text": {
            "type": "string",
            "description": "`type=text`일 때의 텍스트 내용"
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "이미지 URL, 또는 `data:`로 시작하는 base64 data URL"
              }
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Function Calling 도구 정의.",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "도구 유형, `function`으로 고정"
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "함수 이름"
              },
              "description": {
                "type": "string",
                "description": "함수 용도 설명"
              },
              "parameters": {
                "type": "object",
                "description": "함수 매개변수의 JSON Schema"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "이번 대화의 고유 식별자",
            "example": "chatcmpl-xxxxxxxx"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "생성 시간(Unix 초)",
            "example": 1735120033
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "중단 이유\n\n- `stop`: 정상 종료\n- `length`: `max_completion_tokens` 상한 도달\n- `tool_calls`: 도구 호출 필요",
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "description": "어시스턴트 응답 메시지.",
        "properties": {
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "응답 본문"
          },
          "reasoning_content": {
            "type": "string",
            "description": "응답에 반환된 추론 텍스트입니다."
          },
          "tool_calls": {
            "type": "array",
            "description": "모델이 시작한 도구 호출 목록",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer"
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
