{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi API(모든 모델) - Messages 전체 참조",
    "description": "Anthropic Messages 프로토콜로 Kimi 텍스트 모델을 호출합니다. `model`로 `kimi-k3.1-pro`, `kimi-k3.1-pro-highspeed`, `kimi-k3`를 선택합니다. 모두 컨텍스트 창은 1,048,576 tokens이며 여러 턴의 대화, 스트리밍, 도구 호출, 웹 검색, 이미지 입력을 지원합니다.\n\n세 모델 모두 추론이 항상 활성화되며 `output_config.effort`로 강도를 조절합니다. 구조화된 출력, 중지 시퀀스, 캐시 쓰기 TTL은 K3.1 시리즈만 지원합니다. `model` 필드 설명을 확인하세요. 여러 턴의 대화에서는 thinking, signature, tool_use를 포함한 전체 assistant 콘텐츠 블록을 변경 없이 다시 전송하세요.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "프로덕션(권장)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "대체 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Kimi Messages API(모든 모델, Anthropic 호환)",
        "description": "공개 엔드포인트는 POST /v1/messages입니다. 추론 강도는 output_config.effort로 설정합니다. 최상위 cache_control은 5m/1h 캐시 쓰기를 제어합니다(K3.1 시리즈만 지원). thinking, signature, tool_use 및 서버 측 검색 결과 블록을 모두 보존하세요.",
        "operationId": "createMessageKimi",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Highspeed 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "k3": {
                  "summary": "Kimi K3 최소 요청",
                  "value": {
                    "model": "kimi-k3",
                    "max_tokens": 1024,
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "system_prompt": {
                  "summary": "system 프롬프트",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 2048,
                    "output_config": {
                      "effort": "low"
                    },
                    "system": "당신은 정확한 기술 편집자입니다.",
                    "messages": [
                      {
                        "role": "user",
                        "content": "컨텍스트 캐싱을 설명해 주세요."
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "Anthropic SSE 스트리밍",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "stream": true
                  }
                },
                "multimodal": {
                  "summary": "이미지 입력",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "image",
                            "source": {
                              "type": "base64",
                              "media_type": "image/jpeg",
                              "data": "/9j/4AAQSkZJRgABAQAA..."
                            }
                          },
                          {
                            "type": "text",
                            "text": "이 이미지를 설명해 주세요."
                          }
                        ]
                      }
                    ]
                  }
                },
                "tool_use": {
                  "summary": "도구 사용",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 2048,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "오늘 베이징 날씨를 확인해 주세요."
                      }
                    ],
                    "tools": [
                      {
                        "name": "get_weather",
                        "description": "지정한 도시의 날씨 조회",
                        "input_schema": {
                          "type": "object",
                          "properties": {
                            "city": {
                              "type": "string",
                              "description": "도시 이름"
                            }
                          },
                          "required": [
                            "city"
                          ]
                        }
                      }
                    ],
                    "tool_choice": {
                      "type": "auto"
                    }
                  }
                },
                "web_search": {
                  "summary": "서버 측 웹 검색",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "tools": [
                      {
                        "type": "web_search_20250305",
                        "name": "web_search",
                        "max_uses": 1
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "엄격한 구조화된 출력(K3.1 시리즈만 지원)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low",
                      "format": {
                        "type": "json_schema",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ]
                  }
                },
                "cache_1h": {
                  "summary": "최상위 1h 캐시(K3.1 시리즈만 지원)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "cache_control": {
                      "type": "ephemeral",
                      "ttl": "1h"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message 응답입니다. 스트리밍 요청은 Anthropic SSE 이벤트 스트림을 반환합니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "일반적인 이벤트 순서는 message_start, content_block_*, message_delta, message_stop입니다."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "호출할 모델:\n\n| 모델 ID | 특성 | 추론 강도 |\n|---|---|---|\n| `kimi-k3.1-pro` | 최신 세대 모델(권장) | `low` / `high` / `max`, 기본값 `max` |\n| `kimi-k3.1-pro-highspeed` | Pro와 동일한 매개변수, 더 빠른 생성 | `kimi-k3.1-pro`와 동일 |\n| `kimi-k3` | 이전 세대 모델 | `max`만 지원 |\n\n세 모델 모두 컨텍스트 창은 1,048,576 tokens이며 추론이 항상 활성화됩니다.\n\n구조화된 출력(`output_config.format`), 중지 시퀀스(`stop_sequences`), 캐시 쓰기 TTL(`cache_control`)은 K3.1 시리즈만 지원하며 `kimi-k3`는 지원하지 않습니다. `kimi-k3`의 응답은 `thinking` 블록 없이 `text` 블록만 포함할 수 있습니다."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "thinking과 최종 텍스트를 포함해 이번 생성에 허용되는 최대 token 수입니다.",
            "maximum": 1048576
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Anthropic Messages 메시지 목록입니다. 여러 턴 대화에서는 assistant의 전체 콘텐츠 블록을 변경하지 말고 다시 전달하세요.",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "system": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessagesTextBlockParam"
                }
              }
            ],
            "description": "문자열 또는 text 블록 배열 형식의 시스템 프롬프트입니다."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Anthropic SSE 이벤트 스트림 반환 여부입니다."
          },
          "tools": {
            "type": "array",
            "description": "사용자 정의 함수 또는 서버 측 웹 검색입니다. 내장 검색은 type=web_search_20250305, name=web_search를 사용하며 실제 호출 횟수로 과금합니다.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Tool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "description": "중지 시퀀스. 정확히 일치하면 출력을 중단하며 일치한 시퀀스 자체는 출력하지 않습니다. 최대 5개, 각각 32바이트 이하입니다. 일치 시 `stop_reason`은 `end_turn`, `stop_sequence`는 `null`입니다.\n\n`kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`만 지원하며 `kimi-k3`는 지원하지 않습니다."
          },
          "cache_control": {
            "type": "object",
            "description": "최상위 캐시 쓰기 옵션. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`만 지원하며 `kimi-k3`는 이 매개변수를 지원하지 않습니다. 쓰기 TTL은 최상위 cache_control만 제어하며 메시지 블록 내부의 캐시 표시는 이 필드를 대체할 수 없습니다. 생략하면 기본값은 5m입니다.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ephemeral"
                ],
                "description": "캐시 유형으로 ephemeral로 고정됩니다."
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "캐시 유효 기간은 5m 또는 1h이며 기본값은 5m입니다."
              }
            },
            "required": [
              "type"
            ]
          },
          "output_config": {
            "type": "object",
            "description": "출력 설정: 추론 강도 및 구조화 출력.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "추론 강도. 추론은 항상 활성화되며 `thinking.type: \"disabled\"`를 전달해도 꺼지지 않습니다.\n\n- `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`: `low` / `high` / `max`를 권장하며 기본값은 `max`입니다. 범용 클라이언트 호환을 위해 `medium`은 `high`, `xhigh`는 `max`, `minimal` / `none`은 `low`로 처리합니다. `none`도 추론을 끄지 않습니다.\n- `kimi-k3`: `max`만 지원합니다(기본값).\n\n강도를 높이면 일반적으로 추론 토큰과 지연 시간이 증가합니다. 추론 토큰은 출력에 포함됩니다."
              },
              "format": {
                "type": "object",
                "description": "구조화된 출력: 모델이 지정한 JSON Schema를 엄격히 따르는 JSON을 출력합니다. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`만 지원하며 `kimi-k3`는 지원하지 않습니다. `kimi-k3`에서 구조화된 출력이 필요하면 Chat Completions API의 `response_format`을 사용하세요.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "schema": {
                    "type": "object",
                    "description": "출력이 따라야 하는 JSON Schema입니다.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "type",
                  "schema"
                ]
              }
            }
          },
          "temperature": {
            "type": "number",
            "default": 1,
            "description": "샘플링 온도. 모델에서 `1`로 고정하므로 전달할 필요가 없습니다. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`는 이 필드를 자동으로 무시하며 `kimi-k3`는 지원하지 않는 값에 대해 오류를 반환합니다."
          },
          "top_p": {
            "type": "number",
            "default": 0.95,
            "description": "핵 샘플링 임계값. 모델에서 `0.95`로 고정하므로 전달할 필요가 없습니다. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`는 이 필드를 자동으로 무시하며 `kimi-k3`는 지원하지 않는 값에 대해 오류를 반환합니다."
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "메시지 역할입니다. user와 assistant만 지원합니다.",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "description": "일반 텍스트 문자열 또는 Anthropic 콘텐츠 블록 배열 형식의 메시지 내용입니다.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlock"
                }
              }
            ]
          }
        }
      },
      "ContentBlock": {
        "description": "텍스트, 이미지, 추론, 도구 사용 또는 도구 결과를 위한 Anthropic 콘텐츠 블록입니다.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/ImageBlock"
          },
          {
            "$ref": "#/components/schemas/ThinkingBlock"
          },
          {
            "$ref": "#/components/schemas/ToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/ToolResultBlock"
          },
          {
            "$ref": "#/components/schemas/ServerToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/WebSearchResultBlock"
          }
        ]
      },
      "TextBlock": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "콘텐츠 블록 유형입니다. text로 고정됩니다.",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "description": "텍스트 내용입니다."
          }
        }
      },
      "ImageBlock": {
        "type": "object",
        "required": [
          "type",
          "source"
        ],
        "description": "이미지 콘텐츠 블록(멀티모달 입력)입니다.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ],
            "description": "콘텐츠 블록 유형입니다. image로 고정됩니다."
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "이미지 출처입니다.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "base64"
                ],
                "description": "이미지 소스입니다. base64로 인코딩된 인라인 데이터만 지원합니다."
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/gif",
                  "image/webp"
                ],
                "description": "`type=base64`일 때의 이미지 MIME 유형입니다."
              },
              "data": {
                "type": "string",
                "description": "`type=base64`일 때의 이미지 Base64 데이터입니다(`data:` 접두사 제외)."
              }
            }
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "콘텐츠 블록 유형입니다. thinking으로 고정됩니다.",
            "enum": [
              "thinking"
            ]
          },
          "thinking": {
            "type": "string",
            "description": "모델의 추론 내용입니다. 여러 턴 대화에서는 signature와 함께 변경하지 말고 다시 전달하세요."
          },
          "signature": {
            "type": "string",
            "description": "여러 턴 대화에서는 thinking 블록과 함께 변경하지 말고 다시 전달하세요."
          }
        }
      },
      "ToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
