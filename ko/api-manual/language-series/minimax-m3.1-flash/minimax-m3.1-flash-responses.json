            "description": "함수의 용도 설명입니다. 명확한 설명은 모델이 호출 시점을 판단하는 데 도움이 됩니다.",
            "example": "Get the current stock level for a product."
          },
          "parameters": {
            "type": "object",
            "description": "파라미터 정의(JSON Schema 형식)입니다.",
            "example": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "description": "Product identifier."
                }
              },
              "required": [
                "product_id"
              ]
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "Responses API의 응답 객체입니다. 아래 필드 외에도 이번 요청의 설정인 `tools`, `tool_choice`, `temperature`, `top_p`, `text`, `reasoning`, `max_output_tokens` 등을 포함합니다.",
        "properties": {
          "id": {
            "type": "string",
            "description": "이번 응답의 고유 식별자",
            "example": "072514d63605b7a0c83f1672230c398c"
          },
          "object": {
            "type": "string",
            "description": "객체 유형이며 항상 `response`",
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "생성 시각(Unix 타임스탬프, 초)",
            "example": 1792401878
          },
          "status": {
            "type": "string",
            "description": "응답 상태입니다\n\n- `completed`: 정상 완료\n- `incomplete`: 출력이 잘렸으며, 원인은 `incomplete_details`에 표시됩니다\n- `failed`: 생성 실패이며, 원인은 `error`에 표시됩니다",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "model": {
            "type": "string",
            "description": "실제로 이번 응답을 생성한 모델 ID",
            "example": "MiniMax-M3.1-Flash"
          },
          "output": {
            "type": "array",
            "description": "생성 순서대로 정렬된 출력 항목 목록입니다:\n\n- `reasoning`: 추론 과정으로 ID 형식은 `<id>_rs`입니다. `content` (`reasoning_text` 블록 목록), `summary` (빈 배열), `encrypted_content`를 포함합니다\n- `message`: 최종 답변으로 ID 형식은 `<id>_msg`입니다. `content` (`output_text` 블록 목록)를 포함합니다\n- `function_call`: 모델이 시작한 함수 호출로 ID 형식은 `<id>_fc_<index>`입니다. `call_id`, `name`, `arguments`를 포함하며 클라이언트가 실행한 뒤 `function_call_output`으로 결과를 전달해야 합니다",
            "items": {
              "type": "object"
            }
          },
          "output_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "모든 `output_text` 텍스트를 연결한 편의 필드입니다. 텍스트 출력이 없으면 `null`입니다."
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "실패 원인이며 성공 시에는 `null`"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "출력이 잘린 원인으로, 잘리지 않았으면 `null`입니다. `reason`은 `max_output_tokens` (출력 한도 도달) 또는 `content_filter` (콘텐츠 안전)입니다."
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "캐시 및 추론 세부 내역을 포함한 토큰 사용 통계입니다.",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "캐시 적중 부분을 포함한 전체 입력 토큰 수입니다.",
            "example": 207
          },
          "input_tokens_details": {
            "type": "object",
            "description": "입력 token 상세 내역",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "캐시에 적중한 입력 토큰 수입니다\n\n캐시 적중 부분에는 캐시 적중 요금이 적용됩니다. 캐시 미적중 부분 = `input_tokens - cached_tokens`에는 표준 입력 요금이 적용됩니다.",
                "example": 174
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "출력 토큰 수(사고 부분 포함)",
            "example": 32
          },
          "output_tokens_details": {
            "type": "object",
            "description": "출력 token 상세 내역",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "추론 과정에서 생성된 토큰 수로, `output_tokens`에 이미 포함되어 있습니다.",
                "example": 9
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "총 토큰 수 = input_tokens + output_tokens",
            "example": 239
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "오류 응답",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "오류 코드",
                "example": "invalid_prompt"
              },
              "message": {
                "type": "string",
                "description": "오류 설명",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "description": "오류 유형",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
