                              "fps": 1,
                              "detail": "default"
                            }
                          }
                        ]
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "tool_calling": {
                  "summary": "Function Calling 도구 호출",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Check the stock for product demo-item-001."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_product_stock",
                          "description": "Get the current stock level for a product.",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "product_id": {
                                "type": "string",
                                "description": "Product identifier."
                              }
                            },
                            "required": [
                              "product_id"
                            ]
                          }
                        }
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "streaming": {
                  "summary": "스트리밍 출력",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Write a short poem about spring."
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                }
              }
            }
          }
        },
