  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "대화 모델 이름",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "대화 메시지 목록, 멀티턴 대화 지원\n\n역할마다 메시지의 필드 구조가 다르므로 해당 역할을 선택하여 확인하세요",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "추론 깊이입니다. 기본값은 `max`이며, 높은 단계일수록 일반적으로 추론 토큰 사용량과 응답 시간이 증가합니다.",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "high"
          },
          "thinking": {
            "type": "object",
            "description": "추론 모드입니다. MiniMax-M3.1-Flash는 항상 추론을 수행합니다. `adaptive`만 지원하며 생략할 수 있습니다.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive"
                ],
                "default": "adaptive"
              }
            }
          },
          "reasoning_split": {
            "type": "boolean",
            "description": "추론 내용을 별도로 반환할지 여부입니다. `true`만 지원하며 추론 내용은 `reasoning_content`로 반환됩니다. 생략할 수 있습니다.",
            "enum": [
              true
            ],
            "default": true
          },
          "temperature": {
            "type": "number",
            "description": "출력의 무작위성을 제어하는 샘플링 온도입니다\n\n**설명**:\n- 범위: `[0, 2]`, 기본값: 1\n- 값이 낮을수록 출력이 더 결정적이고, 높을수록 더 다양해집니다\n\n**권장 사항**: temperature와 top_p를 동시에 조정하지 마세요",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "누적 확률 샘플링 (Nucleus Sampling) 파라미터입니다\n\n**설명**:\n- 지정한 누적 확률에 도달하는 토큰 집합에서 샘플링합니다\n- 예를 들어 0.95이면 누적 확률이 95%에 도달하는 토큰 집합에서 선택합니다\n- 범위: `[0, 1]`, 기본값: 0.95\n\n**권장 사항**: temperature와 top_p를 동시에 조정하지 마세요",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
