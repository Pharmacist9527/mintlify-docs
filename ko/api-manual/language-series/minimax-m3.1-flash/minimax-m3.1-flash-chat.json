  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "대화 모델 이름\n\n**설명**: `MiniMax-M3.1-Flash`는 프리뷰 모델이며 동작이 변경될 수 있습니다",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "대화 메시지 목록, 멀티턴 대화 지원\n\n역할마다 메시지의 필드 구조가 다르므로 해당 역할을 선택하여 확인하세요",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "사고 깊이\n\nMiniMax-M3.1-Flash는 항상 사고하며, 이 필드는 사고의 깊이만 설정합니다\n\n- `low`: 가장 얕은 사고, 가장 빠른 응답, 가장 적은 출력 token\n- `medium` / `high` / `xhigh`: 단계적으로 더 깊은 사고\n- `max`(기본값): 가장 깊은 사고, 가장 느린 응답, 가장 많은 출력 token\n\n**설명**:\n- 생략하면 기본값 `max`가 적용됩니다. 간단한 작업에서는 더 낮은 수준을 사용하면 지연 시간과 출력 token을 줄일 수 있습니다\n- 사고 token은 출력 token으로 과금되며 `max_completion_tokens`에 포함됩니다\n- `none`과 `minimal`은 사고를 끄지 않습니다. EvoLink가 `low`로 변경합니다",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "medium"
          },
          "thinking": {
            "type": "object",
            "description": "사고 설정(선택 사항)\n\nMiniMax-M3.1-Flash는 항상 사고하므로 이 필드는 생략해도 됩니다. 사고 깊이는 `reasoning_effort`로 설정하세요\n\n**설명**:\n- 사고 내용은 `reasoning_content`로 반환되며 `content`와 분리됩니다\n- 사고 token은 출력 token으로 과금됩니다",
            "properties": {
              "type": {
                "type": "string",
                "description": "사고 모드\n\n- `adaptive`: 사고 켜짐(필드를 생략한 것과 동일)\n- `disabled`: 사고를 끄지 **않습니다**. EvoLink는 `thinking`을 제거하고, `reasoning_effort`가 설정되지 않았다면 `low`로 설정합니다. 사고는 그대로 실행되며 출력 token으로 과금됩니다",
                "enum": [
                  "adaptive",
                  "disabled"
                ],
                "default": "adaptive"
              }
            }
          },
          "temperature": {
            "type": "number",
            "description": "샘플링 온도, 출력의 무작위성을 제어\n\n**설명**:\n- 낮은 값(예: 0.2): 더 확정적이고 집중된 출력\n- 높은 값(예: 1.5): 더 무작위하고 창의적인 출력\n- 범위 `[0, 2]`, 기본값 1",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "핵 샘플링(Nucleus Sampling) 파라미터\n\n**설명**:\n- 누적 확률 상위 토큰에서 샘플링하는 범위를 제어\n- 예를 들어 0.95는 누적 확률이 95%에 도달하는 토큰에서 선택함을 의미\n- 범위 `[0, 1]`, MiniMax-M3.1-Flash 기본값 0.95\n\n**권장 사항**: temperature와 top_p를 동시에 조정하지 마세요",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "생성 내용 길이의 상한 지정(Token 수, 사고 포함)\n\n**설명**:\n- 최대 **524,288**(512K), 권장 최대 **131,072**(128K)\n- 생략하면 EvoLink는 **32768**을 사용합니다\n- 사고 token도 이 상한에 포함됩니다. 값이 작은데 `reasoning_effort`가 높으면 사고가 상한을 소진할 수 있으며, 이 경우 응답은 `finish_reason: \"length\"`로 끝나고 `content`는 비어 있습니다\n- 32768 이상으로 설정하고, 간단한 작업에는 `reasoning_effort`를 낮추세요",
            "minimum": 1,
            "maximum": 524288,
            "example": 32768
          },
          "stream": {
            "type": "boolean",
            "description": "응답을 스트리밍 방식으로 반환할지 여부\n\n- `true`: 스트리밍 반환, SSE(Server-Sent Events)를 통해 내용을 청크 단위로 실시간 반환\n- `false`: 완전한 응답을 기다린 후 한 번에 반환(기본값)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "스트리밍 응답 옵션\n\n`stream=true`일 때만 유효합니다",
            "properties": {
              "include_usage": {
