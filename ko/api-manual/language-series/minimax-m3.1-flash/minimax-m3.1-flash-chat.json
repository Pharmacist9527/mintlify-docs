                    "max_completion_tokens": 131072
                  }
                },
                "image_understanding": {
                  "summary": "이미지 이해(멀티모달 입력)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "What is shown in this image?"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://example.com/image.jpeg",
                              "detail": "default"
                            }
                          }
                        ]
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "video_understanding": {
                  "summary": "비디오 이해 (멀티모달 입력)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Summarize this video."
