  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "호출할 모델\n\n**설명**: `MiniMax-M3.1-Flash`는 프리뷰 모델이며 동작이 변경될 수 있습니다",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "max_tokens": {
            "type": "integer",
            "description": "생성 내용 길이의 상한 지정(Token 수, 사고 포함)\n\n**설명**:\n- 최대 **524,288**(512K), 권장 최대 **131,072**(128K)\n- 생략하면 EvoLink는 **32768**을 사용합니다\n- 사고 token도 이 상한에 포함됩니다. 값이 작은데 `output_config.effort`가 높으면 사고가 상한을 소진할 수 있으며, 이 경우 응답은 `stop_reason: \"max_tokens\"`로 끝나고 `text` 블록이 없습니다\n- 32768 이상으로 설정하고, 간단한 작업에는 `output_config.effort`를 낮추세요",
            "minimum": 1,
            "maximum": 524288,
            "example": 32768
          },
          "messages": {
            "type": "array",
            "description": "대화 메시지 목록, 턴마다 user / assistant 교대\n\n**설명**:\n- 최소 1개의 메시지를 포함해야 함\n- 마지막 메시지는 일반적으로 `role=user`",
            "items": {
              "$ref": "#/components/schemas/InputMessage"
            },
            "minItems": 1
          },
          "system": {
            "description": "시스템 프롬프트, AI 역할과 동작을 설정하는 데 사용\n\n**설명**:\n- 문자열 또는 문자열 배열 지원\n- 최상위 `system` 필드로 전달",
            "oneOf": [
              {
                "type": "string",
                "example": "You are a helpful assistant."
              },
              {
                "type": "array",
                "description": "콘텐츠 블록 배열 형식의 시스템 프롬프트. text 블록은 cache_control을 가질 수 있음",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    },
                    "cache_control": {
                      "$ref": "#/components/schemas/CacheControl"
                    }
                  }
                }
              }
            ]
          },
          "temperature": {
            "type": "number",
            "description": "샘플링 온도\n\n**설명**:\n- 범위 `[0, 2]`\n- 기본값 1; 값이 높을수록 발산적이고, 낮을수록 확정적",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "핵 샘플링 임계값\n\n**설명**:\n- 범위 `[0, 1]`, MiniMax-M3.1-Flash 기본값 0.95\n- temperature와 top_p를 동시에 조정하지 않는 것을 권장",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "stream": {
            "type": "boolean",
            "description": "SSE 스트리밍으로 반환할지 여부\n\n- `true`: Server-Sent Events 스트리밍 반환\n- `false`: 완전한 응답 후 한 번에 반환(기본값)",
            "default": false,
            "example": false
          },
          "thinking": {
            "type": "object",
            "description": "사고 설정(선택 사항)\n\nMiniMax-M3.1-Flash는 항상 사고하므로 이 필드는 생략해도 됩니다. 사고 깊이는 `output_config.effort`로 설정하세요\n\n**설명**:\n- 응답 `content`는 `type=\"thinking\"` 블록으로 시작합니다(출력 token으로 과금)\n- 멀티턴 대화, 특히 도구 호출이 있을 때는 thinking 블록을 원본 그대로 되돌려 보내세요",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive",
                  "disabled",
                  "enabled"
                ],
                "description": "- `adaptive`: 사고 켜짐(필드를 생략한 것과 동일)\n- `disabled`: 사고를 끄지 **않습니다**. EvoLink는 `thinking`을 제거하고, `output_config.effort`가 설정되지 않았다면 `low`로 설정합니다\n- `enabled`: `budget_tokens`와 함께 쓰는 Anthropic의 기존 방식입니다. EvoLink는 이를 adaptive 사고로 변환하며, `output_config.effort`가 설정되지 않았다면 `budget_tokens`에 따라 사고 깊이를 정합니다\n\n어떤 경우든 사고는 실행되며 출력 token으로 과금됩니다",
                "default": "adaptive"
              },
              "budget_tokens": {
                "type": "integer",
                "description": "`type: \"enabled\"`와 함께 쓸 때만 사용됩니다. 사고량의 엄격한 상한이 아니며, `output_config.effort`가 설정되지 않았다면 EvoLink가 이 값을 사고 깊이 수준으로 변환합니다\n\n- ≤ 2048 → `low`\n- ≤ 4096 → `medium`\n- ≤ 8192 → `high`\n- ≤ 16384 → `xhigh`\n- 그보다 크면 → `max`",
                "minimum": 1
              }
            }
          },
          "output_config": {
            "type": "object",
            "description": "출력 설정. `effort`로 사고 깊이를 설정합니다",
            "properties": {
              "effort": {
                "type": "string",
                "description": "사고 깊이\n\n- `low`: 가장 얕은 사고, 가장 빠른 응답, 가장 적은 출력 token\n- `medium` / `high` / `xhigh`: 단계적으로 더 깊은 사고\n- `max`(기본값): 가장 깊은 사고, 가장 느린 응답, 가장 많은 출력 token\n\n**설명**:\n- 생략하면 기본값 `max`가 적용됩니다. 간단한 작업에서는 더 낮은 수준을 사용하면 지연 시간과 출력 token을 줄일 수 있습니다\n- 사고 token은 출력 token으로 과금되며 `max_tokens`에 포함됩니다\n- `none`과 `minimal`은 사고를 끄지 않습니다. EvoLink가 `low`로 변경합니다",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "max",
                "example": "medium"
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "도구 정의 목록\n\n**설명**:\n- Anthropic tool 정의 규범을 따름\n- `input_schema`는 JSON Schema 객체를 사용",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "object",
            "description": "도구 선택 전략. auto와 none만 지원",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "auto",
                  "none"
                ],
                "description": "- `auto`: 모델이 도구 호출 여부를 자동으로 결정(tools 제공 시 기본값)\n- `none`: 도구 호출 금지"
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "요청 메타데이터",
            "properties": {
              "user_id": {
                "type": "string",
                "description": "종단 사용자를 나타내는 고유 식별자로, 사용자 단위 모니터링 및 남용 탐지에 사용할 수 있습니다(해시 처리된 ID 사용 권장)"
              }
            }
          }
        }
      },
      "InputMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "user_system",
              "group",
              "sample_message_user",
              "sample_message_ai"
            ],
            "description": "메시지 발신 측 역할. MiniMax-M3.1-Flash는 user / assistant 교대 메시지를 사용\n\n- `user`: 사용자 메시지(`tool_result` block을 되돌려 보내는 데에도 사용)\n- `assistant`: 어시스턴트 과거 응답(`text` / `thinking` / `tool_use` blocks 포함 가능)\n\n**`system`은 허용되지 않음**: 시스템 프롬프트는 최상위 `system` 필드를 사용하세요."
          },
          "content": {
            "description": "메시지 내용\n\n**설명**:\n- 순수 텍스트일 경우 문자열을 직접 전달\n- 구조화된 경우 content block 배열을 전달(`text` / `image` / `video` / `tool_use` / `tool_result` / `thinking`)",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlock"
                }
              }
            ]
          }
        }
      },
      "ContentBlock": {
        "type": "object",
        "description": "메시지 콘텐츠 블록\n\n**지원 type**:\n- `text`: 텍스트 내용\n- `image`: 이미지 입력\n- `video`: 비디오 입력\n- `tool_use`: 이전 턴 assistant 도구 호출을 되돌려 보냄\n- `tool_result`: 도구 실행 결과\n- `thinking`: 이전 턴 assistant 사고 내용을 되돌려 보냄\n- `mid_conv_system`: 대화 중간에 삽입하는 시스템 지시",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "video",
              "tool_use",
              "tool_result",
              "thinking",
              "mid_conv_system"
            ]
          },
          "text": {
            "type": "string",
            "description": "type=`text`일 때의 텍스트 내용"
          },
          "source": {
            "$ref": "#/components/schemas/MediaSource",
            "description": "이미지 또는 비디오 소스, type=`image` 또는 type=`video`일 때 사용"
          },
          "id": {
            "type": "string",
            "description": "도구 호출 ID(tool_use 시 필수)"
