                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          },
          "thinking": {
            "type": "string",
            "description": "되돌려 보내는 assistant 사고 과정 내용(type=`thinking`일 때 사용). 멀티턴 대화, 특히 도구 호출이 있을 때는 assistant의 thinking 블록을 원본 그대로 되돌려 보내세요"
          },
          "signature": {
            "type": "string",
            "description": "되돌려 보내는 thinking 내용 서명, 멀티턴 이어쓰기 시 원본 그대로 되돌려 보내야 함"
          },
          "cache_control": {
