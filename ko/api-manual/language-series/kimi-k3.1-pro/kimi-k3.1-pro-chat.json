{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - OpenAI 호환 API",
    "description": "kimi-k3.1-pro와 kimi-k3.1-pro-highspeed를 지원하며 컨텍스트 윈도우는 1,048,576 tokens입니다. 두 모델은 항상 추론합니다. 기본 추론 강도는 low / high / max이며 기본값은 max입니다.\n\n멀티턴 기록, SSE, 함수 도구, 웹 검색, 엄격한 JSON Schema 및 5m / 1h 컨텍스트 캐싱을 지원합니다. 샘플링 설정은 temperature=1, top_p=0.95, n=1, presence_penalty=frequency_penalty=0으로 고정되어 별도로 전달할 필요가 없습니다.\n\n[모델, 요금 및 사용 가이드](/ko/api-manual/language-series/kimi-k3.1-pro/kimi-k3.1-pro-overview).",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "프로덕션 (권장)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "대체 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed 채팅 API (OpenAI 호환)",
        "description": "두 모델의 정확한 ID를 같은 엔드포인트에서 사용합니다. 기본 추론 강도는 low / high / max입니다. 기록의 reasoning_content와 tool_calls를 완전히 보존하세요. 검색 결과는 tool_calls로 반환되며 이를 기록에 넣어 다시 요청하면 최종 답변을 얻을 수 있습니다.",
        "operationId": "createChatCompletionKimiK31Pro",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Highspeed 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "usage를 포함하는 SSE 스트리밍",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                },
                "cache_1h": {
                  "summary": "1h 캐시 자동 쓰기",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "웹 검색 (통합 형식)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "web_search_native": {
                  "summary": "웹 검색 (Moonshot 기본 형식)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "builtin_function",
                        "function": {
                          "name": "$web_search"
                        }
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "엄격한 JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "오늘 베이징 날씨를 확인해 주세요."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "지정된 도시의 날씨를 조회합니다",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "도시 이름"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion 응답입니다. 스트리밍 요청은 SSE 이벤트 스트림을 반환합니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "OpenAI Chat Completions 형식의 SSE 데이터이며 `data: [DONE]`으로 끝납니다."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Pro와 Highspeed는 엔드포인트와 매개변수를 공유합니다. Highspeed의 입력, 출력, 캐시 쓰기 단가는 다르며 캐시 읽기 단가는 같습니다."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "대화 메시지입니다. 여러 턴 대화에서는 과거 assistant 메시지 전체를 포함하세요.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "추론과 최종 답변을 포함한 최대 생성 토큰 수입니다. 기본값은 131072, 최대값은 1048576이며 남은 컨텍스트의 제한도 받습니다."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "추론 강도입니다. low / high / max를 권장하며 기본값은 max입니다. 추론은 항상 활성화됩니다. 호환용 값 medium은 high, xhigh는 max, minimal / none은 low로 처리됩니다. none도 추론을 끄지 않습니다. 강도가 높으면 보통 추론 토큰과 지연 시간이 늘어납니다. 추론 토큰은 출력에 포함됩니다."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "응답을 SSE 스트림으로 반환할지 여부입니다."
          },
          "stream_options": {
            "$ref": "#/components/schemas/StreamOptions",
            "description": "스트리밍 응답 옵션입니다. `stream=true`일 때만 적용되며 token 가격이나 생성량을 변경하지 않습니다."
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "함수 도구 또는 웹 검색입니다. 검색은 {\"type\":\"web_search\"} 또는 Moonshot 기본 형식 builtin_function / $web_search를 사용합니다. 실제 검색 횟수로 과금하며 일반 함수에는 검색 요금이 없습니다.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                },
                {
                  "$ref": "#/components/schemas/BuiltinWebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "모델이 도구를 호출할지 또는 특정 함수를 강제로 호출할지 제어합니다."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "컨텍스트 캐시 쓰기 옵션입니다. 생략하면 5m 캐시에 자동으로 기록합니다. 쓰기와 읽기는 별도로 과금됩니다.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "캐시 쓰기 유효 기간입니다. 1h와 5m는 각 쓰기 단가를 적용합니다. 실제 적중 및 TTL 분류는 청구 내역을 따릅니다."
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "출력 형식을 제어합니다. 기본값 {\"type\":\"text\"}는 일반 텍스트입니다. {\"type\":\"json_object\"}는 JSON 모드로 유효한 JSON 객체를 보장하며 프롬프트에도 JSON 출력과 형식을 지정해야 합니다. {\"type\":\"json_schema\"}는 지정한 JSON Schema를 따르는 Structured Output을 활성화합니다(권장, json_schema도 지정). 검증 문제는 walle GitHub Issues (https://github.com/MoonshotAI/walle/issues)에 제보할 수 있습니다.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "출력 형식입니다. text: 기본 일반 텍스트. json_object: 유효한 JSON 객체. json_schema: 지정한 스키마를 따르는 출력(권장, json_schema도 지정)."
              },
              "json_schema": {
                "type": "object",
                "description": "type이 json_schema일 때 출력이 따라야 하는 JSON Schema입니다.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "식별에 사용하는 스키마 이름입니다."
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "스키마를 엄격히 적용할지 여부입니다. 기본값은 true입니다. true이면 MFJS를 준수해야 하며 위반 시 오류나 경고가 반환됩니다. false이면 유효한 JSON 객체만 보장하고 내부 구조는 강제하지 않습니다."
                  },
                  "schema": {
                    "type": "object",
                    "description": "출력 구조를 정의하는 JSON Schema입니다. MFJS(Moonshot Flavored JSON Schema)를 준수해야 합니다. walle CLI로 확인할 수 있습니다: go install github.com/moonshotai/walle/cmd/walle@latest && walle -schema '<schema>' -level strict",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "prompt_cache_key": {
            "type": "string",
            "default": null,
            "description": "유사 요청을 캐싱해 적중률을 높이는 키입니다. 코딩 에이전트에서는 보통 세션 ID 또는 작업 ID를 사용하며 세션을 재개해도 같은 값을 유지합니다. Kimi Code Plan에서는 적중률 향상을 위해 필수이며 다른 멀티턴 에이전트에도 권장합니다."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "이전 클라이언트용 출력 제한 별칭입니다. 새 요청에는 max_completion_tokens를 사용하고 둘을 동시에 지정하지 마세요."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "메시지 역할: system, user, assistant 또는 tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "메시지 내용입니다. 순수 텍스트는 문자열로 전달하며, 멀티모달 입력은 콘텐츠 블록 배열(텍스트 + 이미지 + 비디오)로 전달합니다. 도구 호출 시 assistant content는 null일 수 있습니다.",
            "oneOf": [
              {
                "type": "string",
                "description": "순수 텍스트 메시지 내용입니다."
              },
              {
                "type": "array",
                "description": "멀티모달 콘텐츠 블록 배열입니다.",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "assistant의 추론 내용입니다. 여러 턴 대화에서는 전체 assistant 메시지의 일부로 변경하지 말고 다시 전달하세요."
          },
          "tool_calls": {
            "type": "array",
            "description": "assistant가 반환한 도구 호출입니다. 이후 도구 사용 턴에서 변경하지 말고 다시 전달하세요.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "`role=tool`일 때 대응하는 도구 호출 ID입니다."
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "멀티모달 콘텐츠 블록입니다. `type`이 사용할 필드를 결정합니다.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "콘텐츠 블록 유형입니다."
          },
          "text": {
            "type": "string",
            "description": "`type=text`일 때의 텍스트 내용입니다."
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "`type=image_url`일 때의 이미지입니다. URL 문자열을 직접 전달할 수도 있습니다.",
            "properties": {
              "url": {
                "type": "string",
                "description": "이미지 주소입니다. Base64 Data URL(`data:image/png;base64,...`) 또는 Kimi 플랫폼 파일 참조(`ms://<file_id>`)를 지원합니다."
              }
            }
          },
          "video_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "`type=video_url`일 때의 비디오입니다. URL 문자열을 직접 전달할 수도 있습니다.",
            "properties": {
              "url": {
                "type": "string",
                "description": "비디오 주소입니다. Base64 Data URL(`data:video/mp4;base64,...`) 또는 Kimi 플랫폼 파일 참조(`ms://<file_id>`)를 지원합니다."
              }
            }
          }
        }
      },
      "StreamOptions": {
        "type": "object",
        "properties": {
          "include_usage": {
            "type": "boolean",
            "default": false,
            "description": "true이면 `[DONE]` 전에 최종 usage 청크를 호출자에게 반환합니다. 이 옵션은 해당 청크의 표시 여부만 제어하며 과금 tokens나 가격을 늘리지 않습니다."
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "웹 검색 도구. 게이트웨이가 Moonshot `$web_search`로 변환하며, 호출당 과금"
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "도구 유형입니다. 현재 function으로 고정됩니다.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "모델이 사용할 수 있는 함수 정의입니다.",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "함수 이름입니다."
              },
              "description": {
                "type": "string",
                "description": "모델이 함수를 언제 호출할지 판단하는 데 도움이 되는 설명입니다."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "JSON Schema 형식의 함수 매개변수 정의입니다."
              },
              "strict": {
                "type": "boolean",
                "description": "함수 인수가 parameters의 JSON Schema를 엄격히 따라야 하는지 여부입니다."
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "이름으로 지정한 도구 선택 유형입니다. function으로 고정됩니다.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "모델이 반드시 호출해야 하는 함수입니다.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "모델이 반드시 호출해야 하는 함수 이름입니다."
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "이후 tool 메시지를 tool_call_id로 연결하는 도구 호출 ID입니다."
          },
          "type": {
            "type": "string",
            "description": "도구 호출 유형: 클라이언트 함수는 `function`, 내장 `$web_search` 도구는 `builtin_function`입니다.",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "모델이 요청한 함수와 인수입니다.",
            "properties": {
              "name": {
                "type": "string",
                "description": "함수 이름입니다."
              },
              "arguments": {
                "type": "string",
                "description": "JSON 문자열로 인코딩된 함수 인수입니다."
              }
            }
          }
        },
        "description": "도구 호출 기록을 완전히 보존하세요. 내장 검색 응답의 type은 builtin_function일 수 있으며 서버는 기록 재전송 시 이 형식을 처리합니다. ID, arguments, 추론 내용을 모두 유지하세요."
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "일반 입력, 캐시 읽기, 캐시 쓰기를 포함한 총 입력 토큰 수입니다. 일반 입력 = prompt_tokens - cached_tokens - cache_write_tokens."
          },
          "completion_tokens": {
            "type": "integer",
            "description": "추론 tokens를 포함합니다."
          },
          "total_tokens": {
            "type": "integer",
            "description": "입력과 출력 tokens의 합계입니다."
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "캐시에서 제공된 입력 tokens입니다."
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "5m / 1h 쓰기를 포함한 이번 캐시 쓰기 총 토큰 수입니다. 일반 입력으로 중복 과금하지 않습니다."
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "추론 tokens이며 completion_tokens에 이미 포함되어 있습니다."
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "BuiltinWebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "$web_search"
                ]
              }
            }
          }
        }
      }
