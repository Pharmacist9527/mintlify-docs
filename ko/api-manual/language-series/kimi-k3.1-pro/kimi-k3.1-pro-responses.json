{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - Responses API",
    "version": "1.0.0",
    "description": "OpenAI Responses로 Kimi K3.1 Pro / Highspeed를 호출합니다. 모델 ID는 `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`입니다. 두 모델은 1,048,576 tokens 컨텍스트, 멀티턴 대화, 스트리밍, 도구 호출, 웹 검색, 구조화 출력 및 컨텍스트 캐싱을 지원합니다.\n\n추론은 항상 활성화됩니다. `reasoning.effort`는 `low` / `high` / `max`를 지원하며 기본값은 `max`입니다. 멀티턴에서는 추론 및 도구 호출 기록을 완전히 보존하세요."
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "프로덕션 (권장)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "대체 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "tags": [
          "Responses"
        ],
        "summary": "Kimi K3.1 Pro / Highspeed Responses API",
        "description": "reasoning.effort로 추론 강도, prompt_cache_options로 캐시를 설정합니다. 검색은 web_search_call 출력 항목으로 반환됩니다. 스트리밍에서는 response.completed / response.incomplete / response.failed를 처리하세요. 출력 한도에 도달하면 incomplete가 됩니다. 멀티턴 요청에는 추론, 도구 호출 및 결과를 포함한 전체 output 기록을 전달하세요.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Highspeed 최소 요청",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "Responses SSE 스트리밍",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "1h 캐시 자동 쓰기",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "서버 측 웹 검색",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Use web search to find the official Kimi homepage URL.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "엄격한 JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Return a JSON object with result equal to OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "text": {
                      "format": {
                        "type": "json_schema",
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "응답 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesStreamEvent"
                }
              }
            }
          },
          "400": {
            "description": "잘못된 요청: 유효하지 않은 매개변수",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증 실패: API 키가 유효하지 않거나 누락됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "이 리소스에 대한 접근 권한이 없습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "요청 한도 초과 또는 할당량 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "createResponseKimiK31Pro"
      }
    }
  },
  "components": {
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "`kimi-k3.1-pro` 또는 `kimi-k3.1-pro-highspeed`를 사용하세요. Highspeed는 생성 속도가 더 빠릅니다."
          },
          "input": {
            "description": "이번 요청의 입력입니다. 문자열은 user 메시지 하나와 같습니다. 배열은 유형이 있는 항목을 순서대로 담으며 대화 기록, 도구 호출 및 결과를 포함할 수 있습니다.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResponsesInputItem"
                }
              }
            ]
          },
          "instructions": {
            "type": "string",
            "description": "다른 지시보다 먼저 적용되는 최상위 시스템 지시입니다."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "true이면 SSE 이벤트 스트림으로 응답합니다."
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "추론과 최종 답변을 포함한 최대 생성 토큰 수입니다. 기본값은 131072, 최대값은 1048576이며 남은 컨텍스트의 제한도 받습니다.",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072
          },
          "reasoning": {
            "type": "object",
            "description": "추론 관련 설정입니다.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "추론 강도입니다. low / high / max를 권장하며 기본값은 max입니다. 추론은 항상 활성화됩니다. 호환용 값 medium은 high, xhigh는 max, minimal / none은 low로 처리됩니다. none도 추론을 끄지 않습니다. 강도가 높으면 보통 추론 토큰과 지연 시간이 늘어납니다. 추론 토큰은 출력에 포함됩니다."
              }
            }
          },
          "text": {
            "type": "object",
            "description": "출력 텍스트 설정입니다.",
            "properties": {
              "format": {
                "type": "object",
                "required": [
                  "type",
                  "schema"
                ],
                "description": "JSON Schema로 출력 구조를 제한합니다.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "스키마 이름으로 기본값은 `output`입니다."
                  },
                  "schema": {
                    "type": "object",
                    "description": "출력 구조를 정의하는 JSON Schema입니다."
                  },
                  "strict": {
                    "type": "boolean",
                    "description": "스키마를 엄격히 적용할지 여부입니다."
                  }
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "모델이 호출할 수 있는 도구입니다.",
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ResponsesToolChoice"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "web_search_call.results",
                "web_search_call.action.sources"
              ]
            },
            "description": "추가로 반환할 필드이며 `web_search` 도구에만 적용됩니다. `web_search_call.action.sources`는 검색된 웹 출처를, `web_search_call.results`는 이미지 검색 결과를 반환합니다."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "컨텍스트 캐시 쓰기 옵션입니다. 생략하면 5m 캐시에 자동으로 기록합니다. 쓰기와 읽기는 별도로 과금됩니다.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "캐시 유효 기간은 5m 또는 1h이며 기본값은 5m입니다."
              }
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "모델 응답 하나입니다.",
        "properties": {
          "id": {
            "type": "string",
            "description": "응답의 고유 식별자입니다.",
            "example": "resp_68f0c1c2d3e4f5a6b7c8d9e0"
          },
          "object": {
            "type": "string",
            "enum": [
              "response"
            ]
          },
          "created_at": {
            "type": "integer",
            "description": "응답 생성 시점의 Unix 타임스탬프입니다."
          },
          "completed_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "응답 종료 시점의 Unix 타임스탬프입니다. `status`가 `completed` 또는 `incomplete`이면 제공되며 `in_progress` 또는 `failed`이면 `null`입니다."
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "incomplete",
              "failed"
            ],
            "description": "응답 상태입니다. 스트리밍 초기 스냅샷의 상태는 `in_progress`입니다."
          },
          "model": {
            "type": "string",
            "description": "이번 응답을 생성한 모델입니다."
          },
          "output": {
            "type": "array",
            "description": "출력 항목 배열로 web_search_call(있는 경우), reasoning, message, 도구 호출 순서입니다.",
            "items": {
              "$ref": "#/components/schemas/ResponsesOutputItem"
            }
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "`status`가 `incomplete`일 때 제공되는 이유입니다.",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "max_output_tokens",
                  "content_filter"
                ]
              }
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "`status`가 `failed`일 때 제공되는 오류 정보입니다.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": [
              "object",
              "null"
            ]
          },
          "text": {
            "type": [
              "object",
              "null"
            ]
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesToolChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ]
          },
          "parallel_tool_calls": {
            "type": "boolean"
          },
          "service_tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "store": {
            "type": "boolean",
            "description": "항상 `false`입니다."
          },
          "background": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "항상 `false`입니다."
          },
          "previous_response_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "항상 `null`입니다."
          },
          "conversation": {
            "type": [
              "object",
              "null"
            ],
            "description": "항상 `null`입니다."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "서버가 실제로 적용한 컨텍스트 캐시 쓰기 옵션입니다. prompt_cache_options를 생략한 경우 여기서 반환되는 mode와 ttl을 기준으로 합니다.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "description": "실제로 적용된 쓰기 모드입니다."
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "description": "실제로 적용된 캐시 유효 기간입니다."
              }
            }
          }
        }
      },
      "ResponsesStreamEvent": {
        "type": "object",
        "description": "`stream: true`일 때 반환되는 단일 SSE 이벤트입니다. 프레임은 `event: <type>`과 `data: <json>` 형식이며 나머지 필드는 `type`에 따라 달라집니다.",
        "required": [
          "type",
          "sequence_number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "response.created",
              "response.in_progress",
              "response.output_item.added",
              "response.output_item.done",
              "response.content_part.added",
              "response.content_part.done",
              "response.output_text.delta",
              "response.output_text.done",
              "response.reasoning_summary_part.added",
              "response.reasoning_summary_part.done",
              "response.reasoning_summary_text.delta",
              "response.reasoning_summary_text.done",
              "response.function_call_arguments.delta",
              "response.function_call_arguments.done",
              "response.custom_tool_call_input.delta",
              "response.custom_tool_call_input.done",
              "response.web_search_call.in_progress",
              "response.web_search_call.searching",
              "response.web_search_call.completed",
              "response.completed",
              "response.incomplete",
              "response.failed",
              "error"
            ]
          },
          "sequence_number": {
            "type": "integer",
            "description": "0부터 단조 증가하는 이벤트 순번입니다."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "오류 원인을 설명하는 메시지입니다."
              },
              "type": {
                "type": "string",
                "description": "오류 유형"
              },
              "code": {
                "type": "string",
                "description": "오류 코드"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ResponsesInputItem": {
        "description": "input 배열의 요소로 `type`으로 구분합니다. `type` 생략 시 `message`로 처리합니다.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesAdditionalToolsItem"
          }
        ]
      },
      "ResponsesTool": {
        "description": "`type`으로 구분하는 도구 정의입니다. `function`, `custom`(`apply_patch`만), `namespace`, `web_search`를 지원하며 다른 유형은 지원하지 않습니다.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesFunctionTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesNamespaceTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchTool"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "function": "#/components/schemas/ResponsesFunctionTool",
            "custom": "#/components/schemas/ResponsesCustomTool",
            "namespace": "#/components/schemas/ResponsesNamespaceTool",
            "web_search": "#/components/schemas/ResponsesWebSearchTool"
          }
        }
      },
      "ResponsesToolChoice": {
        "type": "string",
        "enum": [
          "auto"
        ],
        "description": "도구 호출을 제어합니다. `auto`이면 모델이 도구 호출 여부를 결정합니다."
      },
      "ResponsesOutputItem": {
        "description": "`type`으로 구분하는 output 배열의 요소입니다.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesOutputReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputWebSearchCallItem"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "reasoning": "#/components/schemas/ResponsesOutputReasoningItem",
            "message": "#/components/schemas/ResponsesOutputMessageItem",
            "function_call": "#/components/schemas/ResponsesOutputFunctionCallItem",
            "custom_tool_call": "#/components/schemas/ResponsesOutputCustomToolCallItem",
