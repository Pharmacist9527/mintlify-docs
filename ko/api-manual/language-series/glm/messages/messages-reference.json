            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "auto",
                  "none"
                ],
                "description": "- `auto`: 모델이 도구 호출 여부를 자동으로 결정\n- `none`: 도구 호출 금지"
              }
