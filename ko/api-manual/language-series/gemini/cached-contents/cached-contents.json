              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "다음 페이지가 있으면 반환. 다음 요청의 `pageToken`에 그대로 전달"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Gemini 네이티브 오류 형식. `error.details[0].reason`이 구체적인 사유 코드이며 캐시 생성 페이지의 오류 표 참고",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP 상태 코드"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "상태 값(INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE 등)"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
