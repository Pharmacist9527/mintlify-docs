          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "마지막 수정 시각(UTC)"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "만료 시각(UTC). 만료 후 자동 삭제"
          },
          "usageMetadata": {
