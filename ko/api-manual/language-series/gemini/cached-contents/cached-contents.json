  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## 모든 엔드포인트는 Bearer Token 인증이 필요합니다\n\n**API Key 발급:**\n\n[API Key 관리](https://evolink.ai/dashboard/keys)에서 발급받으세요.\n\n**다음 요청 헤더 추가:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\nGemini 네이티브 형식인 `x-goog-api-key: YOUR_API_KEY` 헤더 또는 `?key=YOUR_API_KEY` URL 매개변수도 사용할 수 있습니다."
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "콘텐츠 부분: 텍스트, 인라인 데이터(base64), 파일 참조 중 하나",
        "properties": {
          "text": {
            "type": "string",
            "description": "텍스트"
          },
          "inlineData": {
            "type": "object",
            "description": "인라인 바이너리 데이터(이미지, 오디오, PDF 등)",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "base64로 인코딩된 데이터"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "파일 참조",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "공개 접근 가능한 URL"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "역할. 시스템 지침에는 필요 없음"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "도구 선언. 아래 세 종류만 허용하며 다른 도구는 거부됩니다",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "웹 검색. `{}` 지정"
          },
          "codeExecution": {
            "type": "object",
            "description": "코드 실행. `{}` 지정"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "함수 선언(OpenAPI 하위 집합의 매개변수 구조)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "모델. `models/gemini-3.8-flash`와 `gemini-3.8-flash` 모두 허용. 지원 모델: `gemini-3.8-flash`, `gemini-3.7-flash`, `gemini-3.6-flash`, `gemini-3.5-flash`, `gemini-3.5-flash-lite`, `gemini-3-flash-preview`, `gemini-3.1-flash-lite-preview`, `gemini-3.1-pro-preview`, `gemini-3.1-pro-preview-customtools`, `gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "캐시할 대화 내용. 배열이어야 하며 참조 시 대화 접두사가 됩니다. `contents`, `systemInstruction`, `tools` 중 하나 이상 필요",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "시스템 지침. 캐시한 뒤에는 이를 참조하는 생성 요청에 systemInstruction을 넣을 수 없습니다"
          },
          "tools": {
            "type": "array",
            "description": "도구 선언. 캐시한 뒤에는 이를 참조하는 생성 요청에 tools를 넣을 수 없습니다",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "도구 호출 설정(functionCallingConfig 등). 캐시한 뒤에는 이를 참조하는 생성 요청에 toolConfig를 넣을 수 없습니다"
          },
          "ttl": {
            "type": "string",
            "description": "유효 기간(예: `\"3600s\"`). 최소 `60s`, 최대 `604800s`(168시간). expireTime과 상호 배타적이며 동시 지정은 400. 둘 다 생략하면 `3600s`",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "절대 만료 시각(RFC 3339, UTC). ttl과 상호 배타적이며 동시 지정은 400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "관리용 이름. 최대 255자이며 요금에 영향 없음",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "ttl 또는 expireTime 중 정확히 하나 필수. 다른 필드는 400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "지금부터의 새 유효 기간(예: `\"7200s\"`). 최소 `60s`, 최대 `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "새 절대 만료 시각(RFC 3339, UTC)",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "`cachedContents/<id>` 형식의 이름. 생성 요청의 `cachedContent`에 지정하며 `<id>`는 생성 요청 ID이기도 합니다",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
