      "patch": {
        "summary": "유효 기간 연장 또는 단축",
        "operationId": "geminiUpdateCachedContent",
        "tags": [
          "명시적 컨텍스트 캐싱"
        ],
        "description": "내용은 바꿀 수 없으며 유효 기간만 변경합니다. `ttl`(**지금부터**의 새 기간, 예: `\"7200s\"`) 또는 `expireTime`(새 절대 만료 시각) 중 하나를 지정합니다.\n\n- 새 만료 시각은 지금부터 최소 60초, 최대 168시간 후여야 합니다.\n- `ttl` 또는 `expireTime`만 허용하며 둘 다 보내거나 다른 필드를 보내면 400입니다.\n- **연장**: 추가 기간의 저장 요금을 초 단위로 청구하며 1초 미만은 1초로 계산합니다. **단축**: 이미 청구한 저장 요금은 환불하지 않습니다.\n- 유료 작업입니다. Key에 모델 권한이 필요하며 현재 사용자 그룹의 단가를 적용합니다. 잔액 부족은 402입니다.\n- 같은 연장 요청을 재시도할 때 `Idempotency-Key` 헤더로 중복 과금을 방지할 수 있습니다.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "캐시 ID: 생성 시 반환된 `name`에서 `cachedContents/`를 뺀 부분입니다. `cachedContents/20261103012026348092000s1oTuB96`이면 `20261103012026348092000s1oTuB96`을 지정합니다.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCachedContentRequest"
              },
              "examples": {
                "extend_by_ttl": {
                  "summary": "지금부터 2시간 더 보관",
                  "value": {
                    "ttl": "7200s"
                  }
                },
                "set_expire_time": {
                  "summary": "절대 만료 시각 지정",
                  "value": {
                    "expireTime": "2026-11-03T06:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "갱신된 캐시 메타데이터. `expireTime`은 새 만료 시각입니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CachedContent"
                },
                "example": {
                  "name": "cachedContents/20261103012026348092000s1oTuB96",
                  "model": "models/gemini-3.8-flash",
                  "displayName": "product-manual-v3",
                  "createTime": "2026-11-03T01:20:27.311Z",
                  "updateTime": "2026-11-03T01:35:10.020Z",
                  "expireTime": "2026-11-03T03:35:10.000Z",
                  "usageMetadata": {
                    "totalTokenCount": 7525
                  }
                }
              }
            }
          },
          "400": {
            "description": "ttl / expireTime 누락 또는 동시 지정, 다른 필드 전송, 만료 시각 범위 초과, 처리 중 만료(CACHE_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "new expiry must be at least 60s in the future",
                    "status": "INVALID_ARGUMENT",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INVALID_ARGUMENT",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "API Key가 없거나 유효하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "402": {
            "description": "추가 저장 요금을 지불할 잔액 부족",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "insufficient quota for cache storage extension",
                    "status": "RESOURCE_EXHAUSTED",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INSUFFICIENT_QUOTA",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "Key에 모델 권한이 없거나 출발지 IP가 허용 목록에 없거나 Key의 사용자 그룹을 더 이상 사용할 수 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "캐시가 없거나 만료·삭제되었거나 다른 계정 소유임, 또는 명시적 캐시 기능이 활성화되지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "요청 빈도 제한 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "502": {
            "description": "서비스를 일시적으로 사용할 수 없습니다. 이 요청은 과금되지 않으며 나중에 다시 시도하세요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "failed to reach upstream for cachedContents",
                    "status": "INTERNAL",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "UPSTREAM_ERROR",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "503": {
            "description": "캐시를 일시적으로 사용할 수 없습니다. 나중에 다시 시도하세요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "the channel holding this cached content is unavailable and rebuilding on another channel failed; please retry later",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_CHANNEL_UNAVAILABLE",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
