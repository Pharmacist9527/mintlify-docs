{
  "openapi": "3.1.0",
  "info": {
    "title": "MAGI-2 Reference-to-Video API",
    "description": "MAGI-2 멀티모달 참조 비디오 API, 이미지, 비디오, 오디오 참조 소재를 혼합하여 생성을 지원합니다",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "프로덕션 환경"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "MAGI-2 Reference-to-Video 멀티모달 참조 비디오",
        "description": "- 참조 이미지(0~10장) + 참조 비디오(0~5개) + 참조 오디오(0~5개) + 텍스트 프롬프트로 비디오를 생성합니다\n- 세 가지 참조 소재 중 최소 하나가 필요하며, 자유롭게 조합할 수 있습니다\n- 비동기 처리 모드로, 반환된 작업 ID를 사용하여 [조회하세요](/ko/api-manual/task-management/get-task-detail)\n- 생성된 비디오 링크는 7일 동안 유효하며, 가능한 빨리 저장하세요",
        "operationId": "createMagi2ReferenceToVideo",
        "tags": [
          "비디오 생성"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "multimodal": {
                  "summary": "멀티모달 참조 (이미지 + 비디오 + 오디오)",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "참조 비디오의 카메라 워크와 리듬을 따라 이미지 속 캐릭터가 도시의 옥상에서 춤추게 하고, 참조 오디오의 비트에 맞춘다",
                    "image_urls": [
                      "https://example.com/character.jpg"
                    ],
                    "video_urls": [
                      "https://example.com/reference.mp4"
                    ],
                    "audio_urls": [
                      "https://example.com/bgm.mp3"
                    ],
                    "duration": 10,
                    "quality": "1080p",
                    "aspect_ratio": "16:9",
                    "generate_audio": true
                  }
                },
                "image_reference": {
                  "summary": "다중 이미지 참조",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "이미지 속 두 캐릭터가 카페에 마주 앉아 조용히 대화를 나눈다",
                    "image_urls": [
                      "https://example.com/ref1.jpg",
                      "https://example.com/ref2.jpg"
                    ],
                    "duration": 6,
                    "aspect_ratio": "4:3"
                  }
                },
                "audio_reference": {
                  "summary": "오디오 참조",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "뉴스 앵커가 카메라를 보며 아침 뉴스를 전하고, 입 모양이 오디오와 동기화된다",
                    "audio_urls": [
                      "https://example.com/voice.wav"
                    ],
                    "duration": 8,
                    "aspect_ratio": "16:9"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "비디오 생성 작업이 성공적으로 생성되었습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 파라미터 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "미인증, Token이 유효하지 않거나 만료됨",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "할당량 부족, 충전 필요",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "접근 권한 없음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: magi-2-reference-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "요청 빈도 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "비디오 생성 모델 이름",
            "enum": [
              "magi-2-reference-to-video"
            ],
            "default": "magi-2-reference-to-video",
            "example": "magi-2-reference-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "생성할 비디오를 설명하는 텍스트 프롬프트. 중국어와 영어를 지원합니다. 프롬프트 최대 길이: 15000자",
            "example": "참조 비디오의 카메라 워크와 리듬을 따라 이미지 속 캐릭터가 도시의 옥상에서 춤추게 하고, 참조 오디오의 비트에 맞춘다"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 10,
            "example": [
              "https://example.com/ref1.jpg"
            ],
            "description": "참조 이미지 URL 배열, **0~10장**\n\n**역할 설명:**\n\n| 미디어 유형 | 역할 | 일반적인 용도 |\n|---------|------|----------|\n| 이미지 | `reference_image` | 캐릭터 참조, 스타일 참조, 제품 이미지 |\n\n**이미지 요구사항:**\n- 단일 파일 크기: `30MB` 이하\n- HTTPS URL만 지원하며, 이미지 URL은 서버에서 직접 접근 가능해야 합니다\n\n**주의:** `image_urls`, `video_urls`, `audio_urls` 중 최소 하나를 전달해야 합니다"
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 5,
            "example": [
              "https://example.com/reference.mp4"
            ],
            "description": "참조 비디오 URL 배열, **0~5개**\n\n**역할 설명:**\n\n| 미디어 유형 | 역할 | 일반적인 용도 |\n|---------|------|----------|\n| 비디오 | `reference_video` | 카메라 워크 참조, 동작 참조, 영상 스타일 참조 |\n\n**비디오 요구사항:**\n- 지원 형식: `.mp4`, `.mov`\n- 단일 비디오 길이: `2` ~ `30`초, 최대 5개, 모든 비디오 총 길이 <= `30`초\n- 단일 파일 크기: `200MB` 이하\n- HTTPS URL만 지원하며, 비디오 URL은 서버에서 직접 접근 가능해야 합니다\n\n**주의:** `image_urls`, `video_urls`, `audio_urls` 중 최소 하나를 전달해야 합니다"
          },
          "audio_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 5,
            "example": [
              "https://example.com/bgm.mp3"
            ],
            "description": "참조 오디오 URL 배열, **0~5개**\n\n**역할 설명:**\n\n| 미디어 유형 | 역할 | 일반적인 용도 |\n|---------|------|----------|\n| 오디오 | `reference_audio` | 배경 음악, 효과음, 음성/대사 참조 |\n\n**오디오 요구사항:**\n- 지원 형식: `.wav`, `.mp3`\n- 단일 오디오 길이: `2` ~ `30`초, 최대 5개, 모든 오디오 총 길이 <= `30`초\n- 단일 파일 크기: `15MB` 이하\n- HTTPS URL만 지원하며, 오디오 URL은 서버에서 직접 접근 가능해야 합니다\n\n**주의:** `image_urls`, `video_urls`, `audio_urls` 중 최소 하나를 전달해야 합니다"
          },
          "duration": {
            "type": "integer",
            "description": "출력 비디오 길이(초), 기본값은 `5`초\n\n**설명:**\n- `4`~`30`초 사이의 임의의 정수값을 지원합니다\n- 재생 시간은 과금에 직접적으로 영향을 미칩니다",
            "default": 5,
            "minimum": 4,
            "maximum": 30,
            "example": 8
          },
          "quality": {
            "type": "string",
            "description": "비디오 해상도, `1080p`만 지원합니다",
            "enum": [
              "1080p"
            ],
            "default": "1080p",
            "example": "1080p"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "비디오 화면 비율, 기본값은 `16:9`\n\n**선택 가능한 값:**\n- `16:9`(가로), `9:16`(세로), `1:1`(정사각형), `4:3`, `3:4`, `21:9`(울트라와이드)",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "21:9"
            ],
            "default": "16:9",
            "example": "16:9"
          },
          "generate_audio": {
            "type": "boolean",
            "description": "동기화된 오디오 생성 여부, 기본값은 `true`\n\n**선택 가능한 값:**\n- `true`: 비디오에 동기화된 오디오가 포함되며, 추가 요금이 없습니다\n- `false`: 무음 비디오 출력",
            "default": true,
            "example": true
          },
          "callback_url": {
            "type": "string",
            "description": "작업 완료 후 HTTPS 콜백 주소\n\n**콜백 시점:**\n- 작업 완료(completed), 실패(failed) 또는 취소(cancelled) 시 트리거\n- 과금 확인 완료 후 전송\n\n**보안 제한:**\n- HTTPS 프로토콜만 지원\n- 내부 네트워크 IP 주소로의 콜백 금지(127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x 등)\n- URL 길이는 `2048`자를 초과할 수 없습니다\n\n**콜백 메커니즘:**\n- 타임아웃: `10`초\n- 실패 시 최대 `3`회 재시도(실패 후 각각 `1`/`2`/`4`초 후 재시도)\n- 콜백 응답 본문 형식은 작업 조회 API 반환 형식과 동일\n- 2xx 상태 코드를 성공으로 간주하며, 다른 상태 코드는 재시도를 트리거합니다",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "작업 생성 타임스탬프",
            "example": 1761313744
          },
          "id": {
            "type": "string",
            "description": "작업 ID",
            "example": "task-unified-1774857405-abc123"
          },
          "model": {
            "type": "string",
            "description": "실제 사용된 모델 이름",
            "example": "magi-2-reference-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "작업의 구체적 유형"
          },
          "progress": {
            "type": "integer",
            "description": "작업 진행률 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "작업 상태",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "비디오 작업 상세 정보"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "작업의 출력 유형",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "사용량 및 과금 정보"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "작업 취소 가능 여부입니다. MAGI-2는 사용자의 작업 취소를 지원하지 않으므로 항상 `false`를 반환합니다.",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "예상 완료 시간(초)",
            "minimum": 0,
            "example": 165
          },
          "video_duration": {
            "type": "integer",
            "description": "비디오 길이(초)",
            "example": 8
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "사용량 및 과금 정보",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "과금 규칙",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "예상 소비 크레딧 수",
            "minimum": 0,
            "example": 50
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "오류 코드 식별자"
              },
              "message": {
                "type": "string",
                "description": "오류 설명 정보"
              },
              "type": {
                "type": "string",
                "description": "오류 유형"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##모든 API는 Bearer Token 인증이 필요합니다##\n\n**API Key 얻기:**\n\n[API Key 관리 페이지](https://evolink.ai/dashboard/keys)에서 API Key를 받으세요\n\n**요청 헤더에 다음을 추가하세요:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "비디오 생성",
      "description": "AI 비디오 생성 관련 API"
    }
  ]
}
