{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniHuman 2.0 디지털 휴먼 비디오 생성 API",
    "description": "OmniHuman 2.0 모델을 사용하여 오디오 기반 디지털 휴먼 비디오 생성 작업 생성",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "프로덕션 환경"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "OmniHuman 2.0 디지털 휴먼 비디오 생성",
        "description": "- OmniHuman 2.0 (omnihuman-2.0) 모델은 인물 이미지와 오디오로 입 모양과 몸동작이 오디오를 따라가는 디지털 휴먼 비디오를 생성합니다\n- 비동기 처리 모드이며, 반환된 작업 ID를 사용하여 [조회](/ko/api-manual/task-management/get-task-detail)\n- 생성된 비디오 링크는 24시간 동안 유효하며, 즉시 저장하시기 바랍니다\n\n**참고:**\n- 오디오 길이 제한: 4–300초\n- 지원 오디오 형식: MP3, WAV\n- 요금은 오디오 길이를 기준으로 합니다(`0.1`초 단위 올림)",
        "operationId": "createOmniHuman20VideoGeneration",
        "tags": [
          "디지털 휴먼 비디오 생성"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic_generation": {
                  "summary": "기본 디지털 휴먼 생성",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ]
                  }
                },
                "with_prompt": {
                  "summary": "프롬프트 포함",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ],
                    "prompt": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "디지털 휴먼 비디오 생성 작업이 성공적으로 생성되었습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "요청 매개변수가 잘못되었습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "지원하지 않는 매개변수",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "mask_url is not supported by omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_many_images": {
                    "summary": "이미지가 1장 초과",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "omnihuman-2.0 accepts exactly 1 image, got 2",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_audio_url": {
                    "summary": "오디오 URL 누락",
                    "value": {
                      "error": {
                        "code": "missing_audio_url",
                        "message": "audio_url is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_image_urls": {
                    "summary": "이미지 URL 누락",
                    "value": {
                      "error": {
                        "code": "missing_image_urls",
                        "message": "image_urls is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio": {
                    "summary": "오디오를 다운로드하거나 분석할 수 없음",
                    "value": {
                      "error": {
                        "code": "invalid_audio",
                        "message": "failed to read audio_url: download audio failed: HTTP 404",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio_duration": {
                    "summary": "오디오 길이가 범위를 벗어남",
                    "value": {
                      "error": {
                        "code": "invalid_audio_duration",
                        "message": "audio duration 2.50s is out of range [4, 300] for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_media_url": {
                    "summary": "미디어 URL이 로컬 또는 사설 네트워크 주소를 가리킴",
                    "value": {
                      "error": {
                        "code": "invalid_media_url",
                        "message": "invalid parameter \"audio_url\": points to a local or private network address; provide a publicly accessible URL",
                        "type": "invalid_request_error",
                        "param": "audio_url"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않았거나 토큰이 유효하지 않거나 만료되었습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "할당량이 부족합니다. 충전이 필요합니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "접근이 거부되었습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: omnihuman-2.0",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "요청 한도를 초과했습니다",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "audio_url",
          "image_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "디지털 휴먼 비디오 생성 모델 이름\n\n**참고:**\n- 이 모델은 OmniHuman-1.5의 `mask_url`, `subject_check`, `auto_mask`, `pe_fast_mode`, `audio_urls` 매개변수를 지원하지 않습니다. 활성화하거나 비어 있지 않은 값을 전달하면 400 매개변수 오류가 반환됩니다\n- 모든 매개변수는 요청 본문의 최상위에 작성하세요. 비어 있지 않은 `model_params`를 전달하면 400 매개변수 오류가 반환됩니다",
            "enum": [
              "omnihuman-2.0"
            ],
            "default": "omnihuman-2.0",
            "example": "omnihuman-2.0"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "description": "립싱크 및 신체 동작을 구동하기 위한 오디오 URL\n\n**참고:**\n- 오디오 길이: `4`–`300`초(양 끝 포함). 범위를 벗어나면 400 매개변수 오류가 반환됩니다\n- 지원 형식: `.mp3`, `.wav`\n- 파일 크기: `15MB` 미만\n- 오디오 URL은 서버에서 직접 접근 가능해야 합니다. 다운로드할 수 없거나 지원하지 않는 형식이거나 크기 제한을 초과하면 400 매개변수 오류가 반환됩니다\n- 요금은 오디오 길이를 기준으로 합니다(`0.1`초 단위 올림)",
            "example": "https://your-cdn.com/omnihuman/speech.mp3"
          },
          "image_urls": {
            "type": "array",
            "description": "애니메이션할 인물이 포함된 참조 이미지 URL 목록\n\n**참고:**\n- 요청당 이미지 수: `1`. `1`장을 초과하면 400 매개변수 오류가 반환됩니다\n- 지원 파일 형식: `.jpg`, `.jpeg`, `.png`, `.webp`, `.bmp`, `.tiff`, `.gif`, `.heic`, `.heif`\n- 이미지 크기: `30MB` 미만\n- 종횡비(너비/높이): `0.4`–`2.5`\n- 너비와 높이: `300`–`6000` px\n- 이미지 URL은 서버에서 직접 접근 가능해야 합니다",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://your-cdn.com/omnihuman/portrait.jpg"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "장면, 동작, 카메라 움직임을 제어하는 선택적 텍스트 프롬프트, 중국어, 영어, 일본어, 한국어, 스페인어(멕시코) 및 인도네시아어만 지원합니다",
            "example": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
          },
          "callback_url": {
            "type": "string",
            "description": "작업 완료 후 HTTPS 콜백 주소\n\n**콜백 타이밍:**\n- 작업이 완료 또는 실패할 때 트리거됨 (OmniHuman 2.0 작업은 취소할 수 없음)\n- 과금 확인 완료 후 전송\n\n**보안 제한:**\n- HTTPS 프로토콜만 지원\n- 내부 IP 주소로의 콜백 금지 (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x 등)\n- URL 길이는 `2048`자를 초과할 수 없음\n\n**콜백 메커니즘:**\n- 타임아웃: `10`초\n- 실패 시 최대 `3`회 재시도 (`1`초/`2`초/`4`초 후 재시도)\n- 콜백 응답 본문 형식은 작업 조회 API 응답 형식과 동일\n- 콜백 주소가 2xx 상태 코드를 반환하면 성공으로 간주, 다른 상태 코드는 재시도를 트리거",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "작업 생성 타임스탬프",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "작업 ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "실제 사용된 모델 이름",
            "example": "omnihuman-2.0"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "특정 작업 유형"
          },
          "progress": {
            "type": "integer",
            "description": "작업 진행률 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "작업 상태",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "비디오 작업 상세 정보"
          },
          "type": {
            "type": "string",
            "enum": [
              "video"
            ],
            "description": "작업 출력 유형",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "사용량 및 과금 정보"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "작업 취소 가능 여부입니다. OmniHuman 2.0 작업은 취소할 수 없으며 항상 `false`입니다.",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "예상 완료 시간 (초)",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "예상 비디오 시간(초)",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "사용량 및 과금 정보",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "과금 규칙 (OmniHuman의 경우 per_second)",
            "enum": [
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "예상 크레딧 소비량 (오디오 길이 기준)",
            "minimum": 0,
            "example": 59.024
          },
          "user_group": {
            "type": "string",
            "description": "사용자 그룹 카테고리",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "오류 코드 식별자"
              },
              "message": {
                "type": "string",
                "description": "오류 설명"
              },
              "type": {
                "type": "string",
                "description": "오류 유형"
              },
              "param": {
                "type": "string",
                "description": "관련 매개변수 이름"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##모든 API는 Bearer Token 인증이 필요합니다##\n\n**API Key 받기:**\n\n[API Key 관리 페이지](https://evolink.ai/dashboard/keys)를 방문하여 API Key를 받으세요\n\n**요청 헤더에 추가:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "디지털 휴먼 비디오 생성",
      "description": "OmniHuman 2.0 디지털 휴먼 영상 생성 API"
    }
  ]
}
