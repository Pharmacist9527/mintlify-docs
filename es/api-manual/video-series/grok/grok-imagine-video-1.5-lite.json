{
  "openapi": "3.1.0",
  "info": {
    "title": "Interfaz grok-imagine-video-1.5-lite",
    "description": "Usa Grok Imagine 1.5 Lite para generación de texto a vídeo e imagen a vídeo a menor precio",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Entorno de producción"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Interfaz grok-imagine-video-1.5-lite",
        "description": "- Grok Imagine 1.5 Lite (grok-imagine-video-1.5-lite) es el nivel más económico de Grok Imagine 1.5: texto a vídeo e imagen a vídeo bajo un mismo nombre de modelo\n- No hay parámetro de modo: el número de elementos en `image_urls` selecciona el modo — `0` = texto a vídeo, `1` = imagen a vídeo (usada como primer fotograma). No se admiten imágenes de referencia (2 o más)\n- La salida `1080p` se escala desde 720p y se factura a una tarifa por segundo más alta\n- Modo de procesamiento asíncrono, usa el ID de tarea devuelto para [consultar](/es/api-manual/task-management/get-task-detail)\n- Los enlaces de vídeo generados son válidos durante 24 horas, guárdalos cuanto antes",
        "operationId": "createGrokImagineVideo15LiteGeneration",
        "tags": [
          "Generación de video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrokImagineVideo15LiteRequest"
              },
              "examples": {
                "text_to_video": {
                  "summary": "Texto a vídeo (sin imagen)",
                  "value": {
                    "model": "grok-imagine-video-1.5-lite",
                    "prompt": "Una calle iluminada con neón por la noche, travelling lento hacia adelante bajo la lluvia",
                    "duration": 6,
                    "quality": "480p",
                    "aspect_ratio": "16:9"
                  }
                },
                "image_to_video": {
                  "summary": "Imagen a vídeo (1 imagen)",
                  "value": {
                    "model": "grok-imagine-video-1.5-lite",
                    "prompt": "La persona empieza a bailar",
                    "image_urls": [
                      "https://cdn.evolink.ai/Model-Example/GrokImagine1.5/generated-image.png"
                    ],
                    "duration": 6,
                    "quality": "480p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarea de video creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de solicitud inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, se requiere recarga",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: grok-imagine-video-1.5-lite",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de velocidad excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GrokImagineVideo15LiteRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo",
            "enum": [
              "grok-imagine-video-1.5-lite"
            ],
            "default": "grok-imagine-video-1.5-lite",
            "example": "grok-imagine-video-1.5-lite"
          },
          "prompt": {
            "type": "string",
            "description": "Prompt de descripción del video (obligatorio, no puede estar vacío)\n\n**Límite de longitud:** no más de `2000` tokens (contados con el tokenizador cl100k; el texto CJK alcanza el límite con muchos menos caracteres que el latino)",
            "example": "The person starts dancing"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "URL de la imagen de entrada (opcional). Una imagen cambia la petición a imagen a vídeo.\n\n**Selección de modo:**\n- `0` imágenes (omitir el campo): texto a vídeo, sin cargo por imagen\n- `1` imagen: imagen a vídeo, usada como primer fotograma\n- `2` o más imágenes se rechazan — la referencia a vídeo no se admite en Lite\n\n**Requisitos:**\n- Tamaño de imagen: máx. `10MB`\n- Formatos admitidos: JPEG, PNG, WebP",
            "minItems": 0,
            "maxItems": 1,
            "example": [
              "https://example.com/image.jpg"
            ]
          },
          "duration": {
            "type": "integer",
            "description": "Duración del video (segundos), cualquier entero entre `1` y `15` segundos",
            "minimum": 1,
            "maximum": 15,
            "default": 6,
            "example": 6
          },
          "quality": {
            "type": "string",
            "description": "Resolución del vídeo, por defecto `480p`\n\n**Descripción:**\n- `480p`: Resolución estándar, valor predeterminado\n- `720p`: Alta definición\n- `1080p`: Escalado desde 720p, facturado a una tarifa por segundo más alta\n\nConsulta la [sección de precios](https://evolink.ai/es/grok-imagine-video-1-5?model=grok-imagine-video-1.5-lite#pricing) para las tarifas por resolución.",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "default": "480p",
            "example": "480p"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Relación de aspecto de salida, por defecto `auto`\n\n**Se aplica a:** texto a vídeo (`0` imágenes). Con una imagen de entrada la salida sigue las dimensiones de esa imagen y este parámetro se ignora.\n\n**Descripción:**\n- `auto`: No se envía ninguna relación al proveedor; el canal upstream decide el encuadre (texto a vídeo genera actualmente 16:9); valor predeterminado\n- `16:9`: Horizontal\n- `9:16`: Vertical\n- `1:1`: Cuadrado\n- `4:3`: Horizontal, relación clásica de TV\n- `3:4`: Vertical, relación clásica de TV\n- `3:2`: Horizontal, relación clásica de foto\n- `2:3`: Vertical, relación clásica de foto",
            "enum": [
              "auto",
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "3:2",
              "2:3"
            ],
            "default": "auto",
            "example": "16:9"
          },
          "callback_url": {
            "type": "string",
            "description": "URL de callback HTTPS tras completar la tarea\n\n**Momento del Callback:**\n- Se activa cuando la tarea se completa, falla o se cancela\n- Se envía después de la confirmación de facturación\n\n**Restricciones de Seguridad:**\n- Solo se soporta protocolo HTTPS\n- Callback a IPs internas prohibido (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longitud de la URL no debe exceder `2048` caracteres\n\n**Mecanismo de Callback:**\n- Tiempo de espera: `10` segundos\n- Máximo `3` reintentos en caso de fallo (después de `1`/`2`/`4` segundos)\n- El formato de respuesta coincide con la API de consulta de tareas\n- Código de estado 2xx = éxito, otros activan reintento",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creación de la tarea",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de tarea",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo real utilizado",
            "example": "grok-imagine-video-1.5-lite"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Tipo de tarea específico"
          },
          "progress": {
            "type": "integer",
            "description": "Porcentaje de progreso de la tarea (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Estado de la tarea",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Información detallada de la tarea de video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Tipo de salida de la tarea",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Información de uso y facturación"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Si la tarea puede ser cancelada",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Créditos estimados",
            "minimum": 0,
            "example": 120
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Información de uso y facturación",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regla de facturación",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Créditos estimados consumidos",
            "minimum": 0,
            "example": 8.16
          },
          "user_group": {
            "type": "string",
            "description": "Categoría de grupo de usuario",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identificador del código de error"
              },
              "message": {
                "type": "string",
                "description": "Descripción del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las APIs requieren autenticación Bearer Token##\n\n**Obtener API Key:**\n\nVisita la [Página de gestión de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
