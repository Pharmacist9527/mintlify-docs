{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini Omni 1.1 Flash Texto a vídeo",
    "description": "Genera vídeo con audio nativo desde un prompt",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produccion"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Gemini Omni 1.1 Flash Texto a vídeo",
        "description": "- Genera vídeo con audio nativo desde un prompt\n- `quality`: Resolución: 360p, 720p, 1080p o 4k. Predeterminada: 720p.\n- `duration`: Duración en segundos: entero de 3 a 10, predeterminada 3.\n- `aspect_ratio`: Relación de aspecto: 16:9, 9:16 o auto; predeterminada auto.\n- El modelo genera automáticamente audio nativo sincronizado.\n- Escribe los requisitos negativos directamente en prompt.\n- Procesamiento asíncrono: [consultar el estado de la tarea](/es/api-manual/task-management/get-task-detail)\n- Los enlaces generados son válidos durante 24 horas.",
        "operationId": "createGeminiOmni11FlashTextToVideoGeneration",
        "tags": [
          "Generacion de video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni11FlashTextToVideoRequest"
              },
              "examples": {
                "text_to_video": {
                  "summary": "Texto a vídeo",
                  "value": {
                    "model": "gemini-omni-1.1-flash-text-to-video",
                    "prompt": "Una canica de cristal rueda por una pista y cae al agua.",
                    "quality": "1080p",
                    "aspect_ratio": "16:9",
                    "duration": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarea de video creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametros de solicitud invalidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token invalido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, se requiere recarga",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-1.1-flash-text-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de velocidad excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni11FlashTextToVideoRequest": {
        "required": [
          "model",
          "prompt"
        ],
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo, fijo en `gemini-omni-1.1-flash-text-to-video`",
            "enum": [
              "gemini-omni-1.1-flash-text-to-video"
            ],
            "example": "gemini-omni-1.1-flash-text-to-video",
            "default": "gemini-omni-1.1-flash-text-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Prompt que describe sujeto, acción, escena y movimiento de cámara.",
            "example": "Una canica de cristal rueda por una pista y cae al agua."
          },
          "quality": {
            "type": "string",
            "description": "Resolución de vídeo; valor predeterminado `720p`.\n\n**Valores admitidos:**\n- `360p`: horizontal 640×360 / vertical 360×640\n- `720p`: horizontal 1280×720 / vertical 720×1280; valor predeterminado\n- `1080p`: horizontal 1920×1080 / vertical 1080×1920\n- `4k`: horizontal 3840×2160 / vertical 2160×3840\n\nLa orientación depende de `aspect_ratio`: `16:9` produce horizontal y `9:16` vertical.\n\n**Facturación:** Los tokens de salida aumentan linealmente con la resolución. Frente a `720p`, `360p` usa aproximadamente un tercio, `1080p` alrededor de 1,5× y `4k` alrededor de 3×. El cargo real depende del uso generado.",
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k"
            ],
            "default": "720p",
            "example": "720p"
          },
          "duration": {
            "type": "integer",
            "description": "Duración del vídeo en segundos; valor predeterminado `3`.\n\n**Notas:**\n- Acepta cualquier entero de `3` a `10`\n- La duración afecta directamente a la facturación",
            "minimum": 3,
            "maximum": 10,
            "default": 3,
            "example": 3
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Relación de aspecto: 16:9, 9:16 o auto; predeterminada auto.",
            "enum": [
              "16:9",
              "9:16",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "Direccion de callback HTTPS despues de completar la tarea\n\n**Momento del callback:**\n- Se activa cuando la tarea se completa (completed), falla (failed) o se cancela (cancelled)\n- Se envia despues de completar la confirmacion de facturacion\n\n**Restricciones de seguridad:**\n- Solo se admite el protocolo HTTPS\n- El callback a direcciones IP internas esta prohibido (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longitud de la URL no debe exceder `2048` caracteres\n\n**Mecanismo de callback:**\n- Tiempo de espera: `10` segundos\n- Maximo `3` reintentos en caso de fallo (reintentos despues de `1` segundo/`2` segundos/`4` segundos)\n- El formato del cuerpo de respuesta del callback es consistente con el formato de respuesta de la API de consulta de tareas\n- La direccion de callback que devuelve un codigo de estado 2xx se considera exitosa, otros codigos de estado activaran reintentos",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creacion de la tarea",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de tarea",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo real utilizado",
            "example": "gemini-omni-1.1-flash-text-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Tipo de tarea especifico"
          },
          "progress": {
            "type": "integer",
            "description": "Porcentaje de progreso de la tarea (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Estado de la tarea. El endpoint de creación devuelve processing.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Informacion detallada de la tarea de video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Tipo de salida de la tarea",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Informacion de uso y facturacion"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Si la tarea puede ser cancelada",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Tiempo estimado de finalizacion (segundos)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "Duración de salida; igual a duration.",
            "example": 3
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Informacion de uso y facturacion",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regla de facturacion",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Creditos estimados consumidos",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Grupo de facturación al que pertenece el usuario",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identificador del codigo de error"
              },
              "message": {
                "type": "string",
                "description": "Descripcion del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las APIs requieren autenticacion Bearer Token##\n\n**Obtener API Key:**\n\nVisita la [Pagina de gestion de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
