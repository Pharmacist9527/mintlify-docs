{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini Omni Flash 1.1 Edición de vídeo",
    "description": "Edita un vídeo con imágenes de referencia opcionales",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produccion"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Gemini Omni Flash 1.1 Edición de vídeo",
        "description": "- Edita un vídeo con imágenes de referencia opcionales\n- `video_urls`: Exactamente un MP4 por HTTP/HTTPS, de hasta 10 segundos.\n- `image_urls`: Imágenes de referencia opcionales, máximo 10. Solo HTTP/HTTPS.\n- `quality`: Resolución: 360p, 720p, 1080p, 4k o auto. Predeterminada: auto; auto sigue el vídeo de entrada.\n- `duration`: Solo se permite auto y es el valor predeterminado; la duración sigue el vídeo de entrada.\n- `aspect_ratio`: Solo se permite auto y es el valor predeterminado; la relación sigue el vídeo de entrada.\n- El modelo genera automáticamente audio nativo sincronizado.\n- Escribe los requisitos negativos directamente en prompt.\n- Procesamiento asíncrono: [consultar el estado de la tarea](/es/api-manual/task-management/get-task-detail)\n- Los enlaces generados son válidos durante 24 horas.",
        "operationId": "createGeminiOmni11FlashVideoEditGeneration",
        "tags": [
          "Generacion de video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni11FlashVideoEditRequest"
              },
              "examples": {
                "video_edit": {
                  "summary": "Edición de vídeo",
                  "value": {
                    "model": "gemini-omni-1.1-flash-video-edit",
                    "prompt": "Haz la iluminación más cálida sin cambiar el resto.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "quality": "auto",
                    "duration": "auto",
                    "aspect_ratio": "auto"
                  }
                },
                "video_edit_with_reference": {
                  "summary": "Edición con imagen de referencia",
                  "value": {
                    "model": "gemini-omni-1.1-flash-video-edit",
                    "prompt": "Mantén el estilo de ropa de la referencia.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "image_urls": [
                      "https://example.com/reference.png"
                    ],
                    "quality": "auto",
                    "duration": "auto",
                    "aspect_ratio": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarea de video creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametros de solicitud invalidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token invalido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, se requiere recarga",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-1.1-flash-video-edit",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de velocidad excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni11FlashVideoEditRequest": {
        "required": [
          "model",
          "prompt",
          "video_urls"
        ],
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo, fijo en `gemini-omni-1.1-flash-video-edit`",
            "enum": [
              "gemini-omni-1.1-flash-video-edit"
            ],
            "example": "gemini-omni-1.1-flash-video-edit",
            "default": "gemini-omni-1.1-flash-video-edit"
          },
          "prompt": {
            "type": "string",
            "description": "Instrucción que describe la edición deseada y lo que debe conservarse.",
            "example": "Haz la iluminación más cálida sin cambiar el resto."
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "Exactamente un MP4 por HTTP/HTTPS, de hasta 10 segundos.",
            "example": [
              "https://example.com/source.mp4"
            ]
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Array opcional de imágenes de referencia, hasta 10 imágenes, para restringir sujetos, estilo o elementos.\n\n**Requisitos de entrada:**\n- Solo URL de imagen HTTP/HTTPS\n- Formatos admitidos: `png`, `jpeg`, `webp`\n\n**Facturación:** Cada imagen de referencia aporta tokens de entrada.",
            "example": [
              "https://example.com/reference.png"
            ]
          },
          "quality": {
            "type": "string",
            "description": "Resolución del vídeo de salida; valor predeterminado `auto`.\n\n**Valores admitidos:**\n- `360p`: lado corto 360\n- `720p`: lado corto 720\n- `1080p`: lado corto 1080\n- `4k`: lado corto 2160\n- `auto`: sigue la resolución del vídeo de entrada; valor predeterminado\n\nElegir una resolución concreta puede aumentar o reducir la resolución de salida.\n\n**Facturación:** Los tokens de los vídeos de entrada y salida se calculan con la resolución final de salida; una resolución mayor cuesta más.",
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "duration": {
            "type": "string",
            "description": "Solo se permite auto y es el valor predeterminado; la duración sigue el vídeo de entrada.",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Solo se permite auto y es el valor predeterminado; la relación sigue el vídeo de entrada.",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "Direccion de callback HTTPS despues de completar la tarea\n\n**Momento del callback:**\n- Se activa cuando la tarea se completa (completed), falla (failed) o se cancela (cancelled)\n- Se envia despues de completar la confirmacion de facturacion\n\n**Restricciones de seguridad:**\n- Solo se admite el protocolo HTTPS\n- El callback a direcciones IP internas esta prohibido (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longitud de la URL no debe exceder `2048` caracteres\n\n**Mecanismo de callback:**\n- Tiempo de espera: `10` segundos\n- Maximo `3` reintentos en caso de fallo (reintentos despues de `1` segundo/`2` segundos/`4` segundos)\n- El formato del cuerpo de respuesta del callback es consistente con el formato de respuesta de la API de consulta de tareas\n- La direccion de callback que devuelve un codigo de estado 2xx se considera exitosa, otros codigos de estado activaran reintentos",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creacion de la tarea",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de tarea",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo real utilizado",
            "example": "gemini-omni-1.1-flash-video-edit"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Tipo de tarea especifico"
          },
          "progress": {
            "type": "integer",
            "description": "Porcentaje de progreso de la tarea (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Estado de la tarea. El endpoint de creación devuelve processing.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Informacion detallada de la tarea de video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Tipo de salida de la tarea",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Informacion de uso y facturacion"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Si la tarea puede ser cancelada",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Tiempo estimado de finalizacion (segundos)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "La duración de salida sigue el vídeo de entrada.",
            "example": 5
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Informacion de uso y facturacion",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regla de facturacion",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Creditos estimados consumidos",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Grupo de facturación al que pertenece el usuario",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identificador del codigo de error"
              },
              "message": {
                "type": "string",
                "description": "Descripcion del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las APIs requieren autenticacion Bearer Token##\n\n**Obtener API Key:**\n\nVisita la [Pagina de gestion de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
