{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini Omni Flash 1.1 – Resumen de parámetros",
    "description": "Referencia completa de parámetros para los cinco modos de vídeo",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Produccion"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Gemini Omni Flash 1.1 – Resumen de parámetros",
        "description": "- Referencia completa de parámetros para los cinco modos de vídeo\n- Hay cinco modos: texto a vídeo, imagen a vídeo, referencia a vídeo, edición y extensión.\n- `quality`: Texto/Imagen/Referencia: cuatro niveles, predeterminada 720p. Edición/Extensión: además auto, predeterminada auto.\n- `duration`: Duración: generación 3–10; edición solo auto; extensión 3–10 segundos añadidos.\n- `aspect_ratio`: Relación predeterminada auto; edición y extensión solo aceptan auto.\n- El modelo genera automáticamente audio nativo sincronizado.\n- Escribe los requisitos negativos directamente en prompt.\n- Procesamiento asíncrono: [consultar el estado de la tarea](/es/api-manual/task-management/get-task-detail)\n- Los enlaces generados son válidos durante 24 horas.",
        "operationId": "createGeminiOmni11FlashGeneration",
        "tags": [
          "Generacion de video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni11FlashRequest"
              },
              "examples": {
                "text_to_video": {
                  "summary": "Texto a vídeo",
                  "value": {
                    "model": "gemini-omni-flash-1.1-text-to-video",
                    "prompt": "Una canica de cristal rueda por una pista y cae al agua.",
                    "quality": "720p",
                    "duration": 3,
                    "aspect_ratio": "16:9"
                  }
                },
                "image_to_video": {
                  "summary": "Primero y último fotograma a vídeo",
                  "value": {
                    "model": "gemini-omni-flash-1.1-image-to-video",
                    "prompt": "El personaje gira lentamente la cabeza y sonríe.",
                    "image_urls": [
                      "https://example.com/first-frame.png",
                      "https://example.com/last-frame.png"
                    ],
                    "quality": "720p",
                    "duration": 3,
                    "aspect_ratio": "16:9"
                  }
                },
                "reference_to_video": {
                  "summary": "Referencia a vídeo",
                  "value": {
                    "model": "gemini-omni-flash-1.1-reference-to-video",
                    "prompt": "Mantén la apariencia y el movimiento de cámara de las referencias.",
                    "image_urls": [
                      "https://example.com/character.png"
                    ],
                    "video_urls": [
                      "https://example.com/reference.mp4"
                    ],
                    "quality": "720p",
                    "duration": 3,
                    "aspect_ratio": "16:9"
                  }
                },
                "video_edit": {
                  "summary": "Edición de vídeo",
                  "value": {
                    "model": "gemini-omni-flash-1.1-video-edit",
                    "prompt": "Haz la iluminación más cálida sin cambiar el resto.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "quality": "auto",
                    "duration": "auto",
                    "aspect_ratio": "auto"
                  }
                },
                "video_extend": {
                  "summary": "Extensión de vídeo",
                  "value": {
                    "model": "gemini-omni-flash-1.1-video-extend",
                    "prompt": "La persona sigue caminando y sale del encuadre.",
                    "video_urls": [
                      "https://example.com/source.mp4"
                    ],
                    "duration": 3,
                    "quality": "auto",
                    "aspect_ratio": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarea de video creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametros de solicitud invalidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token invalido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, se requiere recarga",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-flash-1.1-text-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de velocidad excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni11FlashRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Elige el ID de modelo adecuado para la tarea y los medios de entrada:\n\n- `gemini-omni-flash-1.1-text-to-video`\n- `gemini-omni-flash-1.1-image-to-video`\n- `gemini-omni-flash-1.1-reference-to-video`\n- `gemini-omni-flash-1.1-video-edit`\n- `gemini-omni-flash-1.1-video-extend`",
            "enum": [
              "gemini-omni-flash-1.1-text-to-video",
              "gemini-omni-flash-1.1-image-to-video",
              "gemini-omni-flash-1.1-reference-to-video",
              "gemini-omni-flash-1.1-video-edit",
              "gemini-omni-flash-1.1-video-extend"
            ],
            "example": "gemini-omni-flash-1.1-text-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Prompt para generación, edición o extensión.",
            "example": "Una canica de cristal rueda por una pista y cae al agua."
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "URLs de imágenes: 1–2 fotogramas para Imagen a vídeo; hasta 10 referencias; hasta 10 imágenes opcionales para edición y extensión.",
            "example": [
              "https://example.com/character.png",
              "https://example.com/scene.png"
            ]
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "Vídeos: hasta 3 referencias de 10 s; uno de 10 s para edición; uno de 30 s para extensión.",
            "example": [
              "https://example.com/reference.mp4"
            ]
          },
          "quality": {
            "type": "string",
            "description": "Resolución de vídeo\n\n**Valores admitidos:**\n- `360p`: horizontal 640×360 / vertical 360×640\n- `720p`: horizontal 1280×720 / vertical 720×1280\n- `1080p`: horizontal 1920×1080 / vertical 1080×1920\n- `4k`: horizontal 3840×2160 / vertical 2160×3840\n- `auto`: solo para edición y extensión; sigue la resolución del vídeo de entrada\n\n**Valores predeterminados:**\n- Texto/Imagen/Referencia: `720p`\n- Edición/Extensión: `auto`\n\n**Facturación:** La salida se factura por tokens de salida. En edición y extensión, los tokens del vídeo de entrada y salida se calculan con la resolución final de salida.",
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k",
              "auto"
            ],
            "example": "720p"
          },
          "duration": {
            "description": "Duración del vídeo\n\n- Texto/Imagen/Referencia a vídeo: entero de `3` a `10` segundos; valor predeterminado `3`\n- Edición de vídeo: solo se acepta `auto`; valor predeterminado `auto`; la duración sigue al vídeo de entrada\n- Extensión de vídeo: entero de `3` a `10` segundos; valor predeterminado `3`; indica los segundos añadidos",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 3,
                "maximum": 10
              },
              {
                "type": "string",
                "enum": [
                  "auto"
                ]
              }
            ],
            "example": 3
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Relación predeterminada auto; edición y extensión solo aceptan auto.",
            "enum": [
              "16:9",
              "9:16",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "Direccion de callback HTTPS despues de completar la tarea\n\n**Momento del callback:**\n- Se activa cuando la tarea se completa (completed), falla (failed) o se cancela (cancelled)\n- Se envia despues de completar la confirmacion de facturacion\n\n**Restricciones de seguridad:**\n- Solo se admite el protocolo HTTPS\n- El callback a direcciones IP internas esta prohibido (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longitud de la URL no debe exceder `2048` caracteres\n\n**Mecanismo de callback:**\n- Tiempo de espera: `10` segundos\n- Maximo `3` reintentos en caso de fallo (reintentos despues de `1` segundo/`2` segundos/`4` segundos)\n- El formato del cuerpo de respuesta del callback es consistente con el formato de respuesta de la API de consulta de tareas\n- La direccion de callback que devuelve un codigo de estado 2xx se considera exitosa, otros codigos de estado activaran reintentos",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-omni-flash-1.1-text-to-video"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "duration": {
                  "type": "integer",
                  "default": 3
                },
                "quality": {
                  "enum": [
                    "360p",
                    "720p",
                    "1080p",
                    "4k"
                  ],
                  "default": "720p"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "image_urls"
                    ]
                  },
                  {
                    "required": [
                      "video_urls"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-omni-flash-1.1-image-to-video"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "required": [
                "image_urls"
              ],
              "properties": {
                "image_urls": {
                  "maxItems": 2
                },
                "duration": {
                  "type": "integer",
                  "default": 3
                },
                "quality": {
                  "enum": [
                    "360p",
                    "720p",
                    "1080p",
                    "4k"
                  ],
                  "default": "720p"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "video_urls"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-omni-flash-1.1-reference-to-video"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "required": [
                "image_urls"
              ],
              "properties": {
                "video_urls": {
                  "maxItems": 3
                },
                "duration": {
                  "type": "integer",
                  "default": 3
                },
                "quality": {
                  "enum": [
                    "360p",
                    "720p",
                    "1080p",
                    "4k"
                  ],
                  "default": "720p"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-omni-flash-1.1-video-edit"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "required": [
                "video_urls"
              ],
              "properties": {
                "video_urls": {
                  "maxItems": 1
                },
                "image_urls": {
                  "maxItems": 10
                },
                "duration": {
                  "type": "string",
                  "enum": [
                    "auto"
                  ],
                  "default": "auto"
                },
                "aspect_ratio": {
                  "enum": [
                    "auto"
                  ]
                },
                "quality": {
                  "enum": [
                    "360p",
                    "720p",
                    "1080p",
                    "4k",
                    "auto"
                  ],
                  "default": "auto"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-omni-flash-1.1-video-extend"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "required": [
                "video_urls"
              ],
              "properties": {
                "video_urls": {
                  "maxItems": 1
                },
                "image_urls": {
                  "maxItems": 10
                },
                "duration": {
                  "type": "integer",
                  "default": 3
                },
                "aspect_ratio": {
                  "enum": [
                    "auto"
                  ]
                },
                "quality": {
                  "enum": [
                    "360p",
                    "720p",
                    "1080p",
                    "4k",
                    "auto"
                  ],
                  "default": "auto"
                }
              }
            }
          }
        ]
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creacion de la tarea",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de tarea",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo real utilizado",
            "example": "gemini-omni-flash-1.1-text-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Tipo de tarea especifico"
          },
          "progress": {
            "type": "integer",
            "description": "Porcentaje de progreso de la tarea (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Estado de la tarea. El endpoint de creación devuelve processing.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Informacion detallada de la tarea de video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Tipo de salida de la tarea",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Informacion de uso y facturacion"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Si la tarea puede ser cancelada",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Tiempo estimado de finalizacion (segundos)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "Duración de salida según el modo.",
            "example": 3
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Informacion de uso y facturacion",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regla de facturacion",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Creditos estimados consumidos",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Grupo de facturación al que pertenece el usuario",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identificador del codigo de error"
              },
              "message": {
                "type": "string",
                "description": "Descripcion del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las APIs requieren autenticacion Bearer Token##\n\n**Obtener API Key:**\n\nVisita la [Pagina de gestion de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
