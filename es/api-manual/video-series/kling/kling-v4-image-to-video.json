{
  "openapi": "3.1.0",
  "info": {
    "title": "kling-v4-image-to-video API",
    "description": "Crea tareas de imagen a video usando modelos de IA",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Producción"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "kling-v4-image-to-video API",
        "description": "- Kling-4.0 Image to Video (kling-v4-image-to-video) genera vídeos a partir de imágenes\n- Admite un fotograma inicial, uno final y fotogramas intermedios entre ambos\n- La relación de aspecto la determina el primer fotograma, **no acepta `aspect_ratio`**\n- Modo de procesamiento asíncrono, use el ID de tarea devuelto para [consultar el estado](/es/api-manual/task-management/get-task-detail)\n- Los enlaces de vídeo generados son válidos durante 24 horas, guárdelos oportunamente",
        "operationId": "createVideoGeneration",
        "tags": [
          "Generación de video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Imagen de Primer Fotograma a Video",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "The person in the image slowly turns their head and smiles",
                    "image_start": "https://example.com/portrait.jpg",
                    "duration": 5,
                    "quality": "720p"
                  }
                },
                "first_last_frame": {
                  "summary": "Primer fotograma + Último fotograma",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "Transition from daytime to nighttime",
                    "image_start": "https://example.com/day.jpg",
                    "image_end": "https://example.com/night.jpg",
                    "duration": 10,
                    "quality": "1080p"
                  }
                },
                "with_keyframes": {
                  "summary": "Fotograma inicial + intermedios + final",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "El capullo se abre lentamente y después la cámara se aleja",
                    "image_start": "https://example.com/bud.jpg",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/half-open.jpg"
                      },
                      {
                        "image_url": "https://example.com/open.jpg"
                      }
                    ],
                    "image_end": "https://example.com/wide.jpg",
                    "duration": 5,
                    "quality": "720p"
                  }
                },
                "keyframes_without_end": {
                  "summary": "Fotograma inicial + intermedios (sin fotograma final)",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "La cámara avanza desde una calle al amanecer hasta una plaza al anochecer mientras la luz se vuelve más cálida",
                    "image_start": "https://example.com/morning.jpg",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/noon.jpg"
                      },
                      {
                        "image_url": "https://example.com/afternoon.jpg"
                      }
                    ],
                    "duration": 8,
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tarea de generación de video creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de solicitud inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, se requiere recarga",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: kling-v4-image-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "image_start",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo de generación de video",
            "enum": [
              "kling-v4-image-to-video"
            ],
            "default": "kling-v4-image-to-video",
            "example": "kling-v4-image-to-video"
          },
          "image_start": {
            "type": "string",
            "format": "uri",
            "description": "URL de imagen del primer fotograma para generación de imagen a vídeo (**obligatorio**)\n\n**Nota:**\n- Tamaño de imagen: hasta `10MB`\n- Formatos compatibles: `.jpg`, `.jpeg`, `.png`\n- Dimensiones de imagen: ancho y alto >= `300px`, relación de aspecto entre `1:2.5` y `2.5:1`\n- La URL de la imagen debe ser accesible directamente por el servidor o activar una descarga directa al acceder",
            "example": "https://example.com/portrait.jpg"
          },
          "image_end": {
            "type": "string",
            "format": "uri",
            "description": "URL de imagen del último fotograma\n\n**Nota:**\n- Se debe proporcionar `image_start` (primer fotograma) al usar último fotograma\n- Formatos compatibles: `.jpg`, `.jpeg`, `.png`\n- Tamaño de imagen: hasta `10MB`\n- La URL de la imagen debe ser accesible directamente por el servidor o activar una descarga directa al acceder",
            "example": "https://example.com/night.jpg"
          },
          "keyframes": {
            "type": "array",
            "description": "Imágenes de fotogramas intermedios, distribuidas uniformemente en el orden indicado entre el fotograma inicial y el final\n\n**Nota:**\n- Cantidad: de `1` a `8` imágenes\n- La suma del fotograma inicial, los intermedios y el final no debe superar ni `10` imágenes ni `duration` + 1 (por ejemplo, hasta `4` imágenes para `3` segundos o `6` imágenes para `5` segundos)\n- El fotograma final es opcional. Si se omite, el modelo genera la imagen de cierre\n- Tamaño de imagen: hasta `10MB`\n- Formatos compatibles: `.jpg`, `.jpeg`, `.png`\n- Dimensiones de imagen: ancho y alto >= `300px`, relación de aspecto entre `1:2.5` y `2.5:1`\n- La URL de la imagen debe ser accesible directamente por el servidor o activar una descarga directa al acceder",
            "items": {
              "type": "object",
              "properties": {
                "image_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL de imagen del fotograma intermedio"
                }
              },
              "required": [
                "image_url"
              ]
            },
            "minItems": 1,
            "maxItems": 8,
            "example": [
              {
                "image_url": "https://example.com/half-open.jpg"
              },
              {
                "image_url": "https://example.com/open.jpg"
              }
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Prompt de texto que describe el vídeo que se desea generar\n\n**Nota:**\n- Máximo `2500` caracteres",
            "example": "The person in the image slowly turns their head and smiles",
            "maxLength": 2500
          },
          "duration": {
            "type": "integer",
            "description": "Duración del vídeo en segundos. Valor predeterminado: `5` segundos\n\n**Rango:**\n- Entero de `3` a `30`",
            "minimum": 3,
            "maximum": 30,
            "default": 5,
            "example": 5
          },
          "quality": {
            "type": "string",
            "description": "Nivel de resolución\n\n**Opciones:**\n- `720p`: Estándar 720P\n- `1080p`: Alta calidad 1080P",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "example": "720p"
          },
          "callback_url": {
            "type": "string",
            "description": "URL de callback HTTPS para completación de tarea\n\n**Momento del Callback:**\n- Se activa cuando la tarea se completa, falla o se cancela\n- Se envía después de la confirmación de facturación\n\n**Restricciones de Seguridad:**\n- Solo protocolo HTTPS\n- Direcciones IP internas están prohibidas (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longitud de la URL no debe exceder `2048` caracteres\n\n**Mecanismo de Callback:**\n- Tiempo de espera: `10` segundos\n- Máximo `3` reintentos después del fallo (a `1`/`2`/`4` segundos después del fallo)\n- El formato de respuesta del callback es consistente con la API de consulta de tareas\n- El código de estado 2xx se considera exitoso, otros códigos activan reintento",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creación de la tarea",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de tarea",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo real utilizado",
            "example": "kling-v4-image-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Tipo de tarea"
          },
          "progress": {
            "type": "integer",
            "description": "Porcentaje de progreso de la tarea (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Estado de la tarea",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Detalles de la tarea de video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Tipo de salida de la tarea",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Información de uso y facturación"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Si la tarea puede ser cancelada",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "Tiempo estimado de finalización (segundos)",
            "minimum": 0,
            "example": 300
          },
          "video_duration": {
            "type": "integer",
            "description": "Duración del video (segundos)",
            "example": 5
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Información de uso y facturación",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regla de facturación",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Créditos estimados consumidos",
            "minimum": 0,
            "example": 270000
          },
          "user_group": {
            "type": "string",
            "description": "Categoría de grupo de usuario",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identificador del código de error"
              },
              "message": {
                "type": "string",
                "description": "Descripción del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Todas las APIs requieren autenticación Bearer Token ##\n\n**Obtener API Key:**\n\nVisita la [Página de gestión de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Generación de video",
      "description": "APIs de generación de video con IA"
    }
  ]
}
