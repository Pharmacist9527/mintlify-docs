{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Chat Completions — Inicio rápido",
    "description": "Envía tu primera solicitud de chat a Seed con Chat Completions en cinco minutos.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Producción (recomendado)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternativa"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Iniciar una conversación con Seed mediante Chat Completions",
        "description": "- Llama a Seed con el SDK de OpenAI.\n- Las solicitudes síncronas devuelven la respuesta directamente.\n- Empieza con los parámetros básicos.\n- Modelos compatibles — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [Referencia de la API](/es/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-reference)",
        "operationId": "createChatCompletionQuickSeed",
        "tags": [
          "Generación de chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat generado con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error en los parámetros de la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, necesita recargar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de frecuencia de solicitudes excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "El servicio del modelo no está disponible temporalmente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Selecciona un modelo\n\n| ID del modelo | Uso recomendado | Ventana de contexto |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Modelo insignia recomendado para razonamiento complejo, documentos largos y bases de código | 1.000.000 de tokens |\n| `doubao-seed-2-1-turbo` | Opción económica para chat, extracción de datos y tareas de agentes | 256.000 tokens |\n| `doubao-seed-2-1-lite` | Modelo Seed 2.1 de menor precio, con entrada de audio | 1.000.000 de tokens |\n| `doubao-seed-evolving` | Se actualiza cada semana para evaluar nuevas capacidades | 1.000.000 de tokens |\n| `doubao-seed-2.0-pro` | Modelo insignia de Seed 2.0 | 256.000 tokens |\n| `doubao-seed-2.0-lite` | Modelo Seed 2.0 ligero y rápido | 256.000 tokens |\n| `doubao-seed-2.0-mini` | El modelo Seed 2.0 más rápido para tareas sencillas | 256.000 tokens |\n| `doubao-seed-2.0-code` | Modelo Seed 2.0 especializado en programación | 256.000 tokens |\n\nLos ID de Seed 2.1 llevan guion (`2-1`) y los de Seed 2.0, punto (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "messages": {
            "type": "array",
            "description": "Lista de mensajes para la conversación",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            },
            "minItems": 1,
            "example": [
              {
                "role": "user",
                "content": "¡Hola! Preséntate en tres frases."
              }
            ]
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Rol del mensaje",
            "enum": [
              "user"
            ]
          },
          "content": {
            "type": "string",
            "description": "Contenido del mensaje (texto plano)"
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único para la completación de chat",
            "example": "0217714854126607f5a9cf8ed5b018c76e4ad3dc2810db57ffb50"
          },
          "model": {
            "type": "string",
            "description": "Modelo utilizado en esta solicitud.",
            "example": "doubao-seed-2-1-pro"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Tipo de respuesta",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creación",
            "example": 1771485416
          },
          "choices": {
            "type": "array",
            "description": "Lista de opciones de completado",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Índice de esta opción",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Razón por la que finalizó el completado",
            "enum": [
              "stop",
              "length",
              "content_filter"
            ],
            "example": "stop"
          },
          "moderation_hit_type": {
            "type": "string",
            "nullable": true,
            "description": "Cuando el texto generado por el modelo contiene información sensible, devuelve la etiqueta de clasificación de riesgo correspondiente\n\n- `severe_violation`: el texto generado por el modelo constituye una infracción grave\n- `violence`: el texto generado por el modelo implica conducta violenta",
            "enum": [
              "severe_violation",
              "violence"
            ]
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Rol del remitente del mensaje",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "Contenido de la respuesta de la IA",
            "example": "¡Hola! Soy un modelo de Seed para razonar, escribir, programar e interpretar contenido multimodal…"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Estadísticas de uso de tokens",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Número de tokens en la entrada",
            "example": 15
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Tokens de salida, incluido el razonamiento.",
            "example": 256
          },
          "total_tokens": {
            "type": "integer",
            "description": "Número total de tokens utilizados",
            "example": 271
          },
          "prompt_tokens_details": {
            "type": "object",
            "description": "Detalles de tokens de entrada",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Número de tokens en caché alcanzados",
                "example": 0
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "description": "Detalles de tokens de salida",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Número de tokens de razonamiento / cadena de razonamiento",
                "example": 0
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Código de error de estado HTTP"
              },
              "message": {
                "type": "string",
                "description": "Descripción del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              },
              "param": {
                "type": "string",
                "description": "Nombre del parámetro relacionado"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Sugerencia para manejar el error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Todas las APIs requieren autenticación Bearer Token ##\n\n**Obtener API Key:**\n\nVisita la [Página de gestión de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Generación de chat",
      "description": "APIs relacionadas con generación de chat IA"
    }
  ]
}
