{
  "openapi": "3.1.0",
  "info": {
    "title": "Inicio rápido de Doubao Seed 2.0 Responses API",
    "description": "Comienza rápidamente con Doubao Seed 2.0 Responses API, completa tu primera llamada en 5 minutos",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Producción (recomendado)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternativa"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Chat rápido de Doubao Seed 2.0 Responses API",
        "description": "- Llamada a los modelos de la serie Doubao Seed 2.0 con el formato Responses API\n- Admite almacenamiento de contexto en el servidor, con conversaciones multiturno mediante `previous_response_id`\n- Parámetros mínimos, inicio rápido\n- Modelos admitidos: `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- ¿Necesitas más funciones? Consulta la [documentación completa de parámetros](./doubao-seed-2.0-responses-reference)",
        "operationId": "createResponseQuickDoubaoSeed20",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta generada con éxito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "Error en los parámetros de la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token inválido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota insuficiente, necesita recargar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/billing"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acceso denegado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2.0-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de frecuencia de solicitudes excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Error del servicio upstream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Servicio temporalmente no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo de conversación\n\n- `doubao-seed-2.0-pro`: versión insignia, mayor capacidad global, ideal para razonamiento complejo y generación de alta calidad\n- `doubao-seed-2.0-lite`: versión ligera, más rápida y con buena relación calidad-precio\n- `doubao-seed-2.0-mini`: versión ultrarrápida, respuesta más veloz, adecuada para tareas simples\n- `doubao-seed-2.0-code`: versión especializada en código, optimizada para generar y comprender código",
            "enum": [
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2.0-pro",
            "example": "doubao-seed-2.0-pro"
          },
          "input": {
            "type": "string",
            "description": "Contenido de entrada (texto plano), equivalente al texto introducido con el rol user",
            "example": "你好，介绍一下 Doubao Seed 2.0 的新特性"
          }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único de esta respuesta",
            "example": "resp_02177148667427813c33c36521378d02b2c8389204fa8c3e2f63e"
          },
          "object": {
            "type": "string",
            "description": "Tipo de objeto, valor fijo response",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "number",
            "description": "Marca de tiempo Unix de creación (segundos)",
            "example": 1771486674
          },
          "model": {
            "type": "string",
            "description": "Nombre y versión del modelo realmente utilizado",
            "example": "doubao-seed-2-0-code-preview-260215"
          },
          "status": {
            "type": "string",
            "description": "Estado de la respuesta\n\n- `completed`: generación completada\n- `in_progress`: generación en curso\n- `incomplete`: incompleta\n- `failed`: fallida",
            "enum": [
              "completed",
              "in_progress",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "Lista de contenidos de salida del modelo",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "service_tier": {
            "type": "string",
            "description": "Nivel de servicio de esta solicitud",
            "example": "default"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Número máximo de tokens de salida del modelo",
            "example": 32768
          },
          "caching": {
            "type": "object",
            "description": "Configuración de caché",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          },
          "store": {
            "type": "boolean",
            "description": "Indica si la respuesta se almacenó",
            "example": true
          },
          "expire_at": {
            "type": "integer",
            "description": "Momento de expiración del almacenamiento (marca de tiempo Unix)",
            "example": 1771745874
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Información de error, null si la operación tiene éxito"
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasoningOutput"
          },
          {
            "$ref": "#/components/schemas/MessageOutput"
          }
        ]
      },
      "ReasoningOutput": {
        "title": "Salida de la cadena de razonamiento",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del elemento de salida",
            "example": "rs_0217****404a"
          },
          "type": {
            "type": "string",
            "description": "Tipo de salida, aquí reasoning",
            "enum": [
              "reasoning"
            ]
          },
          "summary": {
            "type": "array",
            "description": "Contenido de la cadena de razonamiento",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Texto del contenido de la cadena de razonamiento"
                },
                "type": {
                  "type": "string",
                  "description": "Tipo, valor fijo summary_text",
                  "enum": [
                    "summary_text"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "MessageOutput": {
        "title": "Salida de mensaje",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID del elemento de salida",
            "example": "msg_0217****a93c"
          },
          "type": {
            "type": "string",
            "description": "Tipo de salida, aquí message",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "description": "Rol, valor fijo assistant",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "type": "array",
            "description": "Lista de contenidos del mensaje",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Contenido de texto",
                  "example": "你好呀！很高兴见到你～ 有什么我可以帮你的吗？"
                },
                "type": {
                  "type": "string",
                  "description": "Tipo de contenido",
                  "enum": [
                    "output_text"
                  ]
                },
                "annotations": {
                  "type": "array",
                  "nullable": true,
                  "description": "Información de anotación"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Estado",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Estadísticas de uso de tokens",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Número de tokens de entrada",
            "example": 88
          },
          "input_tokens_details": {
            "type": "object",
            "description": "Detalles de tokens de entrada",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Número de tokens en caché",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Número de tokens de salida",
            "example": 230
          },
          "output_tokens_details": {
            "type": "object",
            "description": "Detalles de tokens de salida",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Número de tokens de razonamiento / cadena de razonamiento",
                "example": 211
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Número total de tokens utilizados",
            "example": 318
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Código de error de estado HTTP"
              },
              "message": {
                "type": "string",
                "description": "Descripción del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              },
              "param": {
                "type": "string",
                "description": "Nombre del parámetro relacionado"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Sugerencia para manejar el error"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Todas las APIs requieren autenticación Bearer Token ##\n\n**Obtener API Key:**\n\nVisita la [Página de gestión de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Agregar al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Responses API",
      "description": "Interfaz de generación de chat de Responses API"
    }
  ]
}
