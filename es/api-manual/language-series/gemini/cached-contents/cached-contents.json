                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "cached content is temporarily unavailable; please retry later",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_CHANNEL_UNAVAILABLE",
                        "domain": "evolink.ai"
                      }
                    ]
