        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Todos los endpoints requieren autenticación Bearer Token\n\n**Obtener una API Key:**\n\nVisite [Gestión de API Keys](https://evolink.ai/dashboard/keys).\n\n**Añada esta cabecera:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\nTambién se acepta el formato nativo de Gemini: cabecera `x-goog-api-key: YOUR_API_KEY` o parámetro URL `?key=YOUR_API_KEY`."
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "Parte de contenido: texto, datos integrados (base64) o referencia a archivo, a elegir",
        "properties": {
          "text": {
            "type": "string",
            "description": "Texto"
          },
          "inlineData": {
            "type": "object",
            "description": "Datos binarios integrados (imágenes, audio, PDF, etc.)",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "Datos codificados en base64"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "Referencia a archivo",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "URL de acceso público"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "Rol; no hace falta en instrucciones del sistema"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Declaraciones de herramientas. Solo se aceptan los tres tipos siguientes; se rechazan los demás",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "Búsqueda web; indique `{}`"
          },
          "codeExecution": {
            "type": "object",
            "description": "Ejecución de código; indique `{}`"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "Declaraciones de funciones (parámetros de un subconjunto de OpenAPI)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modelo; se admite `models/gemini-3.8-flash` o `gemini-3.8-flash`. Compatibles: `gemini-3.8-flash`, `gemini-3.7-flash`, `gemini-3.6-flash`, `gemini-3.5-flash`, `gemini-3.5-flash-lite`, `gemini-3-flash-preview`, `gemini-3.1-flash-lite-preview`, `gemini-3.1-pro-preview`, `gemini-3.1-pro-preview-customtools`, `gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "Contenido de conversación que guardar; debe ser un array. Actúa como prefijo al usar la caché. Proporcione al menos uno de `contents`, `systemInstruction` o `tools`",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "Instrucciones del sistema. Tras guardarlas, no incluya systemInstruction en generaciones que usen esta caché"
          },
          "tools": {
            "type": "array",
            "description": "Declaraciones de herramientas. Tras guardarlas, no incluya tools en generaciones que usen esta caché",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "Configuración de llamadas a herramientas (como functionCallingConfig). Tras guardarla, no incluya toolConfig en generaciones que usen esta caché"
          },
          "ttl": {
            "type": "string",
            "description": "Vigencia, como `\"3600s\"`. Mínimo `60s`, máximo `604800s` (168 horas). Excluyente con expireTime; ambos devuelven 400. Si omite los dos, se usa `3600s`",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Caducidad absoluta (RFC 3339, UTC), excluyente con ttl; ambos devuelven 400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "Nombre para su referencia, hasta 255 caracteres; no afecta a la facturación",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "Indique exactamente uno de ttl o expireTime; otros campos devuelven 400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "Nueva duración desde ahora, como `\"7200s\"`. Mínimo `60s`, máximo `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Nueva caducidad absoluta (RFC 3339, UTC)",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre con formato `cachedContents/<id>`. Úselo en `cachedContent` de las generaciones; `<id>` también es el ID de la solicitud de creación",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
          },
          "model": {
            "type": "string",
            "description": "Modelo asociado a la caché; la generación debe usar el mismo",
            "example": "models/gemini-3.8-flash"
          },
          "displayName": {
            "type": "string",
            "description": "Nombre indicado al crear; se omite si no se indicó"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de creación (UTC)"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha de última actualización (UTC)"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Caducidad (UTC); se elimina automáticamente al caducar"
          },
          "usageMetadata": {
            "type": "object",
            "properties": {
              "totalTokenCount": {
                "type": "integer",
                "description": "Total de tokens en caché, usado para calcular escritura y almacenamiento",
                "example": 7525
              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "Se devuelve si hay otra página; páselo sin cambios como `pageToken` en la siguiente solicitud"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Formato de error nativo de Gemini. `error.details[0].reason` contiene el código: `INVALID_ARGUMENT` parámetros no válidos; `EXPLICIT_CACHE_UNSUPPORTED` el modelo no admite caché explícita; `NO_AVAILABLE_CHANNEL`, `MODEL_PRICE_ERROR` aún no disponible para su cuenta; `CACHE_EXPIRED` la caché caducó o le queda muy poca vigencia; `CACHE_MODEL_MISMATCH` el modelo no coincide con la caché; `INVALID_CACHED_CONTENT` `cachedContent` con formato incorrecto; `INSUFFICIENT_QUOTA` saldo insuficiente; `CACHE_NOT_FOUND` la caché no existe, caducó, se eliminó o pertenece a otra cuenta; `EXPLICIT_CACHE_DISABLED` la función aún no está disponible; `CACHE_CONTENT_TOO_LARGE` el cuerpo de la solicitud supera 10 MB; `UPSTREAM_ERROR` la solicitud no fue aceptada, consulte `message`; `CACHE_CHANNEL_UNAVAILABLE`, `INTERNAL` no disponible temporalmente, reintente más tarde.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Código de estado HTTP"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "Valor de estado, como INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
