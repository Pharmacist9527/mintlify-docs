{
  "openapi": "3.1.0",
  "info": {
    "title": "API Kimi (todos los modelos) - Chat Completions: Referencia completa",
    "description": "Llama a los modelos de texto Kimi mediante el protocolo OpenAI Chat Completions. Usa `model` para seleccionar `kimi-k3.1-pro`, `kimi-k3.1-pro-highspeed` o `kimi-k3`. Todos tienen una ventana de contexto de 1.048.576 tokens y admiten conversaciones de varios turnos, streaming, llamadas a herramientas, búsqueda web, salida estructurada e imágenes y vídeos de entrada.\n\nEl razonamiento siempre está activado en los tres modelos y se devuelve en `reasoning_content`. El esfuerzo de razonamiento y el TTL de escritura de caché varían según el modelo; consulta el campo `model`. Conserva el historial completo de razonamiento y llamadas a herramientas en conversaciones de varios turnos.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Producción (Recomendado)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternativa"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "API de chat Kimi (todos los modelos, compatible con OpenAI)",
        "description": "Llama a los modelos Kimi en formato OpenAI Chat Completions, con respuestas JSON normales o en streaming SSE. En conversaciones de varios turnos, conserva completos reasoning_content y tool_calls de los mensajes assistant.\n\nCuando la búsqueda web devuelva tool_calls, reenvía function.arguments de cada llamada como contenido de un mensaje tool con el mismo tool_call_id y continúa la solicitud para generar la respuesta final.",
        "operationId": "createChatCompletionKimi",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Solicitud mínima de Pro",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Solicitud mínima de Highspeed",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "k3": {
                  "summary": "Solicitud mínima de Kimi K3",
                  "value": {
                    "model": "kimi-k3",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "Salida SSE en streaming",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true
                  }
                },
                "multimodal": {
                  "summary": "Imagen de entrada",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAA..."
                            }
                          },
                          {
                            "type": "text",
                            "text": "Describe esta imagen."
                          }
                        ]
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Consulta el tiempo de hoy en Pekín."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "Consultar el tiempo de una ciudad determinada",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "Nombre de la ciudad"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                },
                "web_search": {
                  "summary": "Búsqueda web (sintaxis unificada)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "JSON Schema estricto",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "cache_1h": {
                  "summary": "Escritura automática en caché de 1h (solo serie K3.1)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta de chat completion; las solicitudes en streaming devuelven un flujo de eventos SSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Datos SSE en formato OpenAI Chat Completions, finalizados con `data: [DONE]`."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Modelo que se va a llamar:\n\n| ID del modelo | Características | Esfuerzo de razonamiento |\n|---|---|---|\n| `kimi-k3.1-pro` | Última generación (recomendado) | `low` / `high` / `max`, `max` de forma predeterminada |\n| `kimi-k3.1-pro-highspeed` | Mismos parámetros que Pro, generación más rápida | Igual que `kimi-k3.1-pro` |\n| `kimi-k3` | Generación anterior | Solo `max` |\n\nLos tres modelos tienen una ventana de contexto de 1.048.576 tokens y el razonamiento siempre activado.\n\nEl TTL de escritura de caché (`prompt_cache_options`) solo es compatible con la serie K3.1; `kimi-k3` no admite este parámetro."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Mensajes de la conversación. En conversaciones de varios turnos, incluye los mensajes históricos completos del assistant.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "Máximo de tokens generados, incluidos el razonamiento y la respuesta final. Valor predeterminado: 131072; máximo: 1048576, limitado también por el contexto restante."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "Esfuerzo de razonamiento. El razonamiento siempre está activado.\n\n- `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`: se recomiendan `low` / `high` / `max`; el valor predeterminado es `max`. Por compatibilidad con clientes genéricos, `medium` equivale a `high`, `xhigh` a `max` y `minimal` / `none` a `low`; `none` no desactiva el razonamiento.\n- `kimi-k3`: solo se admite `max` (predeterminado).\n\nUn esfuerzo mayor suele aumentar los tokens de razonamiento y la latencia. Los tokens de razonamiento se incluyen en la salida."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Indica si la respuesta se devuelve como flujo SSE."
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "Herramientas de función o búsqueda web. Declare la búsqueda con {\"type\":\"web_search\"}.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "Controla si el modelo llama a herramientas o fuerza una función concreta."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Opciones de escritura de la caché de contexto, compatibles solo con `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`; `kimi-k3` no admite este parámetro. Si se omite, se escribe automáticamente una caché de 5m de forma predeterminada. Las escrituras y las lecturas se facturan por separado.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "TTL de caché: 5m o 1h; predeterminado: 5m."
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "Formato de salida: text para texto plano, json_object para un objeto JSON o json_schema para salida estructurada conforme a un JSON Schema.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "Formato: text (predeterminado), texto plano; json_object, objeto JSON válido; json_schema, salida conforme al esquema (recomendado; proporcione json_schema)."
              },
              "json_schema": {
                "type": "object",
                "description": "JSON Schema que debe cumplir la salida cuando type es json_schema.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Nombre del esquema usado como identificador."
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "Si se debe cumplir estrictamente el JSON Schema indicado; predeterminado: true."
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema que define la estructura de salida.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "Alias antiguo del límite de salida. Use max_completion_tokens en nuevas solicitudes y evite configurar ambos."
          },
          "temperature": {
            "type": "number",
            "default": 1,
            "description": "Temperatura de muestreo, fijado por el modelo en `1`; no es necesario enviar este campo. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` lo ignoran automáticamente; `kimi-k3` devuelve un error para valores no admitidos."
          },
          "top_p": {
            "type": "number",
            "default": 0.95,
            "description": "Umbral de muestreo nucleus, fijado por el modelo en `0.95`; no es necesario enviar este campo. `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` lo ignoran automáticamente; `kimi-k3` devuelve un error para valores no admitidos."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Rol del mensaje: system, user, assistant o tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "Contenido del mensaje. Usa una cadena para texto plano; usa un array de bloques de contenido para entrada multimodal (texto + imagen + video). En escenarios de llamada de herramientas, el content del assistant puede ser null.",
            "oneOf": [
              {
                "type": "string",
                "description": "Contenido de mensaje de texto plano."
              },
              {
                "type": "array",
                "description": "Array de bloques de contenido multimodal.",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "Contenido de razonamiento del assistant. Devuélvelo sin cambios como parte del mensaje completo del assistant en conversaciones de varios turnos."
          },
          "tool_calls": {
            "type": "array",
            "description": "Llamadas de herramienta devueltas por el assistant. Devuélvelas sin cambios en turnos posteriores.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID de la llamada de herramienta correspondiente cuando `role=tool`."
          }
        }
      },
      "ContentPart": {
        "description": "Bloque de contenido multimodal. `type` determina qué campo se usa.",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string",
                "description": "Contenido de texto cuando `type=text`."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "image_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image_url"
                ]
              },
              "image_url": {
                "description": "Imagen cuando `type=image_url`; también puedes pasar directamente una cadena de URL.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Contenido de imagen como URL data Base64 (data:image/png;base64,...)."
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "video_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "video_url"
                ]
              },
              "video_url": {
                "description": "Video cuando `type=video_url`; también puedes pasar directamente una cadena de URL.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Contenido de video como URL data Base64 (data:video/mp4;base64,...)."
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "Herramienta de búsqueda web."
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de herramienta. Actualmente fijado en function.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Definición de función disponible para el modelo.",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre de la función."
              },
              "description": {
                "type": "string",
                "description": "Descripción que ayuda al modelo a decidir cuándo llamar a la función."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "Definición de parámetros de la función en formato JSON Schema."
              },
              "strict": {
                "type": "boolean",
                "description": "Indica si los argumentos deben seguir estrictamente el JSON Schema de parameters."
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de selección de herramienta con nombre. Valor fijo: function.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Función que el modelo debe llamar.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre de la función que el modelo debe llamar."
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de llamada de herramienta usado para asociar un mensaje tool posterior mediante tool_call_id."
          },
          "type": {
            "type": "string",
            "description": "Tipo de llamada a herramienta: `function` para funciones del cliente; `builtin_function` para la herramienta integrada `$web_search`.",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Función y argumentos solicitados por el modelo.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre de la función."
              },
              "arguments": {
                "type": "string",
                "description": "Argumentos de la función codificados como cadena JSON."
              }
            }
          }
        },
        "description": "Conserve las llamadas completas entre turnos: ID, tipos, nombres de función, argumentos y razonamiento."
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Total de tokens de entrada, incluidos la entrada normal y las lecturas y escrituras de caché. Serie K3.1: entrada normal = prompt_tokens-cached_tokens-cache_write_tokens; `kimi-k3`: entrada normal = prompt_tokens-cached_tokens."
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Incluye tokens de razonamiento."
          },
          "total_tokens": {
            "type": "integer",
            "description": "Total de tokens de entrada y salida."
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Tokens de entrada servidos desde caché."
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "Total de tokens escritos en caché en esta solicitud, incluidas las escrituras de 5m / 1h. La serie K3.1 los factura por separado sin volver a cobrarlos como entrada normal; `kimi-k3` no los distingue y los factura como entrada normal."
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Tokens de razonamiento, ya incluidos en completion_tokens."
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Parámetros de solicitud no válidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
