{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Messages",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Messages",
        "description": "Use Messages para conversaciones de texto básicas. Para imágenes, consulte Chat; para búsqueda web integrada, use Responses.",
        "operationId": "qwen38OmniFlashMessages",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Conversación básica",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "max_tokens": 1024,
                    "messages": [
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parámetros de solicitud no válidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_output_limit": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "invalid_reasoning_effort": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado, token no válido o expirado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_client_key": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "upstream_authentication": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Saldo insuficiente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas solicitudes (límite de tasa)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las API requieren autenticación con Bearer Token##\n\n**Obtener la API Key:**\n\nVisita la [página de gestión de API Keys](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Añadir al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash",
            "description": "Nombre del modelo de chat"
          },
          "messages": {
            "type": "array",
            "description": "Lista no vacía de mensajes user y assistant. Esta referencia cubre contenido de texto sin formato.",
            "items": {
              "$ref": "#/components/schemas/InputMessage"
            },
            "minItems": 1
          },
          "max_tokens": {
            "type": "integer",
            "description": "Máximo de tokens de salida, incluido el razonamiento.",
            "example": 1024,
            "minimum": 1,
            "maximum": 131072
          }
        }
      },
      "InputMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "description": "Rol del mensaje"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "msg_xxxxxxxx"
          },
          "type": {
            "type": "string",
            "example": "message"
          },
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "content": {
            "type": "array",
            "description": "Array de bloques de contenido de la respuesta",
            "items": {
              "$ref": "#/components/schemas/OutputContentBlock"
            }
          },
          "stop_reason": {
            "type": "string",
            "example": "end_turn"
          },
          "usage": {
            "$ref": "#/components/schemas/AnthropicUsage"
          }
        }
      },
      "OutputContentBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "thinking"
            ]
          },
          "text": {
            "type": "string"
          },
          "thinking": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "AnthropicUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
