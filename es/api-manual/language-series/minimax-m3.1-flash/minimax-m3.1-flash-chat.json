  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nombre del modelo de chat",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "Lista de mensajes de la conversación, admite diálogo de múltiples turnos\n\nLos mensajes con diferentes roles tienen distintas estructuras de campos; selecciona el rol correspondiente para verlas",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Profundidad de razonamiento; el valor predeterminado es `max`. Los niveles más altos suelen aumentar el consumo de tokens de razonamiento y el tiempo de respuesta.",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "high"
          },
          "thinking": {
            "type": "object",
            "description": "Modo de razonamiento. MiniMax-M3.1-Flash siempre realiza razonamiento. Solo admite `adaptive`; el campo es opcional.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive"
                ],
                "default": "adaptive"
              }
            }
          },
          "reasoning_split": {
            "type": "boolean",
            "description": "Indica si el razonamiento se devuelve por separado. Solo admite `true`; el razonamiento se devuelve en `reasoning_content`. El campo es opcional.",
            "enum": [
              true
            ],
            "default": true
          },
          "temperature": {
            "type": "number",
            "description": "Temperatura de muestreo; controla la aleatoriedad de la salida\n\n**Notas**:\n- Rango `[0, 2]`; valor predeterminado: 1\n- Los valores más bajos producen respuestas más deterministas; los más altos, respuestas más variadas\n\n**Recomendación**: evita ajustar temperature y top_p al mismo tiempo",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Parámetro de muestreo de núcleo (Nucleus Sampling)\n\n**Notas**:\n- Limita el muestreo al conjunto de tokens que alcanza la probabilidad acumulada indicada\n- Por ejemplo, 0.95 selecciona tokens del conjunto que suma el 95% de probabilidad acumulada\n- Rango `[0, 1]`; valor predeterminado: 0.95\n\n**Recomendación**: evita ajustar temperature y top_p al mismo tiempo",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Límite de tokens de generación, **incluidos el razonamiento y la respuesta**\n\n**Notas**:\n- Recomendado: **131,072** (128K); máximo: **524,288** (512K)\n- Un valor demasiado bajo puede agotar el límite durante el razonamiento y devolver `finish_reason=length` con `content` vacío",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Si se debe devolver la respuesta en modo streaming\n\n- `true`: respuesta en streaming, devuelve el contenido en fragmentos en tiempo real mediante SSE (Server-Sent Events)\n- `false`: espera la respuesta completa antes de devolverla (predeterminado)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "Opciones de la respuesta en streaming\n\nSolo tiene efecto cuando `stream=true`",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Indica si se envía un bloque adicional que solo contiene las estadísticas de `usage` antes de finalizar el flujo."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Lista de definiciones de herramientas para Function Calling\n\nCada herramienta requiere un nombre, una descripción y un esquema de parámetros",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "Estrategia de selección de herramientas. Solo admite `auto`: el modelo decide si debe invocar una herramienta.",
            "enum": [
              "auto"
            ],
            "default": "auto"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Parámetro heredado de límite de longitud de generación\n\n**Nota**: obsoleto, usa `max_completion_tokens` en su lugar",
            "deprecated": true,
            "minimum": 1
          },
          "n": {
            "type": "integer",
            "description": "Número de respuestas generadas. Solo admite `1`.",
            "enum": [
              1
            ],
            "default": 1
          }
        }
      },
      "SystemMessage": {
        "title": "System Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Identificador de rol, fijo como `system`"
          },
          "content": {
            "type": "string",
            "description": "Contenido de la indicación de sistema, usado para definir el rol y el comportamiento de la IA"
          },
          "name": {
            "type": "string",
            "description": "Nombre del participante, usado para distinguir diferentes fuentes de indicaciones de sistema"
          }
        }
      },
      "UserMessage": {
        "title": "User Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Identificador de rol, fijo como `user`"
          },
          "content": {
            "description": "Contenido del mensaje del usuario\n\n**Notas**:\n- Para texto sin formato, pasa una cadena directamente\n- Para entrada multimodal, pasa un arreglo de partes de contenido: `text`, `image_url` (imagen) o `video_url` (video)\n- Tamaño máximo del cuerpo de la solicitud: 64 MB",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Nombre del participante, usado para distinguir diferentes usuarios"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Parte de contenido multimodal. Declara el tipo mediante `type` y completa únicamente los campos que coincidan con ese tipo",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Tipo de contenido\n\n- `text`: bloque de texto\n- `image_url`: entrada de imagen\n- `video_url`: entrada de video"
          },
          "text": {
            "type": "string",
            "description": "Contenido de texto cuando `type=text`"
          },
          "image_url": {
            "type": "object",
            "description": "Entrada de imagen (cuando `type=image_url`). Máximo 10 MB por imagen, admite JPEG / PNG / GIF / WEBP",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "URL de la imagen, o un data URL base64 que empiece por `data:`"
              },
              "detail": {
                "type": "string",
                "description": "Controla la resolución de análisis de la imagen\n\n- `low`: baja precisión, consume menos tokens\n- `default`: precisión predeterminada\n- `high`: alta precisión, reconoce más detalles pero consume más tokens",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Límite máximo de píxeles para el lado más largo de la imagen",
                "minimum": 1
              }
            }
          },
          "video_url": {
            "type": "object",
            "description": "Entrada de video (cuando `type=video_url`). Máximo 50 MB para video por URL / Base64, admite MP4 / AVI / MOV / MKV",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "URL del video, una data URL en base64 que comienza con `data:`, o una referencia de archivo con el formato `mm_file://{file_id}`"
              },
              "detail": {
                "type": "string",
                "description": "Controla la resolución de extracción de fotogramas del video",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "fps": {
                "type": "number",
                "description": "Frecuencia de extracción de fotogramas de video; valor predeterminado: 1, rango: [0.2, 5]. Una frecuencia mayor permite captar mejor los cambios en la imagen y suele aumentar el consumo de tokens.",
                "minimum": 0.2,
                "maximum": 5,
                "default": 1
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Límite máximo de píxeles para el lado más largo de los fotogramas del video",
                "minimum": 1
              }
            }
          }
        }
      },
      "AssistantRequestMessage": {
        "title": "Assistant Message",
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Identificador de rol, fijo como `assistant`"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Contenido del mensaje del asistente\n\n**Notas**:\n- Se usa para pasar respuestas históricas del asistente en conversaciones de múltiples turnos\n- Puede ser `null` cuando hay `tool_calls` presentes"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Razonamiento devuelto en el turno anterior. En conversaciones de varios turnos, reenvíalo sin modificar."
          },
          "name": {
            "type": "string",
            "description": "Nombre del participante"
          },
          "tool_calls": {
            "type": "array",
            "description": "Lista de llamadas a herramientas\n\nSe usa para pasar información histórica de llamadas a herramientas en conversaciones de múltiples turnos",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identificador único de la llamada a la herramienta"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nombre de la función llamada"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Argumentos de la función (cadena JSON)"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ToolMessage": {
        "title": "Tool Message",
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Identificador de rol, fijo como `tool`"
          },
          "content": {
            "type": "string",
            "description": "Contenido del resultado de la llamada a la herramienta"
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID de la llamada a la herramienta\n\nCorresponde al campo `id` devuelto en `tool_calls` del mensaje del asistente"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Tipo de herramienta, actualmente solo se admite `function`"
          },
          "function": {
            "type": "object",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nombre de la función a llamar\n\n**Notas**:\n- Debe estar compuesto por caracteres a-z, A-Z, 0-9, o incluir guiones bajos y guiones\n- La longitud máxima es de 64 caracteres"
              },
              "description": {
                "type": "string",
                "description": "Descripción de la función, ayuda al modelo a entender cuándo y cómo llamar a esta función"
              },
              "parameters": {
                "type": "object",
                "description": "Parámetros de entrada de la función, descritos como un objeto JSON Schema"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único de la generación de chat",
            "example": "0668a381bdc3c0ded310e27c9a46d16e7"
          },
          "model": {
            "type": "string",
            "description": "Nombre del modelo realmente utilizado",
            "example": "MiniMax-M3.1-Flash"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Tipo de respuesta",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Marca de tiempo de creación (segundos Unix)",
            "example": 1777026807
          },
          "choices": {
            "type": "array",
            "description": "Lista de opciones de generación de chat",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "input_sensitive": {
            "type": "boolean",
            "description": "Si el contenido de entrada activó un filtro de palabras sensibles. Si la entrada infringe gravemente las políticas, la API devolverá un error de violación de contenido con el contenido de respuesta vacío"
          },
          "input_sensitive_type": {
            "type": "integer",
            "description": "Tipo de palabra sensible activada por la entrada (se devuelve cuando `input_sensitive` es true): 1 infracción grave; 2 pornografía; 3 publicidad; 4 contenido prohibido; 5 lenguaje abusivo; 6 violencia/terrorismo; 7 otros"
          },
          "output_sensitive": {
            "type": "boolean",
            "description": "Si el contenido de salida activó un filtro de palabras sensibles"
          },
          "output_sensitive_type": {
            "type": "integer",
            "description": "Tipo de palabra sensible activada por la salida"
          },
          "base_resp": {
            "type": "object",
            "description": "Código de estado y detalles del error",
            "properties": {
              "status_code": {
                "type": "integer",
                "description": "Código de estado. `0` indica éxito; otros códigos incluyen `1002` para limitación de frecuencia, `1008` para saldo insuficiente, `1039` para límite de tokens superado, `2013` para error de parámetro, etc."
              },
              "status_msg": {
                "type": "string",
                "description": "Detalles del error"
              }
            }
          },
          "output_sensitive_int": {
            "type": "integer",
            "description": "Identificador numérico del tipo de palabra sensible detectada en la salida."
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Índice de la opción",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Razón de finalización\n\n- `stop`: finalización natural o secuencia de parada activada\n- `length`: se alcanzó el límite máximo de tokens\n- `content_filter`: contenido filtrado por la política de seguridad\n- `tool_calls`: el modelo invocó una herramienta",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "tool_calls"
            ],
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Rol del remitente del mensaje",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Respuesta final, sin el proceso de razonamiento. Puede ser `null` cuando se invoca una herramienta.",
            "example": "0.05"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Contenido de razonamiento. Las preguntas sencillas pueden no generar razonamiento; en ese caso, este campo se omite.",
            "example": "Let the ball cost x. Then 2x + 1 = 1.10, so x = 0.05."
          },
          "name": {
            "type": "string",
            "description": "Nombre del remitente"
          },
          "audio_content": {
            "type": "string",
            "description": "Contenido de audio (cadena vacía en escenarios de conversación solo de texto)"
          },
          "tool_calls": {
            "type": "array",
            "description": "Lista de llamadas a herramientas (se devuelve cuando el modelo decide invocar una herramienta)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identificador único de la llamada a la herramienta"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nombre de la función llamada"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Argumentos de la función (cadena JSON)"
                    }
                  }
                },
                "index": {
                  "type": "integer",
                  "description": "Índice de la llamada a la herramienta"
                }
              }
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Estadísticas de uso de tokens",
        "properties": {
          "total_tokens": {
            "type": "integer",
            "description": "Número total de tokens consumidos",
            "example": 1604
          },
          "total_characters": {
            "type": "integer",
            "description": "Número total de caracteres consumidos",
            "example": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "description": "Total de tokens de entrada, incluidos los reutilizados de la caché.",
            "example": 1365
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Número de tokens de salida (incluida la parte de razonamiento)",
            "example": 239
          },
          "completion_tokens_details": {
            "type": "object",
            "description": "Desglose detallado de los tokens de salida",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Número de tokens generados durante el razonamiento.",
                "example": 49
              }
            }
          },
          "prompt_tokens_details": {
            "type": "object",
            "description": "Desglose detallado de los tokens de entrada",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Número de tokens de entrada reutilizados de la caché\n\nLos tokens reutilizados se facturan a la tarifa de acierto de caché. Los restantes = `prompt_tokens - cached_tokens` se facturan a la tarifa estándar de entrada.",
                "example": 114
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "Código de error de estado HTTP"
              },
              "message": {
                "type": "string",
                "description": "Descripción del error"
              },
              "type": {
                "type": "string",
                "description": "Tipo de error"
              },
              "param": {
                "type": "string",
                "description": "Nombre del parámetro relacionado"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Todas las API requieren autenticación con Bearer Token\n\n**Obtener la API Key:**\n\nVisita la [página de gestión de API Keys](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Añadir al encabezado de la solicitud:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Generación de chat",
      "description": "Endpoints relacionados con la generación de chat de IA"
    }
  ]
}
