{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - API compatible con Anthropic",
    "description": "Llame a Kimi K3.1 Pro / Highspeed mediante Anthropic Messages con `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`. Ambos ofrecen un contexto de 1.048.576 tokens y admiten conversaciones de varios turnos, streaming, herramientas, búsqueda web, salida estructurada y caché de contexto.\n\nEl razonamiento siempre está activo. `output_config.effort` admite `low` / `high` / `max`, con `max` como predeterminado. Conserve todo el historial de razonamiento y herramientas entre turnos.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Producción (recomendado)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternativa"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "API Messages de Kimi K3.1 Pro / Highspeed",
        "description": "Endpoint público: POST /v1/messages. Configure el esfuerzo en output_config.effort y el TTL de escritura de 5m/1h en cache_control de nivel superior. Conserve completos thinking, signature, tool_use y los bloques de resultados de búsqueda del servidor.",
        "operationId": "createMessageKimiK31Pro",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Solicitud mínima de Pro",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Solicitud mínima de Highspeed",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "Streaming SSE de Anthropic",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "Caché de 1h de nivel superior",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "cache_control": {
                      "type": "ephemeral",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Búsqueda web del lado del servidor",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "tools": [
                      {
                        "type": "web_search_20250305",
                        "name": "web_search",
                        "max_uses": 1
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Salida estructurada estricta",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low",
                      "format": {
                        "type": "json_schema",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta Message; las solicitudes en streaming devuelven un flujo de eventos Anthropic SSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "La secuencia de eventos suele incluir message_start, content_block_*, message_delta y message_stop."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Use `kimi-k3.1-pro` o `kimi-k3.1-pro-highspeed`; Highspeed genera más rápido."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Número máximo de tokens permitidos para esta generación, incluidos thinking y el texto final.",
            "maximum": 1048576
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Lista de mensajes de Anthropic Messages. En conversaciones de varios turnos, devuelve sin cambios los bloques de contenido completos del assistant.",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "system": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessagesTextBlockParam"
                }
              }
            ],
            "description": "Prompt de sistema como cadena o array de bloques text."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Indica si se devuelve un flujo de eventos Anthropic SSE."
          },
          "tools": {
            "type": "array",
            "description": "Funciones personalizadas o búsqueda web del servidor. La búsqueda integrada usa type=web_search_20250305 y name=web_search; se cobra por llamada realizada.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Tool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "description": "Secuencias de parada: una coincidencia exacta detiene la generación y se excluye de la salida. Máximo 5 secuencias, de hasta 32 bytes cada una."
          },
          "cache_control": {
            "type": "object",
            "description": "Solo cache_control de nivel superior controla el TTL de escritura; las marcas en bloques de mensaje no lo sustituyen. Si se omite: 5m.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ephemeral"
                ],
                "description": "Tipo de caché, siempre ephemeral."
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "TTL de caché: 5m o 1h; predeterminado: 5m."
              }
            },
            "required": [
              "type"
            ]
          },
          "output_config": {
            "type": "object",
            "description": "Configuración de salida: esfuerzo de razonamiento y salida estructurada.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "Esfuerzo de razonamiento: se recomienda low / high / max; predeterminado: max. El razonamiento siempre está activo. Alias: medium se convierte en high, xhigh en max y minimal / none en low. none no desactiva el razonamiento. Un mayor esfuerzo suele aumentar los tokens de razonamiento y la latencia. Estos tokens cuentan como salida."
              },
              "format": {
                "type": "object",
                "description": "Salida estructurada. Al configurarlo, el modelo devuelve JSON que sigue estrictamente el JSON Schema proporcionado.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema que debe cumplir la salida.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "type",
                  "schema"
                ]
              }
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Rol del mensaje. Solo se admiten user y assistant.",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "description": "Contenido del mensaje como texto plano o como array de bloques de contenido Anthropic.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlock"
                }
              }
            ]
          }
        }
      },
      "ContentBlock": {
        "description": "Bloque de contenido de Anthropic para texto, imagen, razonamiento, uso de herramientas o resultados de herramientas.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/ImageBlock"
          },
          {
            "$ref": "#/components/schemas/ThinkingBlock"
          },
          {
            "$ref": "#/components/schemas/ToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/ToolResultBlock"
          },
          {
            "$ref": "#/components/schemas/ServerToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/WebSearchResultBlock"
          }
        ]
      },
      "TextBlock": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de bloque de contenido. Valor fijo: text.",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "description": "Contenido de texto."
          }
        }
      },
      "ImageBlock": {
        "type": "object",
        "required": [
          "type",
          "source"
        ],
        "description": "Bloque de contenido de imagen (entrada multimodal).",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ],
            "description": "Tipo de bloque de contenido. Valor fijo: image."
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "Origen de la imagen.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "base64",
                  "url"
                ],
                "description": "Origen de imagen: base64 para datos integrados, url para una referencia de archivo."
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/gif",
                  "image/webp"
                ],
                "description": "Tipo MIME de la imagen cuando `type=base64`."
              },
              "data": {
                "type": "string",
                "description": "Datos Base64 de la imagen cuando `type=base64` (sin el prefijo `data:`)."
              },
              "url": {
                "type": "string",
                "description": "Referencia de archivo de imagen, solo cuando type=url."
              }
            }
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de bloque de contenido. Valor fijo: thinking.",
            "enum": [
              "thinking"
            ]
          },
          "thinking": {
            "type": "string",
            "description": "Contenido de razonamiento del modelo. Devuélvelo sin cambios junto con la firma en conversaciones de varios turnos."
          },
          "signature": {
            "type": "string",
            "description": "En conversaciones de varios turnos, devuélvelo sin cambios junto con el bloque thinking."
          }
        }
      },
      "ToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de bloque de contenido. Valor fijo: tool_use.",
            "enum": [
              "tool_use"
            ]
          },
          "id": {
            "type": "string",
            "description": "ID de tool_use referenciado al devolver el resultado."
          },
          "name": {
            "type": "string",
            "description": "Nombre de la herramienta solicitada por el modelo."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Objeto de entrada de herramienta generado por el modelo."
          }
        }
      },
      "ToolResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo de bloque de contenido. Valor fijo: tool_result.",
            "enum": [
              "tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string",
            "description": "ID del bloque tool_use correspondiente."
          },
          "content": {
            "description": "Resultado de herramienta como cadena o array de bloques de texto e imagen.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextBlock"
                    },
                    {
                      "$ref": "#/components/schemas/ImageBlock"
                    }
                  ]
                }
              }
            ]
          },
          "is_error": {
            "type": "boolean",
            "default": false,
            "description": "Indica si la ejecución de la herramienta ha fallado."
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "name",
          "input_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nombre de la herramienta."
          },
          "description": {
            "type": "string",
            "description": "Descripción que ayuda al modelo a decidir cuándo usar la herramienta."
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": true,
            "description": "Definición de parámetros de la herramienta en formato JSON Schema."
          }
        }
      },
      "ToolChoice": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Selección de herramientas: auto deja decidir al modelo, any exige una llamada y none desactiva las herramientas.",
            "enum": [
              "auto",
              "any",
              "none"
            ],
            "default": "auto"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ]
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use",
              "refusal",
              null
            ]
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens de entrada normal, excluidas lecturas y escrituras de caché. Las tres categorías son excluyentes; no vuelva a restar los tokens de caché."
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "Tokens de entrada escritos en caché."
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "Tokens de entrada servidos desde caché."
          },
          "output_tokens": {
            "type": "integer",
            "description": "Tokens de salida, incluidos los tokens de thinking."
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "thinking_tokens": {
                "type": "integer"
              }
            }
          },
          "cache_creation": {
            "type": "object",
            "properties": {
              "ephemeral_5m_input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "ephemeral_1h_input_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "Las dos categorías de escritura de cache_creation_input_tokens, facturadas según su TTL real."
          },
          "server_tool_use": {
            "type": "object",
            "properties": {
              "web_search_requests": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "Uso de búsqueda de esta respuesta."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_20250305"
            ]
          },
          "name": {
            "type": "string",
            "enum": [
              "web_search"
            ]
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "description": "Máximo de búsquedas permitidas en esta respuesta."
          }
        }
      },
      "ServerToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "server_tool_use"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebSearchResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string"
          },
          "content": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              {
                "type": "object",
                "additionalProperties": true,
                "description": "Objeto de error de búsqueda con type=web_search_tool_result_error."
              }
            ]
          }
        }
      },
      "MessagesTextBlockParam": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Parámetros de solicitud inválidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "La API Key no existe o no es válida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Límite de solicitudes superado o cuota insuficiente",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Error interno del servicio",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Todas las interfaces requieren autenticación mediante Bearer Token##\n\n**Obtención de la API Key**:\n\nVisita la [página de gestión de API Key](https://evolink.ai/dashboard/keys) para obtener tu API Key\n\n**Al usarla, añádela en la cabecera de la solicitud**:\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "API compatible con Anthropic Messages"
    }
  ]
}
