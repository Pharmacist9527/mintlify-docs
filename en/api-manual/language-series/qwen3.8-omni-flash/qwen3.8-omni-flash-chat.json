{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Chat Completions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Chat Completions",
        "description": "Use Qwen3.8 Omni Flash through EvoLink for text and image analysis with configurable reasoning. Compare request costs and choose Chat Completions or Responses before integrating.\n\nImplicit caching can apply to reusable prefixes of at least 1024 tokens. Cache hits use a separate rate; there is no cache creation charge. A hit is not guaranteed.\n\nUse Responses with a web_search tool for web search. Chat accepts only the agent search strategy. Chat thinking plus search returned 400 without streaming; the tested stream lacked complete usage and an end marker. Do not rely on Chat search for complete billing records. Search shares a 15 RPS account limit; excess requests may return without searching.",
        "operationId": "qwen38OmniFlashChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic text conversation",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "system",
                        "content": "You are a helpful assistant."
                      },
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                },
                "multimodal": {
                  "summary": "Multimodal input (image)",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Describe the content of this image"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://dashscope.oss-cn-beijing.aliyuncs.com/images/dog_and_girl.jpeg"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_output_limit": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "invalid_reasoning_effort": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_client_key": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "upstream_authentication": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests (rate limited)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##All APIs require Bearer Token authentication##\n\n**Get API Key**:\n\nVisit [API Key Management Page](https://evolink.ai/dashboard/keys) to get your API Key\n\n**Add to request header**:\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Chat model name",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash"
          },
          "messages": {
            "type": "array",
            "description": "List of conversation messages, supporting multi-turn conversations. Messages from different roles (system / user / assistant / tool) have different field structures; select the corresponding role to view details.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ]
            },
            "minItems": 1
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Maximum output tokens, including reasoning.",
            "minimum": 1,
            "maximum": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to return the response in a streaming manner.\n\n- `true`: returned chunk by chunk via SSE (Server-Sent Events)\n- `false` (default): returns the full response at once",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "description": "Streaming response options, effective only when `stream=true`.",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Requests a final usage block. The tested Chat search stream did not include complete usage or an end marker."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "List of tool definitions for Function Calling. Each tool must define a name, description, and parameter schema.",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "xhigh",
            "description": "Chat reasoning_effort accepts none, minimal, low, medium, high, xhigh, and max, with xhigh as the default. Do not combine it with thinking_budget. Responses uses reasoning.effort."
          },
          "preserve_thinking": {
            "type": "boolean",
            "default": true,
            "description": "The context window is capacity, not a target input size. Input limits depend on the protocol and reasoning mode. Chat defaults to xhigh; preserve_thinking is enabled by default and returned reasoning in history counts as input."
          }
        }
      },
      "SystemMessage": {
        "type": "object",
        "title": "System Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Message role, fixed to `system`"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "UserMessage": {
        "type": "object",
        "title": "User Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Message role, fixed to `user`"
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          }
        }
      },
      "AssistantRequestMessage": {
        "type": "object",
        "title": "Assistant Message",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Message role, fixed to `assistant`"
          },
          "content": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "description": "List of tool calls initiated by the assistant in the previous turn (used to backfill Function Calling history).",
            "items": {
              "type": "object"
            }
          },
          "reasoning_content": {
            "type": "string",
            "description": "The context window is capacity, not a target input size. Input limits depend on the protocol and reasoning mode. Chat defaults to xhigh; preserve_thinking is enabled by default and returned reasoning in history counts as input."
          }
        }
      },
      "ToolMessage": {
        "type": "object",
        "title": "Tool Message",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Message role, fixed to `tool` (tool execution result)"
          },
          "content": {
            "description": "Tool execution result content. Can be a string or a content part array.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID of the corresponding tool call"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url"
            ]
          },
          "text": {
            "type": "string",
            "description": "Text content when `type=text`"
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Image URL, or a base64 data URL starting with `data:`"
              }
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Function Calling tool definition.",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Tool type, fixed to `function`"
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Function name"
              },
              "description": {
                "type": "string",
                "description": "Description of the function's purpose"
              },
              "parameters": {
                "type": "object",
                "description": "JSON Schema of the function parameters"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this conversation",
            "example": "chatcmpl-xxxxxxxx"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Creation time (Unix seconds)",
            "example": 1735120033
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Stop reason\n\n- `stop`: normal completion\n- `length`: reached the `max_completion_tokens` limit\n- `tool_calls`: a tool call is required",
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "description": "Assistant reply message.",
        "properties": {
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "Reply body"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Reasoning text returned with the response."
          },
          "tool_calls": {
            "type": "array",
            "description": "List of tool calls initiated by the model",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer"
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
