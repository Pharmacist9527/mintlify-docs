  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Chat model name\n\n**Note**: `MiniMax-M3.1-Flash` is a preview model, and its behavior may change",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "List of conversation messages, supports multi-turn dialogue\n\nMessages with different roles have different field structures; select the corresponding role to view",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Thinking depth\n\nMiniMax-M3.1-Flash always thinks; this field only sets how deeply it thinks\n\n- `low`: Shallowest thinking, fastest response, fewest output tokens\n- `medium` / `high` / `xhigh`: Progressively deeper thinking\n- `max` (default): Deepest thinking, slowest response, most output tokens\n\n**Notes**:\n- Defaults to `max` when omitted; for simple tasks, a lower level reduces latency and output tokens\n- Thinking tokens are billed as output tokens and count toward `max_completion_tokens`\n- `none` and `minimal` do not turn thinking off: EvoLink changes them to `low`",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "medium"
          },
          "thinking": {
            "type": "object",
            "description": "Thinking settings (optional)\n\nMiniMax-M3.1-Flash always thinks, so this field can be omitted. Use `reasoning_effort` to set the thinking depth\n\n**Notes**:\n- Thinking is returned in `reasoning_content`, separate from `content`\n- Thinking tokens are billed as output tokens",
            "properties": {
              "type": {
                "type": "string",
                "description": "Thinking mode\n\n- `adaptive`: Thinking on (same as omitting the field)\n- `disabled`: Does **not** turn thinking off. EvoLink removes `thinking` and, if `reasoning_effort` is not set, sets it to `low`. Thinking still runs and is billed as output tokens",
                "enum": [
                  "adaptive",
                  "disabled"
                ],
                "default": "adaptive"
              }
            }
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature, controls output randomness\n\n**Notes**:\n- Lower values (e.g. 0.2): More deterministic, focused output\n- Higher values (e.g. 1.5): More random, creative output\n- Range: `[0, 2]`, default 1",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus Sampling parameter\n\n**Notes**:\n- Controls sampling from tokens with cumulative probability\n- e.g. 0.95 means selecting from tokens reaching 95% cumulative probability\n- Range: `[0, 1]`, MiniMax-M3.1-Flash default 0.95\n\n**Recommendation**: Do not adjust temperature and top_p simultaneously",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Upper limit for generated content length (in tokens), including thinking\n\n**Notes**:\n- Maximum **524,288** (512K); recommended up to **131,072** (128K)\n- If omitted, EvoLink uses **32768**\n- Thinking tokens count toward this limit. With a small value and a high `reasoning_effort`, thinking can use up the limit, and the response ends with `finish_reason: \"length\"` and an empty `content`\n- Use 32768 or higher, and lower `reasoning_effort` for simple tasks",
            "minimum": 1,
            "maximum": 524288,
            "example": 32768
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to return the response in streaming mode\n\n- `true`: Streaming response, returns content in real-time chunks via SSE (Server-Sent Events)\n- `false`: Wait for complete response before returning (default)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "Streaming response options\n\nOnly effective when `stream=true`",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Return an additional chunk containing only `usage` statistics at the end of the stream"
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Tool definition list for Function Calling\n\nEach tool requires a name, description, and parameter schema",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "Legacy generation length limit parameter\n\n**Note**: Deprecated, please use `max_completion_tokens` instead. It behaves the same way: thinking tokens count toward it, and if neither field is set, EvoLink uses 32768",
            "deprecated": true,
            "minimum": 1
          }
        }
      },
      "SystemMessage": {
        "title": "System Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Role identifier, fixed as `system`"
          },
          "content": {
            "type": "string",
            "description": "System prompt content, used to set the AI's role and behavior"
          },
          "name": {
            "type": "string",
            "description": "Participant name, used to distinguish different system prompt sources"
          }
        }
      },
      "UserMessage": {
        "title": "User Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Role identifier, fixed as `user`"
          },
          "content": {
            "description": "User message content\n\n**Notes**:\n- For plain text, pass a string directly\n- For multimodal, pass a content part array supporting `text` / `image_url` / `video_url`",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Participant name, used to distinguish different users"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Multimodal content part. Declare the type via `type` and fill in only the fields matching that type",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Content type\n\n- `text`: Text block\n- `image_url`: Image input\n- `video_url`: Video input"
          },
          "text": {
            "type": "string",
            "description": "Text content when `type=text`"
          },
          "image_url": {
            "type": "object",
            "description": "Image input (when `type=image_url`). Maximum 10 MB per image, supports JPEG / PNG / GIF / WEBP",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Image URL, or a base64 data URL starting with `data:`"
              },
              "detail": {
                "type": "string",
                "description": "Controls image parsing resolution\n\n- `low`: Low precision, consumes fewer tokens\n- `default`: Default precision\n- `high`: High precision, recognizes more detail but consumes more tokens",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximum pixel limit for the longest side of the image",
                "minimum": 1
              }
            }
          },
          "video_url": {
            "type": "object",
            "description": "Video input (when `type=video_url`). Maximum 50 MB for URL / Base64 video, supports MP4 / AVI / MOV / MKV",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Video URL, or a base64 data URL starting with `data:`"
              },
              "detail": {
                "type": "string",
                "description": "Controls video frame extraction resolution",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "fps": {
                "type": "number",
                "description": "Video frame extraction rate, default 1, range [0.2, 5]\n\n- Higher values: More sensitive to visual changes, higher token cost and slower speed\n- Lower values: Lower token cost and faster speed, but less sensitive to visual changes",
                "minimum": 0.2,
                "maximum": 5,
                "default": 1
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximum pixel limit for the longest side of video frames",
                "minimum": 1
              }
            }
          }
        }
      },
      "AssistantRequestMessage": {
        "title": "Assistant Message",
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Role identifier, fixed as `assistant`"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Assistant message content\n\n**Notes**:\n- Used to pass historical assistant replies in multi-turn conversations\n- Can be `null` when `tool_calls` is present"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Thinking content of this historical assistant reply\n\n**Notes**:\n- In multi-turn tool calling, send back the full assistant message returned by the model, including `reasoning_content` and `tool_calls`, so the model can continue its reasoning"
          },
          "name": {
            "type": "string",
            "description": "Participant name"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool call list\n\nUsed to pass historical tool call information in multi-turn conversations",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the tool call"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the called function"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Function arguments (JSON string)"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ToolMessage": {
        "title": "Tool Message",
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Role identifier, fixed as `tool`"
          },
          "content": {
            "type": "string",
            "description": "Content of the tool call result"
          },
          "tool_call_id": {
            "type": "string",
            "description": "Tool call ID\n\nCorresponds to the `id` field returned in `tool_calls` of the assistant message"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Tool type, currently only `function` is supported"
          },
          "function": {
            "type": "object",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the function to call\n\n**Notes**:\n- Must consist of a-z, A-Z, 0-9 characters, or include underscores and hyphens\n- Maximum length is 64 characters"
              },
              "description": {
                "type": "string",
                "description": "Function description, helps the model understand when and how to call this function"
              },
              "parameters": {
                "type": "object",
                "description": "Function input parameters, described as a JSON Schema object"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the chat completion",
            "example": "0668a381bdc3c0ded310e27c9a46d16e7"
          },
          "model": {
            "type": "string",
            "description": "Model name actually used",
            "example": "MiniMax-M3.1-Flash"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Response type",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Creation timestamp (Unix seconds)",
            "example": 1777026807
          },
          "choices": {
            "type": "array",
            "description": "List of chat completion choices",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "input_sensitive": {
            "type": "boolean",
            "description": "Whether the input content triggered a sensitive word filter. If the input severely violates policies, the API will return a content violation error with empty response content"
          },
          "input_sensitive_type": {
            "type": "integer",
            "description": "Type of sensitive word triggered by input (returned when `input_sensitive` is true): 1 severe violation; 2 pornography; 3 advertising; 4 prohibited content; 5 abusive language; 6 violence/terrorism; 7 other"
          },
          "output_sensitive": {
            "type": "boolean",
            "description": "Whether the output content triggered a sensitive word filter"
          },
          "output_sensitive_type": {
            "type": "integer",
            "description": "Type of sensitive word triggered by output"
          },
          "base_resp": {
            "type": "object",
            "description": "Status code and error details",
            "properties": {
              "status_code": {
                "type": "integer",
                "description": "Status code. `0` indicates success; other codes include `1002` for rate limiting, `1008` for insufficient balance, `1039` for token limit exceeded, `2013` for parameter error, etc."
              },
              "status_msg": {
                "type": "string",
                "description": "Error details"
              }
            }
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Choice index",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Finish reason\n\n- `stop`: Natural completion or stop sequence triggered\n- `length`: Reached the output-token limit (thinking included); if the limit was used up while thinking, `content` is empty\n- `content_filter`: Content filtered by safety policy\n- `tool_calls`: Model invoked a tool",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "tool_calls"
            ],
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Role of the message sender",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Final answer (does not include thinking). May be empty or `null` when a tool call is triggered, or when the output-token limit is used up while thinking",
            "example": "Hello! I'm MiniMax-M3.1-Flash, and I can help you with conversation, writing, reasoning, coding, and many other tasks."
          },
          "reasoning_content": {
            "type": "string",
            "description": "Thinking content. Always returned for MiniMax-M3.1-Flash, separate from `content` (`content` contains no `<think>` tags). In streaming responses, it arrives in `delta.reasoning_content`",
            "example": "Let me analyze this problem..."
          },
          "name": {
            "type": "string",
            "description": "Sender name"
          },
          "audio_content": {
            "type": "string",
            "description": "Audio content (empty string for text-only conversation scenarios)"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool call list (returned when the model decides to invoke a tool)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the tool call"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the called function"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Function arguments (JSON string)"
                    }
                  }
                },
                "index": {
                  "type": "integer",
                  "description": "Tool call index"
                }
              }
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Token usage statistics",
        "properties": {
          "total_tokens": {
            "type": "integer",
            "description": "Total number of tokens consumed",
            "example": 1604
          },
          "total_characters": {
            "type": "integer",
            "description": "Total number of characters consumed",
            "example": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "description": "Number of tokens in the input",
            "example": 1365
          },
          "completion_tokens": {
            "type": "integer",
