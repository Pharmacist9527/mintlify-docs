{
  "openapi": "3.1.0",
  "info": {
    "title": "MiniMax-M3.1-Flash API Reference (OpenAI Compatible)",
    "description": "Complete API reference for MiniMax-M3.1-Flash chat completions.\n\n**Model capabilities**:\n- Context window: **1,000,000 tokens** (1M)\n- Maximum output: **524,288 tokens** (512K); **131,072 tokens** (128K) recommended, including reasoning tokens\n- Reasoning: always enabled; adjust depth with `reasoning_effort`, which defaults to `max`\n- Multimodal input: text, images, and video\n- Tool calling: Function Calling\n- Context caching: matching prefixes are cached automatically; cached tokens are reported in `usage.prompt_tokens_details.cached_tokens`\n- Streaming: SSE responses\n\nFor multi-turn conversations, include the complete assistant message from the previous turn in `messages`, preserving `reasoning_content` and `tool_calls`.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (Recommended)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "MiniMax-M3.1-Flash Chat Completions (OpenAI Compatible)",
        "description": "- Call MiniMax-M3.1-Flash using the OpenAI Chat Completions protocol\n- **Conversations**: single-turn and multi-turn conversations\n- **System prompts**: set the assistant's role and behavior with `role=system`\n- **Multimodal input**: combine text, images, and video in `content`\n- **Reasoning**: always enabled; adjust depth with `reasoning_effort`. Reasoning is returned in `reasoning_content`; `content` contains only the final answer\n- **Streaming**: SSE responses\n- **Tool calling**: Function Calling\n\n**Streaming responses**: With `stream=true`, each SSE message uses the format `data: {JSON}`, followed by `data: [DONE]` at the end. `choices[].delta` returns incremental `reasoning_content`, then `content` / `tool_calls`. Set `stream_options.include_usage=true` to receive an additional chunk containing `usage` before the stream ends.",
        "operationId": "createChatCompletionMiniMaxM31Flash",
        "tags": [
          "Chat Completion"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple_text": {
                  "summary": "Single-turn text conversation",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Please introduce yourself."
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "multi_turn": {
                  "summary": "Multi-turn conversation (context understanding)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "What is Python?"
                      },
                      {
                        "role": "assistant",
                        "content": "Python is a high-level programming language."
                      },
                      {
                        "role": "user",
                        "content": "What are its main advantages?"
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "system_prompt": {
                  "summary": "Using system prompts",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "system",
                        "content": "You are a Python programming assistant. Keep your answers concise."
                      },
                      {
                        "role": "user",
                        "content": "How do I read a file?"
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "reasoning_effort": {
                  "summary": "Adjust reasoning depth",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "reasoning_effort": "high",
                    "messages": [
                      {
                        "role": "user",
                        "content": "A bat and a ball cost 1.10 in total. The bat costs 1.00 more than the ball. How much does the ball cost?"
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "image_understanding": {
                  "summary": "Image understanding (multimodal input)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "What is shown in this image?"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://example.com/image.jpeg",
                              "detail": "default"
                            }
                          }
                        ]
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "video_understanding": {
                  "summary": "Video understanding (multimodal input)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Summarize this video."
                          },
                          {
                            "type": "video_url",
                            "video_url": {
                              "url": "https://example.com/video.mp4",
                              "fps": 1,
                              "detail": "default"
                            }
                          }
                        ]
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "tool_calling": {
                  "summary": "Function Calling (tool invocation)",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Check the stock for product demo-item-001."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_product_stock",
                          "description": "Get the current stock level for a product.",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "product_id": {
                                "type": "string",
                                "description": "Product identifier."
                              }
                            },
                            "required": [
                              "product_id"
                            ]
                          }
                        }
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                },
                "streaming": {
                  "summary": "Streaming output",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Write a short poem about spring."
                      }
                    ],
                    "max_completion_tokens": 131072
                  }
                }
              }
            }
          }
        },
