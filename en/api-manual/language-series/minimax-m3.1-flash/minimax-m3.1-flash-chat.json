  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Chat model name",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "List of conversation messages, supports multi-turn dialogue\n\nMessages with different roles have different field structures; select the corresponding role to view",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Reasoning depth. Defaults to `max`. Higher levels typically increase reasoning token usage and response time.",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "high"
          },
          "thinking": {
            "type": "object",
            "description": "Reasoning mode. MiniMax-M3.1-Flash always uses reasoning. Only `adaptive` is supported; this field may be omitted.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive"
                ],
                "default": "adaptive"
              }
            }
          },
          "reasoning_split": {
            "type": "boolean",
            "description": "Return reasoning separately. Only `true` is supported. Reasoning is returned in `reasoning_content`; this field may be omitted.",
            "enum": [
              true
            ],
            "default": true
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature controls output randomness.\n\n- Range: `[0, 2]`; default: 1\n- Lower values produce more deterministic output; higher values produce more varied output\n\nAdjust either `temperature` or `top_p`, rather than both.",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus sampling threshold.\n\n- Samples from tokens whose cumulative probability reaches this threshold\n- For example, 0.95 samples from tokens accounting for 95% of the probability mass\n- Range: `[0, 1]`; default: 0.95\n\nAdjust either `temperature` or `top_p`, rather than both.",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Maximum number of generated tokens, **including reasoning and the final answer**.\n\n- Recommended: **131,072** (128K); maximum: **524,288** (512K)\n- A small budget may be exhausted during reasoning, resulting in `finish_reason=length` and an empty `content` field",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to return the response in streaming mode\n\n- `true`: Streaming response, returns content in real-time chunks via SSE (Server-Sent Events)\n- `false`: Wait for complete response before returning (default)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "Streaming response options\n\nOnly effective when `stream=true`",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Include an additional chunk containing only `usage` statistics before the stream ends."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Tool definition list for Function Calling\n\nEach tool requires a name, description, and parameter schema",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "Tool selection strategy. Only `auto` is supported; the model decides whether to call a tool.",
            "enum": [
              "auto"
            ],
            "default": "auto"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Legacy generation length limit parameter\n\n**Note**: Deprecated, please use `max_completion_tokens` instead",
            "deprecated": true,
            "minimum": 1
          },
          "n": {
            "type": "integer",
            "description": "Number of responses to generate. Only `1` is supported.",
            "enum": [
              1
            ],
            "default": 1
          }
        }
      },
      "SystemMessage": {
        "title": "System Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Role identifier, fixed as `system`"
          },
          "content": {
            "type": "string",
            "description": "System prompt content, used to set the AI's role and behavior"
          },
          "name": {
            "type": "string",
            "description": "Participant name, used to distinguish different system prompt sources"
          }
        }
      },
      "UserMessage": {
        "title": "User Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Role identifier, fixed as `user`"
          },
          "content": {
            "description": "User message content.\n\n- Use a string for plain text\n- Use an array of content parts for multimodal input: `text`, `image_url`, or `video_url`\n- Maximum request body size: 64 MB",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Participant name, used to distinguish different users"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Multimodal content part. Declare the type via `type` and fill in only the fields matching that type",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Content type\n\n- `text`: Text block\n- `image_url`: Image input\n- `video_url`: Video input"
          },
          "text": {
            "type": "string",
            "description": "Text content when `type=text`"
          },
          "image_url": {
            "type": "object",
            "description": "Image input (when `type=image_url`). Maximum 10 MB per image, supports JPEG / PNG / GIF / WEBP",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Image URL, or a base64 data URL starting with `data:`"
              },
              "detail": {
                "type": "string",
                "description": "Controls image parsing resolution\n\n- `low`: Low precision, consumes fewer tokens\n- `default`: Default precision\n- `high`: High precision, recognizes more detail but consumes more tokens",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximum pixel limit for the longest side of the image",
                "minimum": 1
              }
            }
          },
          "video_url": {
            "type": "object",
            "description": "Video input (when `type=video_url`). Maximum 50 MB for URL / Base64 video, supports MP4 / AVI / MOV / MKV",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "Video URL, a base64 data URL starting with `data:`, or a file reference in the format `mm_file://{file_id}`"
              },
              "detail": {
                "type": "string",
                "description": "Controls video frame extraction resolution",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "fps": {
                "type": "number",
                "description": "Video frame sampling rate. Defaults to 1; range: [0.2, 5]. Higher rates help capture changes in the video and typically increase token usage.",
                "minimum": 0.2,
                "maximum": 5,
                "default": 1
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Maximum pixel limit for the longest side of video frames",
                "minimum": 1
              }
            }
          }
        }
      },
      "AssistantRequestMessage": {
        "title": "Assistant Message",
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Role identifier, fixed as `assistant`"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Assistant message content\n\n**Notes**:\n- Used to pass historical assistant replies in multi-turn conversations\n- Can be `null` when `tool_calls` is present"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Reasoning content from the previous turn. Preserve it when sending conversation history."
          },
          "name": {
            "type": "string",
            "description": "Participant name"
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool call list\n\nUsed to pass historical tool call information in multi-turn conversations",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique identifier for the tool call"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the called function"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Function arguments (JSON string)"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ToolMessage": {
        "title": "Tool Message",
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Role identifier, fixed as `tool`"
          },
          "content": {
            "type": "string",
            "description": "Content of the tool call result"
          },
          "tool_call_id": {
            "type": "string",
            "description": "Tool call ID\n\nCorresponds to the `id` field returned in `tool_calls` of the assistant message"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Tool type, currently only `function` is supported"
          },
          "function": {
            "type": "object",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the function to call\n\n**Notes**:\n- Must consist of a-z, A-Z, 0-9 characters, or include underscores and hyphens\n- Maximum length is 64 characters"
              },
              "description": {
                "type": "string",
                "description": "Function description, helps the model understand when and how to call this function"
              },
              "parameters": {
                "type": "object",
                "description": "Function input parameters, described as a JSON Schema object"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the chat completion",
            "example": "0668a381bdc3c0ded310e27c9a46d16e7"
          },
          "model": {
            "type": "string",
            "description": "Model name actually used",
            "example": "MiniMax-M3.1-Flash"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Response type",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Creation timestamp (Unix seconds)",
            "example": 1777026807
          },
          "choices": {
            "type": "array",
            "description": "List of chat completion choices",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "input_sensitive": {
            "type": "boolean",
            "description": "Whether the input content triggered a sensitive word filter. If the input severely violates policies, the API will return a content violation error with empty response content"
          },
          "input_sensitive_type": {
            "type": "integer",
            "description": "Type of sensitive word triggered by input (returned when `input_sensitive` is true): 1 severe violation; 2 pornography; 3 advertising; 4 prohibited content; 5 abusive language; 6 violence/terrorism; 7 other"
          },
          "output_sensitive": {
            "type": "boolean",
            "description": "Whether the output content triggered a sensitive word filter"
          },
          "output_sensitive_type": {
            "type": "integer",
            "description": "Type of sensitive word triggered by output"
          },
          "base_resp": {
            "type": "object",
            "description": "Status code and error details",
            "properties": {
              "status_code": {
                "type": "integer",
                "description": "Status code. `0` indicates success; other codes include `1002` for rate limiting, `1008` for insufficient balance, `1039` for token limit exceeded, `2013` for parameter error, etc."
              },
              "status_msg": {
                "type": "string",
                "description": "Error details"
              }
            }
          },
          "output_sensitive_int": {
            "type": "integer",
            "description": "Numeric identifier for the output content sensitivity category."
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Choice index",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Finish reason\n\n- `stop`: Natural completion or stop sequence triggered\n- `length`: Reached maximum token limit\n- `content_filter`: Content filtered by safety policy\n- `tool_calls`: Model invoked a tool",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "tool_calls"
            ],
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
