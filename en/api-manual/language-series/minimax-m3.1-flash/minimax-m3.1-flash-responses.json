      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##All APIs require Bearer Token authentication##\n\n**Get API Key:**\n\nVisit [API Key Management Page](https://evolink.ai/dashboard/keys) to get your API Key\n\n**Add to request header:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model ID\n\n**Note**: `MiniMax-M3.1-Flash` is a preview model, and its behavior may change",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "input": {
            "type": [
              "string",
              "array"
            ],
            "description": "Model input\n\n- **String form**: the whole text is treated as a single `user` message\n- **Array form**: a list of input items supporting four types: `message`, `function_call`, `function_call_output`, `reasoning`\n\n**Multimodal input**: a `message` item may mix `input_text`, `input_image`, and `input_video` parts in its `content` array.\n\n**Multi-turn conversations**: the endpoint is stateless, so continuing a conversation requires putting the full history into the array. In multi-turn tool calling, add the previous response's `output` items (including `reasoning` items) unchanged.",
            "items": {
              "$ref": "#/components/schemas/InputItem"
            },
            "example": "Introduce Hangzhou in one sentence."
          },
          "instructions": {
            "type": "string",
            "description": "System-level instructions, equivalent to a system message inserted at the very front; used to set the role, tone and output constraints.",
            "example": "You are a meticulous technical writer. Keep answers concise."
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to stream the response\n\n- `false` (default): returns the complete response object at once\n- `true`: pushes SSE events; answer text arrives in `response.output_text.delta` events, and generation ends with `response.completed` (or `response.incomplete` / `response.failed`)",
            "default": false,
            "example": false
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Maximum number of output tokens for this generation, including reasoning tokens\n\n**Notes**:\n- Maximum **524,288** (512K); recommended up to **131,072** (128K)\n- If omitted, EvoLink uses **32768**\n- With a small value and a high `reasoning.effort`, thinking can use up the limit, and the response ends with `status: \"incomplete\"` and no `message` item\n- Use 32768 or higher, and lower `reasoning.effort` for simple tasks",
            "minimum": 1,
            "maximum": 524288,
            "example": 32768
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature; higher values make output more random. Range `(0, 1]`, default 1",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus sampling threshold. Range `(0, 1]`, default 0.95. Adjust either this or `temperature`, not both",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "reasoning": {
            "type": "object",
            "description": "Thinking settings. MiniMax-M3.1-Flash always thinks, including when `reasoning` is omitted. Thinking is returned as a `reasoning` output item, and its tokens are billed as output tokens",
            "properties": {
              "effort": {
                "type": "string",
                "description": "Thinking depth\n\n- `low`: Shallowest thinking, fastest response, fewest output tokens\n- `medium` / `high` / `xhigh`: Progressively deeper thinking\n- `max` (default): Deepest thinking, slowest response, most output tokens\n\n**Notes**:\n- Defaults to `max` when omitted; for simple tasks, a lower level reduces latency and output tokens\n- Reasoning tokens count toward `max_output_tokens`\n- `none` and `minimal` do not turn thinking off: EvoLink changes them to `low`",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "max",
                "example": "medium"
              }
            }
          },
          "text": {
            "type": "object",
            "description": "Text output format configuration.",
            "properties": {
              "format": {
                "type": "object",
                "description": "Output format. Only `text` (free-form text) is supported",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "text"
                    ],
                    "default": "text",
                    "description": "Output format type"
                  }
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "List of tools available to the model. Only function tools are supported; the client executes the function and returns the result as `function_call_output`",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "Tool choice strategy\n\n- `none`: tool calling disabled\n- `auto` (default): the model decides whether to call a tool\n\nOther values are not supported",
            "enum": [
              "none",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "store": {
            "type": "boolean",
            "description": "No effect. Responses are not stored"
          },
          "previous_response_id": {
            "type": "string",
            "description": "No effect. Continuing from a stored response is not supported; send the full history in `input`"
          }
        }
      },
      "InputItem": {
        "type": "object",
        "title": "Input item",
        "description": "A single item in the `input` array. `type` determines its meaning.",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Input item type\n\n- `message`: a conversation message\n- `function_call`: a function call the model made earlier\n- `function_call_output`: the result of a function execution\n- `reasoning`: earlier thinking content; send back the item from the previous response's `output` unchanged",
            "enum": [
              "message",
              "function_call",
              "function_call_output",
              "reasoning"
            ],
            "example": "message"
          },
          "role": {
            "type": "string",
            "description": "Message role, used only with `type: message`",
            "enum": [
              "user",
              "assistant",
              "system",
              "developer"
            ],
            "example": "user"
          },
          "content": {
            "description": "Message content, used only with `type: message`. It can be plain text or an array of content parts (`input_text` / `input_image` / `input_video`; earlier assistant text uses `output_text`)",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "call_id": {
            "type": "string",
            "description": "Function call identifier; `function_call` and `function_call_output` are paired through it."
          },
          "name": {
            "type": "string",
            "description": "Name of the called function, used only with `type: function_call`."
          },
          "arguments": {
            "type": "string",
            "description": "Function call arguments as a JSON string, used only with `type: function_call`."
          },
          "output": {
            "type": "string",
            "description": "Function execution result, used only with `type: function_call_output`."
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Multimodal content part. Declare the type via `type` and fill in only the fields matching that type",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_text",
              "output_text",
              "input_image",
              "input_video"
            ],
            "description": "Content part type\n\n- `input_text`: Text input\n- `output_text`: Text from an earlier assistant reply\n- `input_image`: Image input\n- `input_video`: Video input"
          },
          "text": {
            "type": "string",
            "description": "Text content (when `type` is `input_text` / `output_text`)"
          },
          "image_url": {
            "description": "Image input (when `type` is `input_image`): an image URL or a base64 data URL starting with `data:`, passed as a string or as an object with `url`. Maximum 10 MB per image, supports JPEG / PNG / GIF / WEBP",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Image URL, or a base64 data URL starting with `data:`"
                  },
                  "detail": {
                    "type": "string",
                    "description": "Controls image parsing resolution\n\n- `low`: Low precision, consumes fewer tokens\n- `default`: Default precision\n- `high`: High precision, recognizes more detail but consumes more tokens",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default"
                  }
                }
              }
            ]
          },
          "video_url": {
            "description": "Video input (when `type` is `input_video`): a video URL or a base64 data URL starting with `data:`, passed as a string or as an object with `url`. Maximum 50 MB for URL / Base64 video, supports MP4 / AVI / MOV / MKV",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Video URL, or a base64 data URL starting with `data:`"
                  },
                  "fps": {
                    "type": "number",
                    "description": "Video frame extraction rate, default 1, range [0.2, 5]\n\n- Higher values: More sensitive to visual changes, higher token cost and slower speed\n- Lower values: Lower token cost and faster speed, but less sensitive to visual changes",
                    "minimum": 0.2,
                    "maximum": 5,
                    "default": 1
                  },
                  "detail": {
                    "type": "string",
                    "description": "Controls video frame extraction resolution",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default"
                  },
                  "max_long_side_pixel": {
                    "type": "integer",
                    "description": "Maximum pixel limit for the longest side of video frames",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      },
      "Tool": {
        "type": "object",
        "title": "Tool definition",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tool type; only `function` is supported",
            "enum": [
              "function"
            ],
            "example": "function"
          },
          "name": {
            "type": "string",
            "description": "Name of the function to call\n\n**Notes**:\n- Must consist of a-z, A-Z, 0-9 characters, or include underscores and hyphens\n- Maximum length is 64 characters",
            "maxLength": 64,
            "example": "get_weather"
          },
          "description": {
            "type": "string",
            "description": "Description of what the tool does; a clear description helps the model decide when to call it.",
            "example": "Query real-time weather for a given city"
          },
          "parameters": {
            "type": "object",
            "description": "Parameter definition in JSON Schema format.",
            "example": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string",
                  "description": "City name"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "Response object of the Responses endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of this response",
            "example": "resp_066b36619b147e31"
          },
          "object": {
            "type": "string",
            "description": "Object type, always `response`",
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "Creation time as a Unix timestamp (seconds)",
            "example": 1790000000
          },
          "model": {
            "type": "string",
            "description": "ID of the model that actually generated this response",
            "example": "MiniMax-M3.1-Flash"
          },
          "status": {
            "type": "string",
            "description": "Response status\n\n- `completed`: finished normally\n- `incomplete`: truncated, e.g. when the output-token limit is reached; see `incomplete_details`\n- `failed`: generation failed; see `error`",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "List of output items in generation order. Fields per type:\n\n- `reasoning`: the thinking process, with `id`, `status`, `summary`, and `content` (list of `reasoning_text` parts); always present for MiniMax-M3.1-Flash\n- `message`: the final answer, with `id`, `status`, `role`, and `content` (list of `output_text` parts)\n- `function_call`: a function call from the model, with `id`, `status`, `call_id`, `name`, and `arguments`; the client executes it and returns the result as `function_call_output`",
            "items": {
              "type": "object"
            }
          },
          "output_text": {
            "type": "string",
            "description": "Convenience field: all answer text concatenated"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "Failure reason; `null` on success"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Truncation reason; `null` when not truncated. `reason` is `max_output_tokens` when the output-token limit is reached"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Token usage statistics (including cache and reasoning breakdowns)",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Total input tokens (including cache hits and misses)",
            "example": 14
          },
          "input_tokens_details": {
            "type": "object",
            "description": "Input token breakdown",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Number of input tokens served from the prompt cache (a subset of `input_tokens`)",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Number of output tokens (including the thinking portion)",
            "example": 62
          },
          "output_tokens_details": {
            "type": "object",
            "description": "Output token breakdown",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Number of reasoning tokens produced by thinking mode (counted as output and billed at the output rate)",
                "example": 38
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Total tokens = input_tokens + output_tokens",
            "example": 76
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP status error code"
              },
              "message": {
                "type": "string",
                "description": "Error description"
              },
              "type": {
                "type": "string",
                "description": "Error type"
              },
              "param": {
                "type": "string",
                "description": "Related parameter name"
              }
            }
          }
        }
      }
    }
  }
}
