{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - OpenAI-Compatible API",
    "description": "Supports kimi-k3.1-pro and kimi-k3.1-pro-highspeed with a context window of 1,048,576 tokens. Both models always reason, with native effort levels low / high / max; the default is max.\n\nSupports multi-turn history, SSE, function tools, web search, strict JSON Schema, and 5m / 1h context caching. Sampling uses fixed settings: temperature=1, top_p=0.95, n=1, presence_penalty=frequency_penalty=0. You do not need to send these parameters.\n\n[Models, pricing, and usage guide](/en/api-manual/language-series/kimi-k3.1-pro/kimi-k3.1-pro-overview).",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommended)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed Chat API (OpenAI-compatible)",
        "description": "Use either exact model ID with this endpoint. Native reasoning levels are low / high / max. Preserve complete reasoning_content and tool_calls history. Search returns results through tool_calls; pass them back and request again for the final answer.",
        "operationId": "createChatCompletionKimiK31Pro",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Minimal Pro request",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Minimal Highspeed request",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "SSE streaming with usage",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                },
                "cache_1h": {
                  "summary": "Automatic 1h cache write",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Web search (unified syntax)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "web_search_native": {
                  "summary": "Web search (native Moonshot syntax)",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "builtin_function",
                        "function": {
                          "name": "$web_search"
                        }
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Strict JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Check today's weather in Beijing."
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "Query the weather for a specified city",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "City name"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response; streaming requests return an SSE event stream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE data in OpenAI Chat Completions format, ending with `data: [DONE]`."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Pro and Highspeed share endpoints and parameters. Highspeed has different input, output, and cache-write prices; cache-read pricing is the same."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Conversation messages. For multi-turn conversations, include complete historical assistant messages.",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "Maximum generated tokens, including reasoning and the final answer. Default: 131072; maximum: 1048576, also limited by the remaining context."
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "Reasoning effort: low / high / max are recommended; default: max. Reasoning is always enabled. Client aliases: medium maps to high, xhigh to max, minimal / none to low. none does not disable reasoning. Higher effort usually increases reasoning tokens and latency. Reasoning tokens count as output."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Whether to return the response as an SSE stream."
          },
          "stream_options": {
            "$ref": "#/components/schemas/StreamOptions",
            "description": "Streaming response options. These options apply only when `stream=true` and do not change token prices or generated token counts."
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "Function tools or web search. Search accepts {\"type\":\"web_search\"} or native Moonshot builtin_function / $web_search. Charged per actual search; ordinary functions incur no search fee.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                },
                {
                  "$ref": "#/components/schemas/BuiltinWebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "Controls whether the model calls tools or forces a specific function call."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Context cache-write options. If omitted, automatically writes to the 5m cache. Writes and reads are billed separately.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "Cache-write TTL. 1h and 5m use their respective write prices. Actual hits and TTL classifications follow the bill."
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "Controls the output format. The default {\"type\":\"text\"} returns plain text. {\"type\":\"json_object\"} enables JSON mode and guarantees a valid JSON object; ask for JSON and specify the format in the prompt. {\"type\":\"json_schema\"} enables Structured Output constrained by the supplied JSON Schema (recommended; also supply json_schema). Report JSON Schema validation issues to walle GitHub Issues (https://github.com/MoonshotAI/walle/issues).",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "Output format: text (default) for plain text; json_object for a valid JSON object; json_schema for schema-constrained output (recommended; supply json_schema)."
              },
              "json_schema": {
                "type": "object",
                "description": "JSON Schema to follow when type is json_schema.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Schema name used as an identifier."
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether to strictly enforce the schema. Default: true. When true, the schema must comply with MFJS or an error or warning is returned. When false, only valid JSON is guaranteed, without enforcing the internal structure."
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema describing the output structure. Must comply with MFJS (Moonshot Flavored JSON Schema). Validate with the walle CLI: go install github.com/moonshotai/walle/cmd/walle@latest && walle -schema '<schema>' -level strict",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "prompt_cache_key": {
            "type": "string",
            "default": null,
            "description": "A key for caching similar requests to improve the hit rate. For coding agents, use the session ID or task ID and keep it unchanged when resuming a session. Required for Kimi Code Plan to improve cache hits; also recommended for other multi-turn agents."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "Legacy output-limit alias. Use max_completion_tokens for new requests; avoid setting both."
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Message role: system, user, assistant, or tool.",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "Message content. Pass a string for plain text; pass an array of content blocks (text + image + video) for multimodal input. Assistant content may be null in tool-call scenarios.",
            "oneOf": [
              {
                "type": "string",
                "description": "Plain text message content."
              },
              {
                "type": "array",
                "description": "Array of multimodal content blocks.",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "The assistant's reasoning content. Return it unchanged as part of the complete assistant message in multi-turn conversations."
          },
          "tool_calls": {
            "type": "array",
            "description": "Tool calls returned by the assistant. Return them unchanged in subsequent tool-use turns.",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID of the corresponding tool call when `role=tool`."
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "Multimodal content block. `type` determines which field is used.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Content block type."
          },
          "text": {
            "type": "string",
            "description": "Text content when `type=text`."
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "Image when `type=image_url`; a URL string may also be passed directly.",
            "properties": {
              "url": {
                "type": "string",
                "description": "Image address. Supports a Base64 Data URL (`data:image/png;base64,...`) or a Kimi platform file reference (`ms://<file_id>`)."
              }
            }
          },
          "video_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "Video when `type=video_url`; a URL string may also be passed directly.",
            "properties": {
              "url": {
                "type": "string",
                "description": "Video address. Supports a Base64 Data URL (`data:video/mp4;base64,...`) or a Kimi platform file reference (`ms://<file_id>`)."
              }
            }
          }
        }
      },
      "StreamOptions": {
        "type": "object",
        "properties": {
          "include_usage": {
            "type": "boolean",
            "default": false,
            "description": "When true, returns a final usage chunk to the caller before `[DONE]`. This option only controls whether the caller receives that chunk and does not add billable tokens or change prices."
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "Web search tool. Converted by the gateway to Moonshot `$web_search`; billed per call"
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Tool type. Currently fixed to function.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Function definition available to the model.",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Function name."
              },
              "description": {
                "type": "string",
                "description": "Description that helps the model decide when to call the function."
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "Function parameter definition in JSON Schema format."
              },
              "strict": {
                "type": "boolean",
                "description": "Whether function arguments must strictly follow the JSON Schema in parameters."
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Named tool choice type. Fixed to function.",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Function that the model must call.",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the function that the model must call."
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Tool call ID used to associate a subsequent tool message through tool_call_id."
          },
          "type": {
            "type": "string",
            "description": "Tool call type: `function` for client functions; `builtin_function` for the built-in `$web_search` tool.",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "Function and arguments requested by the model.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Function name."
              },
              "arguments": {
                "type": "string",
                "description": "Function arguments encoded as a JSON string."
              }
            }
          }
        },
        "description": "Preserve complete tool-call history. Built-in search responses may use type=builtin_function; the server accepts this type when replayed. Keep IDs, arguments, and reasoning intact."
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Total input tokens, including ordinary input, cache reads, and cache writes. Ordinary input = prompt_tokens - cached_tokens - cache_write_tokens."
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Includes reasoning tokens."
          },
          "total_tokens": {
            "type": "integer",
            "description": "Total input and output tokens."
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Input tokens served from cache."
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "Total tokens written to cache, including 5m / 1h writes. Do not charge these again as ordinary input."
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Reasoning tokens, already included in completion_tokens."
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "BuiltinWebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "$web_search"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API key is missing or invalid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded or insufficient quota",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal service error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##All APIs require Bearer Token authentication##\n\n**Get API Key**:\n\nVisit the [API Key Management Page](https://evolink.ai/dashboard/keys) to obtain your API Key\n\n**Add to request header**:\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Chat Completions",
      "description": "OpenAI Chat Completions-compatible API"
    }
  ]
}
