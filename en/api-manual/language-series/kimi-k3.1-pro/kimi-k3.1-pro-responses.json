      "ResponsesOutputWebSearchCallItem": {
        "type": "object",
        "title": "Web search call",
        "description": "Server-executed web search call. Returned only when the request includes `web_search` and the server decides to search; appears first in the output array.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_call"
            ]
          },
          "id": {
            "type": "string",
            "example": "ws_68f0c1c2d3e4f5a6b7c8d9e0"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed"
            ]
          },
          "action": {
            "type": "object",
            "description": "Action performed by this search.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "search"
                ]
              },
              "query": {
                "type": "string",
                "description": "Search query actually used."
              },
              "sources": {
                "type": "array",
                "description": "Matched web sources. Returned only when `include` contains `web_search_call.action.sources`.",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "url"
                      ]
                    },
                    "url": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "results": {
            "type": "array",
            "description": "Image search results. Returned only when `include` contains `web_search_call.results` and `search_content_types` contains `image`.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "image_result"
                  ]
                },
                "image_url": {
                  "type": "string"
                },
                "thumbnail_url": {
                  "type": "string"
                },
                "source_website_url": {
                  "type": "string"
                },
                "caption": {
                  "type": "string",
                  "description": "Image caption, returned only when `image_settings.caption` is enabled."
                }
              }
            }
          }
        }
      },
      "ResponsesInputContentPart": {
        "description": "A content-array element, distinguished by `type`.",
        "oneOf": [
          {
            "type": "object",
            "title": "Input text",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "input_text"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "title": "Input image",
            "required": [
              "type",
              "image_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "input_image"
                ]
              },
              "image_url": {
                "type": "string",
                "description": "Image data URL, such as `data:image/png;base64,<base64>`. Public http(s) URLs are unsupported."
              },
              "detail": {
                "type": "string",
                "enum": [
                  "auto",
                  "low",
                  "high",
                  "original"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "Output text",
            "description": "Used to replay assistant text history.",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "output_text"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        ]
      }
