      "ResponsesFunctionTool": {
        "type": "object",
        "title": "Function tool",
        "description": "Function tool with parameters described by JSON Schema.",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ]
          },
          "name": {
            "type": "string",
            "description": "Function name. Must match: ^[a-zA-Z_][a-zA-Z0-9-_]{0,127}$",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9-_]{0,127}$"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "description": "JSON Schema describing function parameters."
          },
          "strict": {
            "type": "boolean"
          }
        }
      },
      "ResponsesCustomTool": {
        "type": "object",
        "title": "Custom tool",
        "description": "Custom tool accepting free-form text. Only a tool named `apply_patch` is supported, with a required `grammar` + `lark` format definition. Calls appear as `custom_tool_call` items in output.",
        "required": [
          "type",
          "name",
          "format"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "custom"
            ]
          },
          "name": {
            "type": "string",
            "enum": [
              "apply_patch"
            ],
            "description": "Tool name; only `apply_patch` is supported."
          },
          "description": {
            "type": "string"
          },
          "format": {
            "type": "object",
            "description": "Input-format constraints. Only type `grammar` with syntax `lark` is supported.",
            "required": [
              "type",
              "syntax",
              "definition"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "grammar"
                ]
              },
              "syntax": {
                "type": "string",
                "enum": [
                  "lark"
                ]
              },
              "definition": {
                "type": "string",
                "description": "Lark grammar definition."
              }
            }
          }
        }
      },
      "ResponsesNamespaceTool": {
        "type": "object",
        "title": "Namespace tool",
