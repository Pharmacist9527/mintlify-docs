{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - Responses API",
    "version": "1.0.0",
    "description": "Call Kimi K3.1 Pro / Highspeed through OpenAI Responses using `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed`. Both models offer a 1,048,576-token context and support multi-turn conversations, streaming, tool calls, web search, structured output, and context caching.\n\nReasoning is always enabled. Set `reasoning.effort` to `low` / `high` / `max`; the default is `max`. Preserve complete reasoning and tool-call history across turns."
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommended)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "Alternative URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "tags": [
          "Responses"
        ],
        "summary": "Kimi K3.1 Pro / Highspeed Responses API",
        "description": "Set reasoning effort with reasoning.effort and caching with prompt_cache_options. Search appears as web_search_call output items. For streaming, handle response.completed / response.incomplete / response.failed; hitting the output limit returns incomplete. Multi-turn requests must include the full output history, including reasoning, tool calls, and results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Minimal Pro request",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Minimal Highspeed request",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "Responses SSE streaming",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "Automatic 1h cache write",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Server-side web search",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Use web search to find the official Kimi homepage URL.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Strict JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Return a JSON object with result equal to OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "text": {
                      "format": {
                        "type": "json_schema",
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesStreamEvent"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access to this resource is forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded or insufficient quota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "createResponseKimiK31Pro"
      }
    }
  },
  "components": {
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Use `kimi-k3.1-pro` or `kimi-k3.1-pro-highspeed`; Highspeed offers faster generation."
          },
          "input": {
            "description": "Request input. A string is equivalent to one user message. An array contains typed items in order and may include conversation history, tool calls, and tool results.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResponsesInputItem"
                }
              }
            ]
          },
          "instructions": {
            "type": "string",
            "description": "Top-level system instructions, applied before all other instructions."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "When true, returns the response as an SSE stream."
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Maximum generated tokens, including reasoning and the final answer. Default: 131072; maximum: 1048576, also limited by the remaining context.",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072
          },
          "reasoning": {
            "type": "object",
            "description": "Reasoning configuration.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "Reasoning effort: low / high / max are recommended; default: max. Reasoning is always enabled. Client aliases: medium maps to high, xhigh to max, minimal / none to low. none does not disable reasoning. Higher effort usually increases reasoning tokens and latency. Reasoning tokens count as output."
              }
            }
          },
          "text": {
            "type": "object",
            "description": "Output text configuration.",
            "properties": {
              "format": {
                "type": "object",
                "required": [
                  "type",
                  "schema"
                ],
                "description": "Constrain output structure with JSON Schema.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Schema name; defaults to `output`."
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema describing the output structure."
                  },
                  "strict": {
                    "type": "boolean",
                    "description": "Whether to strictly enforce the schema."
                  }
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Tools that the model may call.",
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ResponsesToolChoice"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "web_search_call.results",
                "web_search_call.action.sources"
              ]
            },
            "description": "Additional fields to return, only for `web_search`. `web_search_call.action.sources` includes matched web sources; `web_search_call.results` includes image search results."
          },
          "prompt_cache_key": {
            "type": "string",
            "description": "Context cache identifier. Reuse the same value within a session to improve cache hits."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Context cache-write options. If omitted, automatically writes to the 5m cache. Writes and reads are billed separately.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "Cache TTL: 5m or 1h; default: 5m."
              }
            }
          },
          "safety_identifier": {
            "type": "string",
            "description": "Stable identifier unique to each user for detecting possible policy violations. Hash usernames or email addresses to avoid sending identifiable information."
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "A model response.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique response identifier.",
            "example": "resp_68f0c1c2d3e4f5a6b7c8d9e0"
          },
          "object": {
            "type": "string",
            "enum": [
              "response"
            ]
          },
          "created_at": {
            "type": "integer",
            "description": "Unix timestamp when the response was created."
          },
          "completed_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix timestamp when the response ended. Present when `status` is `completed` or `incomplete`; `null` for `in_progress` or `failed`."
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "incomplete",
              "failed"
            ],
            "description": "Response status. The initial streaming snapshot has status `in_progress`."
          },
          "model": {
            "type": "string",
            "description": "Model that generated this response."
          },
          "output": {
            "type": "array",
            "description": "Output item array, ordered as web_search_call (if any), reasoning, message, and tool calls.",
            "items": {
              "$ref": "#/components/schemas/ResponsesOutputItem"
            }
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Reason provided when `status` is `incomplete`.",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "max_output_tokens",
                  "content_filter"
                ]
              }
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "Error details provided when `status` is `failed`.",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": [
              "object",
              "null"
            ]
          },
          "text": {
            "type": [
              "object",
              "null"
            ]
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesToolChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ]
          },
          "parallel_tool_calls": {
            "type": "boolean"
          },
          "service_tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "store": {
            "type": "boolean",
            "description": "Always `false`."
          },
          "background": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Always `false`."
          },
          "previous_response_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Always `null`."
          },
          "conversation": {
            "type": [
              "object",
              "null"
            ],
            "description": "Always `null`."
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "Context cache-write options actually applied by the server. If prompt_cache_options was omitted, use the mode and ttl returned here.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "description": "Write mode actually applied."
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "description": "Cache TTL actually applied."
              }
            }
          }
        }
      },
      "ResponsesStreamEvent": {
        "type": "object",
        "description": "A single SSE event when `stream: true`. Each frame contains `event: <type>` and `data: <json>`; the remaining event-body fields depend on `type`.",
        "required": [
          "type",
          "sequence_number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "response.created",
              "response.in_progress",
              "response.output_item.added",
              "response.output_item.done",
              "response.content_part.added",
              "response.content_part.done",
              "response.output_text.delta",
              "response.output_text.done",
              "response.reasoning_summary_part.added",
              "response.reasoning_summary_part.done",
              "response.reasoning_summary_text.delta",
              "response.reasoning_summary_text.done",
              "response.function_call_arguments.delta",
              "response.function_call_arguments.done",
              "response.custom_tool_call_input.delta",
              "response.custom_tool_call_input.done",
              "response.web_search_call.in_progress",
              "response.web_search_call.searching",
              "response.web_search_call.completed",
              "response.completed",
              "response.incomplete",
              "response.failed",
              "error"
            ]
          },
          "sequence_number": {
            "type": "integer",
            "description": "Event sequence number, increasing monotonically from 0."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "Error message explaining the cause."
              },
              "type": {
                "type": "string",
                "description": "Error type"
              },
              "code": {
                "type": "string",
                "description": "Error code"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ResponsesInputItem": {
        "description": "An input-array element, distinguished by `type`. If `type` is omitted, it is treated as `message`.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesAdditionalToolsItem"
          }
        ]
      },
      "ResponsesTool": {
        "description": "Tool definition, distinguished by `type`. Supports `function`, `custom` (only `apply_patch`), `namespace`, and `web_search`; other tool types are unsupported.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesFunctionTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesNamespaceTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchTool"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "function": "#/components/schemas/ResponsesFunctionTool",
            "custom": "#/components/schemas/ResponsesCustomTool",
            "namespace": "#/components/schemas/ResponsesNamespaceTool",
            "web_search": "#/components/schemas/ResponsesWebSearchTool"
          }
        }
      },
      "ResponsesToolChoice": {
        "type": "string",
        "enum": [
          "auto"
        ],
        "description": "Controls tool use. With `auto`, the model decides whether to call a tool."
      },
      "ResponsesOutputItem": {
        "description": "An output-array element, distinguished by `type`.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesOutputReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputWebSearchCallItem"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "reasoning": "#/components/schemas/ResponsesOutputReasoningItem",
            "message": "#/components/schemas/ResponsesOutputMessageItem",
            "function_call": "#/components/schemas/ResponsesOutputFunctionCallItem",
            "custom_tool_call": "#/components/schemas/ResponsesOutputCustomToolCallItem",
            "web_search_call": "#/components/schemas/ResponsesOutputWebSearchCallItem"
          }
        }
      },
      "ResponsesUsage": {
        "type": "object",
        "description": "input_tokens includes cache reads and writes; subtract cached_tokens and cache_write_tokens to get ordinary input. output_tokens already includes reasoning.",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Input token count, including cache hits."
          },
          "input_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Tokens read from the context cache."
              },
              "cache_write_tokens": {
                "type": "integer",
                "description": "Tokens written to the context cache."
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Output token count, including reasoning tokens."
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Tokens used for reasoning."
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Total token count."
          }
        }
      },
      "ResponsesMessageItem": {
        "type": "object",
        "title": "Message",
        "description": "A conversation message. `type` may be omitted.",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "developer"
            ],
            "description": "Message role. `developer` is treated as system instructions."
          },
          "content": {
            "description": "Message content as a string or content-part array.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResponsesInputContentPart"
                }
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          }
        }
      },
      "ResponsesReasoningItem": {
        "type": "object",
        "title": "Reasoning",
        "description": "Replay reasoning from the previous turn. `content` takes precedence over `summary`.",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning"
            ]
          },
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "summary_text"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "reasoning_text"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          }
        }
      },
      "ResponsesFunctionCallItem": {
        "type": "object",
        "title": "Function Call",
        "description": "Replay a function call.",
        "required": [
          "type",
          "call_id",
          "name",
          "arguments"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function_call"
            ]
          },
          "id": {
            "type": "string"
          },
          "call_id": {
            "type": "string",
            "description": "Call ID paired with the corresponding `function_call_output`."
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string",
            "description": "Tool namespace, returned for namespaced tool calls."
          },
          "arguments": {
            "type": "string",
            "description": "Function arguments as a JSON string."
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          }
        }
      },
      "ResponsesFunctionCallOutputItem": {
        "type": "object",
        "title": "Function call result",
        "description": "Execution result of a function call.",
        "required": [
          "type",
          "call_id",
          "output"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function_call_output"
            ]
          },
          "call_id": {
            "type": "string",
            "description": "Same call ID as the corresponding `function_call`."
          },
