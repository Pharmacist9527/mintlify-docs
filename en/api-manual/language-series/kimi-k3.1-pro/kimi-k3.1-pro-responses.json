                },
                {
                  "$ref": "#/components/schemas/ResponsesCustomTool"
                }
              ]
            }
          }
        }
      },
      "ResponsesWebSearchTool": {
        "type": "object",
        "title": "Web search tool",
        "description": "Web search tool, called when the model needs online information. Search records appear as web_search_call items. Declare at most one per request.",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ]
          },
          "filters": {
            "type": "object",
            "description": "Search-scope filters.",
            "properties": {
              "allowed_domains": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100,
                "description": "Search only these domains, up to 100."
              }
            }
          },
          "search_content_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "text",
                "image"
              ]
            },
            "default": [
              "text"
            ],
            "description": "Search content types; defaults to `text` only. Including `image` also runs image search."
          },
          "image_settings": {
            "type": "object",
            "description": "Image search settings, only effective when `search_content_types` includes `image`.",
            "properties": {
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 3,
                "description": "Maximum number of returned images."
              },
              "caption": {
                "type": "boolean",
                "default": false,
                "description": "Whether to generate image captions."
              }
            }
          }
        }
      },
