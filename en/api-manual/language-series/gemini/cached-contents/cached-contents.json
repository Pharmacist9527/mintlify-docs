  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## All endpoints require Bearer Token authentication\n\n**Get an API Key:**\n\nVisit [API Key Management](https://evolink.ai/dashboard/keys) to get your API Key.\n\n**Add this request header:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\nThe Gemini native format is also accepted: the `x-goog-api-key: YOUR_API_KEY` header or the `?key=YOUR_API_KEY` URL parameter."
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "Content part: choose text, inline data (base64), or a file reference",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text"
          },
          "inlineData": {
            "type": "object",
            "description": "Inline binary data (images, audio, PDFs, etc.)",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "Base64-encoded data"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "File reference",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "Publicly accessible URL"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "Role; not required for system instructions"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Tool declarations. Only the following three types are accepted; other tools are rejected",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "Web search; provide `{}`"
          },
          "codeExecution": {
            "type": "object",
            "description": "Code execution; provide `{}`"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "Function declarations (parameter structure based on an OpenAPI subset)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model; either `models/gemini-3.8-flash` or `gemini-3.8-flash` is accepted. Supported: `gemini-3.8-flash`, `gemini-3.7-flash`, `gemini-3.6-flash`, `gemini-3.5-flash`, `gemini-3.5-flash-lite`, `gemini-3-flash-preview`, `gemini-3.1-flash-lite-preview`, `gemini-3.1-pro-preview`, `gemini-3.1-pro-preview-customtools`, `gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "Conversation content to cache; must be an array. It becomes the conversation prefix when referencing the cache. Provide at least one of `contents`, `systemInstruction`, or `tools`",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "System instructions. Once cached, systemInstruction must not be included in generation requests referencing this cache"
          },
          "tools": {
            "type": "array",
            "description": "Tool declarations. Once cached, tools must not be included in generation requests referencing this cache",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "Tool calling configuration (such as functionCallingConfig). Once cached, toolConfig must not be included in generation requests referencing this cache"
          },
          "ttl": {
            "type": "string",
            "description": "Lifetime, such as `\"3600s\"`. Minimum `60s`, maximum `604800s` (168 hours). Mutually exclusive with expireTime; providing both returns 400. Defaults to `3600s` when neither is provided",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Absolute expiry time (RFC 3339, UTC), mutually exclusive with ttl; providing both returns 400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "A name for your reference, up to 255 characters; does not affect billing",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "Provide exactly one of ttl or expireTime; other fields return 400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "New lifetime starting now, such as `\"7200s\"`. Minimum `60s`, maximum `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "New absolute expiry time (RFC 3339, UTC)",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Cache name, in the form `cachedContents/<id>`. Use it in the `cachedContent` field of generation requests; `<id>` is also the creation request's ID",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
          },
          "model": {
            "type": "string",
            "description": "Model bound to the cache; the generation request must use the same model",
            "example": "models/gemini-3.8-flash"
          },
          "displayName": {
            "type": "string",
            "description": "Name provided on creation; omitted if not provided"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "Creation time (UTC)"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Most recent update time (UTC)"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry time (UTC); automatically deleted on expiry"
          },
          "usageMetadata": {
            "type": "object",
            "properties": {
              "totalTokenCount": {
                "type": "integer",
                "description": "Total cached token count, used to calculate cache write and storage fees",
                "example": 7525
              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "Returned when another page is available; pass unchanged as `pageToken` in the next request"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Gemini native error format. `error.details[0].reason` is the reason code: `INVALID_ARGUMENT` invalid parameters; `EXPLICIT_CACHE_UNSUPPORTED` the model does not support explicit caching; `NO_AVAILABLE_CHANNEL`, `MODEL_PRICE_ERROR` not yet available for your user group; `CACHE_EXPIRED` the cache has expired or has too little lifetime left; `CACHE_MODEL_MISMATCH` the model does not match the cache; `INVALID_CACHED_CONTENT` malformed `cachedContent`; `INSUFFICIENT_QUOTA` insufficient balance; `CACHE_NOT_FOUND` the cache does not exist, has expired or been deleted, or belongs to another account; `EXPLICIT_CACHE_DISABLED` the feature is not available yet; `CACHE_CONTENT_TOO_LARGE` the request body exceeds 10 MB; `UPSTREAM_ERROR` the request was not accepted, see `message`; `CACHE_CHANNEL_UNAVAILABLE`, `INTERNAL` temporarily unavailable, retry later.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP status code"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "Status enum, such as INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
