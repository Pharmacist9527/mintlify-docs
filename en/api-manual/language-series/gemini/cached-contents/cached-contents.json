                "example": {
                  "error": {
                    "code": 502,
                    "message": "the request could not be completed due to a service authorization problem; please retry later or contact support",
                    "status": "INTERNAL",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
