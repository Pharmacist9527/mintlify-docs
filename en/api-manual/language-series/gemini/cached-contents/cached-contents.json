    },
    "/v1beta/cachedContents/{id}": {
      "get": {
        "summary": "Get a cache",
        "operationId": "geminiGetCachedContent",
        "tags": [
          "Explicit Context Caching"
        ],
        "description": "Return cache metadata (model, token count, and creation/update/expiry times), without the cached content. Expired caches return 404, just like missing caches. Free of charge.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Cache ID: the `name` returned on creation, without the `cachedContents/` prefix. For example, if `name` is `cachedContents/20261103012026348092000s1oTuB96`, use `20261103012026348092000s1oTuB96` here.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CachedContent"
                },
                "example": {
                  "name": "cachedContents/20261103012026348092000s1oTuB96",
                  "model": "models/gemini-3.8-flash",
                  "displayName": "product-manual-v3",
                  "createTime": "2026-11-03T01:20:27.311Z",
                  "updateTime": "2026-11-03T01:20:27.311Z",
                  "expireTime": "2026-11-03T02:20:26.902Z",
                  "usageMetadata": {
                    "totalTokenCount": 7525
                  }
                }
              }
            }
          },
          "401": {
            "description": "API Key is invalid or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The Key cannot access this model, or the source IP is not on its allowlist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cache does not exist, has expired, was deleted, or belongs to another account; or explicit caching is not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable; please retry later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "explicit context caching is temporarily unavailable",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INTERNAL",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Extend or shorten the lifetime",
        "operationId": "geminiUpdateCachedContent",
        "tags": [
          "Explicit Context Caching"
        ],
        "description": "Only the lifetime can be changed, not the content. Provide either `ttl` (the new lifetime starting **now**, such as `\"7200s\"`) or `expireTime` (the new absolute expiry time).\n\n- The new expiry must be between 60 seconds and 168 hours from now.\n- Only `ttl` or `expireTime` is accepted; providing both or other fields returns 400.\n- **Extending**: Storage fees are charged for the added duration, measured in seconds, with durations below 1 second charged as 1 second. **Shortening**: Storage fees already charged are not refunded.\n- This is a paid operation: the Key must have access to the model, and the price of its current user group applies. Insufficient balance returns 402.\n- When retrying the same extension request, use the `Idempotency-Key` header to avoid duplicate charges.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Cache ID: the `name` returned on creation, without the `cachedContents/` prefix. For example, if `name` is `cachedContents/20261103012026348092000s1oTuB96`, use `20261103012026348092000s1oTuB96` here.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCachedContentRequest"
              },
              "examples": {
                "extend_by_ttl": {
                  "summary": "Keep for another 2 hours from now",
                  "value": {
                    "ttl": "7200s"
                  }
                },
                "set_expire_time": {
                  "summary": "Set an absolute expiry time",
                  "value": {
                    "expireTime": "2026-11-03T06:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated cache metadata; `expireTime` is the new expiry time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CachedContent"
                },
                "example": {
                  "name": "cachedContents/20261103012026348092000s1oTuB96",
                  "model": "models/gemini-3.8-flash",
                  "displayName": "product-manual-v3",
                  "createTime": "2026-11-03T01:20:27.311Z",
                  "updateTime": "2026-11-03T01:35:10.020Z",
                  "expireTime": "2026-11-03T03:35:10.000Z",
                  "usageMetadata": {
                    "totalTokenCount": 7525
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing ttl / expireTime, or both provided; unsupported fields; expiry out of range; cache expired during processing (CACHE_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "new expiry must be at least 60s in the future",
                    "status": "INVALID_ARGUMENT",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INVALID_ARGUMENT",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "API Key is invalid or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient balance for the additional storage fee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "insufficient quota for cache storage extension",
                    "status": "RESOURCE_EXHAUSTED",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INSUFFICIENT_QUOTA",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "The Key cannot access this model, the source IP is not on its allowlist, or the Key's user group is no longer available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cache does not exist, has expired, was deleted, or belongs to another account; or explicit caching is not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Service temporarily unavailable. This request is not charged; please retry later",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
