{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniHuman 2.0 Digital Human Video Generation API",
    "description": "Create audio-driven digital human video generation tasks using the OmniHuman 2.0 model",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Production environment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "OmniHuman 2.0 Digital Human Video Generation",
        "description": "- OmniHuman 2.0 (omnihuman-2.0) model generates a digital human video from a person image and an audio clip, with lip movements and body motion following the audio\n- Asynchronous processing mode, use the returned task ID to [query](/en/api-manual/task-management/get-task-detail)\n- Generated video links are valid for 24 hours, please save them promptly\n\n**Note:**\n- Audio duration limit: 4–300 seconds\n- Supported audio formats: MP3, WAV\n- Billing is based on audio duration (rounded up to the nearest `0.1` second)",
        "operationId": "createOmniHuman20VideoGeneration",
        "tags": [
          "Digital Human Video Generation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic_generation": {
                  "summary": "Basic Digital Human Generation",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ]
                  }
                },
                "with_prompt": {
                  "summary": "With Prompt",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ],
                    "prompt": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Digital human video generation task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "Unsupported parameter",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "mask_url is not supported by omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_many_images": {
                    "summary": "More than 1 image",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "omnihuman-2.0 accepts exactly 1 image, got 2",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_audio_url": {
                    "summary": "Missing audio URL",
                    "value": {
                      "error": {
                        "code": "missing_audio_url",
                        "message": "audio_url is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_image_urls": {
                    "summary": "Missing image URL",
                    "value": {
                      "error": {
                        "code": "missing_image_urls",
                        "message": "image_urls is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio": {
                    "summary": "Audio cannot be downloaded or parsed",
                    "value": {
                      "error": {
                        "code": "invalid_audio",
                        "message": "failed to read audio_url: download audio failed: HTTP 404",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio_duration": {
                    "summary": "Audio duration out of range",
                    "value": {
                      "error": {
                        "code": "invalid_audio_duration",
                        "message": "audio duration 2.50s is out of range [4, 300] for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_media_url": {
                    "summary": "Media URL points to a local or private network address",
                    "value": {
                      "error": {
                        "code": "invalid_media_url",
                        "message": "invalid parameter \"audio_url\": points to a local or private network address; provide a publicly accessible URL",
                        "type": "invalid_request_error",
                        "param": "audio_url"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated, invalid or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient quota, recharge required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: omnihuman-2.0",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "audio_url",
          "image_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Digital human video generation model name\n\n**Note:**\n- This model does not support the OmniHuman-1.5 parameters `mask_url`, `subject_check`, `auto_mask`, `pe_fast_mode`, `audio_urls`; enabling them or passing non-empty values returns a 400 parameter error\n- Put all parameters at the top level of the request body; a non-empty `model_params` returns a 400 parameter error",
            "enum": [
              "omnihuman-2.0"
            ],
            "default": "omnihuman-2.0",
            "example": "omnihuman-2.0"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "description": "Audio URL for driving lip-sync and body movements\n\n**Note:**\n- Audio duration: `4`–`300` seconds (inclusive); audio outside this range returns a 400 parameter error\n- Supported formats: `.mp3`, `.wav`\n- File size: less than `15MB`\n- Audio URLs must be directly accessible by the server; audio that cannot be downloaded, is in an unsupported format, or exceeds the size limit returns a 400 parameter error\n- Billing is based on audio duration (rounded up to the nearest `0.1` second)",
            "example": "https://your-cdn.com/omnihuman/speech.mp3"
          },
          "image_urls": {
            "type": "array",
            "description": "Reference image URL list containing the person to animate\n\n**Note:**\n- Number of images per request: `1`; more than `1` image returns a 400 parameter error\n- Supported file formats: `.jpg`, `.jpeg`, `.png`, `.webp`, `.bmp`, `.tiff`, `.gif`, `.heic`, `.heif`\n- Image size: less than `30MB`\n- Aspect ratio (width/height): `0.4`–`2.5`\n- Width and height: `300`–`6000` px\n- Image URLs must be directly accessible by the server",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://your-cdn.com/omnihuman/portrait.jpg"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Optional text prompt to control the scene, movements, and camera motion; only supports Chinese, English, Japanese, Korean, Spanish (Mexico), and Indonesian",
            "example": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS callback address after task completion\n\n**Callback Timing:**\n- Triggered when task is completed or failed (OmniHuman 2.0 tasks cannot be canceled)\n- Sent after billing confirmation is completed\n\n**Security Restrictions:**\n- Only HTTPS protocol is supported\n- Callback to internal IP addresses is prohibited (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- URL length must not exceed `2048` characters\n\n**Callback Mechanism:**\n- Timeout: `10` seconds\n- Maximum `3` retries on failure (retries after `1` second/`2` seconds/`4` seconds)\n- Callback response body format is consistent with the task query API response format\n- Callback address returning 2xx status code is considered successful, other status codes will trigger retry",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Task creation timestamp",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Task ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Actual model name used",
            "example": "omnihuman-2.0"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Specific task type"
          },
          "progress": {
            "type": "integer",
            "description": "Task progress percentage (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Task status",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Video task detailed information"
          },
          "type": {
            "type": "string",
            "enum": [
              "video"
            ],
            "description": "Task output type",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Usage and billing information"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Whether the task can be canceled. OmniHuman 2.0 tasks cannot be canceled; always `false`.",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Estimated completion time (seconds)",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "Estimated video duration (seconds)",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Usage and billing information",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Billing rule (per_second for OmniHuman)",
            "enum": [
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Estimated credits consumed (based on audio duration)",
            "minimum": 0,
            "example": 59.024
          },
          "user_group": {
            "type": "string",
            "description": "User group category",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code identifier"
              },
              "message": {
                "type": "string",
                "description": "Error description"
              },
              "type": {
                "type": "string",
                "description": "Error type"
              },
              "param": {
                "type": "string",
                "description": "Related parameter name"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##All APIs require Bearer Token authentication##\n\n**Get API Key:**\n\nVisit [API Key Management Page](https://evolink.ai/dashboard/keys) to get your API Key\n\n**Add to request header:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Digital Human Video Generation",
      "description": "OmniHuman 2.0 digital human video generation APIs"
    }
  ]
}
