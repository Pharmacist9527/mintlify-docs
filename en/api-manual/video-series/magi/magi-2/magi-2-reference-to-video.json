{
  "openapi": "3.1.0",
  "info": {
    "title": "MAGI-2 Reference-to-Video API",
    "description": "MAGI-2 multimodal reference-to-video API, supports mixing image, video, and audio references",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "MAGI-2 Reference-to-Video",
        "description": "- Input reference images (0–10) + reference videos (0–5) + reference audio (0–5) + text prompt to generate video\n- At least one of the three reference types is required; they can be combined freely\n- Asynchronous processing mode, use the returned task ID to [query status](/en/api-manual/task-management/get-task-detail)\n- Generated video links are valid for 7 days, please save them promptly",
        "operationId": "createMagi2ReferenceToVideo",
        "tags": [
          "Video Generation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "multimodal": {
                  "summary": "Multimodal reference (image + video + audio)",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "Follow the camera movement and rhythm of the reference video, and have the character from the image dance on a city rooftop to the beat of the reference audio",
                    "image_urls": [
                      "https://example.com/character.jpg"
                    ],
                    "video_urls": [
                      "https://example.com/reference.mp4"
                    ],
                    "audio_urls": [
                      "https://example.com/bgm.mp3"
                    ],
                    "duration": 10,
                    "quality": "1080p",
                    "aspect_ratio": "16:9",
                    "generate_audio": true
                  }
                },
                "image_reference": {
                  "summary": "Multi-image reference",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "The two characters from the images sit across from each other in a café, talking quietly",
                    "image_urls": [
                      "https://example.com/ref1.jpg",
                      "https://example.com/ref2.jpg"
                    ],
                    "duration": 6,
                    "aspect_ratio": "4:3"
                  }
                },
                "audio_reference": {
                  "summary": "Audio reference",
                  "value": {
                    "model": "magi-2-reference-to-video",
                    "prompt": "A news anchor presents the morning news facing the camera, with lip movements synced to the audio",
                    "audio_urls": [
                      "https://example.com/voice.wav"
                    ],
                    "duration": 8,
                    "aspect_ratio": "16:9"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video generation task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated, token invalid or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient quota, top-up required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: magi-2-reference-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Video generation model name",
            "enum": [
              "magi-2-reference-to-video"
            ],
            "default": "magi-2-reference-to-video",
            "example": "magi-2-reference-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Text prompt describing the desired video (optional). Supports both Chinese and English. Maximum prompt length: 15000 characters",
            "example": "Follow the camera movement and rhythm of the reference video, and have the character from the image dance on a city rooftop to the beat of the reference audio"
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 10,
            "example": [
              "https://example.com/ref1.jpg"
            ],
            "description": "Reference image URL array, **0–10 images**\n\n**Role description:**\n\n| Media Type | Role | Typical Usage |\n|---------|------|----------|\n| Image | `reference_image` | Character reference, style reference, product image |\n\n**Image requirements:**\n- Max size per image: `30MB`\n- Only HTTPS URLs are supported; image URLs must be directly accessible by the server\n\n**Note:** At least one of `image_urls`, `video_urls`, or `audio_urls` must be provided"
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 5,
            "example": [
              "https://example.com/reference.mp4"
            ],
            "description": "Reference video URL array, **0–5 videos**\n\n**Role description:**\n\n| Media Type | Role | Typical Usage |\n|---------|------|----------|\n| Video | `reference_video` | Camera movement reference, motion reference, visual style reference |\n\n**Video requirements:**\n- Supported formats: `.mp4`, `.mov`\n- Duration per video: `2` ~ `30` seconds, max 5 videos, total duration of all videos ≤ `30` seconds\n- Max size per video: `200MB`\n- Only HTTPS URLs are supported; video URLs must be directly accessible by the server\n\n**Note:** At least one of `image_urls`, `video_urls`, or `audio_urls` must be provided"
          },
          "audio_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 5,
            "example": [
              "https://example.com/bgm.mp3"
            ],
            "description": "Reference audio URL array, **0–5 clips**\n\n**Role description:**\n\n| Media Type | Role | Typical Usage |\n|---------|------|----------|\n| Audio | `reference_audio` | Background music, sound effects, voice/dialogue reference |\n\n**Audio requirements:**\n- Supported formats: `.wav`, `.mp3`\n- Duration per clip: `2` ~ `30` seconds, max 5 clips, total duration of all audio ≤ `30` seconds\n- Max size per clip: `15MB`\n- Only HTTPS URLs are supported; audio URLs must be directly accessible by the server\n\n**Note:** At least one of `image_urls`, `video_urls`, or `audio_urls` must be provided"
          },
          "duration": {
            "type": "integer",
            "description": "Output video duration (seconds), defaults to `5` seconds\n\n**Details:**\n- Supports any integer value between `4`–`30` seconds\n- Duration directly affects billing",
            "default": 5,
            "minimum": 4,
            "maximum": 30,
            "example": 8
          },
          "quality": {
            "type": "string",
            "description": "Video resolution, only `1080p` is supported",
            "enum": [
              "1080p"
            ],
            "default": "1080p",
            "example": "1080p"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Video aspect ratio, defaults to `16:9`\n\n**Options:**\n- `16:9` (landscape), `9:16` (portrait), `1:1` (square), `4:3`, `3:4`, `21:9` (ultrawide)",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:3",
              "3:4",
              "21:9"
            ],
            "default": "16:9",
            "example": "16:9"
          },
          "generate_audio": {
            "type": "boolean",
            "description": "Whether to generate synchronized audio, defaults to `true`\n\n**Options:**\n- `true`: Video includes synchronized audio at no additional charge\n- `false`: Output silent video",
            "default": true,
            "example": true
          },
          "seed": {
            "type": "integer",
            "description": "Random seed, range `0`–`4294967295`\n\n**Details:**\n- A random seed is used when omitted\n- With all other parameters unchanged, reusing the same seed helps reproduce similar results",
            "minimum": 0,
            "maximum": 4294967295,
            "example": 42
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS callback URL for task completion\n\n**Callback timing:**\n- Triggered when the task is completed, failed, or cancelled\n- Sent after billing confirmation is complete\n\n**Security restrictions:**\n- Only HTTPS protocol is supported\n- Callbacks to private IP addresses are prohibited (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- URL length must not exceed `2048` characters\n\n**Callback mechanism:**\n- Timeout: `10` seconds\n- Up to `3` retries after failure (at `1`/`2`/`4` seconds after failure respectively)\n- Callback response body format is consistent with the task query endpoint response format\n- A 2xx status code is considered successful; other status codes trigger retries",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Task creation timestamp",
            "example": 1761313744
          },
          "id": {
            "type": "string",
            "description": "Task ID",
            "example": "task-unified-1774857405-abc123"
          },
          "model": {
            "type": "string",
            "description": "Actual model name used",
            "example": "magi-2-reference-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Specific type of the task"
          },
          "progress": {
            "type": "integer",
            "description": "Task progress percentage (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Task status",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Video task details"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Output type of the task",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Usage and billing information"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Whether the task can be cancelled. MAGI-2 does not support user cancellation; this field always returns `false`.",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Estimated completion time (seconds)",
            "minimum": 0,
            "example": 165
          },
          "video_duration": {
            "type": "integer",
            "description": "Video duration (seconds)",
            "example": 8
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Usage and billing information",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Billing rule",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Estimated credits consumed",
            "minimum": 0,
            "example": 50
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code identifier"
              },
              "message": {
                "type": "string",
                "description": "Error description message"
              },
              "type": {
                "type": "string",
                "description": "Error type"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##All endpoints require Bearer Token authentication##\n\n**Get API Key:**\n\nVisit the [API Key Management Page](https://evolink.ai/dashboard/keys) to obtain your API Key\n\n**Add to request header:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Video Generation",
      "description": "AI video generation endpoints"
    }
  ]
}
