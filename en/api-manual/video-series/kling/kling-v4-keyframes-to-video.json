{
  "openapi": "3.1.0",
  "info": {
    "title": "kling-v4-keyframes-to-video API",
    "description": "Create keyframe-to-video tasks using AI models",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "kling-v4-keyframes-to-video API",
        "description": "- Kling-4.0 Keyframes to Video (kling-v4-keyframes-to-video) generates videos from keyframes\n- Provide `2` to `10` keyframe images in chronological order to generate a video that passes through each frame in sequence\n- Asynchronous processing mode, use the returned task ID to [query status](/en/api-manual/task-management/get-task-detail)\n- Generated video links are valid for 24 hours, please save them promptly",
        "operationId": "createVideoGeneration",
        "tags": [
          "Video Generation"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Evenly spaced keyframes",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "The camera moves from a street in the early morning to a square at dusk as the light gradually warms",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/morning.jpg"
                      },
                      {
                        "image_url": "https://example.com/noon.jpg"
                      },
                      {
                        "image_url": "https://example.com/evening.jpg"
                      }
                    ],
                    "duration": 6,
                    "aspect_ratio": "16:9",
                    "quality": "720p"
                  }
                },
                "with_time": {
                  "summary": "Explicit keyframe timestamps",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "A flower goes from bud to full bloom and then wilts",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/bud.jpg",
                        "time": 0
                      },
                      {
                        "image_url": "https://example.com/bloom.jpg",
                        "time": 4.5
                      },
                      {
                        "image_url": "https://example.com/wilt.jpg",
                        "time": 10
                      }
                    ],
                    "duration": 10,
                    "aspect_ratio": "1:1",
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Video generation task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated, token invalid or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Insufficient quota, top-up required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: kling-v4-keyframes-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt",
          "keyframes"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Video generation model name",
            "enum": [
              "kling-v4-keyframes-to-video"
            ],
            "default": "kling-v4-keyframes-to-video",
            "example": "kling-v4-keyframes-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Text prompt describing the transitions between keyframes\n\n**Note:**\n- Maximum `2500` characters",
            "example": "The camera moves from a street in the early morning to a square at dusk as the light gradually warms",
            "maxLength": 2500
          },
          "keyframes": {
            "type": "array",
            "description": "Keyframes in chronological order: the first image is the opening frame and the last is the closing frame (**required**)\n\n**Constraints:**\n- `2` to `10` images, and no more than `duration` + 1 (up to `4` images for `3` seconds or `6` images for `5` seconds)\n- Set `time` for every keyframe or omit it for all keyframes. If omitted for all, keyframes are evenly spaced throughout the video\n\n**Note:**\n- Image size: up to `10MB`\n- Supported formats: `.jpg`, `.jpeg`, `.png`\n- Image dimensions: width and height >= `300px`, aspect ratio between `1:2.5` and `2.5:1`\n- Image URL must be directly accessible by the server or trigger a direct download when accessed\n\n**Example 1: omit `time` to distribute keyframes evenly**\n\n```json\n[\n  {\"image_url\": \"https://example.com/morning.jpg\"},\n  {\"image_url\": \"https://example.com/noon.jpg\"},\n  {\"image_url\": \"https://example.com/evening.jpg\"}\n]\n```\n\n**Example 2: set `time` for every keyframe to specify timestamps (`duration` is `10` in this example)**\n\n```json\n[\n  {\"image_url\": \"https://example.com/bud.jpg\", \"time\": 0},\n  {\"image_url\": \"https://example.com/bloom.jpg\", \"time\": 4.5},\n  {\"image_url\": \"https://example.com/wilt.jpg\", \"time\": 10}\n]\n```",
            "items": {
              "type": "object",
              "properties": {
                "image_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Keyframe image URL"
                },
                "time": {
                  "type": "number",
                  "description": "Timestamp of this keyframe in seconds from the start of the video. Decimal values are allowed (for example, `2.5`)\n\n**Note:**\n- Range: `0` to `duration`\n- Must be later than the previous keyframe"
                }
              },
              "required": [
                "image_url"
              ]
            },
            "minItems": 2,
            "maxItems": 10
          },
          "duration": {
            "type": "integer",
            "description": "Video duration in seconds. Defaults to `5` seconds\n\n**Range:**\n- Integer from `3` to `30`",
            "minimum": 3,
            "maximum": 30,
            "default": 5,
            "example": 5
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Video aspect ratio\n\n**Options:**\n- `16:9`: Landscape\n- `9:16`: Portrait\n- `1:1`: Square\n- `21:9`: Ultrawide",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "21:9"
            ],
            "example": "16:9",
            "default": "16:9"
          },
          "quality": {
            "type": "string",
            "description": "Resolution tier\n\n**Options:**\n- `720p`: Standard 720P\n- `1080p`: High quality 1080P",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "example": "720p"
          },
          "callback_url": {
            "type": "string",
            "description": "HTTPS callback URL for task completion\n\n**Callback Timing:**\n- Triggered when task is completed, failed, or cancelled\n- Sent after billing confirmation\n\n**Security Restrictions:**\n- HTTPS protocol only\n- Internal IP addresses are prohibited (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- URL length must not exceed `2048` characters\n\n**Callback Mechanism:**\n- Timeout: `10` seconds\n- Maximum `3` retries after failure (at `1`/`2`/`4` seconds after failure)\n- Callback response format is consistent with task query API\n- 2xx status code is considered successful, other codes trigger retry",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Task creation timestamp",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "Task ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Actual model name used",
            "example": "kling-v4-keyframes-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Task type"
          },
          "progress": {
            "type": "integer",
            "description": "Task progress percentage (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "Task status",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Video task details"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Task output type",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "Usage and billing information"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Whether the task can be cancelled",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "Estimated completion time (seconds)",
            "minimum": 0,
            "example": 300
          },
          "video_duration": {
            "type": "integer",
            "description": "Video duration (seconds)",
            "example": 5
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "Usage and billing information",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Billing rule",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Estimated credits consumed",
            "minimum": 0,
            "example": 270000
          },
          "user_group": {
            "type": "string",
            "description": "User group category",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code identifier"
              },
              "message": {
                "type": "string",
                "description": "Error description"
              },
              "type": {
                "type": "string",
                "description": "Error type"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## All APIs require Bearer Token authentication ##\n\n**Get API Key:**\n\nVisit [API Key Management Page](https://evolink.ai/dashboard/keys) to get your API Key\n\n**Add to request header:**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Video Generation",
      "description": "AI video generation APIs"
    }
  ]
}
