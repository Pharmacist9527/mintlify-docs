                      }
                    ]
                  }
                },
                "tool_result": {
                  "summary": "ツールの結果を返送（マルチターンのツール呼び出し）",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "北京の今日の天気を調べて"
                      },
                      {
