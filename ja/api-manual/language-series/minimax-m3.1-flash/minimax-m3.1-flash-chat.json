                        "content": "",
                        "reasoning_content": "ユーザーは北京の天気を調べたいので、get_weather ツールを呼び出します。",
                        "tool_calls": [
                          {
                            "id": "call_function_p4iiqtpnh5bj_1",
                            "type": "function",
                            "function": {
                              "name": "get_weather",
                              "arguments": "{\"location\": \"北京\"}"
                            }
                          }
