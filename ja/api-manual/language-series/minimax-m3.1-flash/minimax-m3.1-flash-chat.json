                      },
                      {
                        "role": "tool",
                        "tool_call_id": "call_function_p4iiqtpnh5bj_1",
                        "content": "{\"location\": \"北京\", \"weather\": \"晴れ\", \"temperature\": \"22°C\"}"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "指定した都市の天気状況を照会します",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "location": {
                                "type": "string",
                                "description": "都市名、例：北京"
                              }
                            },
                            "required": [
                              "location"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "ストリーミング出力",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    },
                    "messages": [
                      {
