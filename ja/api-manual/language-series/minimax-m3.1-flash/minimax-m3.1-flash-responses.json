            ]
          },
          "call_id": {
            "type": "string",
            "description": "関数呼び出しの識別子。`function_call` と `function_call_output` はこれで対応付けられます。"
          },
          "output": {
            "type": "string",
            "description": "関数の実行結果。`type: function_call_output` のときのみ使用します。"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "title": "コンテンツブロック",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_text",
              "input_image",
              "input_video",
              "output_text"
            ],
            "description": "コンテンツブロックの種類"
          },
          "text": {
            "type": "string",
            "description": "テキスト内容（`input_text` / `output_text`）"
          },
          "image_url": {
            "description": "画像入力。`type: input_image` の場合に使用します。URL / Base64 data URL の文字列、またはオブジェクト `{\"url\": \"...\", \"detail\": \"low | default | high\"}` を指定できます。`detail` で解析精度を制御します（精度が高いほど詳細を認識し、トークン消費量も増加します）。JPEG / PNG / GIF / WEBP に対応し、1 枚あたりの上限は 10 MB です",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "画像 URL または Base64 data URL"
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default",
                    "description": "解像度"
                  }
                }
              }
            ]
          },
          "video_url": {
            "description": "動画入力。`type: input_video` の場合に使用します。URL / Base64 data URL の文字列、またはオブジェクト `{\"url\": \"...\", \"fps\": 1, \"detail\": \"default\", \"max_long_side_pixel\": ...}` を指定できます。`fps` はフレーム抽出頻度で、デフォルトは 1、範囲は [0.2, 5] です。値を下げるとトークン消費量が減少します。MP4 / AVI / MOV / MKV に対応し、URL / Base64 入力の上限は 50 MB です。より大きな動画は `mm_file://{file_id}` 形式のファイル参照で渡します",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "動画 URL、Base64 data URL、または `mm_file://{file_id}`"
                  },
                  "fps": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 5,
                    "default": 1,
                    "description": "フレーム抽出頻度"
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default",
                    "description": "解像度"
                  },
                  "max_long_side_pixel": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "動画フレームの最長辺のピクセル上限"
                  }
                }
              }
            ]
          }
        }
      },
      "Tool": {
        "type": "object",
        "title": "ツール定義",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "ツールの種類。現在は `function` のみ対応しています",
            "enum": [
              "function"
            ],
            "example": "function"
          },
          "name": {
            "type": "string",
            "description": "関数名",
            "example": "get_product_stock"
