        "properties": {
          "model": {
            "type": "string",
            "description": "モデル ID\n\n**説明**：`MiniMax-M3.1-Flash` はプレビュー版モデルのため、動作が変更される可能性があります",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "input": {
            "type": [
              "string",
              "array"
            ],
            "description": "モデルへの入力\n\n- **文字列形式**：テキスト全体が単一の `user` メッセージとして扱われます\n- **配列形式**：入力アイテムのリスト。対応する種類は `message`、`function_call`、`function_call_output`、`reasoning` です\n\n**マルチモーダル入力**：`message` アイテムの `content` 配列には、`input_text`、`input_image`、`input_video` ブロックを混在できます。\n\n**マルチターン会話**：本インターフェースはステートレスのため、会話を継続するには完全な履歴を配列に含める必要があります。マルチターンのツール呼び出しでは、前回のレスポンスの `output` アイテム（`reasoning` アイテムを含む）をそのまま追加してください。",
            "items": {
              "$ref": "#/components/schemas/InputItem"
            },
            "example": "杭州を一文で紹介してください。"
          },
          "instructions": {
            "type": "string",
            "description": "システムレベルの指示。先頭に挿入される system メッセージと同等で、役割・口調・出力制約の設定に使用します。",
            "example": "あなたは厳密なテクニカルライターです。回答は簡潔に保ってください。"
          },
          "stream": {
            "type": "boolean",
            "description": "ストリーミングで返すかどうか\n\n- `false`（デフォルト）：完全なレスポンスオブジェクトを一度に返します\n- `true`：SSE イベントで配信します。回答テキストは `response.output_text.delta` イベントで届き、生成は `response.completed`（または `response.incomplete` / `response.failed`）で終了します",
            "default": false,
            "example": false
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "今回の生成における最大出力トークン数（思考トークンを含む）\n\n**説明**：\n- 上限は **524,288**（512K）、推奨は **131,072**（128K）まで\n- 省略した場合、EvoLink は **32768** を使用します\n- 値が小さく `reasoning.effort` が高いと、思考だけで上限を使い切り、レスポンスが `status: \"incomplete\"` で終了して `message` アイテムが含まれないことがあります\n- 32768 以上を指定し、簡単なタスクでは `reasoning.effort` を下げてください",
            "minimum": 1,
            "maximum": 524288,
            "example": 32768
          },
          "temperature": {
            "type": "number",
            "description": "サンプリング温度。高いほど出力がランダムになります。範囲 `(0, 1]`、デフォルト 1",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "核サンプリングのしきい値。範囲 `(0, 1]`、デフォルト 0.95。`temperature` とはどちらか一方のみを調整し、両方を同時に変更しないでください",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "reasoning": {
            "type": "object",
            "description": "思考の設定。MiniMax-M3.1-Flash は `reasoning` を省略した場合も含め、常に思考します。思考内容は `reasoning` 出力アイテムとして返され、そのトークンは出力トークンとして課金されます",
            "properties": {
              "effort": {
                "type": "string",
                "description": "思考の深さ\n\n- `low`：思考が最も浅く、応答が最も速く、出力トークンが最も少ない\n- `medium` / `high` / `xhigh`：この順に思考が深くなります\n- `max`（デフォルト）：思考が最も深く、応答が最も遅く、出力トークンが最も多い\n\n**説明**：\n- 省略時は `max` になります。簡単なタスクでは低いレベルを指定すると、レイテンシと出力トークンを削減できます\n- 思考トークンは `max_output_tokens` に含まれます\n- `none` と `minimal` を指定しても思考は無効になりません。EvoLink が `low` に変更します",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "max",
                "example": "medium"
              }
            }
          },
          "text": {
            "type": "object",
            "description": "テキスト出力フォーマットの設定。",
            "properties": {
              "format": {
                "type": "object",
                "description": "出力フォーマット。`text`（自由形式テキスト）のみ対応",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "text"
                    ],
                    "default": "text",
                    "description": "出力フォーマットの種類"
                  }
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "モデルが呼び出せるツールのリスト。関数ツールのみ対応します。関数はクライアントが実行し、結果を `function_call_output` として返します",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "ツール呼び出しの方針\n\n- `none`：ツール呼び出しを禁止\n- `auto`（デフォルト）：ツールを呼び出すかどうかをモデルが判断\n\nその他の値には対応していません",
            "enum": [
              "none",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "store": {
            "type": "boolean",
            "description": "効果はありません。レスポンスは保存されません"
          },
          "previous_response_id": {
            "type": "string",
            "description": "非対応。このフィールドを含むリクエストは 400（`unsupported_parameter`）で拒否されます。完全な履歴を `input` で送信してください"
          },
          "conversation": {
            "description": "非対応。このフィールドを含むリクエストは 400（`unsupported_parameter`）で拒否されます。完全な履歴を `input` で送信してください",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "InputItem": {
        "type": "object",
        "title": "入力アイテム",
        "description": "`input` 配列内の単一の入力アイテム。`type` がそのアイテムの意味を決定します。",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "入力アイテムの種類\n\n- `message`：会話メッセージ\n- `function_call`：以前にモデルが発行した関数呼び出し\n- `function_call_output`：関数の実行結果\n- `reasoning`：過去の思考内容。前回のレスポンスの `output` にあるアイテムをそのまま返送してください",
            "enum": [
              "message",
              "function_call",
              "function_call_output",
              "reasoning"
            ],
            "example": "message"
          },
          "role": {
            "type": "string",
            "description": "メッセージのロール。`type: message` のときのみ使用します",
            "enum": [
              "user",
              "assistant",
              "system",
              "developer"
            ],
            "example": "user"
          },
          "content": {
            "description": "メッセージ内容。`type: message` のときのみ使用します。プレーンテキストまたはコンテンツブロック配列を指定できます（`input_text` / `input_image` / `input_video`。過去のアシスタントのテキストには `output_text` を使用）",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "call_id": {
            "type": "string",
            "description": "関数呼び出しの識別子。`function_call` と `function_call_output` はこれで対応付けられます。"
          },
          "name": {
            "type": "string",
            "description": "呼び出された関数名。`type: function_call` のときのみ使用します。"
          },
          "arguments": {
            "type": "string",
            "description": "関数呼び出しの引数（JSON 文字列）。`type: function_call` のときのみ使用します。"
          },
          "output": {
            "type": "string",
            "description": "関数の実行結果。`type: function_call_output` のときのみ使用します。"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "マルチモーダルコンテンツ片。`type` で種類を宣言し、その種類に一致するフィールドのみを記入します",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_text",
              "output_text",
              "input_image",
              "input_video"
            ],
            "description": "コンテンツブロックの種類\n\n- `input_text`：テキスト入力\n- `output_text`：過去のアシスタント返信のテキスト\n- `input_image`：画像入力\n- `input_video`：動画入力"
          },
          "text": {
            "type": "string",
            "description": "テキスト内容（`type` が `input_text` / `output_text` の場合）"
          },
          "image_url": {
            "description": "画像入力（`type` が `input_image` の場合）：画像 URL または `data:` で始まる base64 data URL を、文字列または `url` を持つオブジェクトとして渡します。各画像は最大 10 MB、JPEG / PNG / GIF / WEBP に対応",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "画像 URL、または `data:` で始まる base64 data URL"
                  },
                  "detail": {
                    "type": "string",
                    "description": "画像の解析解像度を制御します\n\n- `low`：低精度、消費トークンが少ない\n- `default`：デフォルト精度\n- `high`：高精度、より細部を認識できるが消費トークンが多い",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default"
                  }
                }
              }
            ]
          },
          "video_url": {
            "description": "動画入力（`type` が `input_video` の場合）：動画 URL または `data:` で始まる base64 data URL を、文字列または `url` を持つオブジェクトとして渡します。URL / Base64 動画は最大 50 MB、MP4 / AVI / MOV / MKV に対応",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "動画 URL、または `data:` で始まる base64 data URL"
                  },
                  "fps": {
                    "type": "number",
                    "description": "動画のフレーム抽出レート。デフォルト 1、範囲 [0.2, 5]\n\n- 値が高いほど：画面の変化により敏感になり、トークンコストが高く速度が遅くなります\n- 値が低いほど：トークンコストが低く速度が速くなりますが、画面の変化に鈍くなります",
                    "minimum": 0.2,
                    "maximum": 5,
                    "default": 1
                  },
                  "detail": {
                    "type": "string",
                    "description": "動画のフレーム抽出解像度を制御します",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default"
                  },
                  "max_long_side_pixel": {
                    "type": "integer",
                    "description": "動画フレームの最長辺のピクセル上限",
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      },
      "Tool": {
        "type": "object",
        "title": "ツール定義",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "ツールの種類。`function` のみ対応",
            "enum": [
              "function"
            ],
            "example": "function"
          },
          "name": {
            "type": "string",
            "description": "呼び出す関数の名前\n\n**説明**：\n- a-z、A-Z、0-9 の文字、またはアンダースコアとハイフンで構成する必要があります\n- 最大長は 64 文字です",
            "maxLength": 64,
            "example": "get_weather"
          },
          "description": {
            "type": "string",
            "description": "ツールの用途説明。明確に書くとモデルが呼び出し時機を判断しやすくなります。",
            "example": "指定した都市のリアルタイム天気を取得する"
          },
          "parameters": {
            "type": "object",
            "description": "パラメータ定義（JSON Schema 形式）。",
            "example": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string",
                  "description": "都市名"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "Responses インターフェースのレスポンスオブジェクト。",
        "properties": {
          "id": {
            "type": "string",
            "description": "本レスポンスの一意な識別子",
            "example": "resp_066b36619b147e31"
          },
          "object": {
            "type": "string",
            "description": "オブジェクト種別。常に `response`",
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "作成時刻（Unix タイムスタンプ、秒）",
            "example": 1790000000
          },
          "model": {
            "type": "string",
            "description": "実際に本レスポンスを生成したモデル ID",
            "example": "MiniMax-M3.1-Flash"
          },
          "status": {
            "type": "string",
            "description": "レスポンスの状態\n\n- `completed`：正常に完了\n- `incomplete`：出力トークン上限への到達などにより切り詰められました。詳細は `incomplete_details` を参照\n- `failed`：生成に失敗しました。詳細は `error` を参照",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "出力アイテムのリスト（生成順）。種類ごとのフィールド：\n\n- `reasoning`：思考過程。`id`、`status`、`summary`、`content`（`reasoning_text` ブロックのリスト）を含みます。MiniMax-M3.1-Flash では常に含まれます\n- `message`：最終回答。`id`、`status`、`role`、`content`（`output_text` ブロックのリスト）を含みます\n- `function_call`：モデルが発行した関数呼び出し。`id`、`status`、`call_id`、`name`、`arguments` を含み、クライアントが実行後に `function_call_output` として結果を返します",
            "items": {
              "type": "object"
            }
          },
          "output_text": {
            "type": "string",
            "description": "利便性のためのフィールド。回答テキストをすべて連結したもの"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "失敗の理由。成功時は `null`"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "切り詰めの理由。切り詰められていない場合は `null`。出力トークン上限に達した場合、`reason` は `max_output_tokens` になります"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "トークン使用統計（キャッシュと推論の内訳を含む）",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "入力トークン総数（キャッシュヒットとミスを含む）",
            "example": 14
          },
          "input_tokens_details": {
            "type": "object",
            "description": "入力トークンの内訳",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "プロンプトキャッシュにヒットした入力トークン数（`input_tokens` の一部）",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "出力トークン数（思考部分を含む）",
            "example": 62
          },
          "output_tokens_details": {
            "type": "object",
            "description": "出力トークンの内訳",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "思考モードで生成された推論トークン数（出力に計上され、出力単価で課金されます）",
                "example": 38
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "総トークン数 = input_tokens + output_tokens",
            "example": 76
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "description": "エラーコード：HTTP ステータスコード、または `unsupported_parameter` などの文字列コード",
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "message": {
                "type": "string",
                "description": "エラー説明情報"
              },
              "type": {
                "type": "string",
                "description": "エラーの種類"
              },
              "param": {
                "type": "string",
                "description": "関連するパラメータ名"
              }
            }
          }
        }
      }
    }
  }
