            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Model not found",
                    "type": "not_found_error"
                  }
                }
              }
            }
          },
          "413": {
            "description": "リクエストボディが大きすぎます",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 413,
                    "message": "Request entity too large",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度が上限を超過",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "server_error"
                  }
                }
              }
            }
          },
          "502": {
            "description": "ゲートウェイエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Bad gateway",
                    "type": "server_error"
                  }
                }
              }
            }
          },
          "503": {
            "description": "サービスが一時的に利用できません",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "server_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "すべての API で Bearer Token 認証が必要です\n\n**API キーの取得：**\n\n[API キー管理ページ](https://evolink.ai/dashboard/keys)で API キーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "モデル ID",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "input": {
            "type": [
              "string",
              "array"
            ],
            "description": "モデルへの入力\n\n- **文字列形式**：テキスト全体を 1 件の `user` メッセージとして扱います\n- **配列形式**：入力アイテムのリスト。`message`、`function_call`、`function_call_output`、`reasoning` に対応します\n\n**マルチモーダル**：`message` アイテムの `content` 配列内で `input_text`、`input_image`、`input_video` ブロックを組み合わせます。\n\n**マルチターン対話**：API はステートレスです。対話を続ける場合は、完全な履歴を配列に含める必要があります。",
            "items": {
              "$ref": "#/components/schemas/InputItem"
            },
            "example": "Explain recursion in one sentence."
          },
          "instructions": {
            "type": "string",
            "description": "システムレベルの指示。先頭に挿入される system メッセージと同等で、役割・口調・出力制約の設定に使用します。",
            "example": "You are a technical documentation assistant. Keep your answers concise."
          },
          "stream": {
            "type": "boolean",
            "description": "ストリーミングで返すかどうか\n\n- `false`（デフォルト）：完全なレスポンスオブジェクトを一括で返します\n- `true`：意味ごとに定義された SSE イベントで配信します。終了イベントは `response.completed` で、**`[DONE]` は送信されません**",
            "default": false,
            "example": false
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "今回の生成で出力できる最大トークン数。**思考と回答の両方を含みます**\n\n- 推奨値は **131,072**（128K）、最大値は **524,288**（512K）\n- 値が小さすぎると、思考中に上限に達し、`status: \"incomplete\"` となって `message` 出力アイテムが返されない場合があります",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "reasoning": {
            "type": "object",
            "description": "思考の設定。MiniMax-M3.1-Flash は常に思考を行い、その内容を `reasoning` 出力アイテムとして返します。思考トークンは出力に含まれ、出力料金で課金されます。",
            "properties": {
              "effort": {
                "type": "string",
                "description": "思考の深さ。デフォルトは `max`。深さを上げると、通常は思考トークンの消費量と応答時間が増加します。",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "max",
                "example": "high"
              }
            }
          },
          "temperature": {
            "type": "number",
            "description": "サンプリング温度。`1` に固定されています",
            "enum": [
              1
            ],
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Nucleus Sampling のしきい値。デフォルトは 0.95。",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "tools": {
            "type": "array",
            "description": "モデルが呼び出せるツールのリスト。現在は `function` タイプのみ対応しています。関数はクライアント側で実行し、結果を `function_call_output` 入力アイテムとして返します。",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "ツールの選択方針。`auto` のみ対応しています（ツールを呼び出すかどうかをモデルが判断します）",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "text": {
            "type": "object",
            "description": "テキスト出力形式の設定。`format.type` は `text` のみ対応しています",
            "properties": {
              "format": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "text"
                    ],
                    "default": "text",
                    "description": "出力フォーマットの種類"
                  }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "リクエストのメタデータ。キーと値はどちらも文字列です",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "InputItem": {
        "title": "入力アイテム",
        "description": "入力アイテム：メッセージ、思考履歴、関数呼び出し、または関数の実行結果。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/MessageItem"
          },
          {
            "$ref": "#/components/schemas/ReasoningItem"
          },
          {
            "$ref": "#/components/schemas/FunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/FunctionCallOutputItem"
          }
        ]
      },
      "MessageItem": {
        "type": "object",
        "title": "メッセージアイテム",
        "description": "対話メッセージ。過去のアシスタントメッセージを送信する場合は、返されたすべてのフィールドを保持してください。",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "default": "message"
          },
          "id": {
            "type": "string",
            "description": "出力アイテムの識別子。履歴を送信する際は変更しないでください。"
          },
          "status": {
            "type": "string",
            "description": "出力アイテムのステータス。履歴を送信する際は変更しないでください。"
          },
          "role": {
            "type": "string",
            "description": "メッセージのロール。`type: message` のときのみ使用します。`developer` は `system` として扱われます。",
            "enum": [
              "user",
              "assistant",
              "system",
              "developer"
            ],
            "example": "user"
          },
          "content": {
            "type": [
              "string",
              "array"
            ],
            "description": "メッセージの内容。`type: message` の場合のみ使用します。プレーンテキスト、またはコンテンツブロックの配列を指定できます。\n\n**コンテンツブロックの種類**：\n- `input_text`：テキスト。`text` フィールドを使用します\n- `input_image`：画像。`image_url` フィールドを使用します\n- `input_video`：動画。`video_url` フィールドを使用します\n- `output_text`：過去の assistant の返信に含まれるテキスト\n\nリクエストボディの上限は 64 MB です。",
            "items": {
              "$ref": "#/components/schemas/ContentPart"
            },
            "example": "Explain recursion in one sentence."
          }
        }
      },
      "ReasoningItem": {
        "type": "object",
        "title": "思考アイテム",
        "description": "前のターンで返された思考アイテム。対話を続ける際は、`id`、`status`、`summary`、`content`、`encrypted_content` を含むアイテム全体をそのまま送信してください。",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning"
            ]
          },
          "id": {
            "type": "string",
            "description": "出力アイテムの識別子。履歴を送信する際は変更しないでください。"
          },
          "status": {
            "type": "string",
            "description": "出力アイテムのステータス。履歴を送信する際は変更しないでください。"
          },
          "summary": {
            "type": "array",
            "description": "思考の要約。会話履歴を送信する際は、そのまま保持してください。",
            "items": {
              "type": "object"
            }
          },
          "content": {
            "type": "array",
            "description": "思考コンテンツブロック。履歴ではそのまま保持してください。",
            "items": {
              "$ref": "#/components/schemas/ReasoningContentPart"
            }
          },
          "encrypted_content": {
            "type": "string",
            "description": "内部形式の思考データ。履歴ではそのまま保持してください。"
          }
        }
      },
      "ReasoningContentPart": {
        "type": "object",
        "title": "思考コンテンツブロック",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning_text"
            ]
          },
          "text": {
            "type": "string",
            "description": "思考テキスト。"
          }
        }
