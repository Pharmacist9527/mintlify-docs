          "arguments": {
            "type": "string",
            "description": "関数呼び出しの引数（JSON 文字列）。`type: function_call` のときのみ使用します。"
          }
        }
      },
      "FunctionCallOutputItem": {
        "type": "object",
        "title": "関数の実行結果アイテム",
