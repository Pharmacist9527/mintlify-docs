              ]
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "Responses API のレスポンスオブジェクト。以下のフィールドに加え、今回のリクエストの設定（`tools`、`tool_choice`、`temperature`、`top_p`、`text`、`reasoning`、`max_output_tokens` など）も返されます。",
        "properties": {
          "id": {
            "type": "string",
            "description": "このレスポンスの一意識別子",
            "example": "072514d63605b7a0c83f1672230c398c"
          },
          "object": {
            "type": "string",
            "description": "オブジェクト種別。常に `response`",
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "作成時刻（Unix タイムスタンプ、秒）",
            "example": 1792401878
          },
          "status": {
            "type": "string",
            "description": "レスポンスの状態\n\n- `completed`：正常に完了\n- `incomplete`：途中で打ち切り。理由は `incomplete_details` を参照してください\n- `failed`：生成に失敗。理由は `error` を参照してください",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "model": {
            "type": "string",
            "description": "実際に本レスポンスを生成したモデル ID",
            "example": "MiniMax-M3.1-Flash"
          },
          "output": {
            "type": "array",
            "description": "生成順に並んだ出力アイテムのリスト：\n\n- `reasoning`：思考過程。id は `<id>_rs` 形式で、`content`（`reasoning_text` ブロックのリスト）、`summary`（空の配列）、`encrypted_content` を含みます\n- `message`：最終回答。id は `<id>_msg` 形式で、`content`（`output_text` ブロックのリスト）を含みます\n- `function_call`：モデルによる関数呼び出し。id は `<id>_fc_<連番>` 形式で、`call_id`、`name`、`arguments` を含みます。クライアント側で実行し、結果を `function_call_output` として返す必要があります",
            "items": {
              "type": "object"
            }
          },
          "output_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "すべての `output_text` のテキストを連結した結果。テキスト出力がない場合は `null` です"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "失敗の理由。成功時は `null`"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "打ち切り理由。打ち切られていない場合は `null` です。`reason` は `max_output_tokens`（出力上限に到達）または `content_filter`（コンテンツ安全性）です"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "トークン使用統計（キャッシュと思考の内訳を含む）",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "入力トークンの総数（キャッシュヒット分を含む）",
            "example": 207
          },
          "input_tokens_details": {
            "type": "object",
            "description": "入力 token の詳細内訳",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "キャッシュにヒットした入力トークン数\n\nキャッシュヒット分にはキャッシュヒット料金が適用されます。キャッシュにヒットしなかった部分は `input_tokens - cached_tokens` で、標準入力料金が適用されます",
                "example": 174
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "出力トークン数（思考部分を含む）",
            "example": 32
          },
          "output_tokens_details": {
            "type": "object",
            "description": "出力 token の詳細内訳",
            "properties": {
