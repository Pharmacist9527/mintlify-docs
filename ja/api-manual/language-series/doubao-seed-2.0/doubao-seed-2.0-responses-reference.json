            "properties": {
              "type": {
                "type": "string",
                "description": "位置タイプ",
                "default": "approximate"
              },
              "country": {
                "type": "string",
                "description": "国"
              },
              "region": {
                "type": "string",
                "description": "都道府県/地域"
              },
              "city": {
                "type": "string",
                "description": "都市"
              }
            }
          }
        }
      },
