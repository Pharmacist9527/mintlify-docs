{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Responses — API リファレンス",
    "description": "Seed モデルで使える Responses のパラメーターと詳細機能。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Seed Responses",
        "description": "- Responses API 形式で Seed を呼び出します。\n- サーバーにコンテキストを保存し、履歴を再送せず `previous_response_id` で会話を続けられます。\n- テキスト・画像・動画・PDF を組み合わせられます。`doubao-seed-2-1-lite` のみ音声にも対応します。\n- 思考は既定で有効です。無効化や深さの調整ができます。\n- 全モデルが関数呼び出しに対応します。Seed 2.1 と `doubao-seed-evolving` はウェブ検索にも対応します。\n- 自動キャッシュは既定で有効です。明示的キャッシュには `caching`、コンテキスト管理には `context_management` を使用します。\n- JSON Object または JSON Schema 形式の構造化出力に対応します。\n- [クイックスタート](/ja/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-responses-quickstart)",
        "operationId": "createResponseSeed",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseRequest"
              },
              "examples": {
                "simple_text": {
                  "summary": "テキスト入力",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": "自己紹介をしてください"
                  }
                },
                "multi_turn": {
                  "summary": "マルチターン会話（previous_response_idによる）",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": "その利点は何ですか？",
                    "previous_response_id": "resp_0217****"
                  }
                },
                "message_array": {
                  "summary": "メッセージリスト入力",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": [
                      {
                        "role": "system",
                        "type": "message",
                        "content": "あなたはプロのPythonプログラミングアシスタントです。"
                      },
                      {
                        "role": "user",
                        "type": "message",
                        "content": "ファイルの読み込み方法は？"
                      }
                    ]
                  }
                },
                "thinking_mode": {
                  "summary": "ディープシンキングモードを有効化",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": "√2が無理数であることを証明してください",
                    "thinking": {
                      "type": "enabled"
                    }
                  }
                },
                "thinking_off": {
                  "summary": "思考を無効にする",
                  "value": {
                    "model": "doubao-seed-2-1-turbo",
                    "input": "次の文を英語に訳してください。今日の会議は午後 3 時に変更されました。",
                    "reasoning": {
                      "effort": "minimal"
                    }
                  }
                },
                "web_search": {
                  "summary": "公開ウェブ全体を検索",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": "今日の東京の天気はどうですか？",
                    "tools": [
                      {
                        "type": "web_search",
                        "limit": 5
                      }
                    ]
                  }
                },
                "web_search_sources": {
                  "summary": "Toutiao、Douyin、Moji を追加して検索",
                  "value": {
                    "model": "doubao-seed-2-1-turbo",
                    "input": "北京の明日の天気と最新の旅行情報を教えてください。",
                    "tools": [
                      {
                        "type": "web_search",
                        "sources": [
                          "toutiao",
                          "douyin",
                          "moji"
                        ],
                        "limit": 5
                      }
                    ]
                  }
                },
                "web_search_doubao": {
                  "summary": "Doubao Search によるウェブ検索",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": "直近 1 週間の主な技術ニュースを教えてください。",
                    "tools": [
                      {
                        "type": "web_search",
                        "sources": [
                          "doubao"
                        ]
                      }
                    ]
                  }
                },
                "explicit_cache": {
                  "summary": "明示的キャッシュの初回作成（既定は 3 日、保存料金は別途）",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "input": [
                      {
                        "role": "system",
                        "content": "製品マニュアル：モーターとバッテリーの保証期間は 2 年です。この規定を覚えてください。"
                      },
                      {
                        "role": "user",
                        "content": "マニュアルに記載されている保証期間はどのくらいですか。"
                      }
                    ],
                    "caching": {
                      "type": "enabled"
                    }
                  }
                },
                "explicit_cache_continue": {
                  "summary": "明示的キャッシュで続行（直前の応答 ID を指定、既定は 3 日）",
                  "value": {
                    "model": "doubao-seed-2-1-pro",
                    "previous_response_id": "resp_0217****",
                    "input": [
                      {
                        "role": "user",
                        "content": "保証の対象となる部品を教えてください。"
                      }
                    ],
                    "caching": {
                      "type": "enabled"
                    }
                  }
                },
                "audio": {
                  "summary": "音声入力（`doubao-seed-2-1-lite` のみ）",
                  "value": {
                    "model": "doubao-seed-2-1-lite",
                    "input": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "input_audio",
                            "audio_url": "https://storage.googleapis.com/generativeai-downloads/data/Apollo-11_Day-01-Highlights-10s.mp3"
                          },
                          {
                            "type": "input_text",
                            "text": "このアポロ 11 号の録音を要約してください。"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "レスポンス生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足、チャージが必要",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセス権限なし",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "リソースが存在しません",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "413": {
            "description": "リクエストボディが大きすぎます",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 413,
                    "message": "File too large",
                    "type": "request_too_large_error",
                    "fallback_suggestion": "compress file to under 50MB"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度制限超過",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "モデルサービスで一時的なエラーが発生しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "サービスが一時的に利用不可",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "モデルの選択\n\n| モデル ID | 用途 | コンテキスト長 |\n|---|---|---|\n| `doubao-seed-2-1-pro` | 複雑な推論、長文書、コードベースに適した推奨の最上位モデル | 100 万トークン |\n| `doubao-seed-2-1-turbo` | 対話、データ抽出、エージェント処理向けの低価格モデル | 25.6 万トークン |\n| `doubao-seed-2-1-lite` | Seed 2.1 で最も低価格。音声入力に対応 | 100 万トークン |\n| `doubao-seed-evolving` | 新機能の評価向けに毎週更新 | 100 万トークン |\n| `doubao-seed-2.0-pro` | Seed 2.0 の最上位モデル | 25.6 万トークン |\n| `doubao-seed-2.0-lite` | 軽量で高速な Seed 2.0 モデル | 25.6 万トークン |\n| `doubao-seed-2.0-mini` | 簡単なタスク向けの Seed 2.0 最速モデル | 25.6 万トークン |\n| `doubao-seed-2.0-code` | コードに特化した Seed 2.0 モデル | 25.6 万トークン |\n\nSeed 2.1 のモデル ID はハイフン（`2-1`）、Seed 2.0 はピリオド（`2.0`）を使います。",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "input": {
            "description": "入力コンテンツ。2 つの形式に対応：\n\n**1. テキスト文字列**: user ロールが入力したテキスト情報と同等\n\n**2. 要素リスト (array)**: メッセージ、コンテキスト、ツール呼び出しなど複数の入力タイプを含む",
            "oneOf": [
              {
                "type": "string",
                "description": "テキスト入力"
              },
              {
                "type": "array",
                "description": "入力要素リスト",
                "items": {
                  "$ref": "#/components/schemas/InputItem"
                }
              }
            ]
          },
          "instructions": {
            "type": "string",
            "nullable": true,
            "description": "モデルのコンテキストにシステムメッセージまたは開発者指示を最初の指示として挿入します\n\n**注意**:\n- previous_response_id と併用する場合、前の返信の指示は継承されません\n- caching キャッシュ機能と併用できません"
          },
          "previous_response_id": {
            "type": "string",
            "nullable": true,
            "description": "前のモデル返信の一意識別子。マルチターン会話の実現に使用します\n\n**説明**:\n- 渡すと前回のリクエストの入力と回答内容が導入され、今回のリクエストの入力トークンが相応に増加します\n- マルチターン連続会話では、各リクエスト間に約 100 ミリ秒の遅延を入れることを推奨します"
          },
          "expire_at": {
            "type": "integer",
            "description": "応答保存（`store`）と明示的キャッシュ（`caching`）の有効期限を UTC の Unix 秒で指定します。作成時刻より後、作成から 604800 秒（7 日）以内が有効で、範囲外はエラーです。既定は作成時刻 + 259200 秒（3 日）です。\n\n明示的キャッシュの保存料金は作成時に全有効期間分を一括請求します。保存期間がまたがる時計上の各時間帯は端数も 1 時間として計算します。早期削除による返金はありません。短期間の再利用には早めの `expire_at` を指定してください。"
          },
          "max_output_tokens": {
            "type": "integer",
            "nullable": true,
            "description": "思考と本文を合計した最大出力トークン数。思考用に十分な予算を確保してください。予算切れでは `status` が `incomplete` となり、思考だけが返る場合があります。",
            "example": 32768
          },
          "thinking": {
            "type": "object",
            "description": "控制模型是否ディープシンキングモードを有効化",
            "properties": {
              "type": {
                "type": "string",
                "description": "すべての Seed モデルで既定は `enabled` で、回答前に思考します。`disabled` では直接回答します。思考トークンは出力に含まれ、出力料金が適用されます。",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "reasoning": {
            "type": "object",
            "description": "ディープシンキングの作業量を制限し、削減するとレスポンス速度が速くなり、トークン使用量が少なくなります",
            "properties": {
              "effort": {
                "type": "string",
                "description": "思考の深さ。`minimal` は直接回答、`low` は速度優先、`medium` は速度と深さのバランス、`high` は複雑な問題の詳細な分析に適しています。\n\n既定値は Seed 2.1 と `doubao-seed-evolving` が `high`、Seed 2.0 が `medium`。`none` は `minimal`、`xhigh` と `max` は `high` として扱います。",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          },
          "caching": {
            "type": "object",
            "description": "省略または `disabled` で自動キャッシュを使用します。直近のリクエストと共通の接頭辞にヒット料金が適用される場合があります。保存料はかからず、ヒットは保証されません。\n\n`{\"type\": \"enabled\"}` で現在の入力を明示的に保存します。`previous_response_id` で続ける各ターンでも `caching: {\"type\": \"enabled\"}` を指定してください。ヒット分にはヒット料金が適用されます。保存料は `expire_at` までの新規保存トークン数 × 保存時間（時間単位）で別途計算し、モデル単価を適用します。\n\n`instructions` や関数以外のツール（ウェブ検索を含む）との併用は 400 を返します。",
            "properties": {
              "type": {
                "type": "string",
                "description": "キャッシュスイッチ\n\n- `enabled`: キャッシュを有効化\n- `disabled`: キャッシュを無効化",
                "enum": [
                  "enabled",
                  "disabled"
                ],
                "default": "disabled"
              },
              "prefix": {
                "type": "boolean",
                "description": "公共プレフィックスキャッシュのみ作成するかどうか（モデルは返信しない）\n\n- `true`: 公共プレフィックスキャッシュのみ作成\n- `false`: 公共プレフィックスキャッシュを作成しない",
                "default": false
              }
            },
            "required": [
              "type"
            ]
          },
          "store": {
            "type": "boolean",
            "nullable": true,
            "description": "生成されたモデルレスポンスを保存し、後でAPI経由で取得できるようにするかどうか\n\n- `true`: 現在のモデルレスポンスを保存\n- `false`: 保存しない",
            "default": true
          },
          "stream": {
            "type": "boolean",
            "nullable": true,
            "description": "レスポンスコンテンツをストリーミングで返すかどうか\n\n- `false`: モデルがすべてのコンテンツを生成した後に一括返却\n- `true`: SSEプロトコルに従いチャンクごとに返し、`data: [DONE]`メッセージで終了",
            "default": false
          },
          "temperature": {
            "type": "number",
            "nullable": true,
            "description": "サンプリング温度、出力のランダム性を制御\n\n- 値の範囲: [0, 2]\n- 低い値はより確定的、高い値はよりランダム\n- temperatureまたはtop_pのいずれか一方のみを調整することを推奨\n\n**注意**: doubao-seed-2.0-proとdoubao-seed-2.0-liteは1に固定されており、手動指定は無視されます",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "top_p": {
            "type": "number",
            "nullable": true,
            "description": "核サンプリング確率閾値\n\n- 値の範囲: [0, 1]\n- temperatureまたはtop_pのいずれか一方のみを調整することを推奨\n\n**注意**: doubao-seed-2.0-proとdoubao-seed-2.0-liteは0.95に固定されており、手動指定は無視されます",
            "minimum": 0,
            "maximum": 1,
            "default": 0.7
          },
          "text": {
            "type": "object",
            "description": "モデルテキスト出力の形式定義",
            "properties": {
              "format": {
                "type": "object",
                "description": "モデルのテキスト出力形式を指定",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "形式タイプ\n\n- `text`: 自然言語（デフォルト）\n- `json_object`: JSON オブジェクト形式\n- `json_schema`: schema定義に従ったJSON形式",
                    "enum": [
                      "text",
                      "json_object",
                      "json_schema"
                    ],
                    "default": "text"
                  },
                  "name": {
                    "type": "string",
                    "description": "JSON 構造名（typeがjson_schemaの場合必須）"
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema形式の定義（typeがjson_schemaの場合必須）"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true,
                    "description": "返信用途の説明"
                  },
                  "strict": {
                    "type": "boolean",
                    "nullable": true,
                    "description": "厳格遵守モードを有効にするかどうか",
                    "default": false
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "全 Seed モデルが `function` に対応します。`web_search` は Seed 2.1 と `doubao-seed-evolving` のみ対応し、Seed 2.0 で指定すると 400 を返します。`doubao_app` や `knowledge_search` など他の組み込みツールも 400 を返します。実行した検索はトークンとは別に、検索元ごとのモデル単価で課金されます。",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
