{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Messages — クイックスタート",
    "description": "Messages (Anthropic) を使い、5 分で Seed に最初のチャットリクエストを送ります。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Messages (Anthropic) で Seed との会話を開始",
        "description": "- Anthropic Messages 形式で Seed を呼び出せます。Claude Code などの対応ツールでも利用できます。\n- 同期リクエストでは応答が直接返ります。\n- 最小限のパラメーターで始められます。\n- 対応モデル — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [API リファレンス](/ja/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-messages-reference)",
        "operationId": "createMessageQuickSeed",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "チャット生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足、チャージが必要",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセス権限なし",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "リソースが存在しません",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度制限超過",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "モデルサービスで一時的なエラーが発生しました。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "サービスが一時的に利用不可",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "モデルの選択\n\n| モデル ID | 用途 | コンテキスト長 |\n|---|---|---|\n| `doubao-seed-2-1-pro` | 複雑な推論、長文書、コードベースに適した推奨の最上位モデル | 100 万トークン |\n| `doubao-seed-2-1-turbo` | 対話、データ抽出、エージェント処理向けの低価格モデル | 25.6 万トークン |\n| `doubao-seed-2-1-lite` | Seed 2.1 で最も低価格。音声入力は Chat Completions と Responses のみ対応 | 100 万トークン |\n| `doubao-seed-evolving` | 新機能の評価向けに毎週更新 | 100 万トークン |\n| `doubao-seed-2.0-pro` | Seed 2.0 の最上位モデル | 25.6 万トークン |\n| `doubao-seed-2.0-lite` | 軽量で高速な Seed 2.0 モデル | 25.6 万トークン |\n| `doubao-seed-2.0-mini` | 簡単なタスク向けの Seed 2.0 最速モデル | 25.6 万トークン |\n| `doubao-seed-2.0-code` | コードに特化した Seed 2.0 モデル | 25.6 万トークン |\n\nSeed 2.1 のモデル ID はハイフン（`2-1`）、Seed 2.0 はピリオド（`2.0`）を使います。",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "example": 4096,
            "description": "思考と本文を合わせた最大出力トークン数。思考が有効な場合は 1024 以上を推奨します。予算を使い切ると `stop_reason` が `max_tokens` となり、思考だけが返る場合があります。"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "チャットメッセージリスト",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            },
            "example": [
              {
                "role": "user",
                "content": "こんにちは。自己紹介を 3 文でお願いします。"
              }
            ]
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "メッセージのロール"
          },
          "content": {
            "type": "string",
            "description": "メッセージ内容（プレーンテキスト）"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "レスポンスの一意の識別子",
            "example": "0217952345678901234567890abcdef"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "description": "常に `message`。"
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "常に `assistant`。"
          },
          "model": {
            "type": "string",
            "description": "このリクエストで使用したモデル。",
            "example": "doubao-seed-2-1-pro"
          },
          "content": {
            "type": "array",
            "description": "生成されたコンテンツブロック。思考が有効な場合、通常は `thinking` の後に `text` が続きます。本文は `type=\"text\"` のブロックから読み取ります。",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/ThinkingBlock"
                }
              ]
            },
            "example": [
              {
                "type": "thinking",
                "thinking": "短い自己紹介を求められている…",
                "signature": "EqQBCkgIARABGAIi..."
              },
              {
                "type": "text",
                "text": "こんにちは。Seed シリーズの言語モデルです。推論、文章作成、プログラミングが得意です。"
              }
            ]
          },
          "stop_reason": {
            "type": "string",
            "description": "生成の終了理由。\n\n- `end_turn`: 正常終了\n- `max_tokens`: トークン上限に到達\n- `stop_sequence`: 停止シーケンスに一致\n- `tool_use`: 関数呼び出しを要求",
            "enum": [
              "end_turn",
              "max_tokens",
              "stop_sequence",
              "tool_use"
            ],
            "example": "end_turn"
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ],
            "description": "一致した停止シーケンス。一致しなければ `null`。"
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "TextBlock": {
        "type": "object",
        "title": "テキスト",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ],
            "description": "常に `text`。"
          },
          "text": {
            "type": "string",
            "description": "テキスト内容"
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "title": "思考",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "thinking"
            ],
            "description": "常に `thinking`。"
          },
          "thinking": {
            "type": "string",
            "description": "モデルの思考内容。次のターンでは署名とともにそのまま返します。"
          },
          "signature": {
            "type": "string",
            "description": "思考の署名。次のターンでも署名、思考内容、ブロックの順序を保持します。"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "description": "トークン使用統計情報",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "キャッシュにヒットしなかった入力トークン数。`cache_read_input_tokens` は含みません。",
            "example": 25
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "キャッシュヒット料金が適用された入力トークン数。総入力 = `input_tokens` + `cache_read_input_tokens`。",
            "example": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "常に 0。このエンドポイントではキャッシュ書き込みに別料金はかかりません。",
            "example": 0
          },
          "output_tokens": {
            "type": "integer",
            "description": "思考を含む出力トークン数。",
            "example": 120
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTPステータスエラーコード"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              },
              "param": {
                "type": "string",
                "description": "関連パラメータ名"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "エラー時の提案"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##すべてのAPIにBearer Token認証が必要です##\n\n**APIキーの取得：**\n\n[APIキー管理ページ](https://evolink.ai/dashboard/keys)にアクセスしてAPIキーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "Anthropic Messages 互換 API"
    }
  ]
}
