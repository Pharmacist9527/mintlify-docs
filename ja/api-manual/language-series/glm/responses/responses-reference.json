          "call_id": {
            "type": "string",
            "description": "結果の返送に使用する関数呼び出し ID。"
          },
          "name": {
            "type": "string",
            "description": "関数名。"
          },
          "arguments": {
            "type": "string",
            "description": "関数引数の JSON 文字列。実行前に解析と検証を行ってください。"
          },
          "action": {
            "type": "object",
            "additionalProperties": true,
            "description": "web_search_call の検索またはページアクセスの操作。"
          }
        },
        "required": [
          "type"
        ]
      },
      "OutputText": {
        "type": "object",
