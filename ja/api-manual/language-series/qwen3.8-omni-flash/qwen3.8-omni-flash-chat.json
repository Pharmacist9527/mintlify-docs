{
  "openapi": "3.0.3",
  "info": {
    "title": "Qwen3.8 Omni Flash · Chat Completions",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "EvoLink API"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "EvoLink API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Qwen3.8 Omni Flash · Chat Completions",
        "description": "EvoLink 経由の Qwen3.8 Omni Flash で、推論強度を調整しながらテキストと画像を分析できます。導入前にリクエスト費用を比較し、Chat Completions または Responses を選択してください。\n\n再利用するプレフィックスが 1024 トークン以上の場合、暗黙的キャッシュが適用されることがあります。ヒットには別料金が適用され、作成料金はありません。ヒットは保証されません。\n\nウェブ検索には Responses の web_search ツールを使用してください。Chat の検索戦略は agent のみです。Chat の推論と検索の組み合わせは非ストリーミングで HTTP 400 となり、検証したストリームには完全な usage と終了マーカーがありませんでした。この組み合わせで完全な課金記録を得られるとは想定しないでください。検索はアカウント全体で 15 RPS を共有し、超過時は検索せずに応答する場合があります。",
        "operationId": "qwen38OmniFlashChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "基本的なテキスト対話",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "system",
                        "content": "You are a helpful assistant."
                      },
                      {
                        "role": "user",
                        "content": "Hello, please introduce yourself"
                      }
                    ]
                  }
                },
                "multimodal": {
                  "summary": "マルチモーダル入力（画像）",
                  "value": {
                    "model": "qwen3.8-omni-flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
                            "text": "Describe the content of this image"
                          },
                          {
                            "type": "image_url",
                            "image_url": {
                              "url": "https://dashscope.oss-cn-beijing.aliyuncs.com/images/dog_and_girl.jpeg"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "対話の生成に成功しました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータが不正です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_output_limit": {
                    "value": {
                      "error": {
                        "message": "Invalid request, please check your input. (request id: RID)",
                        "type": "evo_api_error",
                        "param": "",
                        "code": "invalid_request"
                      }
                    }
                  },
                  "invalid_reasoning_effort": {
                    "value": {
                      "error": {
                        "message": "'reasoning_effort' must be one of: 'none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max' (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_parameter_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れです",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_client_key": {
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Invalid API key (request id: RID)",
                        "param": null,
                        "type": "authentication_error"
                      }
                    }
                  },
                  "upstream_authentication": {
                    "value": {
                      "error": {
                        "message": "Service authentication error, please try again later. (request id: RID)",
                        "type": "invalid_request_error",
                        "param": "",
                        "code": "invalid_api_key"
                      }
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "残高不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "リクエストが頻繁すぎます（レート制限）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##すべての API で Bearer Token 認証が必要です##\n\n**API キーの取得：**\n\n[API キー管理ページ](https://evolink.ai/dashboard/keys)で API キーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "対話モデル名",
            "enum": [
              "qwen3.8-omni-flash"
            ],
            "example": "qwen3.8-omni-flash"
          },
          "messages": {
            "type": "array",
            "description": "対話メッセージのリスト、複数ターン対話に対応。ロール（system / user / assistant / tool）ごとにメッセージのフィールド構造が異なるため、対応するロールを選択して確認してください。",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ]
            },
            "minItems": 1
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "推論を含む出力トークン数の上限。",
            "minimum": 1,
            "maximum": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "応答をストリーミング方式で返すかどうか。\n\n- `true`：SSE（Server-Sent Events）でチャンクごとに返します\n- `false`（デフォルト）：完全な応答を一度に返します",
            "default": false
          },
          "stream_options": {
            "type": "object",
            "description": "ストリーミング応答オプション、`stream=true` の場合のみ有効です。",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "ストリーム末尾の使用量ブロックを要求します。検証した Chat 検索ストリームでは、完全な使用量と終了マーカーが返りませんでした。"
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "ツール定義のリスト、Function Calling に使用します。各ツールには名前、説明、パラメータ schema を定義する必要があります。",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "xhigh",
            "description": "Chat reasoning_effort は none、minimal、low、medium、high、xhigh、max に対応し、既定値は xhigh です。thinking_budget と併用しないでください。Responses は reasoning.effort を使用します。"
          },
          "preserve_thinking": {
            "type": "boolean",
            "default": true,
            "description": "コンテキストウィンドウは容量であり、入力を埋める目標ではありません。入力上限はプロトコルと推論モードで変わります。Chat の既定値は xhigh、preserve_thinking は既定で有効で、履歴に戻す推論内容は入力に計上されます。"
          }
        }
      },
      "SystemMessage": {
        "type": "object",
        "title": "System Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "メッセージのロール、固定で `system`"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "UserMessage": {
        "type": "object",
        "title": "User Message",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "メッセージのロール、固定で `user`"
          },
          "content": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          }
        }
      },
      "AssistantRequestMessage": {
        "type": "object",
        "title": "Assistant Message",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "メッセージのロール、固定で `assistant`"
          },
          "content": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "description": "前のターンでアシスタントが開始したツール呼び出しのリスト（Function Calling 履歴を埋め戻すために使用）。",
            "items": {
              "type": "object"
            }
          },
          "reasoning_content": {
            "type": "string",
            "description": "コンテキストウィンドウは容量であり、入力を埋める目標ではありません。入力上限はプロトコルと推論モードで変わります。Chat の既定値は xhigh、preserve_thinking は既定で有効で、履歴に戻す推論内容は入力に計上されます。"
          }
        }
      },
      "ToolMessage": {
        "type": "object",
        "title": "Tool Message",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "メッセージのロール、固定で `tool`（ツール実行結果）"
          },
          "content": {
            "description": "ツール実行結果の内容。文字列または content part 配列を指定できます。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "tool_call_id": {
            "type": "string",
            "description": "対応するツール呼び出し ID"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url"
            ]
          },
          "text": {
            "type": "string",
            "description": "`type=text` のときのテキスト内容"
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "画像 URL、または `data:` で始まる base64 data URL"
              }
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Function Calling ツール定義。",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "ツールタイプ、固定で `function`"
          },
          "function": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "関数名"
              },
              "description": {
                "type": "string",
                "description": "関数の用途の説明"
              },
              "parameters": {
                "type": "object",
                "description": "関数パラメータの JSON Schema"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "今回の対話の一意の識別子",
            "example": "chatcmpl-xxxxxxxx"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "作成時刻（Unix 秒）",
            "example": 1735120033
          },
          "model": {
            "type": "string",
            "example": "qwen3.8-omni-flash"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "停止理由\n\n- `stop`：正常終了\n- `length`：`max_completion_tokens` の上限に到達\n- `tool_calls`：ツール呼び出しが必要",
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "description": "アシスタントの応答メッセージ。",
        "properties": {
          "role": {
            "type": "string",
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "応答本文"
          },
          "reasoning_content": {
            "type": "string",
            "description": "応答で返される推論テキスト。"
          },
          "tool_calls": {
            "type": "array",
            "description": "モデルが開始したツール呼び出しのリスト",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer"
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      }
    }
  }
}
