  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## すべてのエンドポイントは Bearer Token 認証が必要です\n\n**API Key の取得：**\n\n[API Key 管理](https://evolink.ai/dashboard/keys)で取得してください。\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\nGemini ネイティブ形式の `x-goog-api-key: YOUR_API_KEY` ヘッダー、または URL パラメータ `?key=YOUR_API_KEY` も使用できます。"
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "コンテンツのパーツ。テキスト、インラインデータ（base64）、ファイル参照のいずれか",
        "properties": {
          "text": {
            "type": "string",
            "description": "テキスト"
          },
          "inlineData": {
            "type": "object",
            "description": "インラインのバイナリデータ（画像・音声・PDFなど）",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "base64 エンコードされたデータ"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "ファイル参照",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "公開アクセス可能な URL"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "ロール。システム指示では不要"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "ツール宣言。以下の3種類のみ対応し、他のツールは拒否されます",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "ウェブ検索。`{}` を指定"
          },
          "codeExecution": {
            "type": "object",
            "description": "コード実行。`{}` を指定"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "関数宣言（OpenAPI のサブセットによるパラメータ構造）",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "モデル。`models/gemini-3.8-flash` と `gemini-3.8-flash` の両形式に対応。対応モデル：`gemini-3.8-flash`、`gemini-3.7-flash`、`gemini-3.6-flash`、`gemini-3.5-flash`、`gemini-3.5-flash-lite`、`gemini-3-flash-preview`、`gemini-3.1-flash-lite-preview`、`gemini-3.1-pro-preview`、`gemini-3.1-pro-preview-customtools`、`gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "キャッシュする会話内容。配列で指定し、参照時の会話プレフィックスになります。`contents`、`systemInstruction`、`tools` のうち少なくとも1つが必要です",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "システム指示。キャッシュ後は、それを参照する生成リクエストに systemInstruction を指定できません"
          },
          "tools": {
            "type": "array",
            "description": "ツール宣言。キャッシュ後は、それを参照する生成リクエストに tools を指定できません",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "ツール呼び出し設定（functionCallingConfig など）。キャッシュ後は、それを参照する生成リクエストに toolConfig を指定できません"
          },
          "ttl": {
            "type": "string",
            "description": "有効期間（例：`\"3600s\"`）。最短 `60s`、最長 `604800s`（168時間）。expireTime と排他的で、両方指定すると400。両方省略時は `3600s`",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "絶対有効期限（RFC 3339、UTC）。ttl と排他的で、両方指定すると400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "管理用の名前。最大255文字で、料金には影響しません",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "ttl と expireTime のどちらか一方のみ必須。他のフィールドは400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "現在からの新しい有効期間（例：`\"7200s\"`）。最短 `60s`、最長 `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "新しい絶対有効期限（RFC 3339、UTC）",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "`cachedContents/<id>` 形式のキャッシュ名。生成リクエストの `cachedContent` に指定します。`<id>` は作成リクエストのIDでもあります",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
          },
          "model": {
            "type": "string",
            "description": "キャッシュに紐づくモデル。生成時も同じモデルを使用する必要があります",
            "example": "models/gemini-3.8-flash"
          },
          "displayName": {
            "type": "string",
            "description": "作成時に指定した名前。未指定の場合は返されません"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "作成日時（UTC）"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "最終更新日時（UTC）"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "有効期限（UTC）。期限切れ後に自動削除"
          },
          "usageMetadata": {
            "type": "object",
            "properties": {
              "totalTokenCount": {
                "type": "integer",
                "description": "キャッシュの総トークン数。書き込み料金と保存料金の計算に使用",
                "example": 7525
              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "次ページがある場合に返されます。そのまま次のリクエストの `pageToken` に指定します"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Gemini ネイティブのエラー形式。`error.details[0].reason` は理由コードです：`INVALID_ARGUMENT` パラメータエラー、`EXPLICIT_CACHE_UNSUPPORTED` モデルが明示的キャッシュに非対応、`NO_AVAILABLE_CHANNEL`・`MODEL_PRICE_ERROR` 現在のユーザーグループでは未提供、`CACHE_EXPIRED` キャッシュが期限切れ、または残り有効期間が短すぎる、`CACHE_MODEL_MISMATCH` モデルがキャッシュと一致しない、`INVALID_CACHED_CONTENT` `cachedContent` の形式が不正、`INSUFFICIENT_QUOTA` 残高不足、`CACHE_NOT_FOUND` キャッシュが存在しない・期限切れ・削除済み・他のアカウントのもの、`EXPLICIT_CACHE_DISABLED` 機能が未提供、`CACHE_CONTENT_TOO_LARGE` リクエストボディが 10 MB を超過、`UPSTREAM_ERROR` リクエストが受け付けられなかった（`message` を参照）、`CACHE_CHANNEL_UNAVAILABLE`・`INTERNAL` 一時的に利用不可、時間をおいて再試行してください。",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP ステータスコード"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "ステータス値（INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE など）"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
