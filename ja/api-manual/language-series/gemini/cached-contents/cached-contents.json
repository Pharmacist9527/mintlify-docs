                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "401": {
            "description": "API Key が無効または未指定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Key にモデル利用権限がないか、送信元IPが許可リスト外",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "キャッシュが存在しない、期限切れ、削除済み、他アカウントに所属、または明示的キャッシュ機能が未提供",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
