      "QuestionInstructions": {
        "description": "`input` に対して判定する質問。完全な文で書いてください。テキストのみで、文字列、テキストブロック、またはテキストブロックの配列を指定します",
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/components/schemas/TextContent"
          },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/TextContent"
            }
          }
        ]
      },
      "NoulQuestion": {
        "type": "object",
        "description": "はい／いいえの質問",
        "required": [
          "type",
          "instructions"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "noul"
            ]
          },
          "instructions": {
            "$ref": "#/components/schemas/QuestionInstructions"
          },
          "criteria": {
            "type": "object",
            "description": "省略可。質問だけでは意味があいまいな場合に、何を「はい」「いいえ」とするかを定義します",
            "properties": {
              "true_description": {
                "type": "string",
                "description": "「はい」となる条件"
              },
              "false_description": {
                "type": "string",
                "description": "「いいえ」となる条件"
              }
            }
          }
        }
      },
      "ChoiceQuestion": {
        "type": "object",
        "description": "単一選択の質問",
        "required": [
          "type",
          "instructions",
          "criteria"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "choice"
            ]
          },
          "instructions": {
            "$ref": "#/components/schemas/QuestionInstructions"
          },
          "criteria": {
            "type": "object",
            "description": "選択肢を「選択肢 ID → 該当する条件の説明」のマップで指定します（ID だけで意味が明らかな場合は空文字列 `\"\"` でかまいません）。選択肢は 2～255 個です。選択肢 ID は 1～128 文字（UTF-8 で最大 512 バイト）で、途中の ASCII スペースは使えますが、先頭・末尾のスペースや制御文字は使えません。評価前に選択肢 ID はアルファベット順（UTF-8 のバイト順）に並べ替えられ、確率が完全に同じ場合は先に来る ID が選ばれます。そのため、どれにも当てはまらない場合の受け皿には `none_of_the_above` ではなく `other` のような位置に依存しない ID を使ってください",
            "minProperties": 2,
            "maxProperties": 255,
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "billing": "Payments, invoices, and refunds.",
              "technical": "Problems using the product.",
              "shipping": "Delivery and tracking.",
              "other": "Anything outside these categories."
            }
          }
        }
      },
      "ScoreQuestion": {
        "type": "object",
        "description": "採点の質問",
        "required": [
          "type",
          "instructions",
          "criteria"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "score"
            ]
          },
          "instructions": {
            "$ref": "#/components/schemas/QuestionInstructions"
          },
          "criteria": {
            "type": "array",
            "description": "低い順に並べた各レベルの説明。空でない文字列を 2～255 個（多くの場合 2～10 個を推奨）指定します。レベル `i`（0 から開始）は `criteria[i]` で説明されます。`score` はレベル番号の平均なので、尺度は線形にし、隣り合うレベルを明確に区別してください",
            "minItems": 2,
            "maxItems": 255,
            "items": {
