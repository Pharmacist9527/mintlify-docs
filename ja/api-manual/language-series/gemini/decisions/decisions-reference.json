      "NoulAnswer": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "noul"
            ]
          },
          "noul": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99,
            "description": "答えが「はい」であるキャリブレーション済みの確率（0.01～0.99）。「いいえ」の確率は `1 - noul` です。自社のトラフィックからラベル付けしたサンプルを使い、この範囲内でしきい値を設定してください"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "最も可能性の高い答えが正しい推定確率で、`max(noul, 1 - noul)` に等しくなります"
