{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - Anthropic 互換 API",
    "description": "Anthropic Messages で Kimi K3.1 Pro / Highspeed を呼び出します。モデル ID は `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` です。1,048,576 tokens のコンテキスト、複数ターンの会話、ストリーミング、ツール呼び出し、Web 検索、構造化出力、コンテキストキャッシュに対応します。\n\n推論は常に有効です。`output_config.effort` は `low` / `high` / `max` に対応し、デフォルトは `max` です。複数ターンでは推論とツール呼び出しの履歴を完全に保持してください。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed Messages API",
        "description": "公開エンドポイントは POST /v1/messages。推論強度は output_config.effort、5m/1h の書き込みはトップレベルの cache_control で指定します。thinking、signature、tool_use、サーバー検索結果ブロックを完全に保持してください。",
        "operationId": "createMessageKimiK31Pro",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Highspeed の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "Anthropic SSE ストリーミング",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "トップレベルの 1h キャッシュ",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "cache_control": {
                      "type": "ephemeral",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "サーバー側の Web 検索",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "tools": [
                      {
                        "type": "web_search_20250305",
                        "name": "web_search",
                        "max_uses": 1
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "厳密な構造化出力",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low",
                      "format": {
                        "type": "json_schema",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message 応答。ストリーミングリクエストでは Anthropic SSE イベントストリームを返します",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "通常のイベント順序は message_start、content_block_*、message_delta、message_stop です。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "`kimi-k3.1-pro` または `kimi-k3.1-pro-highspeed` を指定します。Highspeed は生成が速いモデルです。"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "thinking と最終テキストを含む、この生成で使用できる最大 token 数。",
            "maximum": 1048576
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Anthropic Messages のメッセージ一覧。複数ターンの会話では、assistant の完全なコンテンツブロックを変更せずに返してください。",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "system": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessagesTextBlockParam"
                }
              }
            ],
            "description": "文字列または text ブロック配列のシステムプロンプト。"
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Anthropic SSE イベントストリームを返すかどうか。"
          },
          "tools": {
            "type": "array",
            "description": "カスタム関数またはサーバー側 Web 検索。内蔵検索は type=web_search_20250305、name=web_search を使用し、実際の呼び出し回数で課金されます。",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Tool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "description": "停止シーケンス。完全一致で生成を停止し、一致した文字列は出力しません。最大 5 個、各 32 バイト以内です。"
          },
          "cache_control": {
            "type": "object",
            "description": "書き込み TTL はトップレベルの cache_control のみで制御します。メッセージブロック内のキャッシュ指定では代用できません。省略時は 5m です。",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ephemeral"
                ],
                "description": "キャッシュ種別。ephemeral 固定。"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "キャッシュ有効期間。5m または 1h。デフォルトは 5m。"
              }
            },
            "required": [
              "type"
            ]
          },
          "output_config": {
            "type": "object",
            "description": "出力設定：推論強度と構造化出力。",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "推論強度。low / high / max を推奨し、デフォルトは max です。推論は常に有効です。クライアント互換用に medium は high、xhigh は max、minimal / none は low として扱います。none でも推論は無効になりません。強度を上げると通常は推論トークンと遅延が増えます。推論トークンは出力に含まれます。"
              },
              "format": {
                "type": "object",
                "description": "構造化出力。設定すると、指定した JSON Schema に厳密に従う JSON を返します。",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "schema": {
                    "type": "object",
                    "description": "出力が従う JSON Schema。",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "type",
                  "schema"
                ]
              }
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "メッセージのロール。user と assistant のみをサポートします。",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "description": "プレーンテキストまたは Anthropic コンテンツブロック配列としてのメッセージ内容。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlock"
                }
              }
            ]
          }
        }
      },
      "ContentBlock": {
        "description": "テキスト、画像、推論、ツール呼び出し、またはツール結果を表す Anthropic コンテンツブロック。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/ImageBlock"
          },
          {
            "$ref": "#/components/schemas/ThinkingBlock"
          },
          {
            "$ref": "#/components/schemas/ToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/ToolResultBlock"
          },
          {
            "$ref": "#/components/schemas/ServerToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/WebSearchResultBlock"
          }
        ]
      },
      "TextBlock": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "コンテンツブロックの種類。text 固定です。",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "description": "テキスト内容。"
          }
        }
      },
      "ImageBlock": {
        "type": "object",
        "required": [
          "type",
          "source"
        ],
        "description": "画像コンテンツブロック（マルチモーダル入力）。",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ],
            "description": "コンテンツブロックの種類。image 固定です。"
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "画像ソース。",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "base64",
                  "url"
                ],
                "description": "画像ソース。base64 はインラインデータ、url はファイル参照です。"
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/gif",
                  "image/webp"
                ],
                "description": "`type=base64` のときの画像 MIME タイプ。"
              },
              "data": {
                "type": "string",
                "description": "`type=base64` のときの画像 Base64 データ（`data:` プレフィックスを含まない）。"
              },
              "url": {
                "type": "string",
                "description": "画像のファイル参照。type=url の場合のみ使用します。"
              }
            }
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "コンテンツブロックの種類。thinking 固定です。",
            "enum": [
              "thinking"
            ]
          },
          "thinking": {
            "type": "string",
            "description": "モデルの推論内容。複数ターンの会話では signature と一緒に変更せず返してください。"
          },
          "signature": {
            "type": "string",
            "description": "複数ターンの会話では thinking ブロックと一緒に変更せず返してください。"
          }
        }
      },
      "ToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "コンテンツブロックの種類。tool_use 固定です。",
            "enum": [
              "tool_use"
            ]
          },
          "id": {
            "type": "string",
            "description": "結果を返すときに参照する tool_use ID。"
          },
          "name": {
            "type": "string",
            "description": "モデルが要求したツール名。"
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "モデルが生成したツール入力オブジェクト。"
          }
        }
      },
      "ToolResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "コンテンツブロックの種類。tool_result 固定です。",
            "enum": [
              "tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string",
            "description": "対応する tool_use コンテンツブロックの ID。"
          },
          "content": {
            "description": "文字列、またはテキスト・画像ブロック配列のツール実行結果。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TextBlock"
                    },
                    {
                      "$ref": "#/components/schemas/ImageBlock"
                    }
                  ]
                }
              }
            ]
          },
          "is_error": {
            "type": "boolean",
            "default": false,
            "description": "ツール実行が失敗したかどうか。"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "name",
          "input_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "ツール名。"
          },
          "description": {
            "type": "string",
            "description": "モデルがツールを使用するタイミングを判断するための説明。"
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON Schema 形式のツールパラメータ定義。"
          }
        }
      },
      "ToolChoice": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "ツール選択。auto はモデルに判断を任せ、any はツール呼び出しを必須にし、none は呼び出しを禁止します。",
            "enum": [
              "auto",
              "any",
              "none"
            ],
            "default": "auto"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ]
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use",
              "refusal",
              null
            ]
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "キャッシュ読み取りと書き込みを除いた通常入力トークン数。3 区分は重複しないため、キャッシュ分を再度差し引かないでください。"
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "キャッシュに書き込まれた入力 tokens。"
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "キャッシュから提供された入力 tokens。"
          },
          "output_tokens": {
            "type": "integer",
            "description": "thinking tokens を含む出力 tokens。"
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "thinking_tokens": {
                "type": "integer"
              }
            }
          },
          "cache_creation": {
            "type": "object",
            "properties": {
              "ephemeral_5m_input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "ephemeral_1h_input_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "cache_creation_input_tokens の 2 種類の書き込み内訳。実際の TTL に応じて別々に課金されます。"
          },
          "server_tool_use": {
            "type": "object",
            "properties": {
              "web_search_requests": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "今回の応答の検索使用量。"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_20250305"
            ]
          },
          "name": {
            "type": "string",
            "enum": [
              "web_search"
            ]
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "description": "今回の応答で許可される最大検索回数。"
          }
        }
      },
      "ServerToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "server_tool_use"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebSearchResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string"
          },
          "content": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              {
                "type": "object",
                "additionalProperties": true,
                "description": "検索エラーオブジェクト。type=web_search_tool_result_error。"
              }
            ]
          }
        }
      },
      "MessagesTextBlockParam": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "無効なリクエストパラメータ",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API キーがないか、無効です",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
