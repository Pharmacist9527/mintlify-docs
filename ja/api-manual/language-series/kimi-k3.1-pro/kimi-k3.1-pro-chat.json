{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - OpenAI 互換 API",
    "description": "OpenAI Chat Completions で Kimi K3.1 Pro / Highspeed を呼び出します。モデル ID は `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` です。1,048,576 tokens のコンテキスト、複数ターンの会話、ストリーミング、ツール呼び出し、Web 検索、構造化出力、コンテキストキャッシュに対応します。\n\n推論は常に有効です。`reasoning_effort` は `low` / `high` / `max` に対応し、デフォルトは `max` です。複数ターンでは推論とツール呼び出しの履歴を完全に保持してください。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed チャット API（OpenAI 互換）",
        "description": "OpenAI Chat Completions 形式で両モデルを呼び出し、JSON または SSE ストリーミングで応答を受け取れます。複数ターンでは assistant メッセージの reasoning_content と tool_calls を完全に保持してください。\n\nWeb 検索が tool_calls を返した場合、各呼び出しの function.arguments を対応する tool_call_id の tool メッセージの内容として再送し、最終回答をリクエストしてください。",
        "operationId": "createChatCompletionKimiK31Pro",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Highspeed の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "SSE ストリーミング",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "1h キャッシュへの自動書き込み",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Web 検索（統一形式）",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "厳密な JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "北京の今日の天気を調べてください。"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "指定された都市の天気を照会します",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "都市名"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat Completion 応答。ストリーミングリクエストでは SSE イベントストリームを返します",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "OpenAI Chat Completions 形式の SSE データ。`data: [DONE]` で終了します。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "`kimi-k3.1-pro` または `kimi-k3.1-pro-highspeed` を指定します。Highspeed は生成が速いモデルです。"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "会話メッセージ。複数ターンの会話では、過去の完全な assistant メッセージを含めてください。",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "推論と最終回答を含む最大生成トークン数。デフォルトは 131072、最大は 1048576 で、残りのコンテキストにも制限されます。"
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "推論強度。low / high / max を推奨し、デフォルトは max です。推論は常に有効です。クライアント互換用に medium は high、xhigh は max、minimal / none は low として扱います。none でも推論は無効になりません。強度を上げると通常は推論トークンと遅延が増えます。推論トークンは出力に含まれます。"
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "応答を SSE ストリームで返すかどうか。"
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "関数ツールまたは Web 検索。検索は {\"type\":\"web_search\"} で指定します。",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "モデルがツールを呼び出すか、特定の関数を強制するかを制御します。"
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "コンテキストキャッシュの書き込み設定。省略時は 5m キャッシュへ自動書き込みします。書き込みと読み取りは別々に課金されます。",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "キャッシュ有効期間。5m または 1h。デフォルトは 5m。"
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "出力形式。text はプレーンテキスト、json_object は JSON オブジェクト、json_schema は指定した JSON Schema に従う構造化出力です。",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "出力形式。text：デフォルトのプレーンテキスト。json_object：有効な JSON オブジェクト。json_schema：指定した Schema に従う出力（推奨。json_schema も指定）。"
              },
              "json_schema": {
                "type": "object",
                "description": "type が json_schema の場合に出力が従う JSON Schema。",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "識別用の Schema 名。"
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "指定した JSON Schema を厳密に適用するかどうか。デフォルトは true。"
                  },
                  "schema": {
                    "type": "object",
                    "description": "出力構造を定義する JSON Schema。",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "prompt_cache_key": {
            "type": "string",
            "description": "キャッシュ識別子。同一セッションでは同じ値を使用するとヒット率が向上します。"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "旧クライアント用の出力上限の別名。新規リクエストでは max_completion_tokens を使い、両方の同時指定は避けてください。"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "メッセージのロール：system、user、assistant、tool。",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "メッセージ内容。プレーンテキストの場合は文字列を渡します；マルチモーダル入力の場合は内容ブロック配列（テキスト + 画像 + 動画）を渡します。ツール呼び出しの場合、assistant の content は null にできます。",
            "oneOf": [
              {
                "type": "string",
                "description": "プレーンテキストのメッセージ内容。"
              },
              {
                "type": "array",
                "description": "マルチモーダル内容ブロックの配列。",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "assistant の推論内容。複数ターンの会話では、完全な assistant メッセージの一部として変更せず返してください。"
          },
          "tool_calls": {
            "type": "array",
            "description": "assistant が返したツール呼び出し。後続のツール利用ターンで変更せず返してください。",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "`role=tool` のときに対応するツール呼び出し ID。"
          }
        }
      },
      "ContentPart": {
        "description": "マルチモーダル内容ブロック。`type` でどのフィールドを使用するかが決まります。",
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text"
                ]
              },
              "text": {
                "type": "string",
                "description": "`type=text` のときのテキスト内容。"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "image_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "image_url"
                ]
              },
              "image_url": {
                "description": "`type=image_url` のときの画像；URL 文字列を直接渡すこともできます。",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Base64 Data URL 形式の画像内容（data:image/png;base64,...）。"
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "video_url"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "video_url"
                ]
              },
              "video_url": {
                "description": "`type=video_url` のときの動画；URL 文字列を直接渡すこともできます。",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Base64 Data URL 形式の動画内容（data:video/mp4;base64,...）。"
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "Web 検索ツール。"
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "ツールの種類。現在は function 固定です。",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが利用できる関数定義。",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "関数名。"
              },
              "description": {
                "type": "string",
                "description": "モデルが関数を呼び出すタイミングを判断するための説明。"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "JSON Schema 形式の関数パラメータ定義。"
              },
              "strict": {
                "type": "boolean",
                "description": "関数引数が parameters の JSON Schema に厳密に従う必要があるかどうか。"
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "名前付きツール選択の種類。function 固定です。",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが必ず呼び出す関数。",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "モデルが必ず呼び出す関数名。"
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "後続の tool メッセージを tool_call_id で関連付けるツール呼び出し ID。"
          },
          "type": {
            "type": "string",
            "description": "ツール呼び出しの種類。クライアント関数は `function`、組み込みの `$web_search` は `builtin_function`。",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが要求した関数と引数。",
            "properties": {
              "name": {
                "type": "string",
                "description": "関数名。"
              },
              "arguments": {
                "type": "string",
                "description": "JSON 文字列としてエンコードされた関数引数。"
              }
            }
          }
        },
        "description": "複数ターンでは ID、型、関数名、引数、推論内容を含むツール呼び出しを完全に保持してください。"
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "通常入力、キャッシュ読み取り、キャッシュ書き込みを含む総入力トークン数。通常入力 = prompt_tokens - cached_tokens - cache_write_tokens。"
          },
          "completion_tokens": {
            "type": "integer",
            "description": "推論 tokens を含みます。"
          },
          "total_tokens": {
            "type": "integer",
            "description": "入力と出力の合計 tokens。"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "キャッシュから提供された入力 tokens。"
              },
              "cache_write_tokens": {
                "type": "integer",
                "minimum": 0,
                "description": "5m / 1h への書き込みを含む今回のキャッシュ書き込み総トークン数。通常入力として重複課金しません。"
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "推論 tokens。completion_tokens に含まれています。"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "無効なリクエストパラメータ",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API キーがないか、無効です",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "レート制限超過またはクォータ不足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "内部サービスエラー",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
