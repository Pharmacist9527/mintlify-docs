{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - OpenAI 互換 API",
    "description": "kimi-k3.1-pro と kimi-k3.1-pro-highspeed に対応し、コンテキストウィンドウは 1,048,576 tokens です。両モデルとも常に推論を行います。ネイティブの強度は low / high / max、デフォルトは max です。\n\n複数ターンの履歴、SSE、関数ツール、Web 検索、厳密な JSON Schema、5m / 1h のコンテキストキャッシュに対応します。サンプリング設定は temperature=1、top_p=0.95、n=1、presence_penalty=frequency_penalty=0 に固定されており、指定は不要です。\n\n[モデル、料金、利用ガイド](/ja/api-manual/language-series/kimi-k3.1-pro/kimi-k3.1-pro-overview)。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Kimi K3.1 Pro / Highspeed チャット API（OpenAI 互換）",
        "description": "このエンドポイントでは 2 つの正確なモデル ID を使用できます。推論強度は low / high / max です。履歴の reasoning_content と tool_calls を完全に保持してください。検索結果は tool_calls で返されます。結果を履歴に戻して再度リクエストすると最終回答を得られます。",
        "operationId": "createChatCompletionKimiK31Pro",
        "tags": [
          "Chat Completions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Highspeed の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "usage を含む SSE ストリーミング",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                },
                "cache_1h": {
                  "summary": "1h キャッシュへの自動書き込み",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Web 検索（統一形式）",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "web_search_native": {
                  "summary": "Web 検索（Moonshot ネイティブ形式）",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "tools": [
                      {
                        "type": "builtin_function",
                        "function": {
                          "name": "$web_search"
                        }
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "厳密な JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ],
                    "reasoning_effort": "low",
                    "max_completion_tokens": 1024,
                    "response_format": {
                      "type": "json_schema",
                      "json_schema": {
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                },
                "function_calling": {
                  "summary": "Function Calling",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "messages": [
                      {
                        "role": "user",
                        "content": "北京の今日の天気を調べてください。"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "指定された都市の天気を照会します",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "city": {
                                "type": "string",
                                "description": "都市名"
                              }
                            },
                            "required": [
                              "city"
                            ]
                          }
                        }
                      }
                    ],
                    "tool_choice": "auto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat Completion 応答。ストリーミングリクエストでは SSE イベントストリームを返します",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "OpenAI Chat Completions 形式の SSE データ。`data: [DONE]` で終了します。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Pro と Highspeed はエンドポイントとパラメータを共有します。Highspeed は入力、出力、キャッシュ書き込みの単価が異なりますが、キャッシュ読み取りの単価は同じです。"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "会話メッセージ。複数ターンの会話では、過去の完全な assistant メッセージを含めてください。",
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "推論と最終回答を含む最大生成トークン数。デフォルトは 131072、最大は 1048576 で、残りのコンテキストにも制限されます。"
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "low",
              "high",
              "max",
              "medium",
              "xhigh",
              "minimal",
              "none"
            ],
            "default": "max",
            "description": "推論強度。low / high / max を推奨し、デフォルトは max です。推論は常に有効です。クライアント互換用に medium は high、xhigh は max、minimal / none は low として扱います。none でも推論は無効になりません。強度を上げると通常は推論トークンと遅延が増えます。推論トークンは出力に含まれます。"
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "応答を SSE ストリームで返すかどうか。"
          },
          "stream_options": {
            "$ref": "#/components/schemas/StreamOptions",
            "description": "ストリーミング応答オプション。`stream=true` の場合のみ有効で、token の価格や生成数は変わりません。"
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "description": "関数ツールまたは Web 検索。{\"type\":\"web_search\"} と Moonshot ネイティブの builtin_function / $web_search に対応します。実際の検索回数に応じて課金され、通常の関数に検索料金は発生しません。",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FunctionTool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                },
                {
                  "$ref": "#/components/schemas/BuiltinWebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "$ref": "#/components/schemas/NamedToolChoice"
              }
            ],
            "description": "モデルがツールを呼び出すか、特定の関数を強制するかを制御します。"
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "コンテキストキャッシュの書き込み設定。省略時は 5m キャッシュへ自動書き込みします。書き込みと読み取りは別々に課金されます。",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "キャッシュ書き込みの有効期間。1h と 5m はそれぞれの書き込み単価で課金されます。実際のヒットと TTL の分類は請求内容に従います。"
              }
            }
          },
          "response_format": {
            "type": "object",
            "description": "出力形式を制御します。デフォルトの {\"type\":\"text\"} はプレーンテキストです。{\"type\":\"json_object\"} は JSON モードで、有効な JSON オブジェクトを保証します。プロンプトでも JSON 出力と形式を指示してください。{\"type\":\"json_schema\"} は指定した JSON Schema に従う Structured Output を有効にします（推奨。json_schema も指定）。検証の問題は walle GitHub Issues (https://github.com/MoonshotAI/walle/issues) に報告できます。",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "json_object",
                  "json_schema"
                ],
                "description": "出力形式。text：デフォルトのプレーンテキスト。json_object：有効な JSON オブジェクト。json_schema：指定した Schema に従う出力（推奨。json_schema も指定）。"
              },
              "json_schema": {
                "type": "object",
                "description": "type が json_schema の場合に出力が従う JSON Schema。",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "識別用の Schema 名。"
                  },
                  "strict": {
                    "type": "boolean",
                    "default": true,
                    "description": "Schema を厳密に適用するかどうか。デフォルトは true。true の場合は MFJS 準拠が必要で、違反時はエラーまたは警告を返します。false の場合は有効な JSON オブジェクトのみを保証し、内部構造は強制しません。"
                  },
                  "schema": {
                    "type": "object",
                    "description": "出力構造を定義する JSON Schema。MFJS（Moonshot Flavored JSON Schema）に準拠する必要があります。walle CLI で検証できます：go install github.com/moonshotai/walle/cmd/walle@latest && walle -schema '<schema>' -level strict",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "name",
                  "schema"
                ]
              }
            }
          },
          "prompt_cache_key": {
            "type": "string",
            "default": null,
            "description": "類似リクエストのキャッシュヒット率を高めるためのキー。Coding Agent では通常セッション ID またはタスク ID を使用し、セッション再開時も同じ値を維持します。Kimi Code Plan ではヒット率向上のため必須です。ほかの複数ターン Agent にも推奨します。"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "deprecated": true,
            "description": "旧クライアント用の出力上限の別名。新規リクエストでは max_completion_tokens を使い、両方の同時指定は避けてください。"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "メッセージのロール：system、user、assistant、tool。",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "description": "メッセージ内容。プレーンテキストの場合は文字列を渡します；マルチモーダル入力の場合は内容ブロック配列（テキスト + 画像 + 動画）を渡します。ツール呼び出しの場合、assistant の content は null にできます。",
            "oneOf": [
              {
                "type": "string",
                "description": "プレーンテキストのメッセージ内容。"
              },
              {
                "type": "array",
                "description": "マルチモーダル内容ブロックの配列。",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "reasoning_content": {
            "type": "string",
            "description": "assistant の推論内容。複数ターンの会話では、完全な assistant メッセージの一部として変更せず返してください。"
          },
          "tool_calls": {
            "type": "array",
            "description": "assistant が返したツール呼び出し。後続のツール利用ターンで変更せず返してください。",
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          },
          "tool_call_id": {
            "type": "string",
            "description": "`role=tool` のときに対応するツール呼び出し ID。"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "required": [
          "type"
        ],
        "description": "マルチモーダル内容ブロック。`type` でどのフィールドを使用するかが決まります。",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "内容ブロックのタイプ。"
          },
          "text": {
            "type": "string",
            "description": "`type=text` のときのテキスト内容。"
          },
          "image_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "`type=image_url` のときの画像；URL 文字列を直接渡すこともできます。",
            "properties": {
              "url": {
                "type": "string",
                "description": "画像アドレス。Base64 Data URL（`data:image/png;base64,...`）または Kimi プラットフォームのファイル参照（`ms://<file_id>`）をサポートします。"
              }
            }
          },
          "video_url": {
            "type": "object",
            "required": [
              "url"
            ],
            "description": "`type=video_url` のときの動画；URL 文字列を直接渡すこともできます。",
            "properties": {
              "url": {
                "type": "string",
                "description": "動画アドレス。Base64 Data URL（`data:video/mp4;base64,...`）または Kimi プラットフォームのファイル参照（`ms://<file_id>`）をサポートします。"
              }
            }
          }
        }
      },
      "StreamOptions": {
        "type": "object",
        "properties": {
          "include_usage": {
            "type": "boolean",
            "default": false,
            "description": "true の場合、`[DONE]` の前に最終 usage チャンクを呼び出し元へ返します。このオプションはチャンクの表示だけを制御し、課金対象 token や価格を増やしません。"
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search"
            ],
            "description": "ウェブ検索ツール。ゲートウェイが Moonshot の `$web_search` に変換。呼び出しごとに課金"
          }
        }
      },
      "FunctionTool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "ツールの種類。現在は function 固定です。",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが利用できる関数定義。",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "関数名。"
              },
              "description": {
                "type": "string",
                "description": "モデルが関数を呼び出すタイミングを判断するための説明。"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": true,
                "description": "JSON Schema 形式の関数パラメータ定義。"
              },
              "strict": {
                "type": "boolean",
                "description": "関数引数が parameters の JSON Schema に厳密に従う必要があるかどうか。"
              }
            }
          }
        }
      },
      "NamedToolChoice": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "名前付きツール選択の種類。function 固定です。",
            "enum": [
              "function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが必ず呼び出す関数。",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "モデルが必ず呼び出す関数名。"
              }
            }
          }
        }
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "id",
          "type",
          "function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "後続の tool メッセージを tool_call_id で関連付けるツール呼び出し ID。"
          },
          "type": {
            "type": "string",
            "description": "ツール呼び出しの種類。クライアント関数は `function`、組み込みの `$web_search` は `builtin_function`。",
            "enum": [
              "function",
              "builtin_function"
            ]
          },
          "function": {
            "type": "object",
            "description": "モデルが要求した関数と引数。",
            "properties": {
              "name": {
                "type": "string",
                "description": "関数名。"
              },
              "arguments": {
                "type": "string",
                "description": "JSON 文字列としてエンコードされた関数引数。"
              }
            }
          }
        },
        "description": "ツール呼び出し履歴を完全に保持します。内蔵検索の応答は type=builtin_function の場合があり、履歴として再送してもサーバーが対応します。ID、arguments、推論内容をすべて保持してください。"
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "message": {
                  "$ref": "#/components/schemas/ChatMessage"
                },
                "finish_reason": {
                  "type": "string",
                  "enum": [
                    "stop",
                    "length",
                    "tool_calls"
                  ]
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        }
      },
      "ChatUsage": {
        "type": "object",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "通常入力、キャッシュ読み取り、キャッシュ書き込みを含む総入力トークン数。通常入力 = prompt_tokens - cached_tokens - cache_write_tokens。"
          },
          "completion_tokens": {
            "type": "integer",
            "description": "推論 tokens を含みます。"
          },
          "total_tokens": {
            "type": "integer",
            "description": "入力と出力の合計 tokens。"
          },
          "prompt_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
