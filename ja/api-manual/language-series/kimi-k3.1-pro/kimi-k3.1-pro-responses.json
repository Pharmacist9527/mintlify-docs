{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - Responses API",
    "version": "1.0.0",
    "description": "OpenAI Responses で Kimi K3.1 Pro / Highspeed を呼び出します。モデル ID は `kimi-k3.1-pro` / `kimi-k3.1-pro-highspeed` です。1,048,576 tokens のコンテキスト、複数ターンの会話、ストリーミング、ツール呼び出し、Web 検索、構造化出力、コンテキストキャッシュに対応します。\n\n推論は常に有効です。`reasoning.effort` は `low` / `high` / `max` に対応し、デフォルトは `max` です。複数ターンでは推論とツール呼び出しの履歴を完全に保持してください。"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "本番環境（推奨）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "代替 URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "tags": [
          "Responses"
        ],
        "summary": "Kimi K3.1 Pro / Highspeed Responses API",
        "description": "reasoning.effort で推論強度、prompt_cache_options でキャッシュを指定します。検索は web_search_call 出力項目で返されます。ストリーミングでは response.completed / response.incomplete / response.failed を処理してください。出力上限に達すると incomplete になります。複数ターンでは推論、ツール呼び出し、結果を含む完全な output 履歴を渡してください。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "highspeed": {
                  "summary": "Highspeed の最小リクエスト",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "streaming": {
                  "summary": "Responses SSE ストリーミング",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "1h キャッシュへの自動書き込み",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Reply with OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "prompt_cache_options": {
                      "mode": "implicit",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "サーバー側の Web 検索",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Use web search to find the official Kimi homepage URL.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "tools": [
                      {
                        "type": "web_search"
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "厳密な JSON Schema",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "Return a JSON object with result equal to OK.",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024,
                    "text": {
                      "format": {
                        "type": "json_schema",
                        "name": "result",
                        "strict": true,
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "応答を正常に作成しました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesStreamEvent"
                }
              }
            }
          },
          "400": {
            "description": "リクエストエラー：無効なパラメータ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "認証エラー：API キーが無効または未指定",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このリソースへのアクセス権限がありません",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "レート制限超過またはクォータ不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "サーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "operationId": "createResponseKimiK31Pro"
      }
    }
  },
  "components": {
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "`kimi-k3.1-pro` または `kimi-k3.1-pro-highspeed` を指定します。Highspeed は生成が速いモデルです。"
          },
          "input": {
            "description": "今回のリクエストの入力。文字列は 1 つの user メッセージに相当します。配列では型付き項目を順に並べ、会話履歴、ツール呼び出し、ツール結果を含められます。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ResponsesInputItem"
                }
              }
            ]
          },
          "instructions": {
            "type": "string",
            "description": "ほかの指示より前に適用されるトップレベルのシステム指示。"
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "true の場合、SSE イベントストリームで応答を返します。"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "推論と最終回答を含む最大生成トークン数。デフォルトは 131072、最大は 1048576 で、残りのコンテキストにも制限されます。",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072
          },
          "reasoning": {
            "type": "object",
            "description": "推論に関する設定。",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "推論強度。low / high / max を推奨し、デフォルトは max です。推論は常に有効です。クライアント互換用に medium は high、xhigh は max、minimal / none は low として扱います。none でも推論は無効になりません。強度を上げると通常は推論トークンと遅延が増えます。推論トークンは出力に含まれます。"
              }
            }
          },
          "text": {
            "type": "object",
            "description": "出力テキストの設定。",
            "properties": {
              "format": {
                "type": "object",
                "required": [
                  "type",
                  "schema"
                ],
                "description": "JSON Schema で出力構造を制約します。",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Schema 名。デフォルトは `output`。"
                  },
                  "schema": {
                    "type": "object",
                    "description": "出力構造を定義する JSON Schema。"
                  },
                  "strict": {
                    "type": "boolean",
                    "description": "Schema を厳密に適用するかどうか。"
                  }
                }
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "モデルが呼び出せるツール。",
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ResponsesToolChoice"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "web_search_call.results",
                "web_search_call.action.sources"
              ]
            },
            "description": "追加で返すフィールド。`web_search` 使用時のみ有効です。`web_search_call.action.sources` は検索元の Web ページ、`web_search_call.results` は画像検索結果を返します。"
          },
          "prompt_cache_key": {
            "type": "string",
            "description": "コンテキストキャッシュの識別子。同一セッションでは同じ値を使用するとヒット率が向上します。"
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "コンテキストキャッシュの書き込み設定。省略時は 5m キャッシュへ自動書き込みします。書き込みと読み取りは別々に課金されます。",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "default": "implicit"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "キャッシュ有効期間。5m または 1h。デフォルトは 5m。"
              }
            }
          },
          "safety_identifier": {
            "type": "string",
            "description": "利用ポリシー違反の可能性を検出するための、ユーザーごとに一意で安定した識別子。個人を特定できる情報を送らないよう、ユーザー名やメールアドレスをハッシュ化してください。"
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "モデルの 1 回の応答。",
        "properties": {
          "id": {
            "type": "string",
            "description": "応答の一意な識別子。",
            "example": "resp_68f0c1c2d3e4f5a6b7c8d9e0"
          },
          "object": {
            "type": "string",
            "enum": [
              "response"
            ]
          },
          "created_at": {
            "type": "integer",
            "description": "応答作成時の Unix タイムスタンプ。"
          },
          "completed_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "応答終了時の Unix タイムスタンプ。`status` が `completed` または `incomplete` で設定され、`in_progress` または `failed` では `null` です。"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress",
              "completed",
              "incomplete",
              "failed"
            ],
            "description": "応答の状態。ストリーミングの初期スナップショットは `in_progress` です。"
          },
          "model": {
            "type": "string",
            "description": "今回の応答を生成したモデル。"
          },
          "output": {
            "type": "array",
            "description": "出力項目の配列。web_search_call（存在する場合）、reasoning、message、ツール呼び出しの順に並びます。",
            "items": {
              "$ref": "#/components/schemas/ResponsesOutputItem"
            }
          },
          "usage": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesUsage"
              },
              {
                "type": "null"
              }
            ]
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "`status` が `incomplete` の場合の理由。",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "max_output_tokens",
                  "content_filter"
                ]
              }
            }
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "`status` が `failed` の場合のエラー情報。",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning": {
            "type": [
              "object",
              "null"
            ]
          },
          "text": {
            "type": [
              "object",
              "null"
            ]
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ResponsesToolChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "max_output_tokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ]
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ]
          },
          "parallel_tool_calls": {
            "type": "boolean"
          },
          "service_tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "store": {
            "type": "boolean",
            "description": "`false` 固定。"
          },
          "background": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`false` 固定。"
          },
          "previous_response_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` 固定。"
          },
          "conversation": {
            "type": [
              "object",
              "null"
            ],
            "description": "`null` 固定。"
          },
          "prompt_cache_options": {
            "type": "object",
            "description": "サーバーが実際に適用したコンテキストキャッシュの書き込み設定。prompt_cache_options を省略した場合は、ここで返される mode と ttl に従ってください。",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "implicit"
                ],
                "description": "実際に適用された書き込みモード。"
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "description": "実際に適用されたキャッシュ有効期間。"
              }
            }
          }
        }
      },
      "ResponsesStreamEvent": {
        "type": "object",
        "description": "`stream: true` のときの単一 SSE イベント。フレームは `event: <type>` と `data: <json>` で構成され、ほかのフィールドは `type` によって変わります。",
        "required": [
          "type",
          "sequence_number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "response.created",
              "response.in_progress",
              "response.output_item.added",
              "response.output_item.done",
              "response.content_part.added",
              "response.content_part.done",
              "response.output_text.delta",
              "response.output_text.done",
              "response.reasoning_summary_part.added",
              "response.reasoning_summary_part.done",
              "response.reasoning_summary_text.delta",
              "response.reasoning_summary_text.done",
              "response.function_call_arguments.delta",
              "response.function_call_arguments.done",
              "response.custom_tool_call_input.delta",
              "response.custom_tool_call_input.done",
              "response.web_search_call.in_progress",
              "response.web_search_call.searching",
              "response.web_search_call.completed",
              "response.completed",
              "response.incomplete",
              "response.failed",
              "error"
            ]
          },
          "sequence_number": {
            "type": "integer",
            "description": "0 から単調増加するイベント連番。"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "エラー原因を説明するメッセージ。"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              },
              "code": {
                "type": "string",
                "description": "エラーコード"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ResponsesInputItem": {
        "description": "input 配列の要素。`type` で区別し、省略時は `message` として扱います。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesFunctionCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomToolCallOutputItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesAdditionalToolsItem"
          }
        ]
      },
      "ResponsesTool": {
        "description": "`type` で区別するツール定義。`function`、`custom`（`apply_patch` のみ）、`namespace`、`web_search` に対応します。ほかの種類は非対応です。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesFunctionTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesCustomTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesNamespaceTool"
          },
          {
            "$ref": "#/components/schemas/ResponsesWebSearchTool"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "function": "#/components/schemas/ResponsesFunctionTool",
            "custom": "#/components/schemas/ResponsesCustomTool",
            "namespace": "#/components/schemas/ResponsesNamespaceTool",
            "web_search": "#/components/schemas/ResponsesWebSearchTool"
          }
        }
      },
      "ResponsesToolChoice": {
        "type": "string",
        "enum": [
          "auto"
        ],
        "description": "ツール呼び出しを制御します。`auto` ではモデルが呼び出しの要否を判断します。"
      },
      "ResponsesOutputItem": {
        "description": "`type` で区別する output 配列の要素。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ResponsesOutputReasoningItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputMessageItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputFunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputCustomToolCallItem"
          },
          {
            "$ref": "#/components/schemas/ResponsesOutputWebSearchCallItem"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "reasoning": "#/components/schemas/ResponsesOutputReasoningItem",
            "message": "#/components/schemas/ResponsesOutputMessageItem",
            "function_call": "#/components/schemas/ResponsesOutputFunctionCallItem",
            "custom_tool_call": "#/components/schemas/ResponsesOutputCustomToolCallItem",
            "web_search_call": "#/components/schemas/ResponsesOutputWebSearchCallItem"
          }
        }
      },
      "ResponsesUsage": {
        "type": "object",
        "description": "input_tokens はキャッシュ読み取りと書き込みを含みます。通常入力は cached_tokens と cache_write_tokens を差し引いて求めます。output_tokens は推論を含みます。",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "キャッシュヒット分を含む入力トークン数。"
          },
          "input_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "コンテキストキャッシュから読み取ったトークン数。"
              },
              "cache_write_tokens": {
                "type": "integer",
                "description": "コンテキストキャッシュに書き込んだトークン数。"
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "推論トークンを含む出力トークン数。"
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "推論に使用したトークン数。"
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "総トークン数。"
          }
        }
      },
      "ResponsesMessageItem": {
        "type": "object",
        "title": "メッセージ",
        "description": "会話メッセージ。`type` は省略可能です。",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
