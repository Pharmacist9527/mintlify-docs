{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniHuman 2.0 デジタルヒューマン動画生成API",
    "description": "OmniHuman 2.0モデルを使用して音声駆動のデジタルヒューマン動画生成タスクを作成",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "本番環境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "OmniHuman 2.0 デジタルヒューマン動画生成",
        "description": "- OmniHuman 2.0（omnihuman-2.0）モデルは、人物画像と音声から、口の動きと体の動きが音声に連動するデジタルヒューマン動画を生成します\n- 非同期処理モード、返されたタスクIDを使用して[照会](/ja/api-manual/task-management/get-task-detail)してください\n- 生成された動画リンクは24時間有効です。速やかに保存してください\n\n**注意:**\n- 音声の長さ制限: 4–300秒\n- サポートされる音声フォーマット: MP3、WAV\n- 課金は音声の長さに基づきます（`0.1`秒単位で切り上げ）",
        "operationId": "createOmniHuman20VideoGeneration",
        "tags": [
          "デジタルヒューマン動画生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic_generation": {
                  "summary": "基本デジタルヒューマン生成",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ]
                  }
                },
                "with_prompt": {
                  "summary": "プロンプト付き",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ],
                    "prompt": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "デジタルヒューマン動画生成タスクが正常に作成されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータが不正です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "サポートされていないパラメータ",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "mask_url is not supported by omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_many_images": {
                    "summary": "画像が 1 枚を超える",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "omnihuman-2.0 accepts exactly 1 image, got 2",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_audio_url": {
                    "summary": "音声URLがない",
                    "value": {
                      "error": {
                        "code": "missing_audio_url",
                        "message": "audio_url is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_image_urls": {
                    "summary": "画像URLがない",
                    "value": {
                      "error": {
                        "code": "missing_image_urls",
                        "message": "image_urls is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio": {
                    "summary": "音声をダウンロードまたは解析できない",
                    "value": {
                      "error": {
                        "code": "invalid_audio",
                        "message": "failed to read audio_url: download audio failed: HTTP 404",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio_duration": {
                    "summary": "音声の長さが範囲外",
                    "value": {
                      "error": {
                        "code": "invalid_audio_duration",
                        "message": "audio duration 2.50s is out of range [4, 300] for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_media_url": {
                    "summary": "メディアURLがローカルまたはプライベートネットワークのアドレスを指している",
                    "value": {
                      "error": {
                        "code": "invalid_media_url",
                        "message": "invalid parameter \"audio_url\": points to a local or private network address; provide a publicly accessible URL",
                        "type": "invalid_request_error",
                        "param": "audio_url"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れです",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足のため、チャージが必要です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセスが拒否されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: omnihuman-2.0",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "レート制限を超えました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "audio_url",
          "image_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "デジタルヒューマン動画生成モデル名\n\n**注意:**\n- 本モデルは OmniHuman-1.5 の `mask_url`、`subject_check`、`auto_mask`、`pe_fast_mode`、`audio_urls` パラメータをサポートしていません。有効にするか空でない値を渡すと 400 パラメータエラーが返されます\n- すべてのパラメータはリクエストボディの最上位に指定してください。空でない `model_params` を渡すと 400 パラメータエラーが返されます",
            "enum": [
              "omnihuman-2.0"
            ],
            "default": "omnihuman-2.0",
            "example": "omnihuman-2.0"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "description": "リップシンクとボディモーションを駆動するための音声URL\n\n**注意:**\n- 音声の長さ: `4`–`300`秒（両端を含む）。範囲外の場合は 400 パラメータエラーが返されます\n- サポートされるフォーマット: `.mp3`、`.wav`\n- ファイルサイズ: `15MB`未満\n- 音声URLはサーバーから直接アクセス可能である必要があります。ダウンロードできない、フォーマットが非対応、またはサイズ上限を超える場合は 400 パラメータエラーが返されます\n- 課金は音声の長さに基づきます（`0.1`秒単位で切り上げ）",
            "example": "https://your-cdn.com/omnihuman/speech.mp3"
          },
          "image_urls": {
            "type": "array",
            "description": "アニメーション対象の人物を含む参照画像URLリスト\n\n**注意:**\n- リクエストあたりの画像数: `1`。`1`枚を超えると 400 パラメータエラーが返されます\n- サポートされるファイルフォーマット: `.jpg`、`.jpeg`、`.png`、`.webp`、`.bmp`、`.tiff`、`.gif`、`.heic`、`.heif`\n- 画像サイズ: `30MB`未満\n- アスペクト比（幅/高さ）: `0.4`–`2.5`\n- 幅と高さ: `300`–`6000` px\n- 画像URLはサーバーから直接アクセス可能である必要があります",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://your-cdn.com/omnihuman/portrait.jpg"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "シーン、動作、カメラワークを制御するオプションのテキストプロンプト、中国語、英語、日本語、韓国語、スペイン語（メキシコ）、インドネシア語のみサポート",
            "example": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
          },
          "callback_url": {
            "type": "string",
            "description": "タスク完了後の HTTPS コールバックアドレス\n\n**コールバックタイミング：**\n- タスクが完了または失敗した時にトリガーされます（OmniHuman 2.0 はキャンセル非対応）\n- 課金確認完了後に送信されます\n\n**セキュリティ制限：**\n- HTTPS プロトコルのみサポート\n- 内部 IP アドレスへのコールバックは禁止（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x など）\n- URL の長さは `2048` 文字以内\n\n**コールバックメカニズム：**\n- タイムアウト：`10` 秒\n- 失敗時最大 `3` 回リトライ（`1` 秒/`2` 秒/`4` 秒後にリトライ）\n- コールバックレスポンスボディの形式はタスククエリ API のレスポンス形式と一致\n- コールバックアドレスが 2xx ステータスコードを返した場合は成功とみなされ、その他のステータスコードはリトライをトリガーします",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "タスク作成タイムスタンプ",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "タスク ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "使用された実際のモデル名",
            "example": "omnihuman-2.0"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "具体的なタスクタイプ"
          },
          "progress": {
            "type": "integer",
            "description": "タスク進捗率（0-100）",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "タスクステータス",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "動画タスクの詳細情報"
          },
          "type": {
            "type": "string",
            "enum": [
              "video"
            ],
            "description": "タスク出力タイプ",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量と課金情報"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "タスクをキャンセルできるかどうか。OmniHuman 2.0 はキャンセル非対応で、常に `false` です。",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "推定完了時間（秒）",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "推定動画時間（秒）",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量と課金情報",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "課金ルール（OmniHuman では per_second）",
            "enum": [
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "推定消費クレジット（音声の長さに基づく）",
            "minimum": 0,
            "example": 59.024
          },
          "user_group": {
            "type": "string",
            "description": "ユーザーグループカテゴリ",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "エラーコード識別子"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              },
              "param": {
                "type": "string",
                "description": "関連パラメータ名"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##すべてのAPIにBearer Token認証が必要です##\n\n**APIキーの取得：**\n\n[APIキー管理ページ](https://evolink.ai/dashboard/keys)にアクセスしてAPIキーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "デジタルヒューマン動画生成",
      "description": "OmniHuman 2.0 デジタルヒューマン動画生成 API"
    }
  ]
}
