{
  "openapi": "3.1.0",
  "info": {
    "title": "kling-v4-image-to-video API",
    "description": "AIモデルを使用した画像から動画タスクの作成",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "本番環境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "kling-v4-image-to-video API",
        "description": "- Kling-4.0 Image to Video（kling-v4-image-to-video）は画像から動画を生成します\n- 最初と最後のフレーム、およびその間の中間フレームに対応しています\n- アスペクト比は最初のフレーム画像によって決まり、**`aspect_ratio` は受け付けません**\n- 非同期処理モード、返されたタスクIDを使用して[ステータスを照会](/ja/api-manual/task-management/get-task-detail)してください\n- 生成された動画リンクは24時間有効です。速やかに保存してください",
        "operationId": "createVideoGeneration",
        "tags": [
          "動画生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic": {
                  "summary": "最初のフレーム画像から動画",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "The person in the image slowly turns their head and smiles",
                    "image_start": "https://example.com/portrait.jpg",
                    "duration": 5,
                    "quality": "720p"
                  }
                },
                "first_last_frame": {
                  "summary": "最初のフレーム + 最後のフレーム",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "Transition from daytime to nighttime",
                    "image_start": "https://example.com/day.jpg",
                    "image_end": "https://example.com/night.jpg",
                    "duration": 10,
                    "quality": "1080p"
                  }
                },
                "with_keyframes": {
                  "summary": "最初のフレーム + 中間フレーム + 最後のフレーム",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "花のつぼみがゆっくりと開き、その後カメラが引いていく",
                    "image_start": "https://example.com/bud.jpg",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/half-open.jpg"
                      },
                      {
                        "image_url": "https://example.com/open.jpg"
                      }
                    ],
                    "image_end": "https://example.com/wide.jpg",
                    "duration": 5,
                    "quality": "720p"
                  }
                },
                "keyframes_without_end": {
                  "summary": "最初のフレーム + 中間フレーム（最後のフレームなし）",
                  "value": {
                    "model": "kling-v4-image-to-video",
                    "prompt": "早朝の通りから夕暮れの広場へとカメラが進み、光が徐々に暖かくなる",
                    "image_start": "https://example.com/morning.jpg",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/noon.jpg"
                      },
                      {
                        "image_url": "https://example.com/afternoon.jpg"
                      }
                    ],
                    "duration": 8,
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "動画生成タスクが正常に作成されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータが無効です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足、チャージが必要です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセスが拒否されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: kling-v4-image-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度制限を超過しました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "image_start",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "動画生成モデル名",
            "enum": [
              "kling-v4-image-to-video"
            ],
            "default": "kling-v4-image-to-video",
            "example": "kling-v4-image-to-video"
          },
          "image_start": {
            "type": "string",
            "format": "uri",
            "description": "画像から動画生成用の最初のフレーム画像URL（**必須**）\n\n**注意:**\n- 画像サイズ: 最大`10MB`\n- サポートされるフォーマット: `.jpg`、`.jpeg`、`.png`\n- 画像寸法: 幅と高さ >= `300px`、アスペクト比は`1:2.5`から`2.5:1`の間\n- 画像URLはサーバーから直接アクセスできる必要があります。アクセス時に直接ダウンロードされるURLでも構いません",
            "example": "https://example.com/portrait.jpg"
          },
          "image_end": {
            "type": "string",
            "format": "uri",
            "description": "最後のフレーム画像URL\n\n**注意:**\n- 最後のフレームを使用する場合、`image_start`（最初のフレーム）を同時に指定する必要があります\n- サポートされるフォーマット: `.jpg`、`.jpeg`、`.png`\n- 画像サイズ: 最大`10MB`\n- 画像URLはサーバーから直接アクセスできる必要があります。アクセス時に直接ダウンロードされるURLでも構いません",
            "example": "https://example.com/night.jpg"
          },
          "keyframes": {
            "type": "array",
            "description": "中間フレーム画像のリスト。最初と最後のフレームの間に、指定順で均等に配置されます\n\n**注意：**\n- 枚数：`1`～`8`枚\n- 最初・中間・最後のフレームの合計は、`10`枚以下かつ`duration` + 1以下です（例：`3`秒では最大`4`枚、`5`秒では最大`6`枚）\n- 最後のフレームは省略できます。省略した場合、終了画面はモデルが生成します\n- 画像サイズ: 最大`10MB`\n- サポートされるフォーマット: `.jpg`、`.jpeg`、`.png`\n- 画像寸法: 幅と高さ >= `300px`、アスペクト比は`1:2.5`から`2.5:1`の間\n- 画像URLはサーバーから直接アクセスできる必要があります。アクセス時に直接ダウンロードされるURLでも構いません",
            "items": {
              "type": "object",
              "properties": {
                "image_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "中間フレーム画像のURL"
                }
              },
              "required": [
                "image_url"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 8,
            "example": [
              {
                "image_url": "https://example.com/half-open.jpg"
              },
              {
                "image_url": "https://example.com/open.jpg"
              }
            ]
          },
          "prompt": {
            "type": "string",
            "description": "生成したい動画を記述するテキストプロンプト\n\n**注意：**\n- 最大`2500`文字",
            "example": "The person in the image slowly turns their head and smiles",
            "maxLength": 2500
          },
          "duration": {
            "type": "integer",
            "description": "動画の長さ（秒）。デフォルトは`5`秒\n\n**範囲：**\n- `3`～`30`の整数",
            "minimum": 3,
            "maximum": 30,
            "default": 5,
            "example": 5
          },
          "quality": {
            "type": "string",
            "description": "解像度レベル\n\n**オプション:**\n- `720p`: 標準 720P\n- `1080p`: 高画質 1080P",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "example": "720p"
          },
          "callback_url": {
            "type": "string",
            "description": "タスク完了時のHTTPSコールバックURL\n\n**コールバックタイミング:**\n- タスクが完了、失敗、またはキャンセルされた時にトリガー\n- 課金確認後に送信\n\n**セキュリティ制限:**\n- HTTPSプロトコルのみ\n- 内部IPアドレスは禁止（127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x など）\n- URLの長さは`2048`文字以下\n\n**コールバックメカニズム:**\n- タイムアウト: `10`秒\n- 失敗後最大`3`回リトライ（失敗後`1`/`2`/`4`秒）\n- コールバックレスポンス形式はタスク照会APIと一致\n- 2xxステータスコードは成功とみなされ、その他のコードはリトライをトリガー",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "タスク作成タイムスタンプ",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "タスクID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "使用された実際のモデル名",
            "example": "kling-v4-image-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "タスクタイプ"
          },
          "progress": {
            "type": "integer",
            "description": "タスク進捗率（0-100）",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "タスクステータス",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "動画タスクの詳細"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "タスク出力タイプ",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量と課金情報"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "タスクをキャンセルできるかどうか",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "推定完了時間（秒）",
            "minimum": 0,
            "example": 300
          },
          "video_duration": {
            "type": "integer",
            "description": "動画の長さ（秒）",
            "example": 5
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量と課金情報",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "課金ルール",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "推定消費クレジット",
            "minimum": 0,
            "example": 53.38
          },
          "user_group": {
            "type": "string",
            "description": "ユーザーグループカテゴリ",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "エラーコード識別子"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## すべてのAPIにBearer Token認証が必要です ##\n\n**APIキーの取得：**\n\n[APIキー管理ページ](https://evolink.ai/dashboard/keys)にアクセスしてAPIキーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "動画生成",
      "description": "AI動画生成API"
    }
  ]
}
