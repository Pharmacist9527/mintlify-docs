{
  "openapi": "3.1.0",
  "info": {
    "title": "kling-v4-keyframes-to-video API",
    "description": "AIモデルを使用してキーフレームからの動画生成タスクを作成",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "本番環境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "kling-v4-keyframes-to-video API",
        "description": "- Kling-4.0 Keyframes to Video（kling-v4-keyframes-to-video）はキーフレームから動画を生成します\n- `2`～`10`枚のキーフレーム画像を時系列順に指定すると、各画像を順番に経由する動画を生成します\n- 非同期処理モード、返されたタスクIDを使用して[ステータスを照会](/ja/api-manual/task-management/get-task-detail)してください\n- 生成された動画リンクは24時間有効です。速やかに保存してください",
        "operationId": "createVideoGeneration",
        "tags": [
          "動画生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic": {
                  "summary": "キーフレームを均等に配置",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "早朝の通りから夕暮れの広場へとカメラが進み、光が徐々に暖かくなる",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/morning.jpg"
                      },
                      {
                        "image_url": "https://example.com/noon.jpg"
                      },
                      {
                        "image_url": "https://example.com/evening.jpg"
                      }
                    ],
                    "duration": 6,
                    "aspect_ratio": "16:9",
                    "quality": "720p"
                  }
                },
                "with_time": {
                  "summary": "キーフレームの時刻を指定",
                  "value": {
                    "model": "kling-v4-keyframes-to-video",
                    "prompt": "一輪の花がつぼみから満開になり、やがてしおれる",
                    "keyframes": [
                      {
                        "image_url": "https://example.com/bud.jpg",
                        "time": 0
                      },
                      {
                        "image_url": "https://example.com/bloom.jpg",
                        "time": 4.5
                      },
                      {
                        "image_url": "https://example.com/wilt.jpg",
                        "time": 10
                      }
                    ],
                    "duration": 10,
                    "aspect_ratio": "1:1",
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "動画生成タスクが正常に作成されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータが無効です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足、チャージが必要です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセスが拒否されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: kling-v4-keyframes-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度制限を超過しました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt",
          "keyframes"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "動画生成モデル名",
            "enum": [
              "kling-v4-keyframes-to-video"
            ],
            "default": "kling-v4-keyframes-to-video",
            "example": "kling-v4-keyframes-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "キーフレーム間の変化を記述するテキストプロンプト\n\n**注意：**\n- 最大`2500`文字",
            "example": "早朝の通りから夕暮れの広場へとカメラが進み、光が徐々に暖かくなる",
            "maxLength": 2500
          },
          "keyframes": {
            "type": "array",
            "description": "キーフレームを時系列順に指定します。最初の画像が開始フレーム、最後の画像が終了フレームです（**必須**）\n\n**制約：**\n- `2`～`10`枚、かつ`duration` + 1以下（`3`秒では最大`4`枚、`5`秒では最大`6`枚）\n- `time`は全フレームで指定するか、全フレームで省略してください。すべて省略した場合は動画内に均等に配置されます\n\n**注意:**\n- 画像サイズ: 最大`10MB`\n- サポートされるフォーマット: `.jpg`、`.jpeg`、`.png`\n- 画像寸法: 幅と高さ >= `300px`、アスペクト比は`1:2.5`から`2.5:1`の間\n- 画像URLはサーバーから直接アクセスできる必要があります。アクセス時に直接ダウンロードされるURLでも構いません\n\n**例1：`time`を省略し、キーフレームを均等に配置**\n\n```json\n[\n  {\"image_url\": \"https://example.com/morning.jpg\"},\n  {\"image_url\": \"https://example.com/noon.jpg\"},\n  {\"image_url\": \"https://example.com/evening.jpg\"}\n]\n```\n\n**例2：すべてのキーフレームで`time`を指定し、時刻を設定（`duration`が`10`の場合）**\n\n```json\n[\n  {\"image_url\": \"https://example.com/bud.jpg\", \"time\": 0},\n  {\"image_url\": \"https://example.com/bloom.jpg\", \"time\": 4.5},\n  {\"image_url\": \"https://example.com/wilt.jpg\", \"time\": 10}\n]\n```",
            "items": {
              "type": "object",
              "properties": {
                "image_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "キーフレーム画像のURL"
                },
                "time": {
                  "type": "number",
                  "description": "このキーフレームの時刻。動画の先頭からの秒数で指定し、小数も使用できます（例：`2.5`）\n\n**注意：**\n- 範囲：`0`～`duration`\n- 前のキーフレームより後の時刻である必要があります"
                }
              },
              "required": [
                "image_url"
              ]
            },
            "minItems": 2,
            "maxItems": 10
          },
          "duration": {
            "type": "integer",
            "description": "動画の長さ（秒）。デフォルトは`5`秒\n\n**範囲：**\n- `3`～`30`の整数",
            "minimum": 3,
            "maximum": 30,
            "default": 5,
            "example": 5
          },
          "aspect_ratio": {
            "type": "string",
            "description": "動画のアスペクト比\n\n**選択肢：**\n- `16:9`：横向き\n- `9:16`：縦向き\n- `1:1`：正方形\n- `21:9`：ウルトラワイド",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "21:9"
            ],
            "example": "16:9",
            "default": "16:9"
          },
          "quality": {
            "type": "string",
            "description": "解像度レベル\n\n**オプション:**\n- `720p`: 標準 720P\n- `1080p`: 高画質 1080P",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p",
            "example": "720p"
          },
          "callback_url": {
            "type": "string",
            "description": "タスク完了時のHTTPSコールバックURL\n\n**コールバックタイミング:**\n- タスクが完了、失敗、またはキャンセルされた時にトリガー\n- 課金確認後に送信\n\n**セキュリティ制限:**\n- HTTPSプロトコルのみ\n- 内部IPアドレスは禁止（127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x など）\n- URLの長さは`2048`文字以下\n\n**コールバックメカニズム:**\n- タイムアウト: `10`秒\n- 失敗後最大`3`回リトライ（失敗後`1`/`2`/`4`秒）\n- コールバックレスポンス形式はタスク照会APIと一致\n- 2xxステータスコードは成功とみなされ、その他のコードはリトライをトリガー",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "タスク作成タイムスタンプ",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "タスクID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "使用された実際のモデル名",
            "example": "kling-v4-keyframes-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "タスクタイプ"
          },
          "progress": {
            "type": "integer",
            "description": "タスク進捗率（0-100）",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "タスクステータス",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "動画タスクの詳細"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "タスク出力タイプ",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量と課金情報"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "タスクをキャンセルできるかどうか",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "推定完了時間（秒）",
            "minimum": 0,
            "example": 300
          },
          "video_duration": {
            "type": "integer",
            "description": "動画の長さ（秒）",
            "example": 5
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量と課金情報",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "課金ルール",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "推定消費クレジット",
            "minimum": 0,
            "example": 270000
          },
          "user_group": {
            "type": "string",
            "description": "ユーザーグループカテゴリ",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "エラーコード識別子"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## すべてのAPIにBearer Token認証が必要です ##\n\n**APIキーの取得：**\n\n[APIキー管理ページ](https://evolink.ai/dashboard/keys)にアクセスしてAPIキーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "動画生成",
      "description": "AI動画生成API"
    }
  ]
}
