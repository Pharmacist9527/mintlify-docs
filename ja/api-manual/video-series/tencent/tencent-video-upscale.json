{
  "openapi": "3.1.0",
  "info": {
    "title": "tencent-video-upscale インターフェース",
    "description": "Tencent Video Upscale で動画の画質を向上させ、720p、1080p、2K、4K に拡大します",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "本番環境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "tags": [
          "動画生成"
        ],
        "summary": "tencent-video-upscale インターフェース",
        "description": "- Tencent Video Upscale (tencent-video-upscale) は既存の動画の画質を向上させ、`720p`、`1080p`、`2k`、`4k` に拡大します\n- 実写、アニメーション、遠景の小さな顔、顔の忠実な再現、細部の強調、柔らかな仕上がりに対応する 7 種類のスタイルを提供します\n- デフォルトでは元の動画のフレームレートを維持します（`model_params.max_fps: \"source\"`）。`\"30\"`、`\"60\"`、`\"120\"` で上限を設定できます。フレームレートを下げる処理のみ行い、フレーム補間は行いません\n- 動画の長さに応じて課金されます。解像度と出力フレームレートごとの料金は [EvoLink のモデル料金](https://evolink.ai/models)をご確認ください\n- 非同期処理です。返されたタスク ID を使用して[タスクの状態を確認](/ja/api-manual/task-management/get-task-detail)してください\n- 送信後のタスクはキャンセルできません\n- 処理後の動画 URL の有効期間は 24 時間です。お早めに保存してください",
        "operationId": "createTencentVideoUpscaleTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "default_1080p": {
                  "summary": "デフォルト：汎用実写スタイル、1080p、元のフレームレート",
                  "value": {
                    "model": "tencent-video-upscale",
                    "video_urls": [
                      "https://example.com/my-video.mp4"
                    ]
                  }
                },
                "explicit_defaults": {
                  "summary": "上の例と同じ動作：すべてのデフォルト値を明示",
                  "value": {
                    "model": "tencent-video-upscale",
                    "video_urls": [
                      "https://example.com/my-video.mp4"
                    ],
                    "mode": "realistic",
                    "quality": "1080p",
                    "model_params": {
                      "max_fps": "source"
                    }
                  }
                },
                "animation_4k": {
                  "summary": "アニメーション動画を 4K に高画質化",
                  "value": {
                    "model": "tencent-video-upscale",
                    "video_urls": [
                      "https://example.com/my-animation.mp4"
                    ],
                    "mode": "animation",
                    "quality": "4k"
                  }
                },
                "cap_frame_rate": {
                  "summary": "高フレームレートの動画を 30 fps に制限",
                  "value": {
                    "model": "tencent-video-upscale",
                    "video_urls": [
                      "https://example.com/my-60fps-video.mp4"
                    ],
                    "quality": "1080p",
                    "model_params": {
                      "max_fps": "30"
                    }
                  }
                },
                "with_callback": {
                  "summary": "コールバックURL付き",
                  "value": {
                    "model": "tencent-video-upscale",
                    "video_urls": [
                      "https://example.com/my-video.mp4"
                    ],
                    "mode": "face_fidelity",
                    "quality": "2k",
                    "callback_url": "https://your-domain.com/webhooks/video-task-completed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "動画の高画質化タスクが正常に作成されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータが不正です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missing_video": {
                    "summary": "動画URLが不足しています",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "video_urls is required and must not be empty for tencent-video-upscale",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_mode": {
                    "summary": "スタイルの値が無効です",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "invalid mode \"general\" for tencent-video-upscale; supported: realistic, realistic_distant, animation, animation_distant, face_fidelity, detail_boost, soft",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_max_fps": {
                    "summary": "フレームレート上限の値が無効です",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "invalid model_params.max_fps auto for tencent-video-upscale; supported: \"source\", 30, 60, 120",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_long": {
                    "summary": "動画が 60 秒を超えています",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "video duration 75.2s exceeds the 60s limit",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "source_too_large": {
                    "summary": "元の動画が 4K を超えています",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "source video resolution exceeds 4K (short side 2880px > 2160px)",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "target_too_low": {
                    "summary": "指定した解像度が元の動画より低くなっています",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "target quality 720p is lower than the source video (short side 1080px); choose a higher quality",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "top_level_fps": {
                    "summary": "トップレベルの fps パラメータは非対応です",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "fps is not supported for tencent-video-upscale; use model_params.max_fps (30, 60 or 120) to cap the output frame rate",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "probe_failed": {
                    "summary": "動画情報の読み取りに失敗しました",
                    "value": {
                      "error": {
                        "code": "video_probe_failed",
                        "message": "Failed to read the video's duration, resolution and frame rate. Please provide a publicly downloadable MP4 or MOV video URL",
                        "type": "invalid_request_error"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、トークンが無効または期限切れです",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "クォータ不足のため、チャージが必要です",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセスが拒否されました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: tencent-video-upscale",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "レート制限を超えました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          },
          "503": {
            "description": "サービスは一時的に利用できません。後ほど再試行するか、サポートにお問い合わせください",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "video_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "動画超解像モデルの名前",
            "enum": [
              "tencent-video-upscale"
            ],
            "default": "tencent-video-upscale",
            "example": "tencent-video-upscale"
          },
          "video_urls": {
            "type": "array",
            "description": "入力動画 URL のリスト\n\n**注意：**\n- 1 回のリクエストで対応する動画は `1` 本のみです（複数指定した場合は最初の動画のみ使用します）\n- 動画 URL はサーバーから直接アクセスできる必要があります（公開 URL または署名付き URL）\n- 対応形式：`.mp4`、`.mov`\n- 最大動画長：`60` 秒\n- 元の動画の解像度は最大 4K です（短辺が `2160` ピクセル以下）\n- 送信時にサーバーが動画の長さ、解像度、フレームレートを読み取ります。読み取りに失敗した場合は `video_probe_failed` を返します",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://example.com/my-video.mp4"
            ]
          },
          "mode": {
            "type": "string",
            "description": "動画の内容に合わせて選択する高画質化スタイル\n\n**選択肢：**\n- `realistic` - 汎用実写：実写などの一般的な映像 — **デフォルト**\n- `realistic_distant` - 実写・遠景：遠景に写る小さな顔に最適化\n- `animation` - 汎用アニメーション：アニメやカートゥーンなど\n- `animation_distant` - アニメーション・遠景：遠くのキャラクターが多い映像の小さな顔に最適化\n- `face_fidelity` - 顔の忠実な再現：元の顔の特徴をできるだけ維持\n- `detail_boost` - 細部の強調：質感や輪郭をより鮮明に\n- `soft` - ソフト：シャープ化を抑え、より自然な仕上がりに\n\n大文字と小文字は区別しません。無効な値は拒否されます",
            "enum": [
              "realistic",
              "realistic_distant",
              "animation",
              "animation_distant",
              "face_fidelity",
              "detail_boost",
              "soft"
            ],
            "default": "realistic",
            "example": "realistic"
          },
          "quality": {
            "type": "string",
            "description": "動画の短辺を基準とする出力解像度\n\n**選択肢：**\n- `720p` - 短辺 `720` ピクセル\n- `1080p` - 短辺 `1080` ピクセル — **デフォルト**\n- `2k` - 短辺 `1440` ピクセル\n- `4k` - 短辺 `2160` ピクセル\n\n**注意：**\n- 元の動画より低い解像度は指定できません。例えば、`1080p` の動画では `1080p`、`2k`、`4k` を選択でき、`720p` は拒否されます\n- 元の解像度以上の最も低い設定を選ぶと、画像サイズはほぼ変わりません",
            "enum": [
              "720p",
              "1080p",
              "2k",
              "4k"
            ],
            "default": "1080p",
            "example": "1080p"
          },
          "model_params": {
            "type": "object",
            "description": "モデル固有のパラメータ",
            "properties": {
              "max_fps": {
                "type": "string",
                "description": "出力動画のフレームレート上限です。デフォルトの `\"source\"` は元のフレームレートを維持します。省略した場合も `\"source\"` と同じです\n\n**選択肢：**\n- `\"source\"` - 元のフレームレートを維持 — **デフォルト**\n- `\"30\"` - 出力フレームレートを 30 fps 以下に制限\n- `\"60\"` - 出力フレームレートを 60 fps 以下に制限\n- `\"120\"` - 出力フレームレートを 120 fps 以下に制限\n\n**動作：**\n- 元のフレームレートが上限以下の場合はそのまま維持し、**フレーム補間は行いません**。上限を超える場合は上限まで下げます\n- `\"source\"` または省略時でも、元の動画が `120` fps を超える場合は `120` fps に制限されます\n\n**型について：**\n- 文字列の使用を推奨します。整数 `30`、`60`、`120` も受け付けます（例えば `\"60\"` と `60` は同じです）\n- `\"source\"` は大文字と小文字を区別しません\n- その他の値（`45`、`60.5`、`\"auto\"` など）は拒否されます\n- このモデルはトップレベルの `fps` パラメータを受け付けません",
                "enum": [
                  "source",
                  "30",
                  "60",
                  "120"
                ],
                "default": "source",
                "example": "30"
              }
            }
          },
          "callback_url": {
            "type": "string",
            "description": "タスク完了後の HTTPS コールバックアドレス\n\n**コールバックタイミング：**\n- タスクが完了、失敗、またはキャンセルされた時にトリガーされます\n- 課金確認完了後に送信されます\n\n**セキュリティ制限：**\n- HTTPS プロトコルのみサポート\n- 内部 IP アドレスへのコールバックは禁止（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x など）\n- URL の長さは `2048` 文字以内\n\n**コールバックメカニズム：**\n- タイムアウト：`10` 秒\n- 失敗時最大 `3` 回リトライ（`1` 秒/`2` 秒/`4` 秒後にリトライ）\n- コールバックレスポンスボディの形式はタスククエリ API のレスポンス形式と一致\n- コールバックアドレスが 2xx ステータスコードを返した場合は成功とみなされ、その他のステータスコードはリトライをトリガーします",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "タスク作成タイムスタンプ",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "タスク ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "使用された実際のモデル名",
            "example": "tencent-video-upscale"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "タスクタイプ"
          },
          "progress": {
            "type": "integer",
            "description": "タスク進捗率（0-100）",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "タスクステータス",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "動画タスクの詳細情報"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "タスク出力タイプ",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量と課金情報"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "タスクをキャンセルできるかどうか（このモデルのタスクは送信後にキャンセルできません）",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "推定完了時間（秒）。実際の所要時間は待ち行列の状況によって変わり、4K、高フレームレート、長い動画では大幅に長くなります",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "動画の長さ（秒）",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量と課金情報",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "課金ルール。このモデルは動画の長さに応じた `per_second` 課金です。実際の料金は [EvoLink のモデル料金](https://evolink.ai/models)をご確認ください",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "推定クレジット消費量（事前承認）。最終的な消費量はタスク完了後に確定します。確定額は請求明細をご確認ください",
            "minimum": 0,
            "example": 3.264
          },
          "user_group": {
            "type": "string",
            "description": "ユーザーグループカテゴリ",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "エラーコード識別子"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明"
              },
              "type": {
                "type": "string",
                "description": "エラータイプ"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##すべてのAPIにBearer Token認証が必要です##\n\n**APIキーの取得：**\n\n[APIキー管理ページ](https://evolink.ai/dashboard/keys)にアクセスしてAPIキーを取得してください\n\n**リクエストヘッダーに追加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "動画生成",
      "description": "AI動画生成関連API"
    }
  ]
}
