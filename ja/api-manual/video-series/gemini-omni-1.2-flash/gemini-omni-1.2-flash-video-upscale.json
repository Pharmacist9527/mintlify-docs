{
  "openapi": "3.1.0",
  "info": {
    "title": "gemini-omni-1.2-flash-video-upscale API",
    "description": "Gemini Omni 1.2 Flashで動画の解像度を高め、元の映像内容と音声を維持します。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "本番環境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "gemini-omni-1.2-flash-video-upscale API",
        "description": "- Gemini Omni 1.2 Flash（`gemini-omni-1.2-flash-video-upscale`）は、元の映像内容と音声を維持して動画を高解像度化します。プロンプトは不要です。\n- **動画：** `video_urls` は最大15秒の動画1本が必須です。\n- **入力サイズ：** 16:9または9:16の標準サイズのみ。`640×360`、`1280×720`、`1920×1080`、または縦向きの `360×640`、`720×1280`、`1080×1920`。\n- **目標解像度：** `quality` は必須です。360p → `720p` または `1080p`、720p → `1080p` または `4k`、1080p → `4k`。\n- **出力：** 長さ、アスペクト比、音声は入力に合わせます。フレームレートは24 fpsです。\n- `seed` の固定で再現性を高められます。\n- 非同期処理です。タスクIDで[状態を確認](/ja/api-manual/task-management/get-task-detail)してください。\n- リンクは24時間有効です。早めに保存してください。\n\n動画アップスケールでは `prompt` を使用しません。指定しても無視されます。",
        "operationId": "createGeminiOmni12FlashVideoUpscaleGeneration",
        "tags": [
          "動画生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni12FlashVideoUpscaleRequest"
              },
              "examples": {
                "video_upscale": {
                  "summary": "動画アップスケール",
                  "value": {
                    "model": "gemini-omni-1.2-flash-video-upscale",
                    "video_urls": [
                      "https://example.com/source-720p.mp4"
                    ],
                    "quality": "1080p"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "動画タスクの作成に成功しました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "リクエストパラメータエラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未認証、Tokenが無効または期限切れ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "残高不足、チャージが必要",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "アクセス権限がありません",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-1.2-flash-video-upscale",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "リクエスト頻度が上限を超えました",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "サーバー内部エラー",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni12FlashVideoUpscaleRequest": {
        "required": [
          "model",
          "video_urls",
          "quality"
        ],
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "モデル名。固定値は `gemini-omni-1.2-flash-video-upscale` です。",
            "enum": [
              "gemini-omni-1.2-flash-video-upscale"
            ],
            "example": "gemini-omni-1.2-flash-video-upscale",
            "default": "gemini-omni-1.2-flash-video-upscale"
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "description": "アップスケール対象の動画配列。必須で1本のみ対応します。HTTP/HTTPS動画URL、mp4形式、最大 `15` 秒。サイズは `640×360`、`1280×720`、`1920×1080`、または縦向きの `360×640`、`720×1280`、`1080×1920` のみです。",
            "example": [
              "https://example.com/source-720p.mp4"
            ]
          },
          "quality": {
            "type": "string",
            "description": "目標解像度。必須で、入力解像度より高い必要があります。\n\n- 入力360p：`720p`、`1080p`。\n- 入力720p：`1080p`、`4k`。\n- 入力1080p：`4k`。\n\n**課金について：** 実際の動画出力トークン使用量に基づいて精算され、入力トークンや思考トークンの料金は発生しません。出力トークン数は、入力動画の長さと入力・出力解像度の組み合わせによって変わります。送信時の料金は見積額であり、最終的な料金は実際の使用量に基づいて精算されます。",
            "enum": [
              "720p",
              "1080p",
              "4k"
            ],
            "example": "1080p"
          },
          "duration": {
            "type": "string",
            "description": "省略可能です。指定する場合は `auto` のみ使用できます。出力時間は入力動画に従い、秒数を指定することはできません。",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "aspect_ratio": {
            "type": "string",
            "description": "省略可能です。指定する場合は `auto` のみ使用できます。出力のアスペクト比は入力動画に従い、他の比率を指定することはできません。",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "seed": {
            "type": "integer",
            "description": "乱数シード。既定ではランダムです。範囲は `0`〜`4294967295`。固定すると再現性を高められます。",
            "minimum": 0,
            "maximum": 4294967295,
            "example": 42
          },
          "callback_url": {
            "type": "string",
            "description": "タスク完了後のHTTPSコールバックアドレス\n\n**コールバックのタイミング：**\n- タスクの完了（completed）、失敗（failed）、キャンセル（cancelled）時にトリガーされます\n- 課金確定後に送信されます\n\n**セキュリティ制限：**\n- HTTPSプロトコルのみ対応\n- 内部ネットワークIPアドレス（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x など）へのコールバックは禁止\n- URLの長さは `2048` 文字以内\n\n**コールバックの仕組み：**\n- タイムアウト時間：`10` 秒\n- 失敗後は最大 `3` 回まで再試行します（失敗後それぞれ `1` 秒／`2` 秒／`4` 秒後に再試行します）\n- コールバックのレスポンスボディの形式はタスク照会インターフェースの返却形式と同一です\n- コールバックアドレスが2xxステータスコードを返した場合は成功とみなし、それ以外のステータスコードは再試行をトリガーします",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "タスク作成のタイムスタンプ",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "タスクID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "実際に使用されたモデル名",
            "example": "gemini-omni-1.2-flash-video-upscale"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "タスクの具体的な種別"
          },
          "progress": {
            "type": "integer",
            "description": "タスクの進捗率 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "タスクの状態。作成APIは常に `processing` を返します。内部状態の `pending` もクライアントには `processing` として公開されます。",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "動画タスクの詳細情報"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "タスクの出力タイプ",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "使用量と課金情報"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "タスクがキャンセル可能かどうか",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "完了までの推定時間（秒）",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "出力動画の長さ（秒）。入力動画と同じで、システムが検出した入力動画の長さを返します。",
            "example": 5
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "使用量と課金情報",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "課金ルール",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "消費が見込まれるクレジット数",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "ユーザーが所属する課金グループ",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "エラーコード識別子"
              },
              "message": {
                "type": "string",
                "description": "エラーの説明情報"
              },
              "type": {
                "type": "string",
                "description": "エラーの種類"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##すべてのインターフェースはBearer Tokenによる認証が必要です##\n\n**API Key の取得：**\n\n[API Key 管理ページ](https://evolink.ai/dashboard/keys) にアクセスして API Key を取得してください\n\n**利用時はリクエストヘッダーに以下を追加します：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
