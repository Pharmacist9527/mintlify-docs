      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "响应的唯一标识",
            "example": "0217952345678901234567890abcdef"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "description": "对象类型，固定为 message"
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "固定为 assistant"
          },
          "model": {
            "type": "string",
            "description": "本次请求使用的模型",
            "example": "doubao-seed-2-1-pro"
          },
          "content": {
            "type": "array",
            "description": "模型生成的内容块。开启思考时通常先返回 `thinking` 块，再返回 `text` 块；读取正文请遍历 `type=\"text\"` 的块",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/ThinkingBlock"
                },
                {
                  "$ref": "#/components/schemas/ToolUseBlock"
                },
                {
                  "$ref": "#/components/schemas/ServerToolUseBlock"
                },
                {
                  "$ref": "#/components/schemas/WebSearchResultBlock"
                }
              ]
            },
            "example": [
              {
                "type": "thinking",
                "thinking": "用户想要一句简短的自我介绍……",
                "signature": "EqQBCkgIARABGAIi..."
              },
              {
                "type": "text",
                "text": "你好！我是 Seed 系列大语言模型，擅长推理、写作和代码。"
              }
            ]
          },
          "stop_reason": {
            "type": "string",
            "description": "停止原因\n\n- `end_turn`: 正常结束\n- `max_tokens`: 达到 max_tokens 上限\n- `stop_sequence`: 命中停止序列\n- `tool_use`: 模型请求调用函数",
            "enum": [
              "end_turn",
              "max_tokens",
              "stop_sequence",
              "tool_use"
            ],
            "example": "end_turn"
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ],
            "description": "命中的停止序列，未命中时为 null"
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "description": "Token 使用统计信息",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "未命中缓存的输入 token 数量（不含 `cache_read_input_tokens`）",
            "example": 25
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "命中缓存的输入 token 数量，按缓存命中价计费。完整输入 = `input_tokens` + `cache_read_input_tokens`",
            "example": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "固定返回 0，本接口不单独收取缓存写入费",
            "example": 0
          },
          "output_tokens": {
            "type": "integer",
            "description": "输出 token 数量，包含思考内容",
            "example": 120
          },
          "server_tool_use": {
            "type": "object",
            "description": "服务端工具的实际调用次数（使用联网搜索时返回）",
            "properties": {
              "web_search_requests": {
                "type": "integer",
                "description": "本次请求实际执行的联网搜索次数，按次计费",
                "example": 1
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP状态错误代码"
