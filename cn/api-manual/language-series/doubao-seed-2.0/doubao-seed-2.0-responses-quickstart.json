{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Responses 快速开始",
    "description": "快速上手 Seed 系列模型的 Responses 接口，5 分钟完成第一次对话调用",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "生产环境（推荐）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "备用地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Seed Responses 快速对话",
        "description": "- 使用 Responses API 格式调用 Seed 系列模型\n- 支持服务端上下文存储，通过 `previous_response_id` 实现多轮对话\n- 最简化参数，快速上手\n- 支持模型：`doubao-seed-2-1-pro`、`doubao-seed-2-1-turbo`、`doubao-seed-2-1-lite`、`doubao-seed-evolving`、`doubao-seed-2.0-pro`、`doubao-seed-2.0-lite`、`doubao-seed-2.0-mini`、`doubao-seed-2.0-code`\n- **Seed 2.0 旧模型名**：`doubao-seed-2.0-pro` / `doubao-seed-2.0-lite` 现已重定向到 `doubao-seed-2-1-lite`，`doubao-seed-2.0-code` 现已重定向到 `doubao-seed-evolving`，参数行为以新模型为准；新接入建议直接使用新模型名。`doubao-seed-2.0-mini` 不受影响\n- 需要更多功能？查看 [完整参数文档](/cn/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-responses-reference)",
        "operationId": "createResponseQuickSeed",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "响应生成成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证、Token无效或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "配额不足、需要充值",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "模型服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "服务暂时不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "对话模型名称\n\n| 模型 ID | 定位 | 上下文 |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Seed 2.1 旗舰档，适合复杂推理、长文档与代码库任务（推荐） | 100 万 Token |\n| `doubao-seed-2-1-turbo` | Seed 2.1 低价档，覆盖大多数对话、抽取与 Agent 任务 | 25.6 万 Token |\n| `doubao-seed-2-1-lite` | Seed 2.1 单价最低的一档，支持音频输入 | 100 万 Token |\n| `doubao-seed-evolving` | 按周更新的 Seed 模型，适合评估新能力 | 100 万 Token |\n| `doubao-seed-2.0-pro` | 旧模型名，现已重定向到 `doubao-seed-2-1-lite` | 100 万 Token |\n| `doubao-seed-2.0-lite` | 旧模型名，现已重定向到 `doubao-seed-2-1-lite` | 100 万 Token |\n| `doubao-seed-2.0-mini` | Seed 2.0 极速版，适合简单任务 | 25.6 万 Token |\n| `doubao-seed-2.0-code` | 旧模型名，现已重定向到 `doubao-seed-evolving` | 100 万 Token |\n\n注意两代模型 ID 的写法不同：Seed 2.1 写作 `2-1`（连字符），Seed 2.0 写作 `2.0`（点号）。",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "input": {
            "type": "string",
            "description": "输入内容（纯文本），等同于使用 user 角色输入的文本信息",
            "example": "你好，请用三句话介绍一下你自己"
          }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "本次响应的唯一标识",
            "example": "resp_02177148667427813c33c36521378d02b2c8389204fa8c3e2f63e"
          },
          "object": {
            "type": "string",
            "description": "对象类型，固定为 response",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "number",
            "description": "创建时间的 Unix 时间戳（秒）",
            "example": 1771486674
          },
          "model": {
            "type": "string",
            "description": "本次请求使用的模型",
            "example": "doubao-seed-2-1-pro"
          },
          "status": {
            "type": "string",
            "description": "响应状态\n\n- `completed`: 生成完成\n- `in_progress`: 生成中\n- `incomplete`: 未完成\n- `failed`: 失败",
            "enum": [
              "completed",
              "in_progress",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "模型输出内容列表",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "模型输出最大 token 数",
            "example": 32768
          },
          "caching": {
            "type": "object",
            "description": "本次请求的缓存配置；`type=enabled` 表示写入了显式缓存，会产生缓存存储费",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          },
          "store": {
            "type": "boolean",
            "description": "是否存储了响应",
            "example": true
          },
          "expire_at": {
            "type": "integer",
            "description": "响应存储与显式缓存的过期时刻（Unix 时间戳，秒）",
            "example": 1771745874
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "错误信息，成功时为 null"
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasoningOutput"
          },
          {
            "$ref": "#/components/schemas/MessageOutput"
          },
          {
            "$ref": "#/components/schemas/WebSearchCallOutput"
          }
        ]
      },
      "ReasoningOutput": {
        "title": "思维链输出",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "输出项 ID",
            "example": "rs_0217****404a"
          },
          "type": {
            "type": "string",
            "description": "输出类型，此处为 reasoning",
            "enum": [
              "reasoning"
            ]
          },
          "summary": {
            "type": "array",
            "description": "思维链内容",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "思维链内容文本"
                },
                "type": {
                  "type": "string",
                  "description": "类型，固定为 summary_text",
                  "enum": [
                    "summary_text"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "状态",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "MessageOutput": {
        "title": "消息输出",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "输出项 ID",
            "example": "msg_0217****a93c"
          },
          "type": {
            "type": "string",
            "description": "输出类型，此处为 message",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "description": "角色，固定为 assistant",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "type": "array",
            "description": "消息内容列表",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "文本内容",
                  "example": "你好呀！很高兴见到你～ 有什么我可以帮你的吗？"
                },
                "type": {
                  "type": "string",
                  "description": "内容类型",
                  "enum": [
                    "output_text"
                  ]
                },
                "annotations": {
                  "type": "array",
                  "nullable": true,
                  "description": "注释信息"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "状态",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Token 使用统计信息",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "输入 token 数量，包含缓存命中的部分",
            "example": 88
          },
          "input_tokens_details": {
            "type": "object",
            "description": "输入 token 详细信息",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "其中命中缓存的输入 token 数量，按缓存命中价计费",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "输出 token 数量，包含思考内容",
            "example": 230
          },
          "output_tokens_details": {
            "type": "object",
            "description": "输出 token 详细信息",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "推理/思维链 token 数量",
                "example": 211
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "总 token 数量",
            "example": 318
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP状态错误代码"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              },
              "param": {
                "type": "string",
                "description": "相关参数名称"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "错误时的建议"
              }
            }
          }
        }
      },
      "WebSearchCallOutput": {
        "title": "联网搜索调用",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_call"
            ]
          },
          "id": {
            "type": "string",
            "example": "ws_1"
          },
          "status": {
            "type": "string",
            "example": "completed"
          },
          "action": {
            "type": "object",
            "description": "本次执行的搜索动作及查询词。",
            "properties": {
              "type": {
                "type": "string",
                "example": "search"
              },
              "query": {
                "type": "string"
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Responses API",
      "description": "Responses API 对话生成接口"
    }
  ]
}
