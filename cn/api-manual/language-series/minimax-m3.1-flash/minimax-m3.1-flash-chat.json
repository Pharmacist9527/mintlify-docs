                          },
                          {
                            "type": "video_url",
                            "video_url": {
                              "url": "https://example.com/video.mp4",
                              "fps": 1
                            }
                          }
                        ]
                      }
                    ],
                    "max_completion_tokens": 32768
                  }
                },
                "tool_calling": {
                  "summary": "Function Calling 工具调用",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "查询北京今天的天气"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "查询指定城市的天气情况",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "location": {
                                "type": "string",
                                "description": "城市名称，例如：北京"
                              }
                            },
                            "required": [
                              "location"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "tool_result": {
                  "summary": "回传工具结果（多轮工具调用）",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": "查询北京今天的天气"
                      },
                      {
                        "role": "assistant",
                        "content": "",
                        "reasoning_content": "用户想查北京天气，调用 get_weather 工具。",
                        "tool_calls": [
                          {
                            "id": "call_function_p4iiqtpnh5bj_1",
                            "type": "function",
                            "function": {
                              "name": "get_weather",
                              "arguments": "{\"location\": \"北京\"}"
                            }
                          }
                        ]
                      },
                      {
                        "role": "tool",
                        "tool_call_id": "call_function_p4iiqtpnh5bj_1",
                        "content": "{\"location\": \"北京\", \"weather\": \"晴\", \"temperature\": \"22°C\"}"
                      }
                    ],
                    "tools": [
                      {
                        "type": "function",
                        "function": {
                          "name": "get_weather",
                          "description": "查询指定城市的天气情况",
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "location": {
                                "type": "string",
                                "description": "城市名称，例如：北京"
                              }
                            },
                            "required": [
                              "location"
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "流式输出",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "写一首关于春天的短诗"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
