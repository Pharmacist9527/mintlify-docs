                },
                "video_understanding": {
                  "summary": "视频理解（多模态输入）",
                  "value": {
                    "model": "MiniMax-M3.1-Flash",
                    "messages": [
                      {
                        "role": "user",
                        "content": [
                          {
                            "type": "text",
