            "type": "array",
            "description": "工具调用列表\n\n用于在多轮对话中传递历史的工具调用信息",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "工具调用的唯一标识符"
