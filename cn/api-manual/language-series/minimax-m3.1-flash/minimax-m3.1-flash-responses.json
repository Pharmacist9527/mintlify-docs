          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "server_error"
                  }
                }
              }
            }
          },
          "502": {
            "description": "网关错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Bad gateway",
                    "type": "server_error"
                  }
                }
              }
            }
          },
          "503": {
            "description": "服务暂时不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "server_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "所有接口均需要使用 Bearer Token 进行认证\n\n**获取 API Key**：\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加**：\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    },
    "schemas": {
      "ResponsesRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "模型 ID",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "input": {
            "type": [
              "string",
              "array"
            ],
            "description": "模型输入\n\n- **字符串形态**：整段文本按一条 `user` 消息处理\n- **数组形态**：输入项列表，支持 `message`、`function_call`、`function_call_output`、`reasoning`\n\n**多模态**：在 `message` 项的 `content` 数组里混合 `input_text`、`input_image`、`input_video` 块。\n\n**多轮对话**：接口无状态，续接对话必须把完整历史放进数组。",
            "items": {
              "$ref": "#/components/schemas/InputItem"
            },
            "example": "Explain recursion in one sentence."
          },
          "instructions": {
            "type": "string",
            "description": "系统级指令，等价于插入在最前面的一条 system 消息，用于设定角色、语气与输出约束。",
            "example": "You are a technical documentation assistant. Keep your answers concise."
          },
          "stream": {
            "type": "boolean",
            "description": "是否流式返回\n\n- `false`（默认）：一次性返回完整响应对象\n- `true`：以语义化 SSE 事件推送，终止事件为 `response.completed`，**不会发送 `[DONE]`**",
            "default": false,
            "example": false
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "本次生成的最大输出 token 数，**包含思考和回答**\n\n- 推荐 **131,072**（128K），最大 **524,288**（512K）\n- 取值过小时可能在思考阶段就达到上限，返回 `status: \"incomplete\"` 且没有 `message` 输出项",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "reasoning": {
            "type": "object",
            "description": "思考配置。MiniMax-M3.1-Flash 始终进行思考，思考内容以 `reasoning` 输出项返回，其 token 计入输出并按输出价计费。",
            "properties": {
              "effort": {
                "type": "string",
                "description": "思考深度，默认 `max`。较高档位通常会增加思考 token 消耗和响应时间。",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ],
                "default": "max",
                "example": "high"
              }
            }
          },
          "temperature": {
            "type": "number",
            "description": "采样温度，固定为 `1`",
            "enum": [
              1
            ],
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "核采样阈值，默认 0.95。",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "tools": {
            "type": "array",
            "description": "可供模型调用的工具列表，目前只支持 `function` 类型。函数由客户端执行，并把结果以 `function_call_output` 输入项回传。",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "工具选择策略，仅支持 `auto`（由模型决定是否调用工具）",
            "enum": [
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "text": {
            "type": "object",
            "description": "文本输出格式配置，`format.type` 仅支持 `text`",
            "properties": {
              "format": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "text"
                    ],
                    "default": "text",
                    "description": "输出格式类型"
                  }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "请求元数据，键和值都是字符串",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "InputItem": {
        "title": "输入项",
        "description": "输入项：消息、思考历史、函数调用或函数执行结果。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/MessageItem"
          },
          {
            "$ref": "#/components/schemas/ReasoningItem"
          },
          {
            "$ref": "#/components/schemas/FunctionCallItem"
          },
          {
            "$ref": "#/components/schemas/FunctionCallOutputItem"
          }
        ]
      },
      "MessageItem": {
        "type": "object",
        "title": "消息项",
        "description": "对话消息。回传历史助手消息时保留返回项的完整字段。",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "default": "message"
          },
          "id": {
            "type": "string",
            "description": "输出项标识，回传历史时保持不变。"
          },
          "status": {
            "type": "string",
            "description": "输出项状态，回传历史时保持不变。"
          },
          "role": {
            "type": "string",
            "description": "消息角色，仅 `type: message` 使用。`developer` 按 `system` 处理。",
            "enum": [
              "user",
              "assistant",
              "system",
              "developer"
            ],
            "example": "user"
          },
          "content": {
            "type": [
              "string",
              "array"
            ],
            "description": "消息内容，仅 `type: message` 使用。可以是纯文本，也可以是内容块数组。\n\n**内容块类型**：\n- `input_text`：文本，字段 `text`\n- `input_image`：图片，字段 `image_url`\n- `input_video`：视频，字段 `video_url`\n- `output_text`：assistant 历史回复中的文本\n\n请求体最大 64 MB。",
            "items": {
              "$ref": "#/components/schemas/ContentPart"
            },
            "example": "Explain recursion in one sentence."
          }
        }
      },
      "ReasoningItem": {
        "type": "object",
        "title": "思考项",
        "description": "上一轮返回的思考项。续答时按返回结构原样回传，包括 `id`、`status`、`summary`、`content` 和 `encrypted_content`。",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning"
            ]
          },
          "id": {
            "type": "string",
            "description": "输出项标识，回传历史时保持不变。"
          },
          "status": {
            "type": "string",
            "description": "输出项状态，回传历史时保持不变。"
          },
          "summary": {
            "type": "array",
            "description": "思考摘要，回传历史时保持原样。",
            "items": {
              "type": "object"
            }
          },
          "content": {
            "type": "array",
            "description": "思考内容块，回传历史时保持原样。",
            "items": {
              "$ref": "#/components/schemas/ReasoningContentPart"
            }
          },
          "encrypted_content": {
            "type": "string",
            "description": "不透明的思考数据，回传历史时保持原样。"
          }
        }
      },
      "ReasoningContentPart": {
        "type": "object",
        "title": "思考内容块",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning_text"
            ]
          },
          "text": {
            "type": "string",
            "description": "思考文本。"
          }
        }
      },
      "FunctionCallItem": {
        "type": "object",
        "title": "函数调用项",
        "description": "模型返回的函数调用，通过 `call_id` 与 `function_call_output` 项关联。",
        "required": [
          "type",
          "call_id",
          "name",
          "arguments"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function_call"
            ]
          },
          "id": {
            "type": "string",
            "description": "输出项标识，回传历史时保持不变。"
          },
          "status": {
            "type": "string",
            "description": "输出项状态，回传历史时保持不变。"
          },
          "call_id": {
            "type": "string",
            "description": "函数调用标识，`function_call` 与 `function_call_output` 通过它配对。"
          },
          "name": {
            "type": "string",
            "description": "被调用的函数名，仅 `type: function_call` 使用。"
          },
          "arguments": {
            "type": "string",
            "description": "函数调用参数，JSON 字符串，仅 `type: function_call` 使用。"
          }
        }
      },
      "FunctionCallOutputItem": {
        "type": "object",
        "title": "函数执行结果项",
        "description": "客户端执行函数后的结果，通过 `call_id` 与对应的函数调用项关联。",
        "required": [
          "type",
          "call_id",
          "output"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function_call_output"
            ]
          },
          "call_id": {
            "type": "string",
            "description": "函数调用标识，`function_call` 与 `function_call_output` 通过它配对。"
          },
          "output": {
            "type": "string",
            "description": "函数执行结果，仅 `type: function_call_output` 使用。"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "title": "内容块",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "input_text",
              "input_image",
              "input_video",
              "output_text"
            ],
            "description": "内容块类型"
          },
          "text": {
            "type": "string",
            "description": "文本内容（`input_text` / `output_text`）"
          },
          "image_url": {
            "description": "图片输入，`type: input_image` 时使用。可直接传 URL / Base64 data URL 字符串，或传对象 `{\"url\": \"...\", \"detail\": \"low | default | high\"}` 控制解析精度（越高越细致，token 越多）。支持 JPEG / PNG / GIF / WEBP，单张最大 10 MB",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "图片 URL 或 Base64 data URL"
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default",
                    "description": "解析精度"
                  }
                }
              }
            ]
          },
          "video_url": {
            "description": "视频输入，`type: input_video` 时使用。可直接传 URL / Base64 data URL 字符串，或传对象 `{\"url\": \"...\", \"fps\": 1, \"detail\": \"default\", \"max_long_side_pixel\": ...}`。`fps` 为抽帧频率，默认 1，范围 [0.2, 5]，取值越低 token 越少。支持 MP4 / AVI / MOV / MKV，URL / Base64 最大 50 MB；更大的视频通过 `mm_file://{file_id}` 文件引用传入",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "视频 URL、Base64 data URL 或 `mm_file://{file_id}`"
                  },
                  "fps": {
                    "type": "number",
                    "minimum": 0.2,
                    "maximum": 5,
                    "default": 1,
                    "description": "抽帧频率"
                  },
                  "detail": {
                    "type": "string",
                    "enum": [
                      "low",
                      "default",
                      "high"
                    ],
                    "default": "default",
                    "description": "解析精度"
                  },
                  "max_long_side_pixel": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "视频帧最长边像素限制"
                  }
                }
              }
            ]
          }
        }
      },
      "Tool": {
        "type": "object",
        "title": "工具定义",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "工具类型，目前只支持 `function`",
            "enum": [
              "function"
            ],
            "example": "function"
          },
          "name": {
            "type": "string",
            "description": "函数名称",
            "example": "get_product_stock"
          },
          "description": {
            "type": "string",
            "description": "函数用途说明，写清楚有助于模型判断何时调用。",
            "example": "Get the current stock level for a product."
          },
          "parameters": {
            "type": "object",
            "description": "参数定义，JSON Schema 格式。",
            "example": {
              "type": "object",
              "properties": {
                "product_id": {
                  "type": "string",
                  "description": "Product identifier."
                }
              },
              "required": [
                "product_id"
              ]
            }
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "description": "Responses 接口的响应对象。除下列字段外，响应还会回显本次请求的配置（`tools`、`tool_choice`、`temperature`、`top_p`、`text`、`reasoning`、`max_output_tokens` 等）。",
        "properties": {
          "id": {
            "type": "string",
            "description": "本次响应的唯一标识",
            "example": "072514d63605b7a0c83f1672230c398c"
          },
          "object": {
            "type": "string",
            "description": "对象类型，固定为 `response`",
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "创建时间，Unix 时间戳（秒）",
            "example": 1792401878
          },
          "status": {
            "type": "string",
            "description": "响应状态\n\n- `completed`：正常完成\n- `incomplete`：被截断，原因见 `incomplete_details`\n- `failed`：生成失败，原因见 `error`",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "model": {
            "type": "string",
            "description": "实际生成本次响应的模型 ID",
            "example": "MiniMax-M3.1-Flash"
          },
          "output": {
            "type": "array",
            "description": "输出项列表，按生成顺序排列：\n\n- `reasoning`：思考过程，id 形如 `<id>_rs`，含 `content`（`reasoning_text` 块列表）、`summary`（空数组）、`encrypted_content`\n- `message`：最终回答，id 形如 `<id>_msg`，含 `content`（`output_text` 块列表）\n- `function_call`：模型发起的函数调用，id 形如 `<id>_fc_<序号>`，含 `call_id`、`name`、`arguments`，需客户端执行后以 `function_call_output` 回传",
            "items": {
              "type": "object"
            }
          },
          "output_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "便捷字段：所有 `output_text` 文本拼接后的结果；没有文本输出时为 `null`"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "失败原因，成功时为 `null`"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "截断原因，未截断时为 `null`。`reason` 为 `max_output_tokens`（输出达到上限）或 `content_filter`（内容安全）"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Token 使用统计信息（含缓存与思考分项）",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "输入 token 总数（含缓存命中部分）",
            "example": 207
          },
          "input_tokens_details": {
            "type": "object",
            "description": "输入 token 详细分项",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "命中缓存的输入 token 数\n\n命中部分按缓存命中价计费；未命中部分 = `input_tokens - cached_tokens`，按标准输入价计费",
                "example": 174
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "输出 token 数量（含思考部分）",
            "example": 32
          },
          "output_tokens_details": {
            "type": "object",
            "description": "输出 token 详细分项",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "思考产生的 token 数（已计入 `output_tokens`）",
                "example": 9
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "总 token 数量 = input_tokens + output_tokens",
            "example": 239
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "错误响应",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "错误代码",
                "example": "invalid_prompt"
              },
              "message": {
                "type": "string",
                "description": "错误描述",
                "example": "Invalid request parameters"
              },
              "type": {
                "type": "string",
                "description": "错误类型",
                "example": "invalid_request_error"
              }
            }
          }
        }
      }
    }
  }
}
