{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi 全模型接口 - Responses 快速开始",
    "description": "通过 OpenAI Responses 协议调用 Kimi 系列文本模型的快速开始示例。最少只需 `model` 与 `input` 两个参数即可发起对话；工具调用、联网搜索、结构化输出、图片输入等请查看「完整参数」页。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "生产环境（推荐）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "备用地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Kimi Responses 快速调用",
        "description": "使用 `model` 与 `input` 调用 Kimi，支持 `kimi-k3.1-pro`、`kimi-k3.1-pro-highspeed` 与 `kimi-k3`。设置 `max_output_tokens` 时建议从 1024 起，为思考和正文预留空间。\n\n更多示例与模型差异见[完整参数](/cn/api-manual/language-series/kimi/responses/responses-reference)页。",
        "operationId": "kimiResponsesQuick",
        "tags": [
          "Responses"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesQuickRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro 最小请求",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "用一句话解释什么是上下文缓存。"
                  }
                },
                "highspeed": {
                  "summary": "Highspeed 低思考强度",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "input": "用一句话解释什么是上下文缓存。",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 1024
                  }
                },
                "k3": {
                  "summary": "Kimi K3 最小请求",
                  "value": {
                    "model": "kimi-k3",
                    "input": "用一句话解释什么是上下文缓存。"
                  }
                },
                "multi_turn": {
                  "summary": "系统指令与多轮对话",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": [
                      {
                        "role": "developer",
                        "content": "你是一名严谨的中文技术编辑，回答简洁。"
                      },
                      {
                        "role": "user",
                        "content": "什么是上下文缓存？"
                      },
                      {
                        "role": "assistant",
                        "content": "上下文缓存会保存请求中重复出现的前缀内容，后续请求命中时可以更快、更省地处理。"
                      },
                      {
                        "role": "user",
                        "content": "它适合哪些场景？"
                      }
                    ],
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 2048
                  }
                },
                "streaming": {
                  "summary": "SSE 流式输出",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "input": "写一首关于夏夜的四行短诗。",
                    "reasoning": {
                      "effort": "low"
                    },
                    "max_output_tokens": 2048,
                    "stream": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "响应创建成功；流式请求返回 SSE 事件流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Responses 格式的 SSE 事件流，以 `response.completed`、`response.incomplete` 或 `response.failed` 事件结束。"
                }
              }
            }
          },
          "400": {
            "description": "请求错误 - 参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未授权 - API 密钥无效或缺失",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁或额度不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponsesQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "要调用的模型：\n\n| 模型 ID | 定位 |\n|---|---|\n| `kimi-k3.1-pro` | 最新一代模型（推荐） |\n| `kimi-k3.1-pro-highspeed` | 与 Pro 参数相同，生成速度更快 |\n| `kimi-k3` | 上一代模型 |\n\n三个模型的上下文窗口均为 1,048,576 tokens，均始终开启思考。"
          },
          "input": {
            "description": "本次请求的输入。传字符串等价于一条 user 消息；传数组时按顺序给出历史消息。",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/InputMessage"
                }
              }
            ]
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "default": 131072,
            "description": "最大生成 Token 数，包含思考与最终回答；默认 131072，最大 1048576。"
          },
          "reasoning": {
            "type": "object",
            "description": "推理相关配置。",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max"
                ],
                "default": "max",
                "description": "思考强度，默认 `max`。`kimi-k3` 仅支持 `max`；其他兼容取值见完整参数页。"
              }
            }
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "为 true 时以 SSE 事件流返回响应。"
          }
        }
      },
      "InputMessage": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "developer"
            ],
            "description": "消息角色。`developer` 按系统指令处理。"
          },
          "content": {
            "type": "string",
            "description": "消息内容（纯文本）。",
            "example": "用一句话解释什么是上下文缓存。"
          }
        }
      },
      "ResponsesResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "响应 ID。",
            "example": "resp_6adc72aab1f2eaaebe6b869e"
          },
          "object": {
            "type": "string",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "integer",
            "description": "创建时间，Unix 时间戳（秒）。",
            "example": 1792832171
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "incomplete",
              "failed"
            ],
            "description": "响应状态。`incomplete` 通常表示达到 `max_output_tokens` 上限。",
            "example": "completed"
          },
          "incomplete_details": {
            "type": [
              "object",
              "null"
            ],
            "description": "`status` 为 `incomplete` 时给出原因。",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "max_output_tokens",
                  "content_filter"
                ]
              }
            }
          },
          "model": {
            "type": "string",
            "description": "本次调用的模型。",
            "example": "kimi-k3.1-pro"
          },
          "output": {
            "type": "array",
            "description": "输出项数组，通常先是 reasoning，再是 message。",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "OutputItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "reasoning",
              "message"
            ],
            "description": "`reasoning` 为推理内容，`message` 为最终回答。",
            "example": "message"
          },
          "id": {
            "type": "string",
            "example": "msg_6adc72aab1f2eaaebe6b869f"
          },
          "summary": {
            "type": "array",
            "description": "`type=reasoning` 时的推理内容。",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "summary_text"
                  ]
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "`type=message` 时返回。"
          },
          "content": {
            "type": "array",
            "description": "`type=message` 时的回答内容。",
            "items": {
              "$ref": "#/components/schemas/OutputText"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ],
            "example": "completed"
          }
        }
      },
      "OutputText": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "output_text"
            ],
            "example": "output_text"
          },
          "text": {
            "type": "string",
            "example": "上下文缓存会保存请求中重复出现的前缀内容，后续请求命中时可以更快、更省地处理。"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "输入 Token，包含缓存命中部分。",
            "example": 24
          },
          "input_tokens_details": {
            "type": "object",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "缓存命中的输入 Token。",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "输出 Token，包含推理 Token。",
            "example": 96
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "推理 Token，已包含在 output_tokens 中。",
                "example": 62
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "输入与输出 Token 总数。",
            "example": 120
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "description": "描述错误原因的错误消息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              },
              "code": {
                "type": "string",
                "description": "错误码"
              }
            },
            "required": [
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用 Bearer Token 进行认证##\n\n**获取 API Key**：\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加**：\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
