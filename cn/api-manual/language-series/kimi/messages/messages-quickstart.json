{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi 全模型接口 - Messages 快速开始",
    "description": "通过 Anthropic Messages 协议调用 Kimi 系列文本模型的快速开始示例。最少只需 `model`、`max_tokens` 与 `messages` 三个参数即可发起对话；工具调用、联网搜索、图片输入等请查看「完整参数」页。",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "生产环境（推荐）"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "备用地址"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Kimi 快速对话（全模型，Anthropic 兼容）",
        "description": "- 使用 Anthropic Messages 协议调用 Kimi 系列模型，通过 `model` 参数选择具体型号\n- 最少只需 `model`、`max_tokens` 与 `messages` 三个参数（`max_tokens` 在 Anthropic 协议中必填）\n- 三个模型的上下文窗口均为 1,048,576 tokens\n- 三个模型始终开启思考，思考强度放在 `output_config.effort`\n- 需要工具调用、联网搜索、图片输入、结构化输出或缓存设置，请查看[完整参数](/cn/api-manual/language-series/kimi/messages/messages-reference)页",
        "operationId": "kimiMessagesQuick",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageQuickRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Pro 最小请求",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 2048,
                    "messages": [
                      {
                        "role": "user",
                        "content": "用一句话解释什么是上下文缓存。"
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Highspeed 低思考强度",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "max_tokens": 2048,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "用一句话解释什么是上下文缓存。"
                      }
                    ]
                  }
                },
                "k3": {
                  "summary": "Kimi K3 最小请求",
                  "value": {
                    "model": "kimi-k3",
                    "max_tokens": 2048,
                    "messages": [
                      {
                        "role": "user",
                        "content": "用一句话解释什么是上下文缓存。"
                      }
                    ]
                  }
                },
                "multi_turn": {
                  "summary": "system 提示词与多轮对话",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 2048,
                    "output_config": {
                      "effort": "low"
                    },
                    "system": "你是一名严谨的中文技术编辑，回答简洁。",
                    "messages": [
                      {
                        "role": "user",
                        "content": "什么是上下文缓存？"
                      },
                      {
                        "role": "assistant",
                        "content": "上下文缓存会保存请求中重复出现的前缀内容，后续请求命中时可以更快、更省地处理。"
                      },
                      {
                        "role": "user",
                        "content": "它适合哪些场景？"
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "Anthropic SSE 流式输出",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 2048,
                    "output_config": {
                      "effort": "low"
                    },
                    "stream": true,
                    "messages": [
                      {
                        "role": "user",
                        "content": "写一首关于夏夜的四行短诗。"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message 响应；流式请求返回 Anthropic SSE 事件流",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "事件顺序通常为 message_start、content_block_*、message_delta、message_stop。"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed",
              "kimi-k3"
            ],
            "default": "kimi-k3.1-pro",
            "description": "要调用的模型：\n\n| 模型 ID | 定位 |\n|---|---|\n| `kimi-k3.1-pro` | 最新一代模型（推荐） |\n| `kimi-k3.1-pro-highspeed` | 与 Pro 参数相同，生成速度更快 |\n| `kimi-k3` | 上一代模型 |\n\n三个模型的上下文窗口均为 1,048,576 tokens，均始终开启思考。"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576,
            "description": "本次生成允许使用的最大 Token 数，包含 thinking 与最终文本。取值过小时，思考阶段可能耗尽输出预算，导致没有正文；建议不低于 1024，并按任务复杂度调高。"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "对话消息。多轮对话时按顺序放入历史消息；回传思考与工具调用历史的方法见完整参数页。",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            }
          },
          "system": {
            "type": "string",
            "description": "系统提示词。Messages 协议使用顶层 system，不使用 system role。"
          },
          "output_config": {
            "type": "object",
            "description": "输出配置。",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max"
                ],
                "default": "max",
                "description": "思考强度，默认 `max`。`kimi-k3` 仅支持 `max`；其他兼容取值见完整参数页。"
              }
            }
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "是否使用 Anthropic SSE 事件流返回。"
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "description": "消息角色，仅支持 user 或 assistant。"
          },
          "content": {
            "type": "string",
            "description": "消息内容（纯文本）。",
            "example": "用一句话解释什么是上下文缓存。"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "响应 ID。",
            "example": "chatcmpl-6adc72c2b5847b4b2ccb39fd"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "example": "message"
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "model": {
            "type": "string",
            "description": "本次调用的模型。",
            "example": "kimi-k3.1-pro"
          },
          "content": {
            "type": "array",
            "description": "输出内容块，通常先是 thinking，再是 text。",
            "items": {
              "$ref": "#/components/schemas/OutputContentBlock"
            }
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use",
              null
            ],
            "description": "停止原因：`end_turn` 为自然结束，`max_tokens` 为达到输出上限，`tool_use` 为模型请求调用工具。",
            "example": "end_turn"
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "OutputContentBlock": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "thinking",
              "text"
            ],
            "example": "text"
          },
          "thinking": {
            "type": "string",
            "description": "`type=thinking` 时的推理内容。多轮对话时应与 signature 一起原样回传。"
          },
          "signature": {
            "type": "string",
            "description": "`type=thinking` 时的签名，多轮对话时原样回传。"
          },
          "text": {
            "type": "string",
            "description": "`type=text` 时的回答文本。",
            "example": "上下文缓存会保存请求中重复出现的前缀内容，后续请求命中时可以更快、更省地处理。"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "普通输入 Token，已排除缓存读取和缓存写入。",
            "example": 24
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "缓存命中的输入 Token。",
            "example": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "缓存写入 Token。",
            "example": 0
          },
          "output_tokens": {
            "type": "integer",
            "description": "输出 Token，包含 thinking Token。",
            "example": 96
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求参数错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API Key 无效或缺失",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "请求过于频繁或额度不足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "服务内部错误",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用 Bearer Token 进行认证##\n\n**获取 API Key**：\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加**：\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "Anthropic Messages 兼容接口"
    }
  ]
}
