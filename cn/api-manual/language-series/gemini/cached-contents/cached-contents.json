  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用 Bearer Token 进行认证##\n\n**获取 API Key：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\n也接受 Gemini 原生写法：请求头 `x-goog-api-key: YOUR_API_KEY`，或 URL 参数 `?key=YOUR_API_KEY`。"
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "内容片段：文本、内联数据（base64）或文件引用，三选一",
        "properties": {
          "text": {
            "type": "string",
            "description": "文本"
          },
          "inlineData": {
            "type": "object",
            "description": "内联二进制数据（图片 / 音频 / PDF 等）",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "base64 编码的数据"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "文件引用",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "公网可访问的 URL"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "角色；系统指令不需要填"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "工具声明。只接受下面三种，其它工具会被拒绝",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "联网搜索，填 `{}`"
          },
          "codeExecution": {
            "type": "object",
            "description": "代码执行，填 `{}`"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "函数调用声明（OpenAPI 子集的参数结构）",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "模型，`models/gemini-3.8-flash` 或 `gemini-3.8-flash` 两种写法均可。支持 `gemini-3.8-flash`、`gemini-3.7-flash`、`gemini-3.6-flash`、`gemini-3.5-flash`、`gemini-3.5-flash-lite`、`gemini-3-flash-preview`、`gemini-3.1-flash-lite-preview`、`gemini-3.1-pro-preview`、`gemini-3.1-pro-preview-customtools`、`gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "要缓存的对话内容，必须是数组。引用缓存时这些内容会作为对话前缀。`contents`、`systemInstruction`、`tools` 至少提供一项",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "系统指令。写进缓存后，引用缓存的生成请求里不能再带 systemInstruction"
          },
          "tools": {
            "type": "array",
            "description": "工具声明。写进缓存后，引用缓存的生成请求里不能再带 tools",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "工具调用配置（如 functionCallingConfig）。写进缓存后，引用缓存的生成请求里不能再带 toolConfig"
          },
          "ttl": {
            "type": "string",
            "description": "有效期，如 `\"3600s\"`。最短 `60s`，最长 `604800s`（168 小时）。与 expireTime 二选一，同时传入返回 400；都不填默认 `3600s`",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "绝对到期时间（RFC 3339，UTC），与 ttl 二选一，同时传入返回 400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "给自己看的名字，最长 255 个字符，不影响计费",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "ttl 与 expireTime 二选一，必须且只能给一个；传入其它字段返回 400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "从现在起的新有效期，如 `\"7200s\"`。最短 `60s`，最长 `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "新的绝对到期时间（RFC 3339，UTC）",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "缓存名，形如 `cachedContents/<id>`。生成请求的 `cachedContent` 字段填它；`<id>` 同时是创建请求的请求号",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
          },
          "model": {
            "type": "string",
            "description": "缓存绑定的模型，引用时生成请求的模型必须与之一致",
            "example": "models/gemini-3.8-flash"
          },
          "displayName": {
            "type": "string",
            "description": "创建时给的名字，没给则不返回"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间（UTC）"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "最近一次更新时间（UTC）"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "到期时间（UTC），到期后自动删除"
          },
          "usageMetadata": {
            "type": "object",
            "properties": {
              "totalTokenCount": {
                "type": "integer",
                "description": "缓存的 token 总数，缓存写入费与存储费按它计算",
                "example": 7525
              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "还有下一页时返回，原样放到下一次请求的 `pageToken`"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Gemini 原生错误格式。`error.details[0].reason` 为原因码：`INVALID_ARGUMENT` 参数错误；`EXPLICIT_CACHE_UNSUPPORTED` 模型不支持显式缓存；`NO_AVAILABLE_CHANNEL`、`MODEL_PRICE_ERROR` 当前用户组暂未开放；`CACHE_EXPIRED` 缓存已到期或剩余有效期过短；`CACHE_MODEL_MISMATCH` 模型与缓存不一致；`INVALID_CACHED_CONTENT` `cachedContent` 格式不正确；`INSUFFICIENT_QUOTA` 余额不足；`CACHE_NOT_FOUND` 缓存不存在、已过期、已删除或不属于当前账号；`EXPLICIT_CACHE_DISABLED` 功能暂未开放；`CACHE_CONTENT_TOO_LARGE` 请求体超过 10 MB；`UPSTREAM_ERROR` 请求未被接受，原因见 `message`；`CACHE_CHANNEL_UNAVAILABLE`、`INTERNAL` 暂时不可用，请稍后重试。",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP 状态码"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "状态枚举，如 INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
