{
  "openapi": "3.1.0",
  "info": {
    "title": "获取任务详情接口",
    "description": "根据任务ID查询异步任务的状态、进度和结果信息",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/tasks/{task_id}": {
      "get": {
        "summary": "查询任务状态",
        "description": "根据任务ID查询异步任务的状态、进度和结果信息",
        "operationId": "getTaskDetail",
        "tags": [
          "任务管理"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "任务ID，查询时请忽略{}，在路径尾部拼接异步任务响应体的id",
            "example": "task-unified-1756817821-4x3rx6ny"
          }
        ],
        "responses": {
          "200": {
            "description": "任务状态详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetailResponse"
                },
                "example": {
                  "created": 1788436500,
                  "duration": 30,
                  "id": "task-unified-1788436500-yscib7uw",
                  "model": "gemini-3-pro-image-preview",
                  "object": "image.generation.task",
                  "progress": 100,
                  "result_data": [
                    {
                      "url": "http://example.com/image.jpg"
                    }
                  ],
                  "results": [
                    "http://example.com/image.jpg"
                  ],
                  "status": "completed",
                  "task_info": {
                    "can_cancel": false
                  },
                  "type": "image",
                  "usage": {
                    "cost": {
                      "credits": 10,
                      "usd": 0.148,
                      "cny": 1
                    },
                    "credits_used": 10
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证：API Key 缺失、无效、过期或已禁用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid API key (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "403": {
            "description": "账号已被禁用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "user_disabled",
                    "message": "Your account has been disabled (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "404": {
            "description": "任务不存在或不属于当前 API Key（任务 ID 格式错误也返回此状态）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "message": "Task not found",
                    "type": "invalid_request_error",
                    "param": "",
                    "code": "task_not_found"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限（同时返回 Retry-After 响应头）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "You have reached the request limit: max 60 requests per 1 minutes. Retry after 30 seconds. (request id: 20260908103000123456789abcdef)",
                    "param": null,
                    "retry_after": 30,
                    "retryable": true,
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "message": "Failed to get task status",
                    "type": "api_error",
                    "param": "",
                    "code": "internal_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskDetailResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "任务创建时间戳",
            "example": 1756817821
          },
          "id": {
            "type": "string",
            "description": "任务ID",
            "example": "task-unified-1756817821-4x3rx6ny"
          },
          "model": {
            "type": "string",
            "description": "使用的模型",
            "example": "gemini-3-pro-image-preview"
          },
          "object": {
            "type": "string",
            "description": "任务类型",
            "enum": [
              "image.generation.task",
              "video.generation.task",
              "audio.generation.task"
            ],
            "example": "image.generation.task"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "任务进度百分比",
            "example": 100
          },
          "status": {
            "type": "string",
            "description": "任务状态。注意：任务在上游仍为排队中时，查询接口已返回 \"processing\"，因此客户端通常只会看到 processing / completed / failed。",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "completed"
          },
          "type": {
            "type": "string",
            "description": "任务类型",
            "enum": [
              "image",
              "video",
              "audio",
              "text"
            ],
            "example": "image"
          },
          "duration": {
            "type": "integer",
            "description": "任务耗时（秒）。仅当 status 为 \"completed\" 或 \"failed\" 时返回。",
            "example": 30
          },
          "video_duration": {
            "type": "number",
            "description": "实际生成的视频时长（秒）。仅部分视频模型（如 Kling）在终态时返回。",
            "example": 5.0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "结果 URL 列表。仅当 status 为 \"completed\" 且模型产出 URL 结果时返回，其他情况下该字段不存在。",
            "example": [
              "http://example.com/image.jpg"
            ]
          },
          "result_data": {
            "description": "模型专属的完整结果对象。图像模型为对象数组，如 [{\"url\": ...}]（与 results 中的 URL 相同）；部分模型返回更丰富的对象（如 Suno 返回歌曲对象）。无结构化结果的模型不返回该字段。",
            "example": [
              {
                "url": "http://example.com/image.jpg"
              }
            ]
          },
          "usage": {
            "type": "object",
            "description": "用量与计费信息。仅当 status 为 \"completed\" 时返回。固定包含 credits_used 和 cost；token 字段仅按 token 计费的模型（如 gpt-image-2）返回，部分模型还会附加各自的计费明细字段。",
            "properties": {
              "credits_used": {
                "type": "number",
                "description": "本任务实际扣除的 Credits。仅在计费尚未结算时省略。",
                "example": 10
              },
              "cost": {
                "type": "object",
                "description": "本任务费用的三种货币表示，由 credits_used 换算得到（向上取整）。",
                "properties": {
                  "credits": {
                    "type": "number",
                    "description": "扣除的 Credits（与 credits_used 相同）",
                    "example": 10
                  },
                  "usd": {
                    "type": "number",
                    "description": "折合美元",
                    "example": 0.148
                  },
                  "cny": {
                    "type": "number",
                    "description": "折合人民币",
                    "example": 1
                  }
                }
              },
              "image_input_tokens": {
                "type": "integer",
                "description": "图片输入 token（仅按 token 计费的图像模型，如 gpt-image-2）",
                "example": 1032
              },
              "image_cached_input_tokens": {
                "type": "integer",
                "description": "缓存的图片输入 token（仅按 token 计费的图像模型）"
              },
              "image_output_tokens": {
                "type": "integer",
                "description": "图片输出 token（仅按 token 计费的图像模型）",
                "example": 987
              },
              "text_input_tokens": {
                "type": "integer",
                "description": "文本输入 token（仅按 token 计费的模型）",
                "example": 13
              },
              "text_cached_input_tokens": {
                "type": "integer",
                "description": "缓存的文本输入 token（仅按 token 计费的图像模型）"
              },
              "text_output_tokens": {
                "type": "integer",
                "description": "文本输出 token（仅大于 0 时返回）"
              },
              "total_tokens": {
                "type": "integer",
                "description": "总 token 数（仅按 token 计费的模型）",
                "example": 2032
              }
            }
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "任务失败时的错误信息（仅当 status 为 failed 时出现）。注意：此处的 error.code 为字符串类型的业务错误码，与 HTTP 状态码不同。完整错误码列表请参阅错误码参考文档。",
            "properties": {
              "code": {
                "type": "string",
                "description": "业务错误码（字符串类型）",
                "example": "content_policy_violation"
              },
              "message": {
                "type": "string",
                "description": "用户友好的错误说明与排错建议",
                "example": "Content policy violation.\nYour request was blocked by safety filters. Please adjust your prompt or input images and try again."
              },
              "details": {
                "type": "string",
                "description": "补充错误详情，仅在有值时返回"
              },
              "suggestion": {
                "type": "string",
                "description": "建议操作，仅部分 beta/别名模型返回"
              }
            }
          },
          "task_info": {
            "type": "object",
            "description": "任务详细信息",
            "properties": {
              "can_cancel": {
                "type": "boolean",
                "description": "是否可以取消任务",
                "example": false
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误码（字符串类型）",
                "example": "task_not_found"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息。由中间件产生的错误（401、429）末尾会附带 \" (request id: ...)\"",
                "example": "Task not found"
              },
              "type": {
                "type": "string",
                "description": "错误类型",
                "example": "invalid_request_error"
              },
              "param": {
                "type": "string",
                "nullable": true,
                "description": "相关参数名称；本接口为 null 或空字符串"
              },
              "retry_after": {
                "type": "integer",
                "description": "建议重试前等待的秒数（仅 429）",
                "example": 30
              },
              "retryable": {
                "type": "boolean",
                "description": "请求是否可重试（仅 429）",
                "example": true
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key ：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "任务管理",
      "description": "异步任务管理相关接口"
    }
  ]
}
