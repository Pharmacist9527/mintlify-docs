{
  "openapi": "3.1.0",
  "info": {
    "title": "minimax-h3-image接口",
    "description": "使用AI模型创建图像任务，支持多种模型和参数配置",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "minimax-h3-image接口",
        "description": "- MiniMax H3 Image (minimax-h3-image) 模型支持文本转图片、图像编辑两种生成模式，最多可传 16 张参考图\n- 输出最高 2000 万像素：可选画面比例配合 1K / 2K / 4K 分辨率档位，也可直接指定宽高像素\n- 异步处理模式，使用返回的任务ID  [进行查询](/cn/api-manual/task-management/get-task-detail)\n- 生成的图像链接，有效期为24小时，请尽快保存",
        "operationId": "createImageGenerationMinimaxH3Image",
        "tags": [
          "图像生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerationRequest"
              },
              "examples": {
                "text_to_image": {
                  "summary": "文生图（最简）",
                  "value": {
                    "model": "minimax-h3-image",
                    "prompt": "海面上绚丽多彩的美丽日落"
                  }
                },
                "text_to_image_hd": {
                  "summary": "文生图（高清 16:9）",
                  "value": {
                    "model": "minimax-h3-image",
                    "prompt": "黄昏时分未来都市天际线的电影级广角镜头",
                    "size": "16:9",
                    "resolution": "4K",
                    "n": 1
                  }
                },
                "text_to_image_pixel": {
                  "summary": "文生图（指定像素）",
                  "value": {
                    "model": "minimax-h3-image",
                    "prompt": "极简主义 Logo 设计",
                    "size": "1024x1024"
                  }
                },
                "image_edit": {
                  "summary": "图生图 / 图像编辑",
                  "value": {
                    "model": "minimax-h3-image",
                    "prompt": "在她旁边加一只可爱的小猫",
                    "size": "1:1",
                    "resolution": "1K",
                    "image_urls": [
                      "https://example.com/input.png"
                    ],
                    "callback_url": "https://your-domain.com/webhook/image-done"
                  }
                },
                "batch_generation": {
                  "summary": "批量生成",
                  "value": {
                    "model": "minimax-h3-image",
                    "prompt": "像素风格的可爱机器人",
                    "size": "1:1",
                    "resolution": "2K",
                    "n": 4
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "图像任务创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证、Token无效或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "配额不足、需要充值",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: minimax-h3-image",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "图像生成模型名称，官方通道，稳定性和可控性更好，适用于商业场景\n\n| 模型 ID | 定位 |\n|---|---|\n| `minimax-h3-image` | 标准版 |\n| `minimax-h3-image-highspeed` | 与标准版参数相同，生成速度更快 |",
            "enum": [
              "minimax-h3-image",
              "minimax-h3-image-highspeed"
            ],
            "default": "minimax-h3-image",
            "example": "minimax-h3-image"
          },
          "prompt": {
            "type": "string",
            "description": "提示词，描述想要生成的图像，或描述如何编辑已输入的图像\n\n**长度限制：**\n- 最多 `32,000` 字符（按 Unicode 码点统计）\n- `prompt_extend` 为 `false` 时，只有提示词的前约 `4096` 个 token 生效",
            "example": "海面上绚丽多彩的美丽日落",
            "maxLength": 32000
          },
          "image_urls": {
            "type": "array",
            "description": "参考图像URL列表，用于图生图与图像编辑功能\n\n**注意：**\n- 单次请求支持输入图像数量：`1~16`张\n- 单张图像大小：不超过 `64MB`\n- 单张图像边长：宽 / 高均在 `128` ~ `8192` px 之间\n- 单张图像宽高比：长边 / 短边不超过 `4:1`\n- 支持的文件格式：`.jpeg`、`.jpg`、`.png`、`.webp`、`.heic`、`.heif`\n- 图像URL需要服务器能直接查看，或者图像URL在访问时会直接进行下载（一般这种URL是以图像的扩展名作为结尾，例如`.png`、`.jpg`）\n- 图生图/图像编辑场景下，传入的参考图本身会产生额外的图像输入 token 消耗",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "example": [
              "https://example.com/image1.png",
              "https://example.com/image2.png"
            ]
          },
          "size": {
            "type": "string",
            "description": "生成图像的尺寸，支持**比例格式**与**显式像素格式**两种写法，默认 `auto`\n\n**① 比例格式（推荐）**：`X:Y`，常用比例如下：\n\n- `1:1`：正方形\n- `1:2` / `2:1`：极竖/极横\n- `1:3` / `3:1`：超竖/超横（临界 3:1）\n- `2:3` / `3:2`：标准竖/横\n- `3:4` / `4:3`：传统竖/横\n- `4:5` / `5:4`：社交媒体常用\n- `9:16` / `16:9`：手机/桌面宽屏\n- `9:21` / `21:9`：超宽屏\n\n其他 `X:Y` 也可以：`X`、`Y` 为 `1` ~ `300` 的整数，且长宽比 `≤ 3:1`\n\n**② 显式像素格式**：`WxH`（或 `W×H`），例如 `1024x1024`、`2720x1536`、`5472x3072`\n\n- 像素预算：`655,360 ≤ width × height ≤ 20,000,000`（约 0.65 MP ~ 20 MP）\n- 长宽比：`≤ 3:1`\n\n**③ `auto`**：由模型自动决定画面比例，输出面积仍按 `resolution` 档位\n\n**超限处理：**\n- 超出上述范围的尺寸直接返回 `400`，不会自动缩放或取整",
            "default": "auto",
            "example": "auto"
          },
          "resolution": {
            "type": "string",
            "description": "分辨率档位快捷参数，在 `size` 为 `auto` 或比例格式时生效，显式像素格式下此字段被忽略\n\n**像素预算规则**（根据目标总像素数和 `size` 比例推算宽高）：\n\n- `1K`：~1 MP（1024² = 1,048,576 像素）\n- `2K`：~4 MP（2048² = 4,194,304 像素）\n- `4K`：~16.8 MP（4096² = 16,777,216 像素）\n\n**横版/正方形对应实际输出尺寸**（竖版尺寸为对应横版的宽高调换，例如 `3:4` = `4:3` 反转）：\n\n| 比例 | 2K | 4K |\n|---|---|---|\n| `1:1` | 2048×2048 | 4096×4096 |\n| `4:3` | 2368×1760 | 4736×3552 |\n| `16:9` | 2720×1536 | 5472×3072 |\n| `3:1` | 3552×1184 | 7104×2368 |\n\n**注意：**\n- `1K` 与 `2K` 的图像输出 token 数相同（每张约 `4,096`）；`4K` 每张约 `16,384`，以返回的 `usage` 为准\n- 取值大小写不敏感",
            "enum": [
              "1K",
              "2K",
              "4K"
            ],
            "default": "2K",
            "example": "2K"
          },
          "output_format": {
            "type": "string",
            "description": "输出图像的文件格式，默认 `jpeg`\n\n- `jpeg`：有损压缩，文件体积更小\n- `png`：无损\n- `webp`：体积与质量兼顾\n\n**注意：**\n- 不支持透明背景",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ],
            "default": "jpeg",
            "example": "jpeg"
          },
          "n": {
            "type": "integer",
            "description": "生成图片数量，每张独立计费\n\n**注意：**\n- 文本输入 token 与图像输入 token 都会随 `n` 等比放大\n- 部分图片失败时（例如未通过内容安全审核），任务仍会带着成功的图片完成。实际张数以响应中的 `results` 为准，计费按返回的 `usage` 结算",
            "minimum": 1,
            "maximum": 10,
            "default": 1,
            "example": 1
          },
          "prompt_extend": {
            "type": "boolean",
            "description": "提示词优化开关：生成前由模型把提示词改写得更详细，默认 `true`\n\n**注意：**\n- 只有文生图且 `size` 为比例格式或显式像素格式时可以设为 `false`\n- `size` 为 `auto`，或传了 `image_urls` 时，设为 `false` 会返回 `400`\n- 开启时每张图约增加 `2,300` ~ `3,800` 个文本输入 token；关闭时只计提示词本身",
            "default": true,
            "example": true
          },
          "callback_url": {
            "type": "string",
            "description": "任务完成后的HTTPS回调地址\n\n**回调时机：**\n- 任务完成（completed）、失败（failed）或取消（cancelled）时触发\n- 在计费确认完成后发送\n\n**安全限制：**\n- 仅支持HTTPS协议\n- 禁止回调到内网IP地址（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x等）\n- URL长度不超过`2048`字符\n\n**回调机制：**\n- 超时时间：`10`秒\n- 失败后最多重试`3`次（会分别在失败的`1`秒/`2`秒/`4`秒后进行重试）\n- 回调响应体格式与任务查询接口返回的格式一致\n- 回调地址若返回2xx状态码视为成功，其他状态码会触发重试",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/image-task-completed"
          }
        }
      },
      "ImageGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "任务创建时间戳",
            "example": 1757156493
          },
          "id": {
            "type": "string",
            "description": "任务ID",
            "example": "task-unified-1757156493-imcg5zqt"
          },
          "model": {
            "type": "string",
            "description": "实际使用的模型名称",
            "example": "minimax-h3-image"
          },
          "object": {
            "type": "string",
            "enum": [
              "image.generation.task"
            ],
            "description": "任务的具体类型"
          },
          "progress": {
            "type": "integer",
            "description": "任务进度百分比 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "任务状态",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/TaskInfo",
            "description": "异步任务信息"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "任务的输出类型",
            "example": "image"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "使用量和计费信息"
          }
        }
      },
      "TaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "任务是否可以取消",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "预估完成时间（秒）",
            "minimum": 0,
            "example": 100
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "使用量和计费信息",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "计费规则",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_call"
          },
          "credits_reserved": {
            "type": "number",
            "description": "预估消耗积分数",
            "minimum": 0,
            "example": 2.5
          },
          "user_group": {
            "type": "string",
            "description": "用户组类别",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误代码标识符"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key ：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "图像生成",
      "description": "AI图像生成相关接口"
    }
  ]
}
