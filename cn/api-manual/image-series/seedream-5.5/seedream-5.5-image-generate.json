{
  "openapi": "3.1.0",
  "info": {
    "title": "doubao-seedream-5.5接口",
    "description": "使用AI模型创建图像任务，支持多种模型和参数配置",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "summary": "doubao-seedream-5.5接口",
        "description": "- Seedream 5.5 (doubao-seedream-5.5) 支持文生图、图生图和图像编辑，可生成透明背景图片\n- 异步处理，使用返回的任务 ID [查询任务状态](/cn/api-manual/task-management/get-task-detail)\n- 生成的图像链接，有效期为24小时，请尽快保存\n\n### 计费说明\n\n- 按实际生成的图片数量计费\n- 参考图另行收费，与生成图片分开计费",
        "operationId": "createImageGeneration",
        "tags": [
          "图像生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerationRequest"
              },
              "examples": {
                "text_to_image": {
                  "summary": "文本生成图像",
                  "value": {
                    "model": "doubao-seedream-5.5",
                    "prompt": "一片宁静的湖水倒映着夕阳的美景",
                    "size": "16:9",
                    "quality": "2K"
                  }
                },
                "transparent_text_to_image": {
                  "summary": "文生图生成透明背景图片",
                  "value": {
                    "model": "doubao-seedream-5.5",
                    "prompt": "一只橙色小猫的卡通贴纸，透明背景",
                    "size": "1:1",
                    "quality": "1K",
                    "background": "transparent"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "图像生成任务创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证、Token无效或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "配额不足、需要充值",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: doubao-seedream-5.5",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "图像生成模型名称",
            "enum": [
              "doubao-seedream-5.5"
            ],
            "default": "doubao-seedream-5.5",
            "example": "doubao-seedream-5.5"
          },
          "prompt": {
            "type": "string",
            "description": "提示词，描述想要生成的图像，或描述如何编辑已输入的图像\n\n**语言支持：** 中英文之外，Seedream 5.5 还支持俄语、阿拉伯语、菲律宾语、泰语、土耳其语、韩语、马来语、西班牙语、葡萄牙语、印尼语、法语、德语、越南语、日语。\n\n**长度限制：** 最多 `4000` tokens（中文约 2600 字、英文约 5000 词），超出返回 `400` 且不计费。\n\n**效果建议：** 建议中文不超过 300 字、英文不超过 600 词。过长虽在限额内，但信息容易分散，模型可能忽略细节导致画面元素缺失。",
            "example": "一片宁静的湖水倒映着夕阳的美景"
          },
          "size": {
            "type": "string",
            "description": "生成图像的尺寸，支持两种格式：\n\n**方式1 - 比例格式：**\n- `auto`、`1:1`、`2:3`、`3:2`、`3:4`、`4:3`、`4:5`、`5:4`、`9:16`、`16:9`、`21:9`、`9:21`\n- 配合 `quality` 参数使用，系统自动生成对应比例和分辨率的图片，无需手动指定像素\n\n**方式2 - 像素格式：**\n- 宽度x高度，如：`1024x1024`、`2048x2048`等在范围内的值\n- 总像素取值范围：`[921600, 4624220]`\n- 宽高比取值范围：`[1/16, 16]`\n- 宽高均需大于 `14px`\n\n不传 `size` 时默认 `auto`。模型根据提示词确定画面比例，输出分辨率由 `quality` 确定。",
            "default": "auto",
            "example": "16:9"
          },
          "quality": {
            "type": "string",
            "description": "输出分辨率，与 `size` 的比例格式配合使用，默认 `1K`。\n\n| 比例 | 1K | 1.5K | 2K |\n|---|---|---|---|\n| `1:1` | 1024×1024 | 1536×1536 | 2048×2048 |\n| `2:3` | 832×1248 | 1248×1872 | 1664×2496 |\n| `3:2` | 1248×832 | 1872×1248 | 2496×1664 |\n| `3:4` | 864×1152 | 1344×1792 | 1776×2368 |\n| `4:3` | 1152×864 | 1792×1344 | 2368×1776 |\n| `4:5` | 896×1120 | 1344×1680 | 1792×2240 |\n| `5:4` | 1120×896 | 1680×1344 | 2240×1792 |\n| `9:16` | 800×1424 | 1152×2048 | 1584×2816 |\n| `16:9` | 1424×800 | 2048×1152 | 2816×1584 |\n| `21:9` | 1568×672 | 2352×1008 | 3136×1344 |\n| `9:21` | 672×1568 | 1008×2352 | 1344×3136 |",
            "enum": [
              "1K",
              "1.5K",
              "2K"
            ],
            "default": "1K",
            "example": "2K"
          },
          "prompt_priority": {
            "type": "string",
            "description": "提示词优化模式，仅支持 `standard`（默认）。\n\n传入 `fast` 将返回 `400`，不计费。",
            "enum": [
              "standard"
            ],
            "default": "standard",
            "example": "standard"
          },
          "image_urls": {
            "type": "array",
            "description": "参考图像URL列表，用于图生图与图像编辑功能\n\n**注意：**\n- 参考图另行收费，与生成图片分开计费\n- 单次请求支持输入图像数量：`10`张\n- 图像大小：不超过 `30MB`\n- 支持的图像格式：`.jpeg`、`.jpg`、`.png`、`.webp`、`.bmp`、`.tiff`、`.gif`、`.heic`、`.heif`\n- 宽高比（宽/高）范围：`[1/16, 16]`\n- 宽高长度（px）> 14\n- 总像素范围：`[196, 6000×6000]`\n- 图像URL需要服务器能直接查看，或者图像URL在访问时会直接进行下载（一般这种URL是以图像的扩展名作为结尾，例如`.png`、`.jpg`）",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 10,
            "example": [
              "https://example.com/image1.png",
              "https://example.com/image2.png"
            ]
          },
          "output_format": {
            "type": "string",
            "description": "输出图片格式\n\n**可选值：**\n- `png`: PNG 格式（默认）\n- `jpeg`: JPEG 格式\n\n**注意：** 传 `background=transparent` 时输出固定为 png：不传 `output_format` 会自动按 png 输出，指定 `jpeg` 会被拒绝。",
            "enum": [
              "png",
              "jpeg"
            ],
            "default": "png",
            "example": "png"
          },
          "watermark": {
            "type": "boolean",
            "description": "是否在生成图像中添加水印",
            "default": false,
            "example": false
          },
          "background": {
            "type": "string",
            "description": "输出图片的背景类型，默认 `auto`。\n\n**可选值：**\n- `auto`：由模型根据提示词和参考图确定背景类型。任务详情的 `result_data[].background` 返回实际背景类型，值为 `transparent` 或 `opaque`\n- `transparent`：生成带透明通道的 PNG 图片，支持文生图和图生图\n- `opaque`：生成不透明背景图片\n\n**使用 `transparent` 时：**\n- 可不传参考图；如提供，最多 `10` 张，输入图片无需包含透明通道\n- 输出格式固定为 `png`；不传 `output_format` 时自动使用 `png`，传入 `jpeg` 将返回错误",
            "enum": [
              "auto",
              "transparent",
              "opaque"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "任务完成后的HTTPS回调地址\n\n**回调时机：**\n- 任务完成（completed）、失败（failed）或取消（cancelled）时触发\n- 在计费确认完成后发送\n\n**安全限制：**\n- 仅支持HTTPS协议\n- 禁止回调到内网IP地址（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x等）\n- URL长度不超过`2048`字符\n\n**回调机制：**\n- 超时时间：`10`秒\n- 失败后最多重试`3`次（会分别在失败的`1`秒/`2`秒/`4`秒后进行重试）\n- 回调响应体格式与任务查询接口返回的格式一致\n- 回调地址若返回2xx状态码视为成功，其他状态码会触发重试",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/image-task-completed"
          }
        }
      },
      "ImageGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "任务创建时间戳",
            "example": 1757165031
          },
          "id": {
            "type": "string",
            "description": "任务ID",
            "example": "task-unified-1793612886-seedream55"
          },
          "model": {
            "type": "string",
            "description": "实际使用的模型名称",
            "example": "doubao-seedream-5.5"
          },
          "object": {
            "type": "string",
            "enum": [
              "image.generation.task"
            ],
            "description": "任务的具体类型"
          },
          "progress": {
            "type": "integer",
            "description": "任务进度百分比 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "任务状态",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/TaskInfo",
            "description": "异步任务信息"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "任务的输出类型",
            "example": "image"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "使用量和计费信息"
          }
        }
      },
      "TaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "任务是否可以取消",
            "example": true
          },
          "estimated_time": {
            "type": "integer",
            "description": "预估完成时间（秒）",
            "minimum": 0,
            "example": 45
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "使用量和计费信息",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "计费规则",
            "enum": [
              "per_call",
              "per_image",
              "per_token",
              "per_second"
            ],
            "example": "per_image"
          },
          "credits_reserved": {
            "type": "number",
            "description": "预估消耗积分数",
            "minimum": 0,
            "example": 1.836
          },
          "user_group": {
            "type": "string",
            "description": "用户组类别",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误代码标识符"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key ：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "图像生成",
      "description": "AI图像生成相关接口"
    }
  ]
}
