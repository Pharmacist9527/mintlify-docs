{
  "openapi": "3.1.0",
  "info": {
    "title": "veo-3.1-lite-generate-preview接口",
    "description": "创建 Veo 3.1 Lite 视频生成任务，支持文生视频、首帧图生视频和首尾帧图生视频",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "veo-3.1-lite-generate-preview接口",
        "description": "- Veo 3.1 Lite (veo-3.1-lite-generate-preview) 是 Veo 3.1 系列的低价档，支持文生视频、首帧图生视频和首尾帧图生视频；输出时长 `4`、`6` 或 `8` 秒，清晰度 `720p` 或 `1080p`，默认生成音频\n- 相比 Veo 3.1 Fast 和 Veo 3.1 Pro，Lite 不支持参考图（`REFERENCE` 模式）和 `4k` 输出；模型处于 Preview 阶段，目前仅支持英文提示词\n- 计费：每个生成的视频按输出时长计费，每秒单价取决于清晰度（`720p` / `1080p`）和是否生成音频，价格请以 [EvoLink 模型价格](https://evolink.ai/veo-3-1-lite) 为准\n- 异步处理模式，使用返回的任务ID [进行查询](/cn/api-manual/task-management/get-task-detail)\n- 生成的视频链接，有效期为24小时，请尽快保存",
        "operationId": "createVideoGeneration",
        "tags": [
          "视频生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "text_to_video": {
                  "summary": "文本生成视频",
                  "value": {
                    "model": "veo-3.1-lite-generate-preview",
                    "prompt": "A golden retriever puppy running through a sunlit meadow, slow motion, cinematic lighting"
                  }
                },
                "first_frame": {
                  "summary": "首帧图生视频",
                  "value": {
                    "model": "veo-3.1-lite-generate-preview",
                    "prompt": "The camera slowly pushes in as the city lights flicker on at dusk",
                    "image_urls": [
                      "https://example.com/first-frame.jpg"
                    ],
                    "generation_type": "FIRST_FRAME_2_VIDEO",
                    "aspect_ratio": "9:16",
                    "duration": 6
                  }
                },
                "first_and_last_frames": {
                  "summary": "首尾帧图生视频",
                  "value": {
                    "model": "veo-3.1-lite-generate-preview",
                    "prompt": "A time-lapse transition from sunrise to sunset over a mountain lake",
                    "image_urls": [
                      "https://example.com/first-frame.jpg",
                      "https://example.com/last-frame.jpg"
                    ],
                    "generation_type": "FIRST_AND_LAST_FRAMES_2_VIDEO",
                    "quality": "1080p",
                    "duration": 8,
                    "callback_url": "https://your-domain.com/webhooks/video-task-completed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "视频生成任务创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证、Token无效或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "配额不足、需要充值",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: veo-3.1-lite-generate-preview",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "视频生成模型名称",
            "enum": [
              "veo-3.1-lite-generate-preview"
            ],
            "default": "veo-3.1-lite-generate-preview",
            "example": "veo-3.1-lite-generate-preview"
          },
          "prompt": {
            "type": "string",
            "description": "提示词，描述想要生成什么样的视频，限制为`2000`token。请使用英文编写：模型目前仅支持英文提示词（Preview）",
            "example": "A golden retriever puppy running through a sunlit meadow, slow motion, cinematic lighting",
            "maxLength": 2000
          },
          "image_urls": {
            "type": "array",
            "description": "输入图像URL列表，用于图生视频功能\n\n**注意：**\n- 单次请求最多支持`2`张图像：`1`张作为首帧，`2`张作为首尾帧\n- 本模型不支持参考图，传入`3`张及以上图像会被拒绝\n- 图像大小：不超过 `20MB`\n- 支持的文件格式：`.jpg`、`.jpeg`、`.png`、`.webp`",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 2,
            "example": [
              "https://example.com/first-frame.jpg"
            ]
          },
          "generation_type": {
            "type": "string",
            "description": "视频生成模式。不传时按图像数量自动推断；传入时必须与图像数量一致，否则返回 `400`\n\n- `TEXT_2_VIDEO`：文本生视频，不传图像\n- `FIRST_FRAME_2_VIDEO`：首帧图生视频，传入`1`张图像\n- `FIRST_AND_LAST_FRAMES_2_VIDEO`：首尾帧图生视频，传入`2`张图像\n\n本模型不支持 `REFERENCE_2_VIDEO`（参考图生视频），传入会被拒绝",
            "enum": [
              "TEXT_2_VIDEO",
              "FIRST_FRAME_2_VIDEO",
              "FIRST_AND_LAST_FRAMES_2_VIDEO"
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "description": "视频宽高比，默认为`16:9`。本模型不支持 `auto`",
            "enum": [
              "16:9",
              "9:16"
            ],
            "default": "16:9"
          },
          "generate_audio": {
            "type": "boolean",
            "description": "是否生成音频，默认为`true`。生成音频会提高每秒单价",
            "default": true
          },
          "duration": {
            "type": "integer",
            "description": "视频时长（秒），默认为`4`，时长越长费用越高",
            "enum": [
              4,
              6,
              8
            ],
            "default": 4
          },
          "n": {
            "type": "integer",
            "description": "生成视频数量，默认为`1`，每个视频单独计费",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "quality": {
            "type": "string",
            "description": "视频分辨率，默认为`720p`。`1080p` 每秒单价更高；本模型不支持 `4k`",
            "enum": [
              "720p",
              "1080p"
            ],
            "default": "720p"
          },
          "seed": {
            "type": "integer",
            "description": "随机种子，用于复现生成结果",
            "minimum": 0,
            "maximum": 4294967295
          },
          "negative_prompt": {
            "type": "string",
            "description": "负面提示词，描述不希望在视频中出现的内容"
          },
          "callback_url": {
            "type": "string",
            "description": "任务完成后的HTTPS回调地址\n\n**回调时机：**\n- 任务完成（completed）、失败（failed）或取消（cancelled）时触发\n- 在计费确认完成后发送\n\n**安全限制：**\n- 仅支持HTTPS协议\n- 禁止回调到内网IP地址（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x等）\n- URL长度不超过`2048`字符\n\n**回调机制：**\n- 超时时间：`10`秒\n- 失败后最多重试`3`次（会分别在失败的`1`秒/`2`秒/`4`秒后进行重试）\n- 回调响应体格式与任务查询接口返回的格式一致\n- 回调地址若返回2xx状态码视为成功，其他状态码会触发重试",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "任务创建时间戳",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "任务ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "实际使用的模型名称",
            "example": "veo-3.1-lite-generate-preview"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "任务的具体类型"
          },
          "progress": {
            "type": "integer",
            "description": "任务进度百分比 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "任务状态",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "视频任务详细信息"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "任务的输出类型",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量和计费信息"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "任务是否可以取消（本模型任务提交后不可取消）",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "预估完成时间（秒），实际耗时受排队情况影响",
            "minimum": 0,
            "example": 600
          },
          "video_duration": {
            "type": "integer",
            "description": "视频时长（秒），与请求的 `duration` 一致",
            "example": 4
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量和计费信息",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "计费规则。本模型按 `per_call` 计费：每次调用按实际返回的每个视频的输出时长结算，每秒单价由清晰度和是否生成音频决定，实际费用请以 [EvoLink 模型价格](https://evolink.ai/veo-3-1-lite) 为准",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_call"
          },
          "credits_reserved": {
            "type": "number",
            "description": "预估消耗积分（预授权），按 `duration`、`quality`、`generate_audio` 和 `n` 计算。最终消耗积分在任务完成后按实际返回的视频结算，以账单为准",
            "minimum": 0,
            "example": 13.6
          },
          "user_group": {
            "type": "string",
            "description": "用户组类别",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误代码标识符"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key ：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "视频生成",
      "description": "AI视频生成相关接口"
    }
  ]
}
