{
  "openapi": "3.1.0",
  "info": {
    "title": "OmniHuman 2.0 数字人视频生成接口",
    "description": "使用OmniHuman 2.0模型创建音频驱动的数字人视频生成任务",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "OmniHuman 2.0 数字人视频生成",
        "description": "- OmniHuman 2.0 (omnihuman-2.0) 模型根据一张人物图像和一段音频生成数字人视频，口型和动作跟随音频\n- 异步处理模式，使用返回的任务ID [进行查询](/cn/api-manual/task-management/get-task-detail)\n- 生成的视频链接有效期为24小时，请尽快保存\n\n**注意：**\n- 音频时长限制：4–300秒\n- 支持的音频格式：MP3、WAV\n- 按音频时长计费（按`0.1`秒向上取整）",
        "operationId": "createOmniHuman20VideoGeneration",
        "tags": [
          "数字人视频生成"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "basic_generation": {
                  "summary": "基础数字人生成",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ]
                  }
                },
                "with_prompt": {
                  "summary": "带提示词",
                  "value": {
                    "model": "omnihuman-2.0",
                    "audio_url": "https://your-cdn.com/omnihuman/speech.mp3",
                    "image_urls": [
                      "https://your-cdn.com/omnihuman/portrait.jpg"
                    ],
                    "prompt": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "数字人视频生成任务创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported_parameter": {
                    "summary": "传入本模型不支持的参数",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "mask_url is not supported by omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "too_many_images": {
                    "summary": "图像多于 1 张",
                    "value": {
                      "error": {
                        "code": "invalid_parameter",
                        "message": "omnihuman-2.0 accepts exactly 1 image, got 2",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_audio_url": {
                    "summary": "缺少音频URL",
                    "value": {
                      "error": {
                        "code": "missing_audio_url",
                        "message": "audio_url is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "missing_image_urls": {
                    "summary": "缺少图像URL",
                    "value": {
                      "error": {
                        "code": "missing_image_urls",
                        "message": "image_urls is required for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio": {
                    "summary": "音频无法下载或解析",
                    "value": {
                      "error": {
                        "code": "invalid_audio",
                        "message": "failed to read audio_url: download audio failed: HTTP 404",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_audio_duration": {
                    "summary": "音频时长超出范围",
                    "value": {
                      "error": {
                        "code": "invalid_audio_duration",
                        "message": "audio duration 2.50s is out of range [4, 300] for omnihuman-2.0",
                        "type": "invalid_request_error"
                      }
                    }
                  },
                  "invalid_media_url": {
                    "summary": "媒体URL指向本机或内网地址",
                    "value": {
                      "error": {
                        "code": "invalid_media_url",
                        "message": "invalid parameter \"audio_url\": points to a local or private network address; provide a publicly accessible URL",
                        "type": "invalid_request_error",
                        "param": "audio_url"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未认证、Token无效或过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "配额不足、需要充值",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: omnihuman-2.0",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "请求频率超限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务器内部错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VideoGenerationRequest": {
        "type": "object",
        "required": [
          "model",
          "audio_url",
          "image_urls"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "数字人视频生成模型名称\n\n**注意：**\n- 本模型不支持 OmniHuman-1.5 的 `mask_url`、`subject_check`、`auto_mask`、`pe_fast_mode`、`audio_urls` 参数，开启这些开关或传入非空值会返回 400 参数错误\n- 所有参数写在请求体顶层，传入非空的 `model_params` 会返回 400 参数错误",
            "enum": [
              "omnihuman-2.0"
            ],
            "default": "omnihuman-2.0",
            "example": "omnihuman-2.0"
          },
          "audio_url": {
            "type": "string",
            "format": "uri",
            "description": "驱动唇形同步和身体动作的音频URL\n\n**注意：**\n- 音频时长：`4`–`300`秒（含两端），超出范围返回 400 参数错误\n- 支持格式：`.mp3`、`.wav`\n- 文件大小：小于`15MB`\n- 音频URL需要服务器能直接访问；无法下载、格式不支持或超过大小上限时返回 400 参数错误\n- 按音频时长计费（按`0.1`秒向上取整）",
            "example": "https://your-cdn.com/omnihuman/speech.mp3"
          },
          "image_urls": {
            "type": "array",
            "description": "参考图像URL列表，包含需要驱动人物的参考图像\n\n**注意：**\n- 单次请求支持输入图像数量：`1`张，超过`1`张返回 400 参数错误\n- 支持的文件格式：`.jpg`、`.jpeg`、`.png`、`.webp`、`.bmp`、`.tiff`、`.gif`、`.heic`、`.heif`\n- 图像大小：小于`30MB`\n- 宽高比（宽/高）：`0.4`–`2.5`\n- 宽高像素：`300`–`6000` px\n- 图像URL需要服务器能直接访问",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 1,
            "example": [
              "https://your-cdn.com/omnihuman/portrait.jpg"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "可选的文本提示，用于控制场景、动作和运镜，仅支持中文、英语、日语、韩语、西班牙语（墨西哥）、印尼语",
            "example": "The person speaks to the camera with natural hand gestures while the camera slowly pushes in"
          },
          "callback_url": {
            "type": "string",
            "description": "任务完成后的HTTPS回调地址\n\n**回调时机：**\n- 任务完成（completed）或失败（failed）时触发（OmniHuman 2.0 任务不支持取消）\n- 在计费确认完成后发送\n\n**安全限制：**\n- 仅支持HTTPS协议\n- 禁止回调到内网IP地址（127.0.0.1、10.x.x.x、172.16-31.x.x、192.168.x.x等）\n- URL长度不超过`2048`字符\n\n**回调机制：**\n- 超时时间：`10`秒\n- 失败后最多重试`3`次（会分别在失败的`1`秒/`2`秒/`4`秒后进行重试）\n- 回调响应体格式与任务查询接口返回的格式一致\n- 回调地址若返回2xx状态码视为成功，其他状态码会触发重试",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "任务创建时间戳",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "任务ID",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "实际使用的模型名称",
            "example": "omnihuman-2.0"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "任务的具体类型"
          },
          "progress": {
            "type": "integer",
            "description": "任务进度百分比 (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "任务状态",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "pending"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "视频任务详细信息"
          },
          "type": {
            "type": "string",
            "enum": [
              "video"
            ],
            "description": "任务的输出类型",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/VideoUsage",
            "description": "使用量和计费信息"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "任务是否可以取消。OmniHuman 2.0 任务不支持取消，始终为 `false`。",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "预估完成时间(秒)",
            "minimum": 0,
            "example": 120
          },
          "video_duration": {
            "type": "integer",
            "description": "预估视频时长(秒)",
            "example": 0
          }
        }
      },
      "VideoUsage": {
        "type": "object",
        "description": "使用量和计费信息",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "计费规则（OmniHuman为per_second）",
            "enum": [
              "per_second"
            ],
            "example": "per_second"
          },
          "credits_reserved": {
            "type": "number",
            "description": "预估消耗积分数（基于音频时长）",
            "minimum": 0,
            "example": 59.024
          },
          "user_group": {
            "type": "string",
            "description": "用户组类别",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "错误代码标识符"
              },
              "message": {
                "type": "string",
                "description": "错误描述信息"
              },
              "type": {
                "type": "string",
                "description": "错误类型"
              },
              "param": {
                "type": "string",
                "description": "相关参数名称"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##所有接口均需要使用Bearer Token进行认证##\n\n**获取 API Key：**\n\n访问 [API Key 管理页面](https://evolink.ai/dashboard/keys) 获取您的 API Key\n\n**使用时在请求头中添加：**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "数字人视频生成",
      "description": "OmniHuman 2.0数字人视频生成相关接口"
    }
  ]
}
