{
  "openapi": "3.1.0",
  "info": {
    "title": "Gemini Omni 1.1 Flash Référence vers vidéo",
    "description": "Génère une vidéo avec des images et vidéos de référence",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.evolink.ai",
      "description": "Environnement de production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/videos/generations": {
      "post": {
        "summary": "Gemini Omni 1.1 Flash Référence vers vidéo",
        "description": "- Génère une vidéo avec des images et vidéos de référence\n- `image_urls`: URLs d’images de référence. Obligatoire, maximum public 10. HTTP/HTTPS uniquement.\n- `video_urls`: Vidéos de référence facultatives, maximum 3 MP4 HTTP/HTTPS, chacune limitée à 10 secondes.\n- `quality`: Résolution : 360p, 720p, 1080p ou 4k. Défaut : 720p.\n- `duration`: Durée en secondes : entier de 3 à 10, défaut 3.\n- `aspect_ratio`: Format : 16:9, 9:16 ou auto ; défaut auto.\n- Le modèle génère automatiquement un audio natif synchronisé.\n- Écrivez les contraintes négatives directement dans prompt.\n- Traitement asynchrone: [consulter l’état de la tâche](/fr/api-manual/task-management/get-task-detail)\n- Les liens générés restent valides 24 heures.",
        "operationId": "createGeminiOmni11FlashReferenceToVideoGeneration",
        "tags": [
          "Generation video"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeminiOmni11FlashReferenceToVideoRequest"
              },
              "examples": {
                "reference_to_video": {
                  "summary": "Référence vers vidéo",
                  "value": {
                    "model": "gemini-omni-1.1-flash-reference-to-video",
                    "prompt": "Conserver l’apparence et le mouvement de caméra des références.",
                    "image_urls": [
                      "https://example.com/character.png",
                      "https://example.com/scene.png"
                    ],
                    "quality": "720p",
                    "aspect_ratio": "16:9",
                    "duration": 3
                  }
                },
                "reference_with_video": {
                  "summary": "Références image et vidéo",
                  "value": {
                    "model": "gemini-omni-1.1-flash-reference-to-video",
                    "prompt": "Conserver l’apparence et le mouvement de caméra des références.",
                    "image_urls": [
                      "https://example.com/character.png"
                    ],
                    "video_urls": [
                      "https://example.com/reference.mp4"
                    ],
                    "quality": "720p",
                    "aspect_ratio": "16:9",
                    "duration": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tache video creee avec succes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoGenerationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametres de requete invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifie, Token invalide ou expire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Quota insuffisant, recharge necessaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "insufficient_quota",
                    "message": "Insufficient quota. Please top up your account.",
                    "type": "insufficient_quota"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Acces non autorise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "model_access_denied",
                    "message": "Token does not have access to model: gemini-omni-1.1-flash-reference-to-video",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Frequence de requetes depassee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "rate_limit_exceeded",
                    "message": "Too many requests, please try again later",
                    "type": "rate_limit_error"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Internal server error",
                    "type": "api_error"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeminiOmni11FlashReferenceToVideoRequest": {
        "required": [
          "model",
          "prompt",
          "image_urls"
        ],
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Nom du modèle, fixé à `gemini-omni-1.1-flash-reference-to-video`",
            "enum": [
              "gemini-omni-1.1-flash-reference-to-video"
            ],
            "example": "gemini-omni-1.1-flash-reference-to-video",
            "default": "gemini-omni-1.1-flash-reference-to-video"
          },
          "prompt": {
            "type": "string",
            "description": "Prompt décrivant l’utilisation des références de sujet, style et mouvement.",
            "example": "Conserver l’apparence et le mouvement de caméra des références."
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "Tableau d'URL d'images de référence. Obligatoire ; de 1 à 10 images pour contraindre le sujet, le style ou les éléments.\n\n**Exigences d'entrée :**\n- URL d'image HTTP/HTTPS uniquement\n- Formats pris en charge : `png`, `jpeg`, `webp`",
            "example": [
              "https://example.com/character.png",
              "https://example.com/scene.png"
            ]
          },
          "video_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "Tableau facultatif de vidéos de référence ; 3 vidéos maximum.\n\nLes vidéos peuvent fournir des références de mouvement, de caméra ou de style et être utilisées avec `image_urls`.\n\n**Exigences d'entrée :**\n- URL vidéo HTTP/HTTPS uniquement\n- Format : `mp4`\n- Chaque vidéo doit durer au maximum `10` secondes\n\n**Facturation :** Chaque vidéo de référence ajoute des tokens d'entrée.",
            "example": [
              "https://example.com/reference.mp4"
            ]
          },
          "quality": {
            "type": "string",
            "description": "Résolution vidéo ; valeur par défaut `720p`.\n\n**Valeurs prises en charge :**\n- `360p` : paysage 640×360 / portrait 360×640\n- `720p` : paysage 1280×720 / portrait 720×1280 ; valeur par défaut\n- `1080p` : paysage 1920×1080 / portrait 1080×1920\n- `4k` : paysage 3840×2160 / portrait 2160×3840\n\nL'orientation dépend de `aspect_ratio` : `16:9` produit un format paysage et `9:16` un format portrait.\n\n**Facturation :** Les tokens de sortie augmentent linéairement avec la résolution. Par rapport à `720p`, `360p` utilise environ un tiers, `1080p` environ 1,5× et `4k` environ 3×. Le montant réel dépend de l'utilisation générée.",
            "enum": [
              "360p",
              "720p",
              "1080p",
              "4k"
            ],
            "default": "720p",
            "example": "720p"
          },
          "duration": {
            "type": "integer",
            "description": "Durée de la vidéo en secondes ; valeur par défaut `3`.\n\n**Remarques :**\n- Accepte tout entier de `3` à `10`\n- La durée influe directement sur la facturation",
            "minimum": 3,
            "maximum": 10,
            "default": 3,
            "example": 3
          },
          "aspect_ratio": {
            "type": "string",
            "description": "Format : 16:9, 9:16 ou auto ; défaut auto.",
            "enum": [
              "16:9",
              "9:16",
              "auto"
            ],
            "default": "auto",
            "example": "auto"
          },
          "callback_url": {
            "type": "string",
            "description": "Adresse de rappel HTTPS a la fin de la tache\n\n**Moment du rappel :**\n- Declenche lorsque la tache est terminee (completed), a echoue (failed) ou est annulee (cancelled)\n- Envoye apres confirmation de la facturation\n\n**Restrictions de securite :**\n- Prend en charge uniquement le protocole HTTPS\n- Les rappels vers des adresses IP de reseau interne sont interdits (127.0.0.1, 10.x.x.x, 172.16-31.x.x, 192.168.x.x, etc.)\n- La longueur de l'URL ne depasse pas `2048` caracteres\n\n**Mecanisme de rappel :**\n- Delai d'expiration : `10` secondes\n- Jusqu'a `3` tentatives apres echec (les tentatives ont lieu respectivement `1` seconde / `2` secondes / `4` secondes apres l'echec)\n- Le format du corps de rappel est identique a celui renvoye par l'interface de requete de tache\n- L'adresse de rappel est consideree comme reussie si elle renvoie un code de statut 2xx ; les autres codes declenchent une nouvelle tentative",
            "format": "uri",
            "example": "https://your-domain.com/webhooks/video-task-completed"
          }
        }
      },
      "VideoGenerationResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "integer",
            "description": "Horodatage de creation de la tache",
            "example": 1757169743
          },
          "id": {
            "type": "string",
            "description": "ID de la tache",
            "example": "task-unified-1757169743-7cvnl5zw"
          },
          "model": {
            "type": "string",
            "description": "Nom du modele reellement utilise",
            "example": "gemini-omni-1.1-flash-reference-to-video"
          },
          "object": {
            "type": "string",
            "enum": [
              "video.generation.task"
            ],
            "description": "Type specifique de la tache"
          },
          "progress": {
            "type": "integer",
            "description": "Pourcentage de progression de la tache (0-100)",
            "minimum": 0,
            "maximum": 100,
            "example": 0
          },
          "status": {
            "type": "string",
            "description": "État de la tâche. L’endpoint de création retourne processing.",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ],
            "example": "processing"
          },
          "task_info": {
            "$ref": "#/components/schemas/VideoTaskInfo",
            "description": "Informations detaillees sur la tache video"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ],
            "description": "Type de sortie de la tache",
            "example": "video"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage",
            "description": "Informations d'usage et de facturation"
          }
        }
      },
      "VideoTaskInfo": {
        "type": "object",
        "properties": {
          "can_cancel": {
            "type": "boolean",
            "description": "Indique si la tache peut etre annulee",
            "example": false
          },
          "estimated_time": {
            "type": "integer",
            "description": "Temps estime avant achevement (secondes)",
            "minimum": 0,
            "example": 60
          },
          "video_duration": {
            "type": "integer",
            "description": "Durée de sortie ; égale à duration.",
            "example": 3
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Informations d'usage et de facturation",
        "properties": {
          "billing_rule": {
            "type": "string",
            "description": "Regle de facturation",
            "enum": [
              "per_call",
              "per_token",
              "per_second"
            ],
            "example": "per_token"
          },
          "credits_reserved": {
            "type": "number",
            "description": "Nombre de credits estimes consommes",
            "minimum": 0,
            "example": 102.34
          },
          "user_group": {
            "type": "string",
            "description": "Groupe de facturation auquel appartient l'utilisateur",
            "example": "default"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Identifiant du code d'erreur"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les interfaces necessitent une authentification par Bearer Token##\n\n**Obtenir une cle API :**\n\nRendez-vous sur la [page de gestion des cles API](https://evolink.ai/dashboard/keys) pour obtenir votre cle API\n\n**Ajoutez ceci dans l'en-tete de la requete lors de l'utilisation :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  }
}
