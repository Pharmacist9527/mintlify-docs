{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Messages — Démarrage rapide",
    "description": "Envoyez votre première requête de chat à Seed avec Messages (Anthropic) en cinq minutes.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommandée)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternative"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "Démarrer une conversation avec Seed via Messages (Anthropic)",
        "description": "- Appelez Seed au format Anthropic Messages depuis des outils compatibles comme Claude Code.\n- Une requête synchrone renvoie directement la réponse.\n- Commencez avec les paramètres essentiels.\n- Modèles pris en charge — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [Référence de l’API](/fr/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-messages-reference)",
        "operationId": "createMessageQuickSeed",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Génération de chat réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié, token invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Quota insuffisant, rechargement nécessaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Accès non autorisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence de requêtes dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Le service du modèle est temporairement indisponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporairement indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Choisir un modèle\n\n| Identifiant du modèle | Usage | Fenêtre de contexte |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Modèle phare recommandé pour le raisonnement complexe, les documents longs et les bases de code | 1 000 000 de tokens |\n| `doubao-seed-2-1-turbo` | Option économique pour le chat, l’extraction et les tâches des agents | 256 000 tokens |\n| `doubao-seed-2-1-lite` | Modèle Seed 2.1 le moins cher. L’entrée audio est disponible uniquement via Chat Completions et Responses | 1 000 000 de tokens |\n| `doubao-seed-evolving` | Mis à jour chaque semaine pour évaluer les nouvelles capacités | 1 000 000 de tokens |\n| `doubao-seed-2.0-pro` | Modèle phare de Seed 2.0 | 256 000 tokens |\n| `doubao-seed-2.0-lite` | Modèle Seed 2.0 léger et rapide | 256 000 tokens |\n| `doubao-seed-2.0-mini` | Le modèle Seed 2.0 le plus rapide pour les tâches simples | 256 000 tokens |\n| `doubao-seed-2.0-code` | Modèle Seed 2.0 spécialisé en programmation | 256 000 tokens |\n\nLes identifiants de Seed 2.1 utilisent un tiret (`2-1`), ceux de Seed 2.0 un point (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "example": 4096,
            "description": "Limite de tokens de sortie, réflexion et réponse comprises. Prévoyez au moins 1024 tokens si la réflexion est activée. Si le budget est épuisé, `stop_reason` vaut `max_tokens` et la réponse peut contenir uniquement la réflexion."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Liste des messages pour la conversation",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            },
            "example": [
              {
                "role": "user",
                "content": "Bonjour ! Présentez-vous en trois phrases."
              }
            ]
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Rôle du message"
          },
          "content": {
            "type": "string",
            "description": "Contenu du message (texte brut)"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de la réponse",
            "example": "0217952345678901234567890abcdef"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ],
            "description": "Vaut toujours `message`."
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Vaut toujours `assistant`."
          },
          "model": {
            "type": "string",
            "description": "Modèle utilisé pour cette requête.",
            "example": "doubao-seed-2-1-pro"
          },
          "content": {
            "type": "array",
            "description": "Blocs de contenu générés. Avec la réflexion activée, un bloc `thinking` précède généralement le bloc `text`. Parcourez les blocs de `type=\"text\"` pour lire la réponse.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/TextBlock"
                },
                {
                  "$ref": "#/components/schemas/ThinkingBlock"
                }
              ]
            },
            "example": [
              {
                "type": "thinking",
                "thinking": "La personne demande une brève présentation…",
                "signature": "EqQBCkgIARABGAIi..."
              },
              {
                "type": "text",
                "text": "Bonjour ! Je suis un modèle de langage Seed, spécialisé en raisonnement, en rédaction et en programmation."
              }
            ]
          },
          "stop_reason": {
            "type": "string",
            "description": "Motif d’arrêt.\n\n- `end_turn` : fin normale\n- `max_tokens` : limite atteinte\n- `stop_sequence` : séquence d’arrêt rencontrée\n- `tool_use` : appel de fonction demandé",
            "enum": [
              "end_turn",
              "max_tokens",
              "stop_sequence",
              "tool_use"
            ],
            "example": "end_turn"
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ],
            "description": "Séquence d’arrêt rencontrée, ou `null` en l’absence de correspondance."
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "TextBlock": {
        "type": "object",
        "title": "Texte",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ],
            "description": "Vaut toujours `text`."
          },
          "text": {
            "type": "string",
            "description": "Contenu texte"
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "title": "Réflexion",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "thinking"
            ],
            "description": "Vaut toujours `thinking`."
          },
          "thinking": {
            "type": "string",
            "description": "Réflexion du modèle. Aux tours suivants, renvoyez-la telle quelle avec sa signature."
          },
          "signature": {
            "type": "string",
            "description": "Signature de la réflexion. Aux tours suivants, conservez la signature, la réflexion et l’ordre des blocs."
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "description": "Statistiques d'utilisation des jetons",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens d’entrée hors cache, sans les `cache_read_input_tokens`.",
            "example": 25
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "Tokens d’entrée facturés au tarif de lecture du cache. Entrée totale = `input_tokens` + `cache_read_input_tokens`.",
            "example": 0
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "Toujours 0. L’écriture en cache n’est pas facturée séparément sur ce point d’entrée.",
            "example": 0
          },
          "output_tokens": {
            "type": "integer",
            "description": "Tokens de sortie, réflexion comprise.",
            "example": 120
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Code d'erreur de statut HTTP"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              },
              "param": {
                "type": "string",
                "description": "Nom du paramètre concerné"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Suggestion pour gérer l'erreur"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les API nécessitent une authentification Bearer Token##\n\n**Obtenir une clé API :**\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "API compatible Anthropic Messages"
    }
  ]
}
