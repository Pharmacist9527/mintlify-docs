{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Chat Completions — Démarrage rapide",
    "description": "Envoyez votre première requête de chat à Seed avec Chat Completions en cinq minutes.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommandée)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternative"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "Démarrer une conversation avec Seed via Chat Completions",
        "description": "- Appelez Seed avec le SDK OpenAI.\n- Une requête synchrone renvoie directement la réponse.\n- Commencez avec les paramètres essentiels.\n- Modèles pris en charge — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [Référence de l’API](/fr/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-reference)",
        "operationId": "createChatCompletionQuickSeed",
        "tags": [
          "Génération de chat"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Génération de chat réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié, token invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Quota insuffisant, rechargement nécessaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Accès non autorisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence de requêtes dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Le service du modèle est temporairement indisponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporairement indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatCompletionQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Choisir un modèle\n\n| Identifiant du modèle | Usage | Fenêtre de contexte |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Modèle phare recommandé pour le raisonnement complexe, les documents longs et les bases de code | 1 000 000 de tokens |\n| `doubao-seed-2-1-turbo` | Option économique pour le chat, l’extraction et les tâches des agents | 256 000 tokens |\n| `doubao-seed-2-1-lite` | Modèle Seed 2.1 le moins cher, avec entrée audio | 1 000 000 de tokens |\n| `doubao-seed-evolving` | Mis à jour chaque semaine pour évaluer les nouvelles capacités | 1 000 000 de tokens |\n| `doubao-seed-2.0-pro` | Modèle phare de Seed 2.0 | 256 000 tokens |\n| `doubao-seed-2.0-lite` | Modèle Seed 2.0 léger et rapide | 256 000 tokens |\n| `doubao-seed-2.0-mini` | Le modèle Seed 2.0 le plus rapide pour les tâches simples | 256 000 tokens |\n| `doubao-seed-2.0-code` | Modèle Seed 2.0 spécialisé en programmation | 256 000 tokens |\n\nLes identifiants de Seed 2.1 utilisent un tiret (`2-1`), ceux de Seed 2.0 un point (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "messages": {
            "type": "array",
            "description": "Liste des messages pour la conversation",
            "items": {
              "$ref": "#/components/schemas/MessageSimple"
            },
            "minItems": 1,
            "example": [
              {
                "role": "user",
                "content": "Bonjour ! Présentez-vous en trois phrases."
              }
            ]
          }
        }
      },
      "MessageSimple": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Rôle du message",
            "enum": [
              "user"
            ]
          },
          "content": {
            "type": "string",
            "description": "Contenu du message (texte brut)"
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique pour la complétion de chat",
            "example": "0217714854126607f5a9cf8ed5b018c76e4ad3dc2810db57ffb50"
          },
          "model": {
            "type": "string",
            "description": "Modèle utilisé pour cette requête.",
            "example": "doubao-seed-2-1-pro"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Type de réponse",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Horodatage de création",
            "example": 1771485416
          },
          "choices": {
            "type": "array",
            "description": "Liste des choix de complétion",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Index de ce choix",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Raison pour laquelle la complétion s'est terminée",
            "enum": [
              "stop",
              "length",
              "content_filter"
            ],
            "example": "stop"
          },
          "moderation_hit_type": {
            "type": "string",
            "nullable": true,
            "description": "Lorsque le texte produit par le modèle contient des informations sensibles, renvoie l'étiquette de classification du risque correspondante\n\n- `severe_violation` : le texte produit par le modèle constitue une infraction grave\n- `violence` : le texte produit par le modèle relève d'un comportement violent",
            "enum": [
              "severe_violation",
              "violence"
            ]
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Rôle de l'expéditeur du message",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": "string",
            "description": "Contenu de la réponse de l'IA",
            "example": "Bonjour ! Je suis un modèle de langage Seed pour le raisonnement, la rédaction, le code et la compréhension multimodale…"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Statistiques d'utilisation des jetons",
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "description": "Nombre de tokens dans l'entrée",
            "example": 15
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Tokens de sortie, réflexion comprise.",
            "example": 256
          },
          "total_tokens": {
            "type": "integer",
            "description": "Nombre total de tokens utilisés",
            "example": 271
          },
          "prompt_tokens_details": {
            "type": "object",
            "description": "Détails des tokens d'entrée",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Nombre de tokens en cache atteints",
                "example": 0
              }
            }
          },
          "completion_tokens_details": {
            "type": "object",
            "description": "Détails des tokens de sortie",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Nombre de tokens de raisonnement / chaîne de raisonnement",
                "example": 0
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Code d'erreur de statut HTTP"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              },
              "param": {
                "type": "string",
                "description": "Nom du paramètre concerné"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Suggestion pour gérer l'erreur"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les API nécessitent une authentification Bearer Token##\n\n**Obtenir une clé API :**\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Génération de chat",
      "description": "APIs liées à la génération de chat IA"
    }
  ]
}
