{
  "openapi": "3.1.0",
  "info": {
    "title": "Seed Responses — Démarrage rapide",
    "description": "Envoyez votre première requête de chat à Seed avec Responses en cinq minutes.",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommandée)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternative"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Démarrer une conversation avec Seed via Responses",
        "description": "- Appelez Seed au format de l’API Responses.\n- Conservez le contexte côté serveur et poursuivez avec `previous_response_id` sans renvoyer l’historique.\n- Commencez avec les paramètres essentiels.\n- Modèles pris en charge — `doubao-seed-2-1-pro`, `doubao-seed-2-1-turbo`, `doubao-seed-2-1-lite`, `doubao-seed-evolving`, `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- [Référence de l’API](/fr/api-manual/language-series/doubao-seed-2.0/doubao-seed-2.0-responses-reference)",
        "operationId": "createResponseQuickSeed",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse générée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié, token invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Quota insuffisant, rechargement nécessaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/credits"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Accès non autorisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2-1-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence de requêtes dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Le service du modèle est temporairement indisponible.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporairement indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Choisir un modèle\n\n| Identifiant du modèle | Usage | Fenêtre de contexte |\n|---|---|---|\n| `doubao-seed-2-1-pro` | Modèle phare recommandé pour le raisonnement complexe, les documents longs et les bases de code | 1 000 000 de tokens |\n| `doubao-seed-2-1-turbo` | Option économique pour le chat, l’extraction et les tâches des agents | 256 000 tokens |\n| `doubao-seed-2-1-lite` | Modèle Seed 2.1 le moins cher, avec entrée audio | 1 000 000 de tokens |\n| `doubao-seed-evolving` | Mis à jour chaque semaine pour évaluer les nouvelles capacités | 1 000 000 de tokens |\n| `doubao-seed-2.0-pro` | Modèle phare de Seed 2.0 | 256 000 tokens |\n| `doubao-seed-2.0-lite` | Modèle Seed 2.0 léger et rapide | 256 000 tokens |\n| `doubao-seed-2.0-mini` | Le modèle Seed 2.0 le plus rapide pour les tâches simples | 256 000 tokens |\n| `doubao-seed-2.0-code` | Modèle Seed 2.0 spécialisé en programmation | 256 000 tokens |\n\nLes identifiants de Seed 2.1 utilisent un tiret (`2-1`), ceux de Seed 2.0 un point (`2.0`).",
            "enum": [
              "doubao-seed-2-1-pro",
              "doubao-seed-2-1-turbo",
              "doubao-seed-2-1-lite",
              "doubao-seed-evolving",
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2-1-pro",
            "example": "doubao-seed-2-1-pro"
          },
          "input": {
            "type": "string",
            "description": "Contenu d'entrée (texte brut), équivalent à un texte saisi avec le rôle user",
            "example": "Bonjour ! Présentez-vous en trois phrases."
          }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de cette réponse",
            "example": "resp_02177148667427813c33c36521378d02b2c8389204fa8c3e2f63e"
          },
          "object": {
            "type": "string",
            "description": "Type d'objet, valeur fixe response",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "number",
            "description": "Horodatage Unix de création (secondes)",
            "example": 1771486674
          },
          "model": {
            "type": "string",
            "description": "Modèle utilisé pour cette requête.",
            "example": "doubao-seed-2-1-pro"
          },
          "status": {
            "type": "string",
            "description": "Statut de la réponse\n\n- `completed` : génération terminée\n- `in_progress` : génération en cours\n- `incomplete` : incomplète\n- `failed` : échec",
            "enum": [
              "completed",
              "in_progress",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "Liste des contenus de sortie du modèle",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Nombre maximal de tokens de sortie du modèle",
            "example": 32768
          },
          "caching": {
            "type": "object",
            "description": "Configuration du cache de cette requête. Avec `type=enabled`, un cache explicite a été écrit et son stockage est facturé.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          },
          "store": {
            "type": "boolean",
            "description": "Indique si la réponse a été stockée",
            "example": true
          },
          "expire_at": {
            "type": "integer",
            "description": "Expiration de la réponse stockée et du cache explicite, en secondes Unix.",
            "example": 1771745874
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Informations d'erreur, null en cas de succès"
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasoningOutput"
          },
          {
            "$ref": "#/components/schemas/MessageOutput"
          },
          {
            "$ref": "#/components/schemas/WebSearchCallOutput"
          }
        ]
      },
      "ReasoningOutput": {
        "title": "Sortie de la chaîne de raisonnement",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de l'élément de sortie",
            "example": "rs_0217****404a"
          },
          "type": {
            "type": "string",
            "description": "Type de sortie, ici reasoning",
            "enum": [
              "reasoning"
            ]
          },
          "summary": {
            "type": "array",
            "description": "Contenu de la chaîne de raisonnement",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Texte du contenu de la chaîne de raisonnement"
                },
                "type": {
                  "type": "string",
                  "description": "Type, valeur fixe summary_text",
                  "enum": [
                    "summary_text"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Statut",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "MessageOutput": {
        "title": "Sortie de message",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de l'élément de sortie",
            "example": "msg_0217****a93c"
          },
          "type": {
            "type": "string",
            "description": "Type de sortie, ici message",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "description": "Rôle, valeur fixe assistant",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "type": "array",
            "description": "Liste des contenus du message",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Contenu texte",
                  "example": "Bonjour ! Ravi de vous rencontrer. Comment puis-je vous aider ?"
                },
                "type": {
                  "type": "string",
                  "description": "Type de contenu",
                  "enum": [
                    "output_text"
                  ]
                },
                "annotations": {
                  "type": "array",
                  "nullable": true,
                  "description": "Informations d'annotation"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Statut",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Statistiques d'utilisation des jetons",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Total des tokens d’entrée, lectures du cache comprises.",
            "example": 88
          },
          "input_tokens_details": {
            "type": "object",
            "description": "Détails des tokens d'entrée",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Tokens d’entrée lus dans le cache et facturés au tarif de lecture.",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Tokens de sortie, réflexion comprise.",
            "example": 230
          },
          "output_tokens_details": {
            "type": "object",
            "description": "Détails des tokens de sortie",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Nombre de tokens de raisonnement / chaîne de raisonnement",
                "example": 211
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Nombre total de tokens utilisés",
            "example": 318
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Code d'erreur de statut HTTP"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              },
              "param": {
                "type": "string",
                "description": "Nom du paramètre concerné"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Suggestion pour gérer l'erreur"
              }
            }
          }
        }
      },
      "WebSearchCallOutput": {
        "title": "Appel de recherche web",
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_call"
            ]
          },
          "id": {
            "type": "string",
            "example": "ws_1"
          },
          "status": {
            "type": "string",
            "example": "completed"
          },
          "action": {
            "type": "object",
            "description": "Action de recherche et requêtes utilisées lors de cet appel.",
            "properties": {
              "type": {
                "type": "string",
                "example": "search"
              },
              "query": {
                "type": "string"
              },
              "queries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les API nécessitent une authentification Bearer Token##\n\n**Obtenir une clé API :**\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Responses API",
      "description": "Interface de génération de chat Responses API"
    }
  ]
}
