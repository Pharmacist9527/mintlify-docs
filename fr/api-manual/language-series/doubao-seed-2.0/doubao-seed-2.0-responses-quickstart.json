{
  "openapi": "3.1.0",
  "info": {
    "title": "Démarrage rapide Doubao Seed 2.0 Responses API",
    "description": "Démarrage rapide de Doubao Seed 2.0 Responses API, effectuez votre premier appel en 5 minutes",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommandée)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternative"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/responses": {
      "post": {
        "summary": "Chat rapide Doubao Seed 2.0 Responses API",
        "description": "- Appel des modèles de la série Doubao Seed 2.0 au format Responses API\n- Prise en charge du stockage du contexte côté serveur, avec des conversations multi-tours via `previous_response_id`\n- Paramètres minimaux, prise en main rapide\n- Modèles pris en charge : `doubao-seed-2.0-pro`, `doubao-seed-2.0-lite`, `doubao-seed-2.0-mini`, `doubao-seed-2.0-code`\n- Besoin de plus de fonctionnalités ? Consultez la [documentation complète des paramètres](./doubao-seed-2.0-responses-reference)",
        "operationId": "createResponseQuickDoubaoSeed20",
        "tags": [
          "Responses API"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponseQuickRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse générée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseObject"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres de requête invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "Invalid request parameters",
                    "type": "invalid_request_error"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Non authentifié, token invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid or expired token",
                    "type": "authentication_error"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Quota insuffisant, rechargement nécessaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "Insufficient quota",
                    "type": "insufficient_quota_error",
                    "fallback_suggestion": "https://evolink.ai/dashboard/billing"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Accès non autorisé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "Access denied for this model",
                    "type": "permission_error",
                    "param": "model"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "Specified model not found",
                    "type": "not_found_error",
                    "param": "model",
                    "fallback_suggestion": "doubao-seed-2.0-pro"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence de requêtes dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "type": "rate_limit_error",
                    "fallback_suggestion": "retry after 60 seconds"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 500,
                    "message": "Internal server error",
                    "type": "internal_server_error",
                    "fallback_suggestion": "try again later"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Erreur du service en amont",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "Upstream AI service unavailable",
                    "type": "upstream_error",
                    "fallback_suggestion": "try different model"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporairement indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "Service temporarily unavailable",
                    "type": "service_unavailable_error",
                    "fallback_suggestion": "retry after 30 seconds"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ResponseQuickRequest": {
        "type": "object",
        "required": [
          "model",
          "input"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nom du modèle de conversation\n\n- `doubao-seed-2.0-pro` : version phare, capacités globales les plus élevées, adaptée au raisonnement complexe et à la génération de haute qualité\n- `doubao-seed-2.0-lite` : version allégée, plus rapide, bon rapport qualité-prix\n- `doubao-seed-2.0-mini` : version ultra-rapide, réponse la plus rapide, adaptée aux tâches simples\n- `doubao-seed-2.0-code` : version spécialisée pour le code, optimisée pour la génération et la compréhension de code",
            "enum": [
              "doubao-seed-2.0-pro",
              "doubao-seed-2.0-lite",
              "doubao-seed-2.0-mini",
              "doubao-seed-2.0-code"
            ],
            "default": "doubao-seed-2.0-pro",
            "example": "doubao-seed-2.0-pro"
          },
          "input": {
            "type": "string",
            "description": "Contenu d'entrée (texte brut), équivalent à un texte saisi avec le rôle user",
            "example": "Bonjour, présentez les nouvelles fonctionnalités de Doubao Seed 2.0"
          }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de cette réponse",
            "example": "resp_02177148667427813c33c36521378d02b2c8389204fa8c3e2f63e"
          },
          "object": {
            "type": "string",
            "description": "Type d'objet, valeur fixe response",
            "enum": [
              "response"
            ],
            "example": "response"
          },
          "created_at": {
            "type": "number",
            "description": "Horodatage Unix de création (secondes)",
            "example": 1771486674
          },
          "model": {
            "type": "string",
            "description": "Nom et version du modèle réellement utilisé",
            "example": "doubao-seed-2-0-code-preview-260215"
          },
          "status": {
            "type": "string",
            "description": "Statut de la réponse\n\n- `completed` : génération terminée\n- `in_progress` : génération en cours\n- `incomplete` : incomplète\n- `failed` : échec",
            "enum": [
              "completed",
              "in_progress",
              "incomplete",
              "failed"
            ],
            "example": "completed"
          },
          "output": {
            "type": "array",
            "description": "Liste des contenus de sortie du modèle",
            "items": {
              "$ref": "#/components/schemas/OutputItem"
            }
          },
          "service_tier": {
            "type": "string",
            "description": "Niveau de service de cette requête",
            "example": "default"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "max_output_tokens": {
            "type": "integer",
            "description": "Nombre maximal de tokens de sortie du modèle",
            "example": 32768
          },
          "caching": {
            "type": "object",
            "description": "Configuration du cache",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "enabled",
                  "disabled"
                ]
              }
            }
          },
          "store": {
            "type": "boolean",
            "description": "Indique si la réponse a été stockée",
            "example": true
          },
          "expire_at": {
            "type": "integer",
            "description": "Date d'expiration du stockage (horodatage Unix)",
            "example": 1771745874
          },
          "error": {
            "type": "object",
            "nullable": true,
            "description": "Informations d'erreur, null en cas de succès"
          }
        }
      },
      "OutputItem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ReasoningOutput"
          },
          {
            "$ref": "#/components/schemas/MessageOutput"
          }
        ]
      },
      "ReasoningOutput": {
        "title": "Sortie de la chaîne de raisonnement",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de l'élément de sortie",
            "example": "rs_0217****404a"
          },
          "type": {
            "type": "string",
            "description": "Type de sortie, ici reasoning",
            "enum": [
              "reasoning"
            ]
          },
          "summary": {
            "type": "array",
            "description": "Contenu de la chaîne de raisonnement",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Texte du contenu de la chaîne de raisonnement"
                },
                "type": {
                  "type": "string",
                  "description": "Type, valeur fixe summary_text",
                  "enum": [
                    "summary_text"
                  ]
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Statut",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "MessageOutput": {
        "title": "Sortie de message",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID de l'élément de sortie",
            "example": "msg_0217****a93c"
          },
          "type": {
            "type": "string",
            "description": "Type de sortie, ici message",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "description": "Rôle, valeur fixe assistant",
            "enum": [
              "assistant"
            ]
          },
          "content": {
            "type": "array",
            "description": "Liste des contenus du message",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Contenu texte",
                  "example": "Bonjour ! Ravi de vous rencontrer. Comment puis-je vous aider ?"
                },
                "type": {
                  "type": "string",
                  "description": "Type de contenu",
                  "enum": [
                    "output_text"
                  ]
                },
                "annotations": {
                  "type": "array",
                  "nullable": true,
                  "description": "Informations d'annotation"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "description": "Statut",
            "enum": [
              "in_progress",
              "completed",
              "incomplete"
            ],
            "example": "completed"
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Statistiques d'utilisation des jetons",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Nombre de tokens d'entrée",
            "example": 88
          },
          "input_tokens_details": {
            "type": "object",
            "description": "Détails des tokens d'entrée",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Nombre de tokens en cache",
                "example": 0
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "description": "Nombre de tokens de sortie",
            "example": 230
          },
          "output_tokens_details": {
            "type": "object",
            "description": "Détails des tokens de sortie",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Nombre de tokens de raisonnement / chaîne de raisonnement",
                "example": 211
              }
            }
          },
          "total_tokens": {
            "type": "integer",
            "description": "Nombre total de tokens utilisés",
            "example": 318
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Code d'erreur de statut HTTP"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              },
              "param": {
                "type": "string",
                "description": "Nom du paramètre concerné"
              },
              "fallback_suggestion": {
                "type": "string",
                "description": "Suggestion pour gérer l'erreur"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les API nécessitent une authentification Bearer Token##\n\n**Obtenir une clé API :**\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Responses API",
      "description": "Interface de génération de chat Responses API"
    }
  ]
}
