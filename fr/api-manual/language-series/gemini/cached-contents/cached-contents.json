                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1beta/cachedContents/{id}": {
      "get": {
        "summary": "Consulter un cache",
        "operationId": "geminiGetCachedContent",
        "tags": [
          "Cache explicite du contexte"
        ],
        "description": "Renvoie les métadonnées (modèle, nombre de tokens, dates de création/modification/expiration), sans le contenu. Un cache expiré renvoie 404, comme un cache absent. Gratuit.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identifiant du cache : le `name` renvoyé à la création, sans le préfixe `cachedContents/`. Pour `cachedContents/20261103012026348092000s1oTuB96`, utilisez ici `20261103012026348092000s1oTuB96`.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Métadonnées du cache",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CachedContent"
                },
                "example": {
                  "name": "cachedContents/20261103012026348092000s1oTuB96",
                  "model": "models/gemini-3.8-flash",
                  "displayName": "product-manual-v3",
                  "createTime": "2026-11-03T01:20:27.311Z",
                  "updateTime": "2026-11-03T01:20:27.311Z",
                  "expireTime": "2026-11-03T02:20:26.902Z",
                  "usageMetadata": {
                    "totalTokenCount": 7525
                  }
                }
              }
            }
          },
          "401": {
            "description": "Clé API absente ou invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "403": {
            "description": "La clé n’a pas accès au modèle ou l’IP source n’est pas autorisée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cache absent, expiré, supprimé ou appartenant à un autre compte ; ou cache explicite non activé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service temporairement indisponible ; réessayez plus tard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "explicit context caching is temporarily unavailable",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INTERNAL",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Prolonger ou réduire la durée",
        "operationId": "geminiUpdateCachedContent",
        "tags": [
          "Cache explicite du contexte"
        ],
        "description": "Seule la durée est modifiable, pas le contenu. Fournissez soit `ttl` (nouvelle durée à partir de **maintenant**, par exemple `\"7200s\"`), soit `expireTime` (nouvelle date d’expiration absolue).\n\n- L’expiration doit se situer entre 60 secondes et 168 heures à partir de maintenant.\n- Seul `ttl` ou `expireTime` est accepté ; fournir les deux ou d’autres champs renvoie 400.\n- **Prolongation** : stockage facturé sur la durée ajoutée, en secondes ; toute durée inférieure à 1 seconde est facturée comme 1 seconde. **Réduction** : aucun remboursement du stockage déjà facturé.\n- Opération payante : la clé doit avoir accès au modèle ; le tarif de son groupe actuel s’applique. Un solde insuffisant renvoie 402.\n- Pour réessayer la même prolongation sans double facturation, utilisez l’en-tête `Idempotency-Key`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identifiant du cache : le `name` renvoyé à la création, sans le préfixe `cachedContents/`. Pour `cachedContents/20261103012026348092000s1oTuB96`, utilisez ici `20261103012026348092000s1oTuB96`.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCachedContentRequest"
              },
              "examples": {
                "extend_by_ttl": {
                  "summary": "Conserver encore 2 heures à partir de maintenant",
                  "value": {
                    "ttl": "7200s"
                  }
                },
                "set_expire_time": {
                  "summary": "Définir une expiration absolue",
                  "value": {
                    "expireTime": "2026-11-03T06:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Métadonnées mises à jour ; `expireTime` est la nouvelle expiration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CachedContent"
                },
                "example": {
                  "name": "cachedContents/20261103012026348092000s1oTuB96",
                  "model": "models/gemini-3.8-flash",
                  "displayName": "product-manual-v3",
                  "createTime": "2026-11-03T01:20:27.311Z",
                  "updateTime": "2026-11-03T01:35:10.020Z",
                  "expireTime": "2026-11-03T03:35:10.000Z",
                  "usageMetadata": {
                    "totalTokenCount": 7525
                  }
                }
              }
            }
          },
          "400": {
            "description": "ttl / expireTime absent ou tous deux fournis ; autres champs transmis ; expiration hors limites ; cache expiré pendant le traitement (CACHE_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 400,
                    "message": "new expiry must be at least 60s in the future",
                    "status": "INVALID_ARGUMENT",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INVALID_ARGUMENT",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Clé API absente ou invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "402": {
            "description": "Solde insuffisant pour le stockage supplémentaire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 402,
                    "message": "insufficient quota for cache storage extension",
                    "status": "RESOURCE_EXHAUSTED",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "INSUFFICIENT_QUOTA",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "La clé n’a pas accès au modèle, l’IP source n’est pas autorisée ou le groupe de la clé n’est plus disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cache absent, expiré, supprimé ou appartenant à un autre compte ; ou cache explicite non activé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "502": {
            "description": "Service temporairement indisponible. Cette requête n’est pas facturée ; réessayez plus tard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 502,
                    "message": "failed to reach upstream for cachedContents",
                    "status": "INTERNAL",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "UPSTREAM_ERROR",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "503": {
            "description": "Cache temporairement indisponible ; réessayez plus tard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "the channel holding this cached content is unavailable and rebuilding on another channel failed; please retry later",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_CHANNEL_UNAVAILABLE",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Supprimer un cache",
        "operationId": "geminiDeleteCachedContent",
        "tags": [
          "Cache explicite du contexte"
        ],
        "description": "Supprime immédiatement le cache. Toute référence ultérieure à son nom renvoie 404. Le stockage déjà facturé n’est pas remboursé. Gratuit.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identifiant du cache : le `name` renvoyé à la création, sans le préfixe `cachedContents/`. Pour `cachedContents/20261103012026348092000s1oTuB96`, utilisez ici `20261103012026348092000s1oTuB96`.",
            "schema": {
              "type": "string",
              "example": "20261103012026348092000s1oTuB96"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Supprimé ; renvoie un objet vide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "401": {
            "description": "Clé API absente ou invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 401,
                    "message": "Invalid API key",
                    "status": "UNAUTHENTICATED"
                  }
                }
              }
            }
          },
          "403": {
            "description": "La clé n’a pas accès au modèle ou l’IP source n’est pas autorisée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 403,
                    "message": "This key is not allowed to use model gemini-3.8-flash",
                    "status": "PERMISSION_DENIED"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cache absent, expiré, supprimé ou appartenant à un autre compte ; ou cache explicite non activé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 404,
                    "message": "cached content not found",
                    "status": "NOT_FOUND",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_NOT_FOUND",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          },
          "429": {
            "description": "Limite de fréquence dépassée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 429,
                    "message": "Rate limit exceeded",
                    "status": "RESOURCE_EXHAUSTED"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Cache temporairement indisponible ; réessayez plus tard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": 503,
                    "message": "the channel holding this cached content is unavailable and rebuilding on another channel failed; please retry later",
                    "status": "UNAVAILABLE",
                    "details": [
                      {
                        "@type": "type.googleapis.com/google.rpc.ErrorInfo",
                        "reason": "CACHE_CHANNEL_UNAVAILABLE",
                        "domain": "evolink.ai"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "## Tous les endpoints nécessitent une authentification Bearer Token\n\n**Obtenir une clé API :**\n\nConsultez la [gestion des clés API](https://evolink.ai/dashboard/keys).\n\n**Ajoutez cet en-tête :**\n```\nAuthorization: Bearer YOUR_API_KEY\n```\n\nLe format natif Gemini est aussi accepté : en-tête `x-goog-api-key: YOUR_API_KEY` ou paramètre URL `?key=YOUR_API_KEY`."
      }
    },
    "schemas": {
      "Part": {
        "type": "object",
        "description": "Partie de contenu : texte, données intégrées (base64) ou référence de fichier, au choix",
        "properties": {
          "text": {
            "type": "string",
            "description": "Texte"
          },
          "inlineData": {
            "type": "object",
            "description": "Données binaires intégrées (images, audio, PDF, etc.)",
            "properties": {
              "mimeType": {
                "type": "string",
                "example": "application/pdf"
              },
              "data": {
                "type": "string",
                "description": "Données encodées en base64"
              }
            }
          },
          "fileData": {
            "type": "object",
            "description": "Référence de fichier",
            "properties": {
              "mimeType": {
                "type": "string"
              },
              "fileUri": {
                "type": "string",
                "description": "URL accessible publiquement"
              }
            }
          }
        }
      },
      "Content": {
        "type": "object",
        "required": [
          "parts"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "model"
            ],
            "description": "Rôle ; inutile pour les instructions système"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        }
      },
      "Tool": {
        "type": "object",
        "description": "Déclarations d’outils. Seuls les trois types suivants sont acceptés ; les autres sont rejetés",
        "properties": {
          "googleSearch": {
            "type": "object",
            "description": "Recherche web ; fournir `{}`"
          },
          "codeExecution": {
            "type": "object",
            "description": "Exécution de code ; fournir `{}`"
          },
          "functionDeclarations": {
            "type": "array",
            "description": "Déclarations de fonctions (paramètres suivant un sous-ensemble d’OpenAPI)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parameters": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "CreateCachedContentRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Modèle ; `models/gemini-3.8-flash` et `gemini-3.8-flash` sont acceptés. Modèles pris en charge : `gemini-3.8-flash`, `gemini-3.7-flash`, `gemini-3.6-flash`, `gemini-3.5-flash`, `gemini-3.5-flash-lite`, `gemini-3-flash-preview`, `gemini-3.1-flash-lite-preview`, `gemini-3.1-pro-preview`, `gemini-3.1-pro-preview-customtools`, `gemini-3-pro-preview`",
            "example": "models/gemini-3.8-flash"
          },
          "contents": {
            "type": "array",
            "description": "Contenu de conversation à mettre en cache, obligatoirement un tableau. Il devient le préfixe lors de l’utilisation du cache. Fournissez au moins un des champs `contents`, `systemInstruction` ou `tools`",
            "items": {
              "$ref": "#/components/schemas/Content"
            }
          },
          "systemInstruction": {
            "$ref": "#/components/schemas/Content",
            "description": "Instructions système. Une fois mises en cache, systemInstruction ne doit plus figurer dans les requêtes de génération utilisant ce cache"
          },
          "tools": {
            "type": "array",
            "description": "Déclarations d’outils. Une fois mises en cache, tools ne doit plus figurer dans les requêtes de génération utilisant ce cache",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "toolConfig": {
            "type": "object",
            "description": "Configuration des appels d’outils (par exemple functionCallingConfig). Une fois mise en cache, toolConfig ne doit plus figurer dans les requêtes de génération utilisant ce cache"
          },
          "ttl": {
            "type": "string",
            "description": "Durée, par exemple `\"3600s\"`. Minimum `60s`, maximum `604800s` (168 heures). Mutuellement exclusif avec expireTime ; les deux renvoient 400. Sans les deux, valeur par défaut `3600s`",
            "example": "3600s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration absolue (RFC 3339, UTC), mutuellement exclusive avec ttl ; les deux renvoient 400",
            "example": "2026-11-03T06:00:00Z"
          },
          "displayName": {
            "type": "string",
            "maxLength": 255,
            "description": "Nom pour votre usage, 255 caractères maximum ; sans effet sur la facturation",
            "example": "product-manual-v3"
          }
        }
      },
      "UpdateCachedContentRequest": {
        "type": "object",
        "description": "Fournissez exactement un des champs ttl ou expireTime ; les autres champs renvoient 400",
        "properties": {
          "ttl": {
            "type": "string",
            "description": "Nouvelle durée à partir de maintenant, par exemple `\"7200s\"`. Minimum `60s`, maximum `604800s`",
            "example": "7200s"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Nouvelle expiration absolue (RFC 3339, UTC)",
            "example": "2026-11-03T06:00:00Z"
          }
        }
      },
      "CachedContent": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom au format `cachedContents/<id>`. À utiliser dans `cachedContent` des requêtes de génération ; `<id>` est aussi l’identifiant de la requête de création",
            "example": "cachedContents/20261103012026348092000s1oTuB96"
          },
          "model": {
            "type": "string",
            "description": "Modèle lié au cache ; la génération doit utiliser le même modèle",
            "example": "models/gemini-3.8-flash"
          },
          "displayName": {
            "type": "string",
            "description": "Nom fourni à la création ; absent si aucun nom n’a été fourni"
          },
          "createTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date de création (UTC)"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date de dernière modification (UTC)"
          },
          "expireTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date d’expiration (UTC) ; suppression automatique à expiration"
          },
          "usageMetadata": {
            "type": "object",
            "properties": {
              "totalTokenCount": {
                "type": "integer",
                "description": "Total des tokens en cache, utilisé pour les frais d’écriture et de stockage",
                "example": 7525
              }
            }
          }
        }
      },
      "ListCachedContentsResponse": {
        "type": "object",
        "properties": {
          "cachedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CachedContent"
            }
          },
          "nextPageToken": {
            "type": "string",
            "description": "Présent si une autre page existe ; à transmettre sans modification comme `pageToken` dans la requête suivante"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Format d’erreur natif Gemini. `error.details[0].reason` contient le code précis ; voir le tableau d’erreurs de « Créer un cache »",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Code de statut HTTP"
              },
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "description": "Valeur de statut, par exemple INVALID_ARGUMENT / NOT_FOUND / UNAVAILABLE"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "@type": {
                      "type": "string",
                      "example": "type.googleapis.com/google.rpc.ErrorInfo"
                    },
                    "reason": {
                      "type": "string",
                      "example": "CACHE_NOT_FOUND"
                    },
                    "domain": {
                      "type": "string",
                      "example": "evolink.ai"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
