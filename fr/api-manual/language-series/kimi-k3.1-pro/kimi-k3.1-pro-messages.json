{
  "openapi": "3.1.0",
  "info": {
    "title": "Kimi K3.1 Pro / Highspeed - API compatible Anthropic",
    "description": "Prend en charge kimi-k3.1-pro et kimi-k3.1-pro-highspeed avec une fenêtre de contexte de 1 048 576 tokens. Les deux modèles raisonnent toujours ; niveaux natifs : low / high / max, par défaut : max.\n\nPrend en charge l’historique multi-tours, SSE, les outils de fonction, la recherche web, JSON Schema strict et le cache de contexte 5m / 1h. Paramètres d’échantillonnage fixes : temperature=1, top_p=0.95, n=1, presence_penalty=frequency_penalty=0. Il est inutile de les transmettre.\n\n[Modèles, tarifs et guide d’utilisation](/fr/api-manual/language-series/kimi-k3.1-pro/kimi-k3.1-pro-overview).",
    "license": {
      "name": "MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://direct.evolink.ai",
      "description": "Production (recommandée)"
    },
    {
      "url": "https://api.evolink.ai",
      "description": "URL alternative"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/messages": {
      "post": {
        "summary": "API Messages Kimi K3.1 Pro / Highspeed",
        "description": "Point de terminaison public : POST /v1/messages. Définissez l’effort dans output_config.effort et le TTL d’écriture 5m/1h dans cache_control au premier niveau. Conservez intégralement thinking, signature, tool_use et les blocs de résultats de recherche du serveur.",
        "operationId": "createMessageKimiK31Pro",
        "tags": [
          "Messages"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              },
              "examples": {
                "simple": {
                  "summary": "Requête Pro minimale",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "highspeed": {
                  "summary": "Requête Highspeed minimale",
                  "value": {
                    "model": "kimi-k3.1-pro-highspeed",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ]
                  }
                },
                "streaming": {
                  "summary": "Streaming SSE Anthropic",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "stream": true
                  }
                },
                "cache_1h": {
                  "summary": "Cache 1h au premier niveau",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Reply with OK."
                      }
                    ],
                    "cache_control": {
                      "type": "ephemeral",
                      "ttl": "1h"
                    }
                  }
                },
                "web_search": {
                  "summary": "Recherche web côté serveur",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low"
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Use web search to find the official Kimi homepage URL."
                      }
                    ],
                    "tools": [
                      {
                        "type": "web_search_20250305",
                        "name": "web_search",
                        "max_uses": 1
                      }
                    ]
                  }
                },
                "structured_output": {
                  "summary": "Sortie structurée stricte",
                  "value": {
                    "model": "kimi-k3.1-pro",
                    "max_tokens": 1024,
                    "output_config": {
                      "effort": "low",
                      "format": {
                        "type": "json_schema",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "result": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "result"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "messages": [
                      {
                        "role": "user",
                        "content": "Return a JSON object with result equal to OK."
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Réponse Message ; les requêtes en streaming renvoient un flux d'événements Anthropic SSE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "La séquence d'événements comprend généralement message_start, content_block_*, message_delta et message_stop."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kimi-k3.1-pro",
              "kimi-k3.1-pro-highspeed"
            ],
            "default": "kimi-k3.1-pro",
            "description": "Pro et Highspeed partagent les points de terminaison et les paramètres. Les tarifs d’entrée, de sortie et d’écriture en cache diffèrent ; le tarif de lecture du cache est identique."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "Nombre maximal de tokens autorisés pour cette génération, y compris thinking et le texte final.",
            "maximum": 1048576
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Liste de messages Anthropic Messages. Pour une conversation multi-tour, renvoyez les blocs de contenu assistant complets sans modification.",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "system": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessagesTextBlockParam"
                }
              }
            ],
            "description": "Prompt système sous forme de chaîne ou de tableau de blocs text."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Indique si un flux d'événements Anthropic SSE est renvoyé."
          },
          "tools": {
            "type": "array",
            "description": "Fonctions personnalisées ou recherche web côté serveur. La recherche intégrée utilise type=web_search_20250305 et name=web_search ; facturation par appel effectué.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Tool"
                },
                {
                  "$ref": "#/components/schemas/WebSearchTool"
                }
              ]
            }
          },
          "tool_choice": {
            "$ref": "#/components/schemas/ToolChoice"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "description": "ID stable d’utilisateur final ou de session pour le cache et la détection d’abus. Utilisez une valeur hachée sans données personnelles identifiables. Pour les agents de code, gardez le même ID pendant la session."
              }
            }
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "description": "Séquences d’arrêt : une correspondance exacte arrête la génération et est exclue de la sortie. Au plus 5 séquences, de 32 octets maximum chacune."
          },
          "cache_control": {
            "type": "object",
            "description": "Seul cache_control au premier niveau contrôle le TTL d’écriture ; les marqueurs dans les blocs de message ne le remplacent pas. Par défaut : 5m.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ephemeral"
                ],
                "description": "Type de cache, toujours ephemeral."
              },
              "ttl": {
                "type": "string",
                "enum": [
                  "5m",
                  "1h"
                ],
                "default": "5m",
                "description": "TTL d’écriture du cache. Les caches 5m et 1h sont indépendants. Un accès au même préfixe pendant la validité renouvelle le cache avec son TTL initial."
              }
            },
            "required": [
              "type"
            ]
          },
          "output_config": {
            "type": "object",
            "description": "Configuration de sortie : effort de raisonnement et sortie structurée.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "high",
                  "max",
                  "medium",
                  "xhigh",
                  "minimal",
                  "none"
                ],
                "default": "max",
                "description": "Effort de raisonnement : low / high / max recommandés ; par défaut : max. Le raisonnement reste actif. Alias clients : medium devient high, xhigh devient max, minimal / none devient low. none ne désactive pas le raisonnement. Un effort supérieur augmente généralement les tokens de raisonnement et la latence. Ces tokens comptent dans la sortie."
              },
              "format": {
                "type": "object",
                "description": "Sortie structurée. Si défini, le modèle renvoie du JSON respectant strictement le JSON Schema fourni.",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "json_schema"
                    ]
                  },
                  "schema": {
                    "type": "object",
                    "description": "JSON Schema que la sortie doit respecter.",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "type",
                  "schema"
                ]
              }
            }
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "description": "Rôle du message. Seuls user et assistant sont pris en charge.",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "description": "Contenu du message sous forme de texte brut ou de tableau de blocs de contenu Anthropic.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentBlock"
                }
              }
            ]
          }
        }
      },
      "ContentBlock": {
        "description": "Bloc de contenu Anthropic pour le texte, l'image, le raisonnement, l'appel d'outil ou le résultat d'outil.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/TextBlock"
          },
          {
            "$ref": "#/components/schemas/ImageBlock"
          },
          {
            "$ref": "#/components/schemas/ThinkingBlock"
          },
          {
            "$ref": "#/components/schemas/ToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/ToolResultBlock"
          },
          {
            "$ref": "#/components/schemas/ServerToolUseBlock"
          },
          {
            "$ref": "#/components/schemas/WebSearchResultBlock"
          }
        ]
      },
      "TextBlock": {
        "type": "object",
        "required": [
          "type",
          "text"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type de bloc de contenu. Valeur fixe : text.",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string",
            "description": "Contenu textuel."
          }
        }
      },
      "ImageBlock": {
        "type": "object",
        "required": [
          "type",
          "source"
        ],
        "description": "Bloc de contenu image (entrée multimodale).",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image"
            ],
            "description": "Type de bloc de contenu. Valeur fixe : image."
          },
          "source": {
            "type": "object",
            "required": [
              "type"
            ],
            "description": "Source de l'image.",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "base64",
                  "url"
                ],
                "description": "Type de source : `base64` pour un encodage en ligne, ou `url` pour un lien."
              },
              "media_type": {
                "type": "string",
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/gif",
                  "image/webp"
                ],
                "description": "Type MIME de l'image lorsque `type=base64`."
              },
              "data": {
                "type": "string",
                "description": "Données Base64 de l'image lorsque `type=base64` (sans le préfixe `data:`)."
              },
              "url": {
                "type": "string",
                "description": "Adresse de l'image lorsque `type=url` ; prend aussi en charge la référence de fichier Kimi `ms://<file_id>`."
              }
            }
          }
        }
      },
      "ThinkingBlock": {
        "type": "object",
        "required": [
          "type",
          "thinking"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type de bloc de contenu. Valeur fixe : thinking.",
            "enum": [
              "thinking"
            ]
          },
          "thinking": {
            "type": "string",
            "description": "Contenu de raisonnement du modèle. Renvoyez-le sans modification avec la signature dans les conversations multi-tours."
          },
          "signature": {
            "type": "string",
            "description": "Pour une conversation multi-tour, renvoyez cette valeur sans modification avec le bloc thinking."
          }
        }
      },
      "ToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type de bloc de contenu. Valeur fixe : tool_use.",
            "enum": [
              "tool_use"
            ]
          },
          "id": {
            "type": "string",
            "description": "ID tool_use référencé lors du renvoi du résultat."
          },
          "name": {
            "type": "string",
            "description": "Nom de l'outil demandé par le modèle."
          },
          "input": {
            "type": "object",
            "additionalProperties": true,
            "description": "Objet d'entrée d'outil généré par le modèle."
          }
        }
      },
      "ToolResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Type de bloc de contenu. Valeur fixe : tool_result.",
            "enum": [
              "tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string",
            "description": "ID du bloc tool_use correspondant."
          },
          "content": {
            "type": "string",
            "description": "Résultat de l'exécution de l'outil."
          },
          "is_error": {
            "type": "boolean",
            "default": false,
            "description": "Indique si l'exécution de l'outil a échoué."
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "name",
          "input_schema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom de l'outil."
          },
          "description": {
            "type": "string",
            "description": "Description aidant le modèle à décider quand utiliser l'outil."
          },
          "input_schema": {
            "type": "object",
            "additionalProperties": true,
            "description": "Définition des paramètres de l'outil au format JSON Schema."
          }
        }
      },
      "ToolChoice": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Stratégie de sélection : auto laisse le modèle décider, any impose un outil et tool impose l'outil nommé.",
            "enum": [
              "auto",
              "any",
              "tool"
            ]
          },
          "name": {
            "type": "string",
            "description": "Nom de l'outil à appeler lorsque type=tool."
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "message"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ]
          },
          "model": {
            "type": "string",
            "example": "kimi-k3.1-pro"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentBlock"
            }
          },
          "stop_reason": {
            "type": "string",
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use"
            ]
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "$ref": "#/components/schemas/MessageUsage"
          }
        }
      },
      "MessageUsage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer",
            "description": "Tokens d’entrée ordinaires, hors lectures et écritures du cache. Les trois catégories sont disjointes ; ne soustrayez pas à nouveau les tokens du cache."
          },
          "cache_creation_input_tokens": {
            "type": "integer",
            "description": "Tokens d'entrée écrits dans le cache."
          },
          "cache_read_input_tokens": {
            "type": "integer",
            "description": "Tokens d'entrée servis depuis le cache."
          },
          "output_tokens": {
            "type": "integer",
            "description": "Tokens de sortie, y compris les tokens thinking."
          },
          "output_tokens_details": {
            "type": "object",
            "properties": {
              "thinking_tokens": {
                "type": "integer"
              }
            }
          },
          "cache_creation": {
            "type": "object",
            "properties": {
              "ephemeral_5m_input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "ephemeral_1h_input_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "Les deux sous-catégories d’écriture de cache_creation_input_tokens, facturées selon leur TTL réel."
          },
          "server_tool_use": {
            "type": "object",
            "properties": {
              "web_search_requests": {
                "type": "integer",
                "minimum": 0
              }
            },
            "description": "Le fournisseur peut omettre le récapitulatif du nombre de recherches. Les résultats de recherche réussis restent facturés selon le nombre réel de recherches."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "WebSearchTool": {
        "type": "object",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_20250305"
            ]
          },
          "name": {
            "type": "string",
            "enum": [
              "web_search"
            ]
          },
          "max_uses": {
            "type": "integer",
            "minimum": 1,
            "description": "Nombre maximal de recherches autorisées pour cette réponse."
          }
        }
      },
      "ServerToolUseBlock": {
        "type": "object",
        "required": [
          "type",
          "id",
          "name",
          "input"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "server_tool_use"
            ]
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "WebSearchResultBlock": {
        "type": "object",
        "required": [
          "type",
          "tool_use_id",
          "content"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "web_search_tool_result"
            ]
          },
          "tool_use_id": {
            "type": "string"
          },
          "content": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              {
                "type": "object",
                "additionalProperties": true,
                "description": "Objet d’erreur de recherche, type=web_search_tool_result_error."
              }
            ]
          }
        }
      },
      "MessagesTextBlockParam": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Paramètres de requête invalides",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "La clé API est absente ou invalide",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Limite de débit dépassée ou quota insuffisant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Erreur interne du service",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "##Toutes les API nécessitent une authentification Bearer Token##\n\n**Obtenir une clé API** :\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête** :\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Messages",
      "description": "API compatible Anthropic Messages"
    }
  ]
}
