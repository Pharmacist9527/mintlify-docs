  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Nom du modèle de conversation",
            "enum": [
              "MiniMax-M3.1-Flash"
            ],
            "example": "MiniMax-M3.1-Flash"
          },
          "messages": {
            "type": "array",
            "description": "Liste des messages de la conversation, prend en charge le dialogue multi-tours\n\nLes messages de rôles différents ont des structures de champs différentes ; sélectionnez le rôle correspondant pour le consulter",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SystemMessage"
                },
                {
                  "$ref": "#/components/schemas/UserMessage"
                },
                {
                  "$ref": "#/components/schemas/AssistantRequestMessage"
                },
                {
                  "$ref": "#/components/schemas/ToolMessage"
                }
              ],
              "discriminator": {
                "propertyName": "role",
                "mapping": {
                  "system": "#/components/schemas/SystemMessage",
                  "user": "#/components/schemas/UserMessage",
                  "assistant": "#/components/schemas/AssistantRequestMessage",
                  "tool": "#/components/schemas/ToolMessage"
                }
              }
            },
            "minItems": 1
          },
          "reasoning_effort": {
            "type": "string",
            "description": "Profondeur du raisonnement, valeur par défaut : `max`. Les niveaux plus élevés augmentent généralement la consommation de tokens de raisonnement et le temps de réponse.",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "default": "max",
            "example": "high"
          },
          "thinking": {
            "type": "object",
            "description": "Mode de raisonnement. MiniMax-M3.1-Flash effectue toujours un raisonnement. Seule la valeur `adaptive` est prise en charge ; ce champ peut être omis",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "adaptive"
                ],
                "default": "adaptive"
              }
            }
          },
          "reasoning_split": {
            "type": "boolean",
            "description": "Indique si le contenu du raisonnement est renvoyé séparément. Seule la valeur `true` est prise en charge ; le contenu est renvoyé dans `reasoning_content`. Ce champ peut être omis",
            "enum": [
              true
            ],
            "default": true
          },
          "temperature": {
            "type": "number",
            "description": "Température d’échantillonnage, qui contrôle le caractère aléatoire de la sortie\n\n**Remarques** :\n- Plage : `[0, 2]`, valeur par défaut : 1\n- Les valeurs plus faibles produisent des résultats plus déterministes ; les valeurs plus élevées, des résultats plus variés\n\n**Recommandation** : ne modifiez pas simultanément temperature et top_p",
            "minimum": 0,
            "maximum": 2,
            "default": 1,
            "example": 1
          },
          "top_p": {
            "type": "number",
            "description": "Paramètre d’échantillonnage par noyau (Nucleus Sampling)\n\n**Remarques** :\n- Détermine la probabilité cumulée des tokens parmi lesquels effectuer l’échantillonnage\n- Par exemple, 0.95 sélectionne les tokens dont la probabilité cumulée atteint 95%\n- Plage : `[0, 1]`, valeur par défaut : 0.95\n\n**Recommandation** : ne modifiez pas simultanément temperature et top_p",
            "minimum": 0,
            "maximum": 1,
            "default": 0.95,
            "example": 0.95
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Longueur maximale du contenu généré en tokens, **raisonnement et réponse inclus**\n\n**Remarques** :\n- Valeur recommandée : **131,072** (128K), maximum : **524,288** (512K)\n- Une valeur trop faible peut atteindre la limite pendant le raisonnement. Dans ce cas, la réponse contient `finish_reason=length` avec un `content` vide",
            "minimum": 1,
            "maximum": 524288,
            "example": 131072
          },
          "stream": {
            "type": "boolean",
            "description": "Indique s'il faut renvoyer la réponse en mode streaming\n\n- `true` : réponse en streaming, renvoie le contenu en temps réel par blocs via SSE (Server-Sent Events)\n- `false` : attend la réponse complète avant de la renvoyer (par défaut)",
            "default": false,
            "example": false
          },
          "stream_options": {
            "type": "object",
            "description": "Options de réponse en streaming\n\nN'a d'effet que lorsque `stream=true`",
            "properties": {
              "include_usage": {
                "type": "boolean",
                "description": "Indique si un bloc de données supplémentaire contenant uniquement les statistiques `usage` est renvoyé avant la fin du flux"
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "Liste de définitions d'outils pour le Function Calling\n\nChaque outil requiert un nom, une description et un schéma de paramètres",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          },
          "tool_choice": {
            "type": "string",
            "description": "Stratégie de sélection des outils. Seule la valeur `auto` est prise en charge ; le modèle décide s’il doit appeler un outil",
            "enum": [
              "auto"
            ],
            "default": "auto"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Ancien paramètre de limite de longueur de génération\n\n**Remarque** : obsolète, veuillez utiliser `max_completion_tokens` à la place",
            "deprecated": true,
            "minimum": 1
          },
          "n": {
            "type": "integer",
            "description": "Nombre de réponses générées ; seule la valeur `1` est prise en charge",
            "enum": [
              1
            ],
            "default": 1
          }
        }
      },
      "SystemMessage": {
        "title": "System Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system"
            ],
            "description": "Identifiant de rôle, fixé à `system`"
          },
          "content": {
            "type": "string",
            "description": "Contenu de l'invite système, utilisé pour définir le rôle et le comportement de l'IA"
          },
          "name": {
            "type": "string",
            "description": "Nom du participant, utilisé pour distinguer les différentes sources d'invites système"
          }
        }
      },
      "UserMessage": {
        "title": "User Message",
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user"
            ],
            "description": "Identifiant de rôle, fixé à `user`"
          },
          "content": {
            "description": "Contenu du message utilisateur\n\n**Remarques** :\n- Pour du texte brut, transmettez directement une chaîne\n- Pour une entrée multimodale, transmettez un tableau de blocs de contenu ; les types pris en charge sont `text`, `image_url` (image) et `video_url` (vidéo)\n- Taille maximale du corps de la requête : 64 MB",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ContentPart"
                }
              }
            ]
          },
          "name": {
            "type": "string",
            "description": "Nom du participant, utilisé pour distinguer les différents utilisateurs"
          }
        }
      },
      "ContentPart": {
        "type": "object",
        "description": "Partie de contenu multimodal. Déclarez le type via `type` et ne renseignez que les champs correspondant à ce type",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image_url",
              "video_url"
            ],
            "description": "Type de contenu\n\n- `text` : bloc de texte\n- `image_url` : entrée d'image\n- `video_url` : entrée vidéo"
          },
          "text": {
            "type": "string",
            "description": "Contenu textuel lorsque `type=text`"
          },
          "image_url": {
            "type": "object",
            "description": "Entrée d'image (lorsque `type=image_url`). Maximum 10 Mo par image, prend en charge JPEG / PNG / GIF / WEBP",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "URL de l'image, ou data URL base64 commençant par `data:`"
              },
              "detail": {
                "type": "string",
                "description": "Contrôle la résolution d'analyse de l'image\n\n- `low` : faible précision, consomme moins de tokens\n- `default` : précision par défaut\n- `high` : haute précision, reconnaît plus de détails mais consomme plus de tokens",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Limite de pixels maximale pour le côté le plus long de l'image",
                "minimum": 1
              }
            }
          },
          "video_url": {
            "type": "object",
            "description": "Entrée vidéo (lorsque `type=video_url`). Maximum 50 Mo pour une vidéo en URL / Base64, prend en charge MP4 / AVI / MOV / MKV",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "URL de la vidéo, une data URL base64 commençant par `data:`, ou une référence de fichier au format `mm_file://{file_id}`"
              },
              "detail": {
                "type": "string",
                "description": "Contrôle la résolution d'extraction des images de la vidéo",
                "enum": [
                  "low",
                  "default",
                  "high"
                ],
                "default": "default"
              },
              "fps": {
                "type": "number",
                "description": "Fréquence d’échantillonnage des images vidéo, valeur par défaut : 1, plage : [0.2, 5]. Une fréquence plus élevée aide à détecter les changements visuels et augmente généralement la consommation de tokens.",
                "minimum": 0.2,
                "maximum": 5,
                "default": 1
              },
              "max_long_side_pixel": {
                "type": "integer",
                "description": "Limite de pixels maximale pour le côté le plus long des images de la vidéo",
                "minimum": 1
              }
            }
          }
        }
      },
      "AssistantRequestMessage": {
        "title": "Assistant Message",
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "assistant"
            ],
            "description": "Identifiant de rôle, fixé à `assistant`"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Contenu du message de l'assistant\n\n**Remarques** :\n- Utilisé pour transmettre les réponses historiques de l'assistant dans les conversations multi-tours\n- Peut être `null` lorsque `tool_calls` est présent"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Contenu de raisonnement renvoyé au tour précédent ; à retransmettre sans modification dans les conversations multi-tours"
          },
          "name": {
            "type": "string",
            "description": "Nom du participant"
          },
          "tool_calls": {
            "type": "array",
            "description": "Liste des appels d'outils\n\nUtilisée pour transmettre les informations historiques d'appels d'outils dans les conversations multi-tours",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identifiant unique de l'appel d'outil"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nom de la fonction appelée"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Arguments de la fonction (chaîne JSON)"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ToolMessage": {
        "title": "Tool Message",
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "tool"
            ],
            "description": "Identifiant de rôle, fixé à `tool`"
          },
          "content": {
            "type": "string",
            "description": "Contenu du résultat de l'appel d'outil"
          },
          "tool_call_id": {
            "type": "string",
            "description": "ID de l'appel d'outil\n\nCorrespond au champ `id` renvoyé dans `tool_calls` du message de l'assistant"
          }
        }
      },
      "Tool": {
        "type": "object",
        "required": [
          "type",
          "function"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "function"
            ],
            "description": "Type d'outil, actuellement seul `function` est pris en charge"
          },
          "function": {
            "type": "object",
            "required": [
              "name",
              "parameters"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Nom de la fonction à appeler\n\n**Remarques** :\n- Doit être composé de caractères a-z, A-Z, 0-9, ou inclure des traits de soulignement et des tirets\n- La longueur maximale est de 64 caractères"
              },
              "description": {
                "type": "string",
                "description": "Description de la fonction, aide le modèle à comprendre quand et comment appeler cette fonction"
              },
              "parameters": {
                "type": "object",
                "description": "Paramètres d'entrée de la fonction, décrits sous forme d'objet JSON Schema"
              }
            }
          }
        }
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de la complétion de conversation",
            "example": "0668a381bdc3c0ded310e27c9a46d16e7"
          },
          "model": {
            "type": "string",
            "description": "Nom du modèle réellement utilisé",
            "example": "MiniMax-M3.1-Flash"
          },
          "object": {
            "type": "string",
            "enum": [
              "chat.completion"
            ],
            "description": "Type de réponse",
            "example": "chat.completion"
          },
          "created": {
            "type": "integer",
            "description": "Horodatage de création (secondes Unix)",
            "example": 1777026807
          },
          "choices": {
            "type": "array",
            "description": "Liste des choix de complétion de conversation",
            "items": {
              "$ref": "#/components/schemas/Choice"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "input_sensitive": {
            "type": "boolean",
            "description": "Indique si le contenu d'entrée a déclenché un filtre de mots sensibles. Si l'entrée enfreint gravement les règles, l'API renvoie une erreur de violation de contenu avec un contenu de réponse vide"
          },
          "input_sensitive_type": {
            "type": "integer",
            "description": "Type de mot sensible déclenché par l'entrée (renvoyé lorsque `input_sensitive` est true) : 1 violation grave ; 2 pornographie ; 3 publicité ; 4 contenu interdit ; 5 langage injurieux ; 6 violence/terrorisme ; 7 autre"
          },
          "output_sensitive": {
            "type": "boolean",
            "description": "Indique si le contenu de sortie a déclenché un filtre de mots sensibles"
          },
          "output_sensitive_type": {
            "type": "integer",
            "description": "Type de mot sensible déclenché par la sortie"
          },
          "base_resp": {
            "type": "object",
            "description": "Code de statut et détails de l'erreur",
            "properties": {
              "status_code": {
                "type": "integer",
                "description": "Code de statut. `0` indique un succès ; les autres codes incluent `1002` pour la limitation de fréquence, `1008` pour un solde insuffisant, `1039` pour un dépassement de la limite de tokens, `2013` pour une erreur de paramètre, etc."
              },
              "status_msg": {
                "type": "string",
                "description": "Détails de l'erreur"
              }
            }
          },
          "output_sensitive_int": {
            "type": "integer",
            "description": "Identifiant numérique de la catégorie de mots sensibles détectée dans la sortie"
          }
        }
      },
      "Choice": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "description": "Index du choix",
            "example": 0
          },
          "message": {
            "$ref": "#/components/schemas/AssistantMessage"
          },
          "finish_reason": {
            "type": "string",
            "description": "Raison de fin\n\n- `stop` : achèvement naturel ou séquence d'arrêt déclenchée\n- `length` : limite maximale de tokens atteinte\n- `content_filter` : contenu filtré par la politique de sécurité\n- `tool_calls` : le modèle a invoqué un outil",
            "enum": [
              "stop",
              "length",
              "content_filter",
              "tool_calls"
            ],
            "example": "stop"
          }
        }
      },
      "AssistantMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Rôle de l'expéditeur du message",
            "enum": [
              "assistant"
            ],
            "example": "assistant"
          },
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Contenu de la réponse finale, sans le processus de raisonnement (peut valoir `null` en cas d’appel d’outil)",
            "example": "0.05"
          },
          "reasoning_content": {
            "type": "string",
            "description": "Contenu du raisonnement. Il peut être absent pour les questions simples ; dans ce cas, ce champ n’est pas renvoyé",
            "example": "Let the ball cost x. Then 2x + 1 = 1.10, so x = 0.05."
          },
          "name": {
            "type": "string",
            "description": "Nom de l'expéditeur"
          },
          "audio_content": {
            "type": "string",
            "description": "Contenu audio (chaîne vide pour les scénarios de conversation en texte uniquement)"
          },
          "tool_calls": {
            "type": "array",
            "description": "Liste des appels d'outils (renvoyée lorsque le modèle décide d'invoquer un outil)",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identifiant unique de l'appel d'outil"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "function"
                  ]
                },
                "function": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Nom de la fonction appelée"
                    },
                    "arguments": {
                      "type": "string",
                      "description": "Arguments de la fonction (chaîne JSON)"
                    }
                  }
                },
                "index": {
                  "type": "integer",
                  "description": "Index de l'appel d'outil"
                }
              }
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "description": "Statistiques d'utilisation des tokens",
        "properties": {
          "total_tokens": {
            "type": "integer",
            "description": "Nombre total de tokens consommés",
            "example": 1604
          },
          "total_characters": {
            "type": "integer",
            "description": "Nombre total de caractères consommés",
            "example": 0
          },
          "prompt_tokens": {
            "type": "integer",
            "description": "Nombre total de tokens d’entrée, y compris les tokens lus depuis le cache",
            "example": 1365
          },
          "completion_tokens": {
            "type": "integer",
            "description": "Nombre de tokens de sortie (part de réflexion incluse)",
            "example": 239
          },
          "completion_tokens_details": {
            "type": "object",
            "description": "Détail des tokens de sortie",
            "properties": {
              "reasoning_tokens": {
                "type": "integer",
                "description": "Nombre de tokens de raisonnement",
                "example": 49
              }
            }
          },
          "prompt_tokens_details": {
            "type": "object",
            "description": "Détail des tokens d'entrée",
            "properties": {
              "cached_tokens": {
                "type": "integer",
                "description": "Nombre de tokens d’entrée lus depuis le cache\n\nLes tokens lus depuis le cache sont facturés au tarif de lecture du cache. Tokens non mis en cache = `prompt_tokens - cached_tokens` ; ils sont facturés au tarif d’entrée standard",
                "example": 114
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "description": "Code d'erreur de statut HTTP"
              },
              "message": {
                "type": "string",
                "description": "Description de l'erreur"
              },
              "type": {
                "type": "string",
                "description": "Type d'erreur"
              },
              "param": {
                "type": "string",
                "description": "Nom du paramètre concerné"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Toutes les API nécessitent une authentification Bearer Token\n\n**Obtenir une clé API** :\n\nVisitez la [Page de gestion des clés API](https://evolink.ai/dashboard/keys) pour obtenir votre clé API\n\n**Ajouter à l'en-tête de requête** :\n```\nAuthorization: Bearer YOUR_API_KEY\n```"
      }
    }
  },
  "tags": [
    {
      "name": "Génération de conversation",
      "description": "Points de terminaison liés à la génération de conversation par IA"
    }
  ]
